{
  "name": "blockfield-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
    "start": "node ./dist/server/entry.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:postgres": "node --experimental-strip-types --test test/stats*.test.mjs test/admin.test.mjs test/names.test.mjs test/storage.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,astro,css}\" \"{scripts,test}/**/*.mjs\" \"*.mjs\" package.json",
    "format:check": "prettier --check \"src/**/*.{ts,astro,css}\" \"{scripts,test}/**/*.mjs\" \"*.mjs\" package.json"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "astro": "7.3.5",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "1.1.0",
    "typescript-eslint": "8.71.0"
  }
}
