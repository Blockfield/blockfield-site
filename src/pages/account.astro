---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/500.css';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Аккаунт — Blockfield</title>
    <meta name="description" content="Вход, регистрация, скин, плащ и пароль аккаунта Blockfield." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#070604" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="Blockfield — главная"><img src="/logo.svg" width="40" height="40" alt="" />BLOCKFIELD</a>
      <a href="/">На главную</a>
    </header>
    <main>
      <p class="eyebrow">Blockfield ID</p>
      <h1>Аккаунт</h1>
      <p class="intro">Этот же никнейм и пароль подходят для входа в Blockfield Launcher. Если вы играете через Prism Launcher, в лобби сервера используйте команды <code>/register</code> и <code>/login</code> — аккаунт будет тот же.</p>
      <p id="account-status" role="status">Проверяем вход…</p>

      <section id="guest" class="panel" hidden aria-labelledby="auth-title">
        <h2 id="auth-title">Вход</h2>
        <div class="tabs" role="group" aria-label="Что сделать">
          <button type="button" data-mode="login" aria-pressed="true">Войти</button>
          <button type="button" data-mode="register" aria-pressed="false">Создать аккаунт</button>
        </div>
        <form id="auth-form">
          <label>Никнейм
            <input name="username" autocomplete="username" required minlength="3" maxlength="16" pattern="[A-Za-z0-9_]{3,16}" aria-describedby="nick-hint" />
          </label>
          <small id="nick-hint">3–16 символов: латинские буквы, цифры и _. Никнейм виден в игре.</small>
          <label>Пароль
            <input name="password" type="password" autocomplete="current-password" required minlength="8" aria-describedby="pass-hint" />
          </label>
          <small id="pass-hint">Не короче 8 символов.</small>
          <button class="primary" type="submit">Войти</button>
          <p class="form-status" role="status"></p>
        </form>
      </section>

      <section id="profile" hidden aria-labelledby="nickname">
        <aside class="who panel">
          <div id="stage" class="stage" role="img" aria-label="Скин игрока в 3D. Потяните, чтобы повернуть.">
            <div class="rig"><div id="figure" class="figure"></div></div>
            <span class="floor"></span>
          </div>
          <p class="hint">Потяните фигуру, чтобы повернуть</p>
          <p class="label">Никнейм</p>
          <h2 id="nickname"></h2>
          <p id="skin-note"></p>
          <button id="logout" type="button">Выйти</button>
        </aside>

        <div class="forms">
          <form id="skin-form" class="panel">
            <h3><span class="num">01</span>Скин</h3>
            <label>Файл PNG 64×64 или 64×32, до 1 МиБ
              <input name="file" type="file" accept="image/png" />
            </label>
            <fieldset>
              <legend>Модель рук</legend>
              <label class="choice"><input type="radio" name="model" value="classic" checked /> Классическая, 4 px</label>
              <label class="choice"><input type="radio" name="model" value="slim" /> Тонкая, 3 px</label>
            </fieldset>
            <div class="actions">
              <button class="primary" type="submit">Сохранить скин</button>
              <button type="button" data-remove="skin">Сбросить к скину Minecraft</button>
            </div>
            <p class="form-status" role="status"></p>
          </form>

          <form id="cape-form" class="panel">
            <h3><span class="num">02</span>Плащ</h3>
            <label>Файл PNG 64×32, до 1 МиБ
              <input name="file" type="file" accept="image/png" required />
            </label>
            <div class="actions">
              <button class="primary" type="submit">Загрузить плащ</button>
              <button type="button" data-remove="cape">Убрать плащ</button>
            </div>
            <p class="form-status" role="status"></p>
          </form>

          <form id="password-form" class="panel">
            <h3><span class="num">03</span>Пароль</h3>
            <input name="username" autocomplete="username" hidden />
            <label>Текущий пароль
              <input name="current" type="password" autocomplete="current-password" required />
            </label>
            <label>Новый пароль
              <input name="password" type="password" autocomplete="new-password" required minlength="8" aria-describedby="new-pass-hint" />
            </label>
            <small id="new-pass-hint">Не короче 8 символов. После смены пароля лаунчер и игра попросят войти заново.</small>
            <button class="primary" type="submit">Сменить пароль</button>
            <p class="form-status" role="status"></p>
          </form>
        </div>
      </section>
    </main>
    <style is:global>
      :root { color-scheme: dark; font-family: 'Inter Variable', sans-serif; background: #070604; color: #F3E7D0; --mono: 'IBM Plex Mono', ui-monospace, monospace; }
      * { box-sizing: border-box; }
      body { margin: 0; min-width: 320px; background: radial-gradient(60% 40% at 50% -10%, #1c150a 0%, transparent 100%); }
      [hidden] { display: none !important; }
      a { color: #F5A524; text-underline-offset: 4px; text-decoration-thickness: 1px; }
      a:hover { color: #F3E7D0; }
      a:focus-visible, button:focus-visible, input:focus-visible, .stage:focus-visible { outline: 2px solid #F5A524; outline-offset: 3px; }
      header { max-width: 1200px; margin: 0 auto; padding: 24px clamp(20px, 5vw, 48px); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; border-bottom: 1px solid #2A2116; }
      .brand { display: flex; align-items: center; gap: 12px; color: #F3E7D0; font-weight: 750; text-decoration: none; letter-spacing: .04em; }
      main { max-width: 1120px; margin: 0 auto; padding: 56px clamp(20px, 5vw, 48px) 96px; }
      .eyebrow, .label, .num, .hint { font-family: var(--mono); font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #8E7A5E; margin: 0; }
      .eyebrow { color: #F5A524; margin-bottom: 12px; }
      .eyebrow::before { content: '// '; color: #5E5040; }
      h1 { font-size: clamp(38px, 6vw, 64px); line-height: .95; letter-spacing: -.03em; text-transform: uppercase; font-weight: 800; margin: 0 0 20px; }
      h2, h3 { margin: 0 0 16px; }
      h2 { font-size: 24px; overflow-wrap: anywhere; }
      h3 { font-size: 18px; display: flex; align-items: baseline; gap: 12px; }
      .num { color: #F5A524; }
      p, small { color: #C7AE86; line-height: 1.6; }
      .intro { font-size: 17px; max-width: 64ch; }
      code { font-family: var(--mono); color: #F3E7D0; background: #18130D; padding: 1px 6px; }
      .panel { background: #11100D; border: 1px solid #2A2116; padding: clamp(20px, 4vw, 32px); }
      #guest { max-width: 520px; margin-top: 24px; }
      form { display: grid; gap: 12px; }
      label { display: grid; gap: 8px; font-weight: 600; }
      small { margin-top: -6px; font-size: 14px; }
      input:not([type=radio]) { font: inherit; color: #F3E7D0; background: #070604; border: 1px solid #3A2C1D; padding: 12px; width: 100%; }
      input[type=file] { padding: 10px; }
      input:user-invalid { border-color: #FF9D99; }
      fieldset { border: 1px solid #2A2116; margin: 0; padding: 12px 16px; display: flex; flex-wrap: wrap; gap: 8px 24px; }
      legend { color: #C7AE86; padding: 0 6px; }
      .choice { display: flex; align-items: center; gap: 8px; font-weight: 400; }
      .choice input { accent-color: #F5A524; width: 18px; height: 18px; margin: 0; }
      button { font: inherit; font-weight: 700; color: #F3E7D0; background: transparent; border: 1px solid #F5A524; padding: 12px 18px; cursor: pointer; }
      button:hover { background: #2A2116; }
      button.primary { background: #F5A524; color: #070604; }
      button.primary:hover { background: #FFC861; }
      button:disabled { opacity: .6; cursor: progress; }
      form > button { justify-self: start; }
      .actions { display: flex; flex-wrap: wrap; gap: 12px; }
      .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
      .tabs button { border-color: #3A2C1D; }
      .tabs button[aria-pressed=true] { border-color: #F5A524; background: #2A2116; }
      .form-status { margin: 0; min-height: 1.6em; }
      .form-status.error, #account-status.error { color: #FF9D99; }
      .form-status.ok { color: #82D66B; }

      #profile { display: grid; grid-template-columns: minmax(300px, 380px) 1fr; gap: 24px; align-items: start; margin-top: 24px; }
      .forms { display: grid; gap: 24px; }
      .who { position: sticky; top: 24px; }
      .who p { margin: 0; }
      .who h2 { font-size: 32px; letter-spacing: -.02em; margin: 4px 0 8px; }
      .who .hint { margin: 12px 0 28px; text-align: center; letter-spacing: .1em; text-transform: none; }
      #logout { width: 100%; margin-top: 20px; }

      /* 3D-фигура из CSS-кубоидов: --s — размер текселя, --tex — картинка скина или плаща. */
      .stage { --s: 8px; position: relative; height: 380px; display: grid; place-items: center; overflow: hidden; perspective: 1400px; cursor: grab; touch-action: pan-y; user-select: none; border: 1px solid #2A2116;
        background: radial-gradient(80% 45% at 50% 100%, #3a2410 0%, transparent 70%), repeating-linear-gradient(0deg, #17120c 0 1px, transparent 1px 24px), repeating-linear-gradient(90deg, #17120c 0 1px, transparent 1px 24px), #0B0906; }
      .stage.grabbed { cursor: grabbing; }
      .stage.grabbed .rig { animation-play-state: paused; }
      .floor { position: absolute; left: 50%; bottom: 44px; width: 160px; height: 28px; translate: -50% 0; border-radius: 50%; background: radial-gradient(#000c 0%, transparent 70%); }
      .rig, .figure, .box { transform-style: preserve-3d; }
      .rig { transform: rotateX(-12deg); animation: spin 18s linear infinite; }
      .figure { --yaw: 0deg; position: relative; width: calc(16 * var(--s)); height: calc(32 * var(--s)); transform: rotateY(var(--yaw)); }
      .box { position: absolute; transform-origin: 50% 0; }
      .box.swing { animation: swing 1.6s ease-in-out infinite alternate; }
      .box.swing.back { animation-delay: -1.6s; }
      .overlay { inset: 0; transform-origin: 50% 50%; }
      .face { position: absolute; left: 50%; top: 50%; translate: -50% -50%; backface-visibility: hidden; image-rendering: pixelated; background-repeat: no-repeat; background-image: var(--tex, none); background-color: var(--fill, transparent); background-size: calc(64 * var(--s)) auto; }
      .blank { --fill: #2A2116; }
      .blank .overlay { display: none; }
      .face:nth-child(2) { filter: brightness(.75); }
      .face:nth-child(3), .face:nth-child(4) { filter: brightness(.85); }
      .face:nth-child(5) { filter: brightness(1.12); }
      .face:nth-child(6) { filter: brightness(.55); }
      @keyframes spin { to { transform: rotateX(-12deg) rotateY(360deg); } }
      @keyframes swing { from { rotate: x -22deg; } to { rotate: x 22deg; } }
      @media (prefers-reduced-motion: reduce) { .rig, .box { animation: none; } }
      @media (max-width: 860px) { #profile { grid-template-columns: 1fr; } .who { position: static; } }
      @media (max-width: 600px) { main { padding-top: 40px; } .stage { height: 320px; --s: 7px; } }
    </style>
    <script>
      import { faces, parts } from '../lib/skin3d';
      const status = document.querySelector<HTMLElement>('#account-status')!;
      const guest = document.querySelector<HTMLElement>('#guest')!;
      const profile = document.querySelector<HTMLElement>('#profile')!;
      const authForm = document.querySelector<HTMLFormElement>('#auth-form')!;
      const skinForm = document.querySelector<HTMLFormElement>('#skin-form')!;
      const capeForm = document.querySelector<HTMLFormElement>('#cape-form')!;
      const passwordForm = document.querySelector<HTMLFormElement>('#password-form')!;
      const stage = document.querySelector<HTMLElement>('#stage')!;
      const figure = document.querySelector<HTMLElement>('#figure')!;
      type Account = { username: string; skinUrl: string | null; capeUrl: string | null; skinModel: 'classic' | 'slim' };
      let mode = 'login';

      async function api(path: string, init?: RequestInit) {
        const response = await fetch(path, init).catch(() => null);
        if (!response) throw new Error('Нет связи с сайтом. Проверьте подключение.');
        const data = response.status === 204 ? null : await response.json().catch(() => null);
        if (response.status === 401) show(null);
        if (!response.ok) throw new Error(data?.error || 'Не удалось выполнить запрос.');
        return data;
      }
      const json = (method: string, body: unknown): RequestInit => ({ method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

      function say(form: HTMLFormElement, text: string, ok = false) {
        const line = form.querySelector('.form-status')!;
        line.textContent = text;
        line.className = `form-status ${ok ? 'ok' : 'error'}`;
      }

      async function submit(form: HTMLFormElement, action: () => Promise<string>) {
        const buttons = form.querySelectorAll('button');
        buttons.forEach(b => (b.disabled = true));
        say(form, 'Отправляем…', true);
        try { say(form, await action(), true); } catch (error) { say(form, (error as Error).message); } finally { buttons.forEach(b => (b.disabled = false)); }
      }

      const px = (n: number) => `calc(${n} * var(--s))`;
      function box(x: number, y: number, u: number, v: number, W: number, H: number, D: number, style = ''): HTMLElement {
        const el = document.createElement('div');
        el.className = 'box';
        el.style.cssText = `left:${px(x)};top:${px(y)};width:${px(W)};height:${px(H)};${style}`;
        for (const f of faces(u, v, W, H, D)) {
          const face = document.createElement('span');
          face.className = 'face';
          face.style.cssText = `width:${px(f.w)};height:${px(f.h)};background-position:${px(-f.u)} ${px(-f.v)};transform:${f.rot} translateZ(${px(f.out)})`;
          el.append(face);
        }
        return el;
      }

      function buildFigure(account: Account, legacy: boolean) {
        figure.replaceChildren();
        figure.classList.toggle('blank', !account.skinUrl);
        figure.style.setProperty('--tex', account.skinUrl ? `url("${account.skinUrl}")` : 'none');
        for (const p of parts(account.skinModel === 'slim', legacy)) {
          const el = box(p.x, p.y, p.u, p.v, p.W, p.H, p.D, p.mirror ? 'transform:scaleX(-1)' : '');
          if (p.swing) el.className += ` swing${p.swing < 0 ? ' back' : ''}`;
          if (p.over) {
            const g = p.grow ?? .5;
            const overlay = box(0, 0, p.over[0], p.over[1], p.W, p.H, p.D, `transform:scale3d(${(p.W + g) / p.W},${(p.H + g) / p.H},${(p.D + g) / p.D})`);
            overlay.classList.add('overlay');
            el.append(overlay);
          }
          figure.append(el);
        }
        if (account.capeUrl) figure.append(box(3, 8, 0, 0, 10, 16, 1, `--tex:url("${account.capeUrl}");transform:translateZ(${px(-2.5)}) rotateY(180deg) rotateX(8deg)`));
      }

      function drawSkin(account: Account) {
        if (!account.skinUrl) return buildFigure(account, false);
        const image = new Image();
        image.onload = () => buildFigure(account, image.height === 32);
        image.onerror = () => buildFigure({ ...account, skinUrl: null }, false);
        image.src = account.skinUrl;
      }

      let yaw = 0, dragX: number | null = null;
      stage.addEventListener('pointerdown', e => { dragX = e.clientX; stage.classList.add('grabbed'); stage.setPointerCapture(e.pointerId); });
      stage.addEventListener('pointermove', e => {
        if (dragX === null) return;
        yaw += (e.clientX - dragX) * .6;
        dragX = e.clientX;
        figure.style.setProperty('--yaw', `${yaw}deg`);
      });
      stage.addEventListener('pointerup', () => { dragX = null; stage.classList.remove('grabbed'); });
      stage.addEventListener('pointercancel', () => { dragX = null; stage.classList.remove('grabbed'); });

      function show(account: Account | null) {
        guest.hidden = !!account;
        profile.hidden = !account;
        status.className = '';
        status.textContent = account ? `Вы вошли как ${account.username}.` : 'Войдите или создайте аккаунт.';
        if (!account) return;
        document.querySelector('#nickname')!.textContent = account.username;
        passwordForm.username.value = account.username;
        document.querySelector('#skin-note')!.textContent = `${account.skinUrl ? 'Свой скин' : 'Скин Minecraft по умолчанию'}, модель ${account.skinModel === 'slim' ? 'тонкая' : 'классическая'}. ${account.capeUrl ? 'Плащ загружен.' : 'Плаща нет.'}`;
        skinForm.querySelector<HTMLInputElement>(`input[value=${account.skinModel}]`)!.checked = true;
        drawSkin(account);
      }

      document.querySelectorAll<HTMLButtonElement>('.tabs button').forEach(button => button.addEventListener('click', () => {
        mode = button.dataset.mode!;
        document.querySelectorAll('.tabs button').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
        authForm.querySelector('button[type=submit]')!.textContent = mode === 'login' ? 'Войти' : 'Создать аккаунт';
        authForm.password.autocomplete = mode === 'login' ? 'current-password' : 'new-password';
        say(authForm, '', true);
      }));

      authForm.addEventListener('submit', event => {
        event.preventDefault();
        submit(authForm, async () => {
          const account = await api(`/api/account/${mode}`, json('POST', { username: authForm.username.value, password: authForm.password.value }));
          authForm.reset();
          show(account);
          return '';
        });
      });

      document.querySelector('#logout')!.addEventListener('click', async () => {
        await api('/api/account/logout', json('POST', {})).catch(() => {});
        show(null);
      });

      skinForm.addEventListener('submit', event => {
        event.preventDefault();
        submit(skinForm, async () => {
          const file = skinForm.file.files[0] as File | undefined;
          const model = skinForm.model.value;
          if (file && file.size > 1_048_576) throw new Error('Файл больше 1 МиБ.');
          const account = file
            ? await api(`/api/account/skin?model=${model}`, { method: 'PUT', headers: { 'Content-Type': 'image/png' }, body: file })
            : await api('/api/account/skin', json('PATCH', { model }));
          skinForm.file.value = '';
          show({ ...account, capeUrl: (await api('/api/account/me')).account?.capeUrl ?? null });
          return file ? 'Скин сохранён. В игре он появится при следующем входе.' : 'Модель скина сохранена.';
        });
      });

      capeForm.addEventListener('submit', event => {
        event.preventDefault();
        submit(capeForm, async () => {
          const file = capeForm.file.files[0] as File;
          if (file.size > 1_048_576) throw new Error('Файл больше 1 МиБ.');
          show(await api('/api/account/cape', { method: 'PUT', headers: { 'Content-Type': 'image/png' }, body: file }).then(() => api('/api/account/me')).then(d => d.account));
          capeForm.reset();
          return 'Плащ сохранён.';
        });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach(button => button.addEventListener('click', () => {
        const form = button.form!;
        submit(form, async () => {
          // Без Content-Type встроенная проверка Astro сравнивает Origin с http-адресом за nginx и отвечает 403.
          await api(`/api/account/${button.dataset.remove}`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
          show((await api('/api/account/me')).account);
          return button.dataset.remove === 'skin' ? 'Скин сброшен к скину Minecraft.' : 'Плащ убран.';
        });
      }));

      passwordForm.addEventListener('submit', event => {
        event.preventDefault();
        submit(passwordForm, async () => {
          await api('/api/account/password', json('POST', { current: passwordForm.current.value, password: passwordForm.password.value }));
          passwordForm.reset();
          return 'Пароль изменён. Войдите в лаунчере с новым паролем.';
        });
      });

      api('/api/account/me').then(data => show(data.account), (error: Error) => { status.textContent = error.message; status.className = 'error'; });
    </script>
  </body>
</html>
