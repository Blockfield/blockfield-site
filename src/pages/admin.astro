  <script>
    import {
      BALANCE_DEFAULTS,
      ARENA_MODES,
      BALANCE_GROUPS,
      BALANCE_LABELS,
      BALANCE_SCOPES,
      CLASS_COSTS,
      CLASS_NAMES,
      KIT_GUNS,
      MAP_NAMES,
      MODE_NAMES,
      PARCOOL_ACTIONS,
      PARCOOL_FILE_DEFAULT,
      WORKSHOP_PLACES,
      TEAM_NAMES,
    } from '../lib/game-names'
    import { settingsBody, settingsReceipt } from '../lib/settings-form'
    import { effectiveKits, renderKitForm } from '../lib/kit-form'
    import { validateKitChanges, type KitCatalog, type KitDefinition } from '../lib/kit-schema'
    import { customSelect, customCombo } from '../lib/custom-select'
    import { gameReady, switchView } from '../lib/switch-status'
    import { dangerousCommand } from '../lib/console'
    import { NAV_GROUPS, resolveTab } from '../lib/admin-navigation'
    import type {
      GunBalanceCatalog,
      GunDefinition,
      GunField,
      GunOverrides,
    } from '../lib/gun-balance'
    import type { MapCatalogEntry, MapSession } from '../lib/admin'

    type Me = { uuid: string; name: string; role: string | null; permissions: string[] }
    const $ = <T extends HTMLElement = HTMLElement>(selector: string) =>
      document.querySelector<T>(selector)!
    const ROLES: Record<string, { name: string; about: string }> = {
      builder: {
        name: 'Строитель',
        about: 'Строит доступные карты и отправляет их на проверку.',
      },
      moderator: {
        name: 'Модератор',
        about: 'Следит за порядком, выгоняет игроков и завершает зависшие матчи.',
      },
      admin: {
        name: 'Администратор',
        about: 'Управляет игрой, банами, статистикой и командой.',
      },
      owner: {
        name: 'Владелец',
        about: 'Полный доступ. Назначает администраторов.',
      },
    }
    const PHASES: Record<string, string> = {
      IDLE: 'Ждёт игроков',
      VOTING: 'Голосование за карту',
      PREPARING: 'Подготовка к бою',
      GAME: 'Идёт бой',
      MATCH_END: 'Подведение итогов',
    }
    const OUTCOMES: [string, string, string][] = [
      ['draw', 'Ничья', 'Без победителя.'],
      ['RED', 'Победа красных', ''],
      ['BLUE', 'Победа синих', ''],
      ['none', 'Без итога', 'Без победителя и результата.'],
    ]
    let me: Me
    const can = (permission: string) => me.permissions.includes(permission)

    // Times use the visitor's own time zone, like the server-rendered pages (LocalTime).
    const dateFormat = new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'long',
      hour: '2-digit',
      minute: '2-digit',
    })
    const relative = new Intl.RelativeTimeFormat('ru', { numeric: 'auto' })
    const date = (ms: number) => dateFormat.format(ms)
    function ago(ms: number) {
      const seconds = (ms - Date.now()) / 1000
      for (const [unit, size] of [
        ['year', 31536000],
        ['month', 2592000],
        ['week', 604800],
        ['day', 86400],
        ['hour', 3600],
        ['minute', 60],
      ] as const)
        if (Math.abs(seconds) >= size) return relative.format(Math.round(seconds / size), unit)
      return 'только что'
    }
    const number = (n: number) => n.toLocaleString('ru-RU')

    /** Server errors are mostly Russian already; technical or English ones are replaced with plain words. */
    function friendly(message: string | undefined, status: number) {
      const rules: [RegExp, string][] = [
        [
          /^Сервер не принял команду/,
          'Игрок вышел или матч закончился. Обновите список и повторите.',
        ],
        [/^(Недостаточно прав|Нет доступа)/, 'Недостаточно прав. Попросите администратора.'],
        [
          /^RCON не настроен/,
          'Управление игровым сервером с сайта не настроено. Сообщите владельцу.',
        ],
        [/already voided/, 'Этот матч уже не учитывается. Обновите страницу.'],
        [/is not voided/, 'Этот матч уже учитывается. Обновите страницу.'],
        [/Result not found/, 'Матч не найден. Обновите страницу.'],
        [/^Нет ревизии/, 'Состояние сервера изменилось. Обновите страницу и попробуйте снова.'],
        [/Участник не найден/, 'Этого участника уже нет в команде. Обновите страницу.'],
      ]
      if (!message)
        return status >= 500
          ? 'Сайт сейчас не отвечает. Попробуйте через минуту.'
          : 'Не получилось. Обновите страницу и попробуйте ещё раз.'
      const rule = rules.find(([pattern]) => pattern.test(message))
      if (rule) return rule[1]
      return /[а-яё]/i.test(message)
        ? message
        : 'Действие не выполнено. Обновите страницу и повторите.'
    }
    async function api(path: string, method = 'GET', body?: unknown) {
      // Content-Type is sent even without a body: Astro's origin check rejects bodiless non-GET requests behind the proxy.
      const response = await fetch(`/api/admin/${path}`, {
        method,
        cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body),
      }).catch(() => null)
      if (!response) throw new Error('Нет связи с сайтом. Проверьте интернет и попробуйте ещё раз.')
      const data = await response.json().catch(() => null)
      if (!response.ok)
        throw Object.assign(new Error(friendly(data?.error, response.status)), {
          raw: data?.error ?? '',
          status: response.status,
        })
      return data
    }
    function el<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      props: Record<string, any> = {},
      ...children: (Node | string | null | undefined | false)[]
    ) {
      const node = document.createElement(tag)
      for (const [key, value] of Object.entries(props)) {
        if (key.startsWith('aria') || key.startsWith('data') || key === 'role' || key === 'for')
          node.setAttribute(
            key
              .replace(/^aria([A-Z])/, (_, c) => `aria-${c.toLowerCase()}`)
              .replace(/^data([A-Z])/, (_, c) => `data-${c.toLowerCase()}`),
            String(value),
          )
        else (node as any)[key] = value
      }
      node.append(
        ...children.filter((c): c is Node | string => c !== null && c !== undefined && c !== false),
      )
      return node
    }
    const button = (text: string, onclick: () => void, className = 'small', label?: string) =>
      el('button', {
        type: 'button',
        className,
        textContent: text,
        onclick,
        ...(label ? { ariaLabel: label } : {}),
      })
    function say(line: HTMLElement, text: string, tone: 'ok' | 'error' | 'pending' = 'ok') {
      line.textContent = text
      line.classList.remove('ok', 'error', 'pending')
      line.classList.add(tone)
    }
    /** Runs an action with its buttons disabled and reports progress, success or a friendly error on `line`. */
    async function run(
      line: HTMLElement,
      action: () => Promise<string | void>,
      scope: HTMLElement | null = null,
    ) {
      const buttons = scope ? [...scope.querySelectorAll('button')].filter((b) => !b.disabled) : []
      buttons.forEach((b) => (b.disabled = true))
      say(line, 'применяем…', 'pending')
      try {
        const text = await action()
        if (text) say(line, text, text === 'применяем…' ? 'pending' : 'ok')
        else {
          // Some actions render a one-time key or other structured success feedback directly.
          if (line.textContent === 'применяем…') line.textContent = ''
          line.classList.replace('pending', 'ok')
        }
      } catch (error) {
        say(line, (error as Error).message, 'error')
      } finally {
        buttons.forEach((b) => (b.disabled = false))
      }
    }

    // Accessible confirmation: native <dialog> traps focus, Escape cancels, focus returns to the opener.
    const dialog = $<HTMLDialogElement>('#dialog')
    function ask({
      title,
      text,
      ok,
      danger = false,
      fields = [],
    }: {
      title: string
      text: string
      ok: string
      danger?: boolean
      fields?: Node[]
    }): Promise<FormData | null> {
      const opener = document.activeElement as HTMLElement | null
      $('#dialog-title').textContent = title
      $('#dialog-text').textContent = text
      $('#dialog-fields').replaceChildren(...fields)
      Object.assign($('#dialog-ok'), {
        textContent: ok,
        className: danger ? 'primary danger' : 'primary',
      })
      dialog.returnValue = ''
      dialog.showModal()
      return new Promise((resolve) =>
        dialog.addEventListener(
          'close',
          () => {
            const form = dialog.querySelector('form')!
            resolve(dialog.returnValue === 'ok' ? new FormData(form) : null)
            opener?.focus()
          },
          { once: true },
        ),
      )
    }
    let fieldId = 0
    function field(label: string, input: HTMLElement, hint?: string, wrap?: HTMLElement) {
      const id = `f${++fieldId}`
      input.id = id
      if (hint) input.setAttribute('aria-describedby', `${id}-hint`)
      return el(
        'div',
        { className: 'field row' },
        el(
          'label',
          { for: id },
          label,
          hint ? el('small', { id: `${id}-hint`, textContent: hint }) : null,
        ),
        el('div', { className: 'ctl' }, wrap ?? input),
        el('span', { className: 'state', role: 'status' }),
      )
    }
    const reasonField = (label = 'Причина (игрок её увидит)', required = false) =>
      field(
        label,
        el('input', { name: 'reason', maxLength: 120, required, autocomplete: 'off' }),
        required ? undefined : 'Необязательно.',
      )

    // Results arrive live; a single GET at the deadline recovers a missed event.
    const followTokens = new WeakMap<HTMLElement, string>()
    const pendingRequests = new Map<string, (result: any) => void>()
    const requestResults = new Map<string, any>()
    function requestResult(id: string, result: any) {
      const finish = pendingRequests.get(id)
      if (finish) finish(result)
      else {
        requestResults.delete(id)
        requestResults.set(id, result)
        if (requestResults.size > 50) requestResults.delete(requestResults.keys().next().value!)
      }
    }
    async function follow(
      line: HTMLElement,
      id: string,
      done: string,
      onError?: (error: string) => Promise<boolean> | boolean,
    ) {
      followTokens.set(line, id)
      say(line, 'применяем…', 'pending')
      const result = await new Promise<any>((resolve) => {
        const finish = (result: any) => {
          clearTimeout(timer)
          pendingRequests.delete(id)
          resolve(result)
        }
        const timer = setTimeout(async () => {
          const { result } = await api(`request?id=${id}`).catch(() => ({ result: null }))
          finish(result)
        }, 60_000)
        pendingRequests.set(id, finish)
        if (requestResults.has(id)) {
          const result = requestResults.get(id)
          requestResults.delete(id)
          finish(result)
        }
      })
      if (followTokens.get(line) !== id) return
      if (!result) say(line, 'Нет подтверждения. Проверьте состояние позже.', 'error')
      else if (result.ok) say(line, done)
      else if (!(await onError?.(String(result.error))))
        say(
          line,
          /revision/i.test(String(result.error))
            ? 'Состояние сервера успело измениться. Обновите страницу и попробуйте снова.'
            : 'Действие не выполнено. Повторите или сообщите владельцу.',
          'error',
        )
      return result?.ok ? result : null
    }

    // ---------- Overview and matches ----------
    let controller: any = null
    let session: any = null
    /** since/deadline are ms timestamps; ago() naturally reads a future one as "через …" and a past one as "… назад". */
    function timing(view: ReturnType<typeof switchView>): string {
      return [
        typeof view.since === 'number' ? `началось ${ago(view.since)}` : null,
        typeof view.deadline === 'number' ? `автоматический откат ${ago(view.deadline)}` : null,
      ]
        .filter(Boolean)
        .join(' · ')
    }
    /** «Мастерская»/«Тестовый матч» status: who started the session, when, and which maps it covers. */
    function sessionLine(current: any): string | null {
      if (!current) return null
      const maps = current.maps
        ? current.maps.map((id: string) => MAP_NAMES[id] ?? id).join(', ')
        : 'все карты'
      return `Сеанс: ${maps} · начал ${current.startedBy?.name ?? '?'} ${ago(current.startedAt)}.`
    }
    function describeWorkshop(
      state: any,
      current: any,
      testCandidate: any,
    ): { tone: string; title: string; detail: string } {
      const view = switchView(state),
        when = timing(view)
      switch (state?.schema === 1 ? state.phase : undefined) {
        case 'workshop':
          if (state.gate !== 'builders') break
          return {
            tone: 'ok',
            title: 'Мастерская открыта',
            detail: [sessionLine(current), 'Доступна участникам команды с выданными правами.']
              .filter(Boolean)
              .join(' '),
          }
        case 'test': {
          if (state.gate !== 'testers') break
          const name = testCandidate
            ? (WORKSHOP_PLACES[testCandidate.mapId] ?? testCandidate.mapId)
            : 'карта'
          const who = testCandidate?.author?.name
            ? ` (кандидат от ${testCandidate.author.name}, ${ago(testCandidate.createdAt)})`
            : ''
          return {
            tone: 'warn',
            title: `Тестовый матч: ${name}${who}`,
            detail: [sessionLine(current), 'Заходить могут только тестеры.']
              .filter(Boolean)
              .join(' '),
          }
        }
        case 'DRAINING':
          return {
            tone: 'warn',
            title: 'Мастерская готовится к смене режима',
            detail: [view.step, when].filter(Boolean).join(' · '),
          }
        case 'REQUESTED':
        case 'SAVING':
        case 'STARTING':
          return {
            tone: 'warn',
            title: view.step ?? 'Мастерская перезапускается',
            detail: when || 'Вход в мастерскую временно закрыт.',
          }
        case 'ERROR':
          return {
            tone: 'bad',
            title: 'Мастерская недоступна из-за ошибки',
            detail: [
              view.errorMessage ? `Причина: ${view.errorMessage}.` : null,
              can('recover')
                ? 'Восстановите мастерскую в карточке «Игра и мастерская».'
                : 'Сообщите администратору.',
            ]
              .filter(Boolean)
              .join(' '),
          }
      }
      return {
        tone: 'warn',
        title: 'Готовность мастерской не подтверждена',
        detail: 'Ждём ответа сервера.',
      }
    }
    function describeGame(state: any, rooms: any): { tone: string; title: string; detail: string } {
      if (rooms.maintenance)
        return { tone: 'warn', title: 'Вход в игру закрыт', detail: rooms.maintenance.message }
      if (!gameReady(state))
        return {
          tone: 'warn',
          title:
            state?.game?.phase === 'STARTING'
              ? 'Игра запускается'
              : 'Готовность игры не подтверждена',
          detail: 'Ждём ответа сервера.',
        }
      if (rooms.available)
        return {
          tone: 'ok',
          title: 'Игра работает',
          detail: `Идёт матчей: ${rooms.rooms?.length ?? 0}`,
        }
      return {
        tone: 'bad',
        title: 'Игровой сервер не отвечает',
        detail: rooms.lobby
          ? 'Лобби работает, но матчи сейчас недоступны.'
          : 'Игроки сейчас не могут зайти.',
      }
    }
    let lastWorkshop: ReturnType<typeof describeWorkshop> | undefined
    async function loadOverview() {
      await renderOverview(await api('overview'))
    }
    async function renderOverview({ status: state, session: sessionData, rooms }: any) {
      controller = state
      session = sessionData
      // The candidate behind a running test match: same source the candidates card reads, "view" permission covers it.
      const testCandidate =
        state?.phase === 'test' && state?.desired?.candidate
          ? ((await api('candidates').catch(() => ({ candidates: [] }))).candidates?.find(
              (c: any) => c.sha256 === state.desired.candidate,
            ) ?? null)
          : null
      const workshop = (lastWorkshop = describeWorkshop(state, session, testCandidate))
      say(
        $('#editor-state'),
        `${workshop.title}. ${workshop.detail}`,
        workshop.tone === 'bad' ? 'error' : workshop.tone === 'warn' ? 'pending' : 'ok',
      )
      renderGameOverview(state, rooms, workshop)
      const message = $<HTMLTextAreaElement>('#message')
      if (
        !message.value &&
        typeof state?.message === 'string' &&
        document.activeElement !== message
      )
        savedMessage = message.value = state.message
      // The candidates card's «Тест» button depends on the phase just learned above; keep it in sync (cheap local read).
      if (can('workshop')) loadCandidates().catch(() => {})
    }

    function renderGameOverview(
      state: any,
      rooms: any,
      workshop = describeWorkshop(state, session, null),
    ) {
      const view = describeGame(state, rooms)
      $('#lamp').dataset.tone = view.tone
      $('#lamp').textContent = view.title
      renderRoomSummary(rooms)
      $('#server-card').dataset.tone = view.tone
      $('#server-headline').textContent = view.title
      $('#server-detail').textContent = [
        view.detail,
        `проверено ${ago(rooms.checkedAt || Date.now())}`,
      ]
        .filter(Boolean)
        .join(' · ')
      renderModes(workshop, rooms)
      renderRooms(rooms)
    }
    function renderRoomSummary(rooms: any) {
      for (const [selector, value] of [
        ['#s-online', rooms.online],
        ['#s-matches', rooms.available ? rooms.rooms.length : undefined],
        ['#n-online', rooms.online],
        ['#n-matches', rooms.available ? rooms.rooms.length : undefined],
      ] as const) {
        const node = document.querySelector(selector)
        if (node) node.textContent = typeof value === 'number' ? String(value) : '—'
      }
      $('#side-now').replaceChildren(
        el('p', { className: 'label', textContent: 'Сейчас на сервере' }),
        ...(rooms.available
          ? rooms.rooms.map((room: any) =>
              el(
                'div',
                { className: 'match' },
                el(
                  'span',
                  {},
                  room.map || room.name,
                  el('small', { textContent: ` ${room.mode}` }),
                ),
                room.battle
                  ? el(
                      'span',
                      { className: 'score' },
                      el('b', { textContent: String(room.battle.red) }),
                      ' : ',
                      el('i', { textContent: String(room.battle.blue) }),
                    )
                  : el('span', {
                      className: 'muted',
                      textContent: PHASES[room.phase] ?? 'ожидание',
                    }),
              ),
            )
          : [el('p', { className: 'muted', textContent: 'недоступно' })]),
        ...(rooms.available && !rooms.rooms.length
          ? [el('p', { className: 'muted', textContent: 'Матчей нет' })]
          : []),
      )
    }

    /** Empty text collapses per the status-line convention; busy wins over an error, which wins over a stale rollback notice. */
    function renderProgress(view: ReturnType<typeof switchView>) {
      const line = $('#mode-progress')
      if (view.busy) say(line, [view.step, timing(view)].filter(Boolean).join(' · '), 'pending')
      else if (view.errorMessage) say(line, `Причина: ${view.errorMessage}.`, 'error')
      else if (view.notice) say(line, view.notice, 'error')
      else say(line, '')
    }
    function renderModes(workshop: { title: string; detail: string; tone: string }, rooms: any) {
      const box = $('#mode-options')
      const view = switchView(controller)
      renderProgress(view)
      const ready = gameReady(controller) && rooms.available && !rooms.maintenance
      const editor = el(
        'div',
        { className: 'option' },
        el(
          'div',
          { className: 'option-head' },
          workshop.title,
          el('span', {
            className: `badge ${workshop.tone}`,
            textContent: view.busy
              ? 'Применяется…'
              : controller?.phase === 'test'
                ? 'Закрытый тест'
                : workshop.tone === 'ok'
                  ? 'Доступна'
                  : 'Вход закрыт',
          }),
        ),
        el('p', { textContent: workshop.detail }),
      )
      const actionable =
        controller?.schema === 1 &&
        Number.isSafeInteger(controller.revision) &&
        controller.revision >= 0
      if (actionable && can('mode')) {
        if (view.busy && view.canCancel)
          editor.append(button('Отменить смену режима', cancelSwitch, 'small danger'))
        else if (controller.phase === 'ERROR' && can('recover'))
          editor.append(button('Восстановить мастерскую', recoverWorkshop, 'small primary'))
        else if (controller.phase === 'test')
          editor.append(button('Вернуться в мастерскую', resumeWorkshop, 'small'))
        else if (!view.busy && controller.phase !== 'ERROR')
          editor.append(button('Выбрать сеанс и карты', startWorkshop, 'small'))
      }
      box.replaceChildren(
        el(
          'div',
          { className: 'option', ...(ready ? { dataCurrent: '' } : {}) },
          el(
            'div',
            { className: 'option-head' },
            'Игра',
            el('span', {
              className: `badge ${ready ? 'ok' : 'warn'}`,
              textContent: ready ? 'Вход открыт' : 'Готовность не подтверждена',
            }),
          ),
          el('p', { textContent: 'Игроки продолжают матчи, пока команда работает в мастерской.' }),
        ),
        editor,
      )
    }
    async function cancelSwitch() {
      if (
        !(await ask({
          title: 'Отменить смену режима мастерской?',
          text: 'Мастерская вернётся в прежний режим. Отмена доступна на текущем этапе; после сохранения мира может потребоваться восстановление.',
          ok: 'Отменить смену режима',
          danger: true,
        }))
      )
        return
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('cancel', 'POST', {})
          follow(line, id, 'применено')
          return 'применяем…'
        },
        $('#mode-options'),
      )
    }
    async function recoverWorkshop() {
      if (
        !(await ask({
          title: 'Восстановить мастерскую?',
          text: 'Мастерская перезапустится в редакторе с прежним сеансом. Используйте это после ошибки запуска.',
          ok: 'Восстановить мастерскую',
          danger: true,
        }))
      )
        return
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('mode', 'POST', {
            profile: 'game',
            expectedRevision: controller.revision,
            recover: true,
          })
          follow(line, id, 'применено')
          return 'применяем…'
        },
        $('#mode-options'),
      )
    }
    /** A new session selects published map copies; resume keeps the existing edits and selection. */
    async function startWorkshop() {
      const known = mapScopes()
      const checks = el(
        'div',
        { className: 'checks' },
        ...known.map((id) =>
          el(
            'label',
            { className: 'check' },
            el('input', { type: 'checkbox', name: 'map', value: id, checked: true }),
            mapName(id),
          ),
        ),
      )
      const all = el('input', { type: 'checkbox', checked: true }) as HTMLInputElement
      all.addEventListener('change', () =>
        checks
          .querySelectorAll('input')
          .forEach((i) => ((i as HTMLInputElement).checked = all.checked)),
      )
      const mapsBlock = el('div', {}, el('label', { className: 'check' }, all, 'Все карты'), checks)
      const fields: Node[] = []
      if (session) {
        const label = session.maps
          ? session.maps.map((id: string) => MAP_NAMES[id] ?? id).join(', ')
          : 'все карты'
        const resume = el('input', {
          type: 'radio',
          name: 'session',
          value: 'resume',
          checked: true,
        }) as HTMLInputElement
        const fresh = el('input', {
          type: 'radio',
          name: 'session',
          value: 'new',
        }) as HTMLInputElement
        const toggle = () =>
          mapsBlock
            .querySelectorAll('input')
            .forEach((i) => ((i as HTMLInputElement).disabled = !fresh.checked))
        resume.addEventListener('change', toggle)
        fresh.addEventListener('change', toggle)
        toggle()
        fields.push(
          el(
            'fieldset',
            { className: 'plain' },
            el('legend', { textContent: 'Сеанс' }),
            el(
              'label',
              { className: 'radio' },
              resume,
              el('span', {}, `Продолжить прошлый сеанс (${date(session.startedAt)}, ${label})`),
            ),
            el('label', { className: 'radio' }, fresh, 'Новый сеанс'),
          ),
        )
      }
      fields.push(mapsBlock)
      const answer = await ask({
        title: 'Выбрать сеанс мастерской?',
        text: 'При смене сеанса мастерская сохранит мир и перезапустится. Новый сеанс готовит рабочие копии из опубликованных версий карт; продолжение сохраняет текущие правки и список карт.',
        ok: 'Открыть сеанс',
        danger: true,
        fields,
      })
      if (!answer) return
      const resuming = !!session && answer.get('session') !== 'new'
      const ids = answer.getAll('map').map(String)
      const body: Record<string, unknown> = {
        profile: 'workshop',
        expectedRevision: controller.revision,
        session: resuming ? 'resume' : 'new',
        ...(resuming ? {} : { maps: ids.length === known.length ? null : ids }),
      }
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('mode', 'POST', body)
          follow(line, id, 'применено')
          return 'применяем…'
        },
        $('#mode-options'),
      )
    }
    async function resumeWorkshop() {
      if (
        !(await ask({
          title: 'Вернуться в мастерскую?',
          text: 'Тестовый матч остановится, мастерская вернётся в редактор с тем же сеансом и рабочими копиями.',
          ok: 'Вернуться в мастерскую',
        }))
      )
        return
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('mode', 'POST', {
            profile: 'workshop',
            expectedRevision: controller.revision,
            session: 'resume',
          })
          follow(line, id, 'применено')
          return 'применяем…'
        },
        $('#mode-options'),
      )
    }

    function renderRooms(rooms: any) {
      const list = $('#room-list')
      if (!rooms.available) {
        list.replaceChildren(
          el('p', {
            className: 'empty',
            textContent: rooms.maintenance
              ? 'Вход на сервер закрыт — матчей сейчас нет.'
              : 'Игровой сервер не отвечает, список матчей недоступен.',
          }),
        )
        return
      }
      if (!rooms.rooms.length) {
        list.replaceChildren(
          el('p', { className: 'empty', textContent: 'Сейчас не идёт ни одного матча.' }),
        )
        return
      }
      list.replaceChildren(
        ...rooms.rooms.map((room: any) => {
          const facts: [string, string][] = [
            ['Карта', room.map || 'выбирается'],
            ['Режим', room.mode],
            ['Сейчас', PHASES[room.phase] ?? 'Идёт'],
            ['Игроков', String(room.players)],
          ]
          if (room.battle)
            facts.push(['Тикеты', `красные ${room.battle.red} · синие ${room.battle.blue}`])
          const card = el(
            'article',
            { className: 'card room', ariaLabel: room.name },
            el(
              'div',
              { className: 'card-head' },
              el('h3', { textContent: room.name }),
              el('span', {
                className: `badge ${room.joinable ? 'ok' : ''}`,
                textContent: room.joinable ? 'Можно зайти' : 'Набор закрыт',
              }),
            ),
            el(
              'dl',
              { className: 'facts' },
              ...facts.flatMap(([k, v]) => [
                el('dt', { textContent: k }),
                el('dd', { textContent: v }),
              ]),
            ),
          )
          if (can('moderate'))
            card.append(
              button(
                'Завершить матч',
                () => stopRoom(room),
                'danger',
                `Завершить матч «${room.name}»`,
              ),
            )
          return card
        }),
      )
    }
    async function stopRoom(room: any) {
      const radios = el(
        'fieldset',
        { className: 'plain' },
        el('legend', { textContent: 'Чем закончить матч' }),
        el(
          'div',
          { className: 'radios' },
          ...OUTCOMES.map(([value, label, about], i) =>
            el(
              'label',
              { className: 'radio' },
              el('input', {
                type: 'radio',
                name: 'outcome',
                value,
                required: true,
                checked: i === 0,
              }),
              el('span', {}, label, about ? el('small', { textContent: about }) : null),
            ),
          ),
        ),
      )
      const answer = await ask({
        title: `Завершить матч «${room.name}»?`,
        text: 'Все игроки вернутся в лобби. Итог попадёт в статистику.',
        ok: 'Завершить матч',
        danger: true,
        fields: [radios, reasonField('Причина (увидят игроки)')],
      })
      if (!answer) return
      const outcome = String(answer.get('outcome')),
        reason = String(answer.get('reason') ?? '')
      run($('#room-status'), async () => {
        await api('rcon', 'POST', {
          action: 'stop-room',
          roomId: room.id,
          outcome,
          reason: outcome === 'none' && /^(win|draw)\b/i.test(reason) ? `— ${reason}` : reason,
        })
        loadOverview()
        return `Матч «${room.name}» завершён.`
      })
    }

    // ---------- Players ----------
    const PLAYER_ACTIONS: Record<
      string,
      {
        ok: string
        title: (p: string) => string
        text: (p: string) => string
        done: (p: string) => string
        reason: boolean
      }
    > = {
      kick: {
        ok: 'Выгнать',
        title: (p) => `Выгнать ${p}?`,
        text: (p) => `${p} будет отключён от сервера, но сможет сразу зайти снова.`,
        done: (p) => `${p} выгнан с сервера.`,
        reason: true,
      },
      'team-kick': {
        ok: 'Убрать из матча',
        title: (p) => `Убрать ${p} из матча?`,
        text: (p) => `${p} покинет команду в текущем матче. С сервера его не выгонит.`,
        done: (p) => `${p} убран из матча.`,
        reason: false,
      },
      ban: {
        ok: 'Забанить',
        title: (p) => `Забанить ${p}?`,
        text: (p) => `${p} будет отключён и не сможет зайти на сервер, пока его не разбанят.`,
        done: (p) => `${p} забанен.`,
        reason: true,
      },
      pardon: {
        ok: 'Разбанить',
        title: (p) => `Разбанить ${p}?`,
        text: (p) => `${p} снова сможет заходить на сервер.`,
        done: (p) => `${p} разбанен.`,
        reason: false,
      },
    }
    async function playerAction(action: string, player: string, line: HTMLElement) {
      const spec = PLAYER_ACTIONS[action]
      const answer = await ask({
        title: spec.title(player),
        text: spec.text(player),
        ok: spec.ok,
        danger: action !== 'pardon',
        fields: spec.reason ? [reasonField()] : [],
      })
      if (!answer) return
      await run(line, async () => {
        await api('rcon', 'POST', { action, player, reason: String(answer.get('reason') ?? '') })
        if (action === 'ban' || action === 'pardon') loadBans()
        if (action !== 'pardon') setTimeout(loadOnline, 1000)
        return spec.done(player)
      })
    }
    async function loadOnline() {
      const summary = $('#online-summary')
      try {
        const { players } = await api('rcon', 'POST', { action: 'list' })
        summary.className = 'muted'
        summary.textContent = players.length
          ? `Игроков на сервере: ${players.length}.`
          : 'На сервере никого нет.'
        $('#online-list').replaceChildren(
          ...players.map((name: string) =>
            el(
              'li',
              { className: 'row' },
              el('div', { className: 'row-main' }, el('strong', { textContent: name })),
              el(
                'div',
                { className: 'actions' },
                button(
                  'Выгнать',
                  () => playerAction('kick', name, summary),
                  'small',
                  `Выгнать ${name}`,
                ),
                button(
                  'Убрать из матча',
                  () => playerAction('team-kick', name, summary),
                  'small',
                  `Убрать ${name} из матча`,
                ),
                can('ban')
                  ? button(
                      'Забанить',
                      () => playerAction('ban', name, summary),
                      'small danger',
                      `Забанить ${name}`,
                    )
                  : null,
              ),
            ),
          ),
        )
      } catch (error) {
        say(summary, (error as Error).message, 'error')
        $('#online-list').replaceChildren()
      }
    }
    async function loadBans() {
      const { bans } = await api('bans')
      $('#ban-list').replaceChildren(
        ...(bans.length
          ? bans.map((b: any) =>
              el(
                'li',
                { className: 'row' },
                el(
                  'div',
                  { className: 'row-main' },
                  el('strong', { textContent: b.player }),
                  el('small', {
                    textContent: `Забанил ${b.by} ${ago(b.at)}${b.reason ? ` · причина: «${b.reason}»` : ''}`,
                  }),
                ),
                button(
                  'Разбанить',
                  () => playerAction('pardon', b.player, $('#ban-status')),
                  'small',
                  `Разбанить ${b.player}`,
                ),
              ),
            )
          : [el('li', { className: 'empty', textContent: 'Никто не забанен.' })]),
      )
    }

    // ---------- Settings ----------
    const GUN_LABELS: Record<string, string> = {
      ammo: 'Боеприпас',
      ammo_amount: 'Вместимость магазина',
      extended_mag_ammo_amount: 'Расширенные магазины',
      can_crawl: 'Стрельба ползком',
