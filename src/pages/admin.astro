        say($('#workshop-ai-key-status'), 'Ключ применяется…', 'pending')
        await pollWorkshopAiKey(id)
      })
    }
    $('#workshop-ai-refresh').onclick = async () => {
      if (
        await ask({
          title: 'Обновить AI мастерской?',
