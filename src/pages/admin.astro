      kitClassCosts = structuredClone(settings.classCosts ?? {})
      kitSnapshot = kitBody()
      renderKits()
      say(
        $('#kits-status'),
        `${kitCatalog!.kits.length} наборов в каталоге. Выдача следует подтверждённым настройкам сервера.`,
      )
    }
    $('#kit-select').onchange = () => {
