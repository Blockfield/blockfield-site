    function checkWorkshopAiGuard() {
      const hint = $('#workshop-ai-guard-hint')
      const value = $<HTMLInputElement>('#workshop-ai-guard').value.trim()
      const valid = !value || isWorkshopAiGuardModel(value)
      hint.textContent = valid
        ? 'Только typesafe/jev-…: сторож ходит в Typesafe API.'
        : 'Сторожевая модель: только typesafe/jev-…'
      hint.classList.toggle('error', !valid)
      return valid
    }
    async function loadWorkshopAi() {
      const [{ settings }, key] = await Promise.all([
        api('workshop-ai-settings'),
        api('workshop-ai-key'),
      ])
      workshopAiRevision = settings.revision
      $<HTMLInputElement>('#workshop-ai-enabled').checked = settings.enabled
      $<HTMLInputElement>('#workshop-ai-generation').value = settings.generationModel
      $<HTMLInputElement>('#workshop-ai-guard').value = settings.guardModel
      $<HTMLSelectElement>('#workshop-ai-transcription').value = settings.transcriptionModel
      checkWorkshopAiGuard()
      say($('#workshop-ai-status'), `Настройки сохранены в ревизии ${settings.revision}.`)
      sayWorkshopAiKey(key.status, null, false)
    }
    async function pollWorkshopAiKey(id: string) {
      const line = $('#workshop-ai-key-status')
      for (let attempt = 0; attempt < 10; attempt++) {
        await new Promise((resolve) => setTimeout(resolve, 3000))
        try {
          const key = await api(`workshop-ai-key?id=${id}`)
          if (!key.result) {
            say(line, workshopAiKeyLine(key.status, { waiting: true }, date), 'pending')
            continue
          }
          if (key.result.ok) await loadWorkshopAi()
          else sayWorkshopAiKey(key.status, key.result, false)
          return
        } catch {
          // One failed poll must not hide the pending state; the next attempt retries.
        }
      }
      say(line, 'Ключ применяется… Обновите состояние AI позже.', 'pending')
    }
    $<HTMLInputElement>('#workshop-ai-guard').addEventListener('input', checkWorkshopAiGuard)
    $('#workshop-ai-form').onsubmit = (event) => {
      event.preventDefault()
      run($('#workshop-ai-status'), async () => {
        const body = {
          expectedRevision: workshopAiRevision,
          enabled: $<HTMLInputElement>('#workshop-ai-enabled').checked,
          generationModel: $<HTMLInputElement>('#workshop-ai-generation').value.trim(),
          guardModel: $<HTMLInputElement>('#workshop-ai-guard').value.trim(),
          transcriptionModel: $<HTMLSelectElement>('#workshop-ai-transcription').value,
        }
        try {
          const { settings } = await api('workshop-ai-settings', 'PUT', body)
          workshopAiRevision = settings.revision
          return `Настройки сохранены, ревизия ${settings.revision}.`
        } catch (error) {
          if ((error as Error & { status?: number }).status === 409) {
            await loadWorkshopAi()
            throw new Error('Настройки уже изменил кто-то другой. Показаны сохранённые значения.', {
              cause: error,
            })
          }
          throw error
        }
      })
    }
    $('#workshop-ai-key-save').onclick = () => {
