          <input id="event-search" type="search" autocomplete="off" spellcheck="false" />
        </div>
      </div>
      <div class="actions">
        <button type="button" id="event-copy" class="small">
          Скопировать показанное
        </button>
        <button type="button" id="event-export" class="small">
          Скачать JSON
        </button>
      </div>
      <p class="form-status" id="event-status" role="status"></p>
      <ul id="event-list" class="log" aria-labelledby="events-title"></ul>
    </section>

    <section
      id="console"
      data-perm="rcon-raw"
      data-tab="Консоль"
      hidden
      aria-labelledby="console-title"
    >
      <h2 id="console-title" tabindex="-1">
        Консоль
      </h2>
      <p class="muted">
        Команды основного сервера и мастерской, как в их консоли. Каждая команда попадает в журнал.
