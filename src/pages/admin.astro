      }
      if (map.versions.length > 1) {
        const compare = el('form', { className: 'form-grid' }),
          output = el('div', {})
        const choose = (name: string) =>
          el(
            'select',
            { name },
            ...map.versions.map((version) =>
              el('option', {
                value: version.versionDigest,
                textContent: `${date(version.createdAt)} · ${version.versionDigest.slice(0, 8)}`,
              }),
            ),
          )
        const before = choose('before'),
          after = choose('after')
        ;(before as HTMLSelectElement).selectedIndex = 1
        compare.append(
          field('Сравнить: до', before),
          field('После', after),
          el(
            'div',
            { className: 'actions' },
            el('button', { type: 'submit', className: 'small', textContent: 'Сравнить коммиты' }),
          ),
        )
        compare.onsubmit = (event) => {
          event.preventDefault()
          const data = new FormData(compare)
          run(
            line,
            () =>
              compareMap(
                map.mapId,
                String(data.get('before')),
                String(data.get('after')),
                output,
                line,
              ),
            compare,
          )
        }
        content.append(compare, output)
      }
      return content
    }
