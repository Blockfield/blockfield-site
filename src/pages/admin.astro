                spellcheck="false"
                maxlength="128"
                placeholder="openai/whisper-1"
              />
              <label for="workshop-ai-transcription-provider">Провайдер расшифровки</label>
              <select id="workshop-ai-transcription-provider"></select>
              <label for="workshop-ai-cleanup">Модель чистки расшифровки</label>
              <input
                id="workshop-ai-cleanup"
                autocomplete="off"
                spellcheck="false"
                maxlength="128"
