      const entries = [
        ...data.files.map((file: any) => ({ file })),
        ...data.config.map((config: any) => ({ config })),
      ]
      let shown = 0
      function append() {
        for (const entry of entries.slice(shown, shown + 100)) {
          if (entry.file) {
            const file = entry.file,
              area = file.area
            rows.append(
              el(
                'li',
                { className: 'row' },
