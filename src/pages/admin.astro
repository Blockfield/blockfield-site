---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/system.css';
import SiteHeader from '../components/SiteHeader.astro';
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Панель управления — Blockfield</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#070604" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#content">Перейти к содержимому</a>
    <SiteHeader />
    <main id="content">
      <div class="top">
        <p class="rule"><span class="rule__square"></span><span class="rule__label">Панель</span><span class="rule__line"></span><span class="rule__code">CONSOLE</span></p>
        <h1>Сервер Blockfield</h1>
        <p id="whoami" role="status">Проверяем доступ…</p>
      </div>
      <nav id="tabs" class="tabs" aria-label="Разделы панели" hidden></nav>

      <section id="overview" data-perm="view" data-tab="Обзор" hidden aria-labelledby="overview-title">
        <h2 id="overview-title" tabindex="-1">Обзор</h2>
        <div id="server-card" class="hero" data-tone="wait">
          <span class="dot" aria-hidden="true"></span>
          <div><p class="headline" id="server-headline">Загружаем состояние сервера…</p><p id="server-detail" class="muted"></p></div>
        </div>
        <div class="cards">
          <article class="card" data-perm="mode" aria-labelledby="mode-title">
            <h3 id="mode-title">Режим сервера</h3>
            <p class="muted">Кто сейчас может зайти на сервер. Переключение перезапускает игру.</p>
            <p class="form-status" id="mode-progress" role="status"></p>
            <div id="mode-options" class="options"></div>
            <p class="form-status" id="mode-status" role="status"></p>
          </article>
          <article class="card" data-perm="message" aria-labelledby="message-title">
            <h3 id="message-title">Сообщение для игроков</h3>
            <p class="muted">Что игроки увидят при попытке зайти, пока сервер закрыт.</p>
            <form id="message-form">
              <label for="message">Текст сообщения</label>
              <textarea id="message" name="message" maxlength="200" rows="3" required aria-describedby="message-hint"></textarea>
              <small id="message-hint">Например: «Обновляем карты, вернёмся к 20:00». До 200 символов.</small>
              <button class="primary" type="submit">Сохранить сообщение</button>
              <p class="form-status" role="status"></p>
            </form>
          </article>
          <article class="card" data-perm="moderate" aria-labelledby="quick-title">
            <h3 id="quick-title">Быстрые действия</h3>
            <div class="quick-group">
              <h4 id="range-title">Полигон</h4>
              <p class="muted">Площадка в лобби, где пристреливают оружие.</p>
              <div class="actions">
                <button type="button" data-range="open">Открыть</button>
                <button type="button" data-range="close">Закрыть</button>
                <button type="button" data-range="reset">Сбросить</button>
              </div>
              <p class="form-status" id="range-status" role="status"></p>
            </div>
            <div class="quick-group quick-group--warn" data-perm="maintenance">
              <h4 id="maint-title">Техработы и аварии</h4>
              <p class="muted">Если сервер нужно освободить прямо сейчас. Обычно хватает мастерской: она дождётся конца матчей сама.</p>
              <div class="actions">
                <button type="button" id="drain">Не начинать новые матчи</button>
                <button type="button" id="interrupt" class="danger">Прервать все матчи</button>
              </div>
              <p class="form-status" id="maint-status" role="status"></p>
            </div>
          </article>
        </div>
      </section>

      <section id="players" data-perm="moderate" data-tab="Игроки" hidden aria-labelledby="players-title">
        <h2 id="players-title" tabindex="-1">Игроки</h2>
        <article class="card" aria-labelledby="online-title">
          <div class="card-head"><h3 id="online-title">Сейчас на сервере</h3><button type="button" id="online-refresh" class="small">Обновить</button></div>
          <p id="online-summary" class="muted" role="status">Загружаем список…</p>
          <ul id="online-list" class="rows"></ul>
        </article>
        <div class="cards">
          <article class="card" aria-labelledby="say-title">
            <h3 id="say-title">Объявление всем</h3>
            <p class="muted">Сообщение сразу появится в чате у всех, кто сейчас на сервере.</p>
            <form id="say-form">
              <label for="say-text">Текст объявления</label>
              <input id="say-text" name="text" maxlength="120" required autocomplete="off" />
              <button class="primary" type="submit">Отправить всем</button>
              <p class="form-status" role="status"></p>
            </form>
          </article>
          <article class="card" aria-labelledby="byname-title">
            <h3 id="byname-title">Найти по никнейму</h3>
            <p class="muted" id="byname-about">Для тех, кого сейчас нет на сервере. Начните вводить никнейм — подскажем знакомые.</p>
            <form id="byname-form">
              <label for="byname">Никнейм игрока</label>
              <input id="byname" name="player" required pattern="[A-Za-z0-9_]{3,16}" autocomplete="off" aria-describedby="byname-hint" />
              <small id="byname-hint">Точно как в игре: латинские буквы, цифры и _.</small>
              <div class="actions">
                <button type="submit" value="kick">Выгнать</button>
                <button type="submit" value="ban" data-perm="ban" class="danger">Забанить</button>
                <button type="submit" value="pardon" data-perm="ban">Разбанить</button>
              </div>
              <p class="form-status" role="status"></p>
            </form>
          </article>
        </div>
        <article class="card" data-perm="ban" aria-labelledby="bans-title">
          <h3 id="bans-title">Забаненные игроки</h3>
          <p class="muted">Кого забанили отсюда. Если бан выдали прямо в игре, снимайте его в «Найти по никнейму».</p>
          <ul id="ban-list" class="rows"></ul>
          <p class="form-status" id="ban-status" role="status"></p>
        </article>
      </section>

      <section id="matches" data-perm="view" data-tab="Матчи" hidden aria-labelledby="matches-title">
        <h2 id="matches-title" tabindex="-1">Матчи</h2>
        <p class="muted">Что сейчас идёт на сервере. Список обновляется сам.</p>
        <p class="form-status" id="room-status" role="status"></p>
        <div id="room-list" class="cards"></div>
      </section>

      <section id="settings" data-perm="settings" data-tab="Настройки игры" hidden aria-labelledby="settings-title">
        <h2 id="settings-title" tabindex="-1">Настройки игры</h2>
        <p id="settings-state" class="banner" role="status">Загружаем настройки…</p>
        <form id="settings-form">
          <fieldset class="card">
            <legend>Лобби</legend>
            <div class="fields">
              <div class="field">
                <label for="pvp">PvP в лобби</label>
                <select id="pvp" name="pvpEnabled"><option value="true">Включено</option><option value="false">Выключено</option></select>
              </div>
            </div>
            <div id="lobby-fields" class="fields"></div>
          </fieldset>
          <fieldset class="card">
            <legend>Комнаты</legend>
            <div id="room-fields" class="fields"></div>
          </fieldset>
          <fieldset class="card">
            <legend>Каждый сам за себя</legend>
            <div id="deathmatch-fields" class="fields"></div>
          </fieldset>
          <fieldset class="card">
            <legend>Стоимость высадки</legend>
            <small class="muted">Боевые кредиты (БК) зарабатываются в бою и сбрасываются в конце матча. Цена списывается за каждую высадку. Изменения действуют со следующей высадки, включая текущие матчи. 0 — бесплатно.</small>
            <div id="class-costs" class="fields"></div>
            <small class="muted">Штурмовик и марксман всегда бесплатны. Численность команды не закрывает сильные классы.</small>
          </fieldset>
          <fieldset class="card">
            <legend>Аварийное отключение классов</legend>
            <small class="muted">Кто уже играет этим классом, доиграет ещё три минуты.</small>
            <div id="class-list" class="checks"></div>
          </fieldset>
          <fieldset class="card">
            <legend>Баланс матчей</legend>
            <small class="muted">Новые значения подхватит следующий матч.</small>
            <div class="scope">
              <label for="scope">Для каких матчей</label>
              <select id="scope"></select>
              <small id="scope-hint"></small>
            </div>
            <div id="balance-fields"></div>
          </fieldset>
          <div class="savebar">
            <button class="primary" type="submit">Сохранить и применить</button>
            <p class="form-status" role="status"></p>
          </div>
        </form>
      </section>

      <section id="team" data-perm="roles" data-tab="Команда" hidden aria-labelledby="team-title">
        <h2 id="team-title" tabindex="-1">Команда</h2>
        <p class="muted">Кто помогает вести сервер. Каждая роль умеет всё, что предыдущая, и чуть больше.</p>
        <dl id="role-legend" class="legend"></dl>
        <ul id="staff-list" class="rows"></ul>
        <p class="form-status" id="staff-status" role="status"></p>
        <div class="cards">
          <article class="card" aria-labelledby="grant-title">
            <h3 id="grant-title">Добавить в команду</h3>
            <form id="grant-form">
              <label for="grant-name">Никнейм игрока</label>
              <input id="grant-name" name="nickname" required pattern="[A-Za-z0-9_]{3,16}" autocomplete="off" aria-describedby="grant-hint" />
              <small id="grant-hint">Начните вводить — подскажем тех, кто уже играл. Нужен аккаунт Blockfield.</small>
              <fieldset class="plain"><legend>Роль</legend><div id="grant-roles" class="radios"></div></fieldset>
              <button class="primary" type="submit">Добавить в команду</button>
              <p class="form-status" role="status"></p>
            </form>
          </article>
        </div>
      </section>

      <section id="workshop" data-perm="workshop" data-tab="Мастерская" hidden aria-labelledby="workshop-title">
        <h2 id="workshop-title" tabindex="-1">Мастерская</h2>
        <p class="muted">Кто какие карты правит. Модераторы и администраторы правят все карты, строителям доступ выдаётся по картам. В игре строители переходят между картами планшетом (M).</p>
        <article class="card" aria-labelledby="candidates-title">
          <h3 id="candidates-title">Карты на проверке</h3>
          <p class="muted">Строитель отправляет карту из планшета («Разметка» → «На проверку») или администратор кнопкой у карты ниже. Принятие сохраняет проверенный пакет. Карта попадёт в игру после выпуска новой версии; до этого игра работает на прежних картах.</p>
          <p class="form-status" id="candidates-status" role="status"></p>
          <ul id="candidate-list" class="rows"></ul>
        </article>
        <p class="form-status" id="map-access-status" role="status"></p>
        <ul id="map-access" class="rows"></ul>
        <div class="cards">
          <article class="card" data-perm="workshop" aria-labelledby="ws-title">
            <h3 id="ws-title">Доступ в мастерскую</h3>
            <p id="workshop-state" class="muted">Проверяем список…</p>
            <button type="button" id="sync">Обновить доступ</button>
            <p class="form-status" id="sync-status" role="status"></p>
          </article>
        </div>
      </section>

      <section id="stats" data-perm="stats" data-tab="Статистика" hidden aria-labelledby="stats-title">
        <h2 id="stats-title" tabindex="-1">Статистика</h2>
        <p class="muted">Матчи, которые попали в лидерборд. Время UTC. Нечестный или сломанный матч можно убрать из статистики — и вернуть обратно, если передумаете.</p>
        <div class="scope">
          <label for="result-mode">Показать</label>
          <select id="result-mode"><option value="">Все матчи</option><option value="campaign">Ranked-кампании</option><option value="room">Обычные бои</option><option value="deathmatch">Каждый сам за себя</option></select>
        </div>
        <p class="form-status" id="result-status" role="status"></p>
        <ul id="result-list" class="rows"></ul>
        <div class="actions pager"><button type="button" id="prev" class="small">← Новее</button><span id="page" class="muted"></span><button type="button" id="next" class="small">Старее →</button></div>
        <h3>Сезоны</h3>
        <ul id="season-list" class="plain-list"></ul>
        <details class="dev">
          <summary>Ключи для игровых серверов</summary>
          <p class="muted">Игровой сервер отправляет результаты матчей с секретным ключом. Заведите ключ, когда подключаете новый сервер, и отзовите, если он мог утечь. Ключ показывается один раз.</p>
          <form id="key-form">
            <label for="key-server">ID игрового сервера</label>
            <input id="key-server" name="serverId" required autocomplete="off" aria-describedby="key-server-hint" />
            <small id="key-server-hint">Лежит в настройках статистики на самом сервере.</small>
            <label for="key-label">Как его называть</label>
            <input id="key-label" name="label" required maxlength="64" placeholder="Например: основной сервер" />
            <button type="submit">Создать ключ</button>
            <p class="form-status" role="status"></p>
          </form>
          <ul id="key-list" class="rows"></ul>
        </details>
      </section>

      <section id="journal" data-perm="audit" data-tab="Журнал действий" hidden aria-labelledby="journal-title">
        <h2 id="journal-title" tabindex="-1">Журнал действий</h2>
        <p class="muted">Что команда делала здесь в последнее время.</p>
        <ul id="audit-list" class="log"></ul>
      </section>
    </main>

    <dialog id="dialog" aria-labelledby="dialog-title" aria-describedby="dialog-text">
      <form method="dialog">
        <h2 id="dialog-title"></h2>
        <p id="dialog-text"></p>
        <div id="dialog-fields"></div>
        <div class="actions end">
          <button type="submit" value="cancel" formnovalidate>Отмена</button>
          <button type="submit" value="ok" id="dialog-ok" class="primary"></button>
        </div>
      </form>
    </dialog>

    <style is:global>
      body { background: radial-gradient(60% 40% at 50% -10%, #1c150a 0%, transparent 100%), var(--bg); }
      /* Console container: wider than the 1200px reading-page default so staff cards pack instead of running down a mid-screen column on a wide monitor. */
      main { max-width: 1320px; margin: 0 auto; padding: clamp(28px, 4vw, 40px) clamp(14px, 5vw, 48px) 96px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
      .top { display: grid; gap: 10px; }
      h2 { margin: 0 0 4px; }
      h3 { margin: 0; }
      #whoami { color: var(--sand); }
      #whoami strong { color: var(--cream); }
      section { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; min-width: 0; scroll-margin-top: 80px; }

      .tabs { position: sticky; top: 0; z-index: 2; background: rgb(7 6 4 / 0.95); border-bottom: 1px solid var(--line); padding: 8px 0; }

      /* Карточка состояния сервера: тон несёт точка и слово, а не толстая полоса сбоку. */
      .hero { display: flex; gap: 14px; align-items: flex-start; background: var(--panel); border: 1px solid var(--line); padding: 18px 20px; }
      .hero .headline { font-size: clamp(19px, 3vw, 23px); font-weight: 700; }
      .dot { flex: none; width: 12px; height: 12px; border-radius: 50%; margin-top: 7px; background: var(--muted); }
      [data-tone='ok'] { border-color: rgb(130 214 107 / 0.45); } [data-tone='ok'] .dot { background: var(--ok); box-shadow: 0 0 0 4px rgb(130 214 107 / 0.15); }
      [data-tone='warn'] { border-color: rgb(245 165 36 / 0.45); } [data-tone='warn'] .dot { background: var(--amber); }
      [data-tone='bad'] { border-color: rgb(255 157 153 / 0.45); } [data-tone='bad'] .dot { background: var(--danger); }

      .card.warn { border-color: var(--line-warn); }
      .card-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
      /* «Быстрые действия»: several small action groups share one card instead of each stretching a whole grid row for three buttons. */
      .quick-group + .quick-group { padding-top: 12px; border-top: 1px solid var(--line); }
      .quick-group--warn { border-top-color: var(--line-warn); }
      .quick-group h4 { margin: 0; font-size: 15px; font-weight: 700; }
      fieldset.card { padding-top: 8px; }
      legend { font-size: 17px; font-weight: 700; text-transform: uppercase; letter-spacing: -0.01em; padding: 0 6px; margin-left: -6px; }
      fieldset.plain { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
      fieldset.plain legend { font-size: 15px; font-weight: 600; text-transform: none; letter-spacing: normal; margin-bottom: 8px; }

      form { display: grid; gap: 10px; }
      textarea { min-height: 88px; }
      form > button, .card > button { justify-self: start; }
      .row .actions select { width: auto; min-width: 170px; }

      .options { display: grid; gap: 10px; }
      .option { border: 1px solid var(--line); padding: 14px; display: grid; gap: 8px; }
      .option[data-current] { border-color: var(--ok); background: rgb(130 214 107 / 0.05); }
      .option p { color: var(--sand); font-size: 15px; }
      .option-head { display: flex; justify-content: space-between; gap: 8px; align-items: center; flex-wrap: wrap; font-weight: 700; }

      .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
      .row { background: var(--panel); border: 1px solid var(--line); padding: 12px 14px; display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; justify-content: space-between; }
      .card .row { background: var(--bg-2); }
      .row-main { display: grid; gap: 4px; min-width: 0; flex: 1 1 240px; }
      .row-main strong { overflow-wrap: anywhere; }
      .row.voided { opacity: 0.75; border-style: dashed; }
      /* Eighteen short map rows pack into columns instead of one long full-width list. */
      #map-access { grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); }
      .empty { color: var(--muted); padding: 8px 0; }
      .team-RED { color: var(--danger); } .team-BLUE { color: var(--info); }

      .room { gap: 14px; }
      .facts { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; }
      .facts dt { color: var(--sand); } .facts dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }

      .banner { background: var(--panel); border: 1px solid var(--line); padding: 14px 16px; }
      .banner.ok { border-color: rgb(130 214 107 / 0.45); color: var(--cream); }
      .banner.pending { border-color: rgb(245 165 36 / 0.45); color: var(--cream); }
      .banner.error { border-color: rgb(255 157 153 / 0.45); color: var(--cream); }

      #settings-form { gap: 16px; }
      /* Поля пакуются в несколько колонок на широком экране, а не тянутся в одну узкую полосу. */
      .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); align-items: start; gap: 10px 24px; }
      .field { display: grid; grid-template-columns: minmax(140px, 260px) minmax(0, 340px); align-items: center; gap: 4px 16px; }
      .field small { grid-column: 2; }
      .group { display: grid; gap: 12px; padding-top: 16px; border-top: 1px solid var(--line); }
      .group h4 { margin: 0; font-size: 15px; color: var(--amber); font-weight: 650; }
      .switch, .check, .radio { display: flex; gap: 10px; align-items: flex-start; font-weight: 600; cursor: pointer; }
      .switch input, .check input, .radio input { margin-top: 2px; }
      .checks { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 10px; }
      .check, .radio { border: 1px solid var(--line); padding: 12px; }
      .radios { display: grid; gap: 8px; }
      .radio:has(input:checked) { border-color: var(--amber); }
      .radio span { display: grid; gap: 2px; } .radio small { font-weight: 400; }
      .scope { display: grid; gap: 6px; max-width: 420px; }
      /* Липкая полоса, чтобы «сохранить» не уезжало вверх на длинной форме. */
      .savebar { position: sticky; bottom: 0; z-index: 3; background: rgb(7 6 4 / 0.95); backdrop-filter: blur(4px); border-top: 1px solid var(--line); padding: 16px 0; display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }

      .legend { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 10px; margin: 0; }
      .legend div { background: var(--panel); border: 1px solid var(--line); padding: 12px 14px; }
      .legend dt { font-weight: 700; } .legend dd { margin: 4px 0 0; color: var(--sand); font-size: 15px; line-height: 1.45; }

      .pager { justify-content: space-between; }
      .plain-list { margin: 0; padding-left: 20px; color: var(--sand); line-height: 1.7; }
      .plain-list li::marker { color: var(--amber-dim); }
      details.dev { border: 1px solid var(--line); padding: 12px 16px; display: grid; gap: 12px; }
      details.dev summary { cursor: pointer; font-weight: 600; color: var(--sand); }
      details.dev summary::marker { color: var(--amber); }
      details.dev > * + * { margin-top: 12px; }
      .secret { font-family: var(--mono); background: var(--panel-2); padding: 8px 10px; overflow-wrap: anywhere; color: var(--cream); }

      .log { list-style: none; margin: 0; padding: 0; display: grid; }
      .log li { display: grid; grid-template-columns: 1fr auto; gap: 4px 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
      .log time { color: var(--muted); font-family: var(--mono); font-size: 13px; white-space: nowrap; }
      .log li.failed .fail { color: var(--danger); font-weight: 600; }

      dialog h2 { font-size: 22px; }
      #dialog-fields { display: grid; gap: 10px; }
      #dialog-fields:empty { display: none; }

      @media (max-width: 600px) {
        main { padding-top: 24px; gap: 20px; }
        /* Скроллится горизонтально, а не переносится в два ряда — как задано в системе (.tabs). */
        .tabs { position: static; }
        .tabs a { padding: 8px 12px; }
        .log li { grid-template-columns: 1fr; }
        .row > .actions { width: 100%; }
        .savebar button { width: 100%; }
        .field { grid-template-columns: 1fr; gap: 6px; }
        .field small { grid-column: 1; }
      }
    </style>

    <script>
      import { BALANCE_DEFAULTS, BALANCE_GROUPS, BALANCE_LABELS, BALANCE_SCOPES, CLASS_COSTS, CLASS_NAMES, MAP_NAMES, MODE_NAMES, WORKSHOP_PLACES, TEAM_NAMES } from '../lib/game-names';
      import { settingsBody } from '../lib/settings-form';
      import { customSelect, customCombo } from '../lib/custom-select';
      import { switchView } from '../lib/switch-status';

      type Me = { name: string; role: string | null; permissions: string[] };
      const $ = <T extends HTMLElement = HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
      const ROLES: Record<string, { name: string; about: string }> = {
        builder: { name: 'Строитель', about: 'Делает карты в мастерской. В панели только смотрит, что происходит на сервере.' },
        moderator: { name: 'Модератор', about: 'Следит за порядком в игре: может выгнать, объявить что-то всем и завершить зависший матч.' },
        admin: { name: 'Администратор', about: 'Отвечает за сервер целиком: баны, настройки игры, честность статистики и состав команды.' },
        owner: { name: 'Владелец', about: 'Полный доступ, включая назначение администраторов. Владельцы задаются в настройках сервера.' },
      };
      const PHASES: Record<string, string> = { IDLE: 'Ждёт игроков', VOTING: 'Голосование за карту', PREPARING: 'Подготовка к бою', GAME: 'Идёт бой', MATCH_END: 'Подведение итогов' };
      const OUTCOMES: [string, string, string][] = [
        ['draw', 'Ничья', 'Никто не побеждает.'], ['RED', 'Победа красных', ''], ['BLUE', 'Победа синих', ''],
        ['none', 'Без итога', 'Матч просто останавливается, победитель не записывается.'],
      ];
      let me: Me;
      const can = (permission: string) => me.permissions.includes(permission);

      // The whole site shows times in UTC (leaderboard and player pages too), always labelled.
      const dateFormat = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
      const relative = new Intl.RelativeTimeFormat('ru', { numeric: 'auto' });
      const date = (ms: number) => `${dateFormat.format(ms)} UTC`;
      function ago(ms: number) {
        const seconds = (ms - Date.now()) / 1000;
        for (const [unit, size] of [['year', 31536000], ['month', 2592000], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60]] as const)
          if (Math.abs(seconds) >= size) return relative.format(Math.round(seconds / size), unit);
        return 'только что';
      }
      const number = (n: number) => n.toLocaleString('ru-RU');

      /** Server errors are mostly Russian already; technical or English ones are replaced with plain words. */
      function friendly(message: string | undefined, status: number) {
        const rules: [RegExp, string][] = [
          [/^Сервер не принял команду/, 'Игровой сервер не выполнил действие. Возможно, игрок уже вышел или матч уже закончился.'],
          [/^(Недостаточно прав|Нет доступа)/, 'У вашей роли нет прав на это действие.'],
          [/^RCON не настроен/, 'Управление игровым сервером с сайта не настроено. Сообщите владельцу.'],
          [/already voided/, 'Этот матч уже не учитывается. Обновите страницу.'], [/is not voided/, 'Этот матч уже учитывается. Обновите страницу.'],
          [/Result not found/, 'Матч не найден. Обновите страницу.'], [/^Нет ревизии/, 'Состояние сервера изменилось. Обновите страницу и попробуйте снова.'],
          [/Участник не найден/, 'Этого участника уже нет в команде. Обновите страницу.'],
        ];
        if (!message) return status >= 500 ? 'Сайт сейчас не отвечает. Попробуйте через минуту.' : 'Не получилось. Обновите страницу и попробуйте ещё раз.';
        const rule = rules.find(([pattern]) => pattern.test(message));
        if (rule) return rule[1];
        return /[а-яё]/i.test(message) ? message : 'Что-то пошло не так. Обновите страницу и попробуйте ещё раз.';
      }
      async function api(path: string, method = 'GET', body?: unknown) {
        // Content-Type is sent even without a body: Astro's origin check rejects bodiless non-GET requests behind the proxy.
        const response = await fetch(`/api/admin/${path}`, { method, cache: 'no-store', headers: { 'Content-Type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) }).catch(() => null);
        if (!response) throw new Error('Нет связи с сайтом. Проверьте интернет и попробуйте ещё раз.');
        const data = await response.json().catch(() => null);
        if (method !== 'GET' && can('audit')) loadAudit().catch(() => {});
        if (!response.ok) throw Object.assign(new Error(friendly(data?.error, response.status)), { raw: data?.error ?? '' });
        return data;
      }
      function el<K extends keyof HTMLElementTagNameMap>(tag: K, props: Record<string, any> = {}, ...children: (Node | string | null | undefined | false)[]) {
        const node = document.createElement(tag);
        for (const [key, value] of Object.entries(props)) {
          if (key.startsWith('aria') || key.startsWith('data') || key === 'role' || key === 'for') node.setAttribute(key.replace(/^aria([A-Z])/, (_, c) => `aria-${c.toLowerCase()}`).replace(/^data([A-Z])/, (_, c) => `data-${c.toLowerCase()}`), String(value));
          else (node as any)[key] = value;
        }
        node.append(...children.filter((c): c is Node | string => c !== null && c !== undefined && c !== false));
        return node;
      }
      const button = (text: string, onclick: () => void, className = 'small', label?: string) => el('button', { type: 'button', className, textContent: text, onclick, ...(label ? { ariaLabel: label } : {}) });
      function say(line: HTMLElement, text: string, tone: 'ok' | 'error' | 'pending' = 'ok') { line.textContent = text; line.classList.remove('ok', 'error', 'pending'); line.classList.add(tone); }
      /** Runs an action with its buttons disabled and reports progress, success or a friendly error on `line`. */
      async function run(line: HTMLElement, action: () => Promise<string | void>, scope: HTMLElement | null = null) {
        const buttons = scope ? [...scope.querySelectorAll('button')].filter(b => !b.disabled) : [];
        buttons.forEach(b => (b.disabled = true));
        say(line, 'Выполняем…', 'pending');
        try { const text = await action(); if (text) say(line, text); else line.textContent = ''; }
        catch (error) { say(line, (error as Error).message, 'error'); }
        finally { buttons.forEach(b => (b.disabled = false)); }
      }

      // Accessible confirmation: native <dialog> traps focus, Escape cancels, focus returns to the opener.
      const dialog = $<HTMLDialogElement>('#dialog');
      function ask({ title, text, ok, danger = false, fields = [] }: { title: string; text: string; ok: string; danger?: boolean; fields?: Node[] }): Promise<FormData | null> {
        const opener = document.activeElement as HTMLElement | null;
        $('#dialog-title').textContent = title; $('#dialog-text').textContent = text;
        $('#dialog-fields').replaceChildren(...fields);
        Object.assign($('#dialog-ok'), { textContent: ok, className: danger ? 'primary danger' : 'primary' });
        dialog.returnValue = '';
        dialog.showModal();
        return new Promise(resolve => dialog.addEventListener('close', () => {
          const form = dialog.querySelector('form')!;
          resolve(dialog.returnValue === 'ok' ? new FormData(form) : null);
          opener?.focus();
        }, { once: true }));
      }
      let fieldId = 0;
      function field(label: string, input: HTMLElement, hint?: string, wrap?: HTMLElement) {
        const id = `f${++fieldId}`; input.id = id;
        if (hint) input.setAttribute('aria-describedby', `${id}-hint`);
        return el('div', { className: 'field' }, el('label', { for: id, textContent: label }), wrap ?? input, hint ? el('small', { id: `${id}-hint`, textContent: hint }) : null);
      }
      const reasonField = (label = 'Причина (игрок её увидит)', required = false) => field(label, el('input', { name: 'reason', maxLength: 120, required, autocomplete: 'off' }), required ? undefined : 'Необязательно.');

      /**
       * Controller requests are applied by the host within ~15 s; poll its result file for up to a minute.
       * `onError`, when given, sees the raw error text first and may handle it itself (return true) instead of the generic message.
       */
      async function follow(line: HTMLElement, id: string, done: string, onError?: (error: string) => Promise<boolean> | boolean) {
        say(line, 'Запрос отправлен. Сервер применит его в течение 15 секунд…', 'pending');
        for (let i = 0; i < 30; i++) {
          await new Promise(r => setTimeout(r, 2000));
          const { result } = await api(`request?id=${id}`).catch(() => ({ result: null }));
          if (result) {
            if (result.ok) say(line, done);
            else if (!(await onError?.(String(result.error))))
              say(line, /revision/i.test(String(result.error)) ? 'Состояние сервера успело измениться. Обновите страницу и попробуйте снова.' : 'Сервер не смог выполнить запрос. Попробуйте ещё раз или сообщите владельцу.', 'error');
            loadOverview(); return;
          }
        }
        say(line, 'Сервер не ответил за минуту. Возможно, управляющая программа выключена — проверьте состояние позже.', 'error');
      }

      // ---------- Overview and matches ----------
      let controller: any = null;
      let session: any = null;
      /** since/deadline are ms timestamps; ago() naturally reads a future one as "через …" and a past one as "… назад". */
      function timing(view: ReturnType<typeof switchView>): string {
        return [typeof view.since === 'number' ? `началось ${ago(view.since)}` : null,
          typeof view.deadline === 'number' ? `автоматический откат ${ago(view.deadline)}` : null].filter(Boolean).join(' · ');
      }
      /** «Мастерская»/«Тестовый матч» status: who started the session, when, and which maps it covers. */
      function sessionLine(current: any): string | null {
        if (!current) return null;
        const maps = current.maps ? current.maps.map((id: string) => MAP_NAMES[id] ?? id).join(', ') : 'все карты';
        return `Сеанс: ${maps} · начал ${current.startedBy?.name ?? '?'} ${ago(current.startedAt)}.`;
      }
      function describe(state: any, rooms: any, current: any, testCandidate: any): { tone: string; title: string; detail: string } {
        const matches = rooms.rooms?.length ?? 0;
        const counts = [typeof rooms.online === 'number' ? `Игроков онлайн: ${rooms.online}` : null, rooms.available ? `Идёт матчей: ${matches}` : null].filter(Boolean).join(' · ');
        const target = state?.desired?.profile === 'workshop' ? 'мастерскую' : state?.desired?.profile === 'test' ? 'тестовый режим' : 'игровой режим';
        const view = switchView(state), when = timing(view);
        switch (state?.phase) {
          case 'workshop': return { tone: 'warn', title: 'Открыта мастерская', detail: [sessionLine(current), 'Заходить могут только участники команды. Обычные игроки видят сообщение о техработах.'].filter(Boolean).join(' ') };
          case 'test': {
            const name = testCandidate ? (WORKSHOP_PLACES[testCandidate.mapId] ?? testCandidate.mapId) : 'карта';
            const who = testCandidate?.author?.name ? ` (кандидат от ${testCandidate.author.name}, ${ago(testCandidate.createdAt)})` : '';
            return { tone: 'warn', title: `Тестовый матч: ${name}${who}`, detail: [sessionLine(current), 'Заходить могут только тестеры.'].filter(Boolean).join(' ') };
          }
          case 'DRAINING': return { tone: 'warn', title: 'Готовимся к мастерской', detail: [`${view.step}: новые матчи не начинаются, сервер ждёт, пока закончатся идущие.`, counts, when].filter(Boolean).join(' · ') };
          case 'REQUESTED': case 'SAVING': case 'STARTING': return { tone: 'warn', title: `Сервер переключается в ${target}`, detail: [`${view.step}.`, when].filter(Boolean).join(' · ') || 'Игроки пока не могут зайти.' };
          case 'ERROR': return { tone: 'bad', title: 'Сервер остановлен из-за ошибки', detail: [view.errorMessage ? `Причина: ${view.errorMessage}.` : null, can('recover') ? 'Игроки не могут зайти. Восстановите игровой режим в карточке «Режим сервера».' : 'Игроки не могут зайти. Сообщите администратору.'].filter(Boolean).join(' ') };
        }
        if (rooms.maintenance) return { tone: 'warn', title: 'Вход на сервер закрыт', detail: rooms.maintenance.message };
        if (rooms.available) return { tone: 'ok', title: 'Сервер работает', detail: counts };
        return { tone: 'bad', title: 'Игровой сервер не отвечает', detail: rooms.lobby ? 'Лобби работает, но матчи сейчас недоступны.' : 'Игроки сейчас не могут зайти.' };
      }
      async function loadOverview() {
        const { status: state, session: sessionData, rooms } = await api('overview');
        controller = state; session = sessionData;
        // The candidate behind a running test match: same source the candidates card reads, "view" permission covers it.
        const testCandidate = state?.phase === 'test' && state?.desired?.candidate
          ? (await api('candidates').catch(() => ({ candidates: [] }))).candidates?.find((c: any) => c.id === state.desired.candidate) ?? null : null;
        const view = describe(state, rooms, session, testCandidate);
        $('#server-card').dataset.tone = view.tone;
        $('#server-headline').textContent = view.title;
        $('#server-detail').textContent = [view.detail, `проверено ${ago(rooms.checkedAt || Date.now())}`].filter(Boolean).join(' · ');
        const message = $<HTMLTextAreaElement>('#message');
        if (!message.value && rooms.maintenance?.message && document.activeElement !== message) message.value = rooms.maintenance.message;
        renderModes();
        renderRooms(rooms);
        // The candidates card's «Тест» button depends on the phase just learned above; keep it in sync (cheap local read).
        if (can('workshop')) loadCandidates().catch(() => {});
      }

      const MODES = [
        { id: 'game', title: 'Игра', about: 'Обычный режим: все игроки заходят и играют матчи.' },
        { id: 'workshop', title: 'Мастерская', about: 'Сервер для строителей карт. Обычные игроки зайти не смогут.' },
      ];
      /** Empty text collapses per the status-line convention; busy wins over an error, which wins over a stale rollback notice. */
      function renderProgress(view: ReturnType<typeof switchView>) {
        const line = $('#mode-progress');
        if (view.busy) say(line, [view.step, timing(view)].filter(Boolean).join(' · '), 'pending');
        else if (view.errorMessage) say(line, `Причина: ${view.errorMessage}.`, 'error');
        else if (view.notice) say(line, view.notice, 'error');
        else say(line, '');
      }
      function renderModes() {
        const box = $('#mode-options');
        if (!controller || controller.phase === 'UNINITIALIZED') {
          box.replaceChildren(el('p', { className: 'muted', textContent: 'Переключение режимов недоступно: управляющая программа сервера ещё не сообщила своё состояние.' }));
          say($('#mode-progress'), '');
          return;
        }
        const view = switchView(controller);
        renderProgress(view);
        // "test" is not a switchable target from here (only from a candidate's «Тест»), so it gets its own box instead of a MODES entry.
        if (controller.phase === 'test' && !view.busy) {
          box.replaceChildren(el('div', { className: 'option', dataCurrent: '' },
            el('div', { className: 'option-head' }, 'Тестовый матч', el('span', { className: 'badge ok', textContent: 'Включено сейчас' })),
            el('p', { textContent: 'Закрытый тест версии карты. Обычные игроки зайти не смогут.' }),
            can('mode') ? button('Вернуться в мастерскую', resumeWorkshop, 'small') : null,
            can('mode') ? button('Вернуть игровой режим', () => switchMode('game', false), 'small danger') : null,
          ));
          return;
        }
        const busy = view.busy, broken = controller.phase === 'ERROR';
        const target = controller.desired?.profile;
        box.replaceChildren(...MODES.map(mode => {
          const current = !busy && !broken && controller.phase === mode.id, pending = busy && target === mode.id;
          const head = el('div', { className: 'option-head' }, mode.title,
            current ? el('span', { className: 'badge ok', textContent: 'Включено сейчас' }) : pending ? el('span', { className: 'badge warn', textContent: 'Переключается…' }) : null);
          const option = el('div', { className: 'option', ...(current ? { dataCurrent: '' } : {}) }, head, el('p', { textContent: mode.about }));
          if (!current && !pending && !broken) option.append(button(mode.id === 'game' ? 'Вернуть игровой режим' : 'Включить мастерскую', () => (mode.id === 'workshop' ? startWorkshop() : switchMode('game', false)), 'small', undefined));
          if (busy && !pending) option.lastElementChild instanceof HTMLButtonElement && ((option.lastElementChild as HTMLButtonElement).disabled = true);
          if (pending && view.canCancel && can('mode')) option.append(button('Отменить переключение', cancelSwitch, 'small danger'));
          if (broken && mode.id === 'game' && can('recover')) option.append(button('Восстановить игровой режим', () => switchMode('game', true), 'small primary'));
          return option;
        }));
      }
      async function cancelSwitch() {
        if (!(await ask({ title: 'Отменить переключение?', text: 'Сервер вернётся в тот режим, в котором был до переключения. Отменить можно только пока идёт переключение — позже потребуется восстановление вручную.', ok: 'Отменить переключение', danger: true }))) return;
        const line = $('#mode-status');
        run(line, async () => {
          const { id } = await api('cancel', 'POST', {});
          follow(line, id, 'Переключение отменено, сервер возвращается в прежний режим.');
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…';
        }, $('#mode-options'));
      }
      async function switchMode(profile: 'game', recover: boolean) {
        const texts = recover
          ? { title: 'Восстановить игровой режим?', text: 'Сервер остановит всё, что сейчас запущено, и заново запустит игру. Используйте это, если сервер застрял в ошибке.', ok: 'Восстановить' }
          : { title: 'Вернуть игровой режим?', text: 'Мастерская закроется, строители будут отключены. Сервер перезапустится для всех игроков, обычно это занимает несколько минут.', ok: 'Вернуть игровой режим' };
        if (!(await ask({ ...texts, danger: true }))) return;
        const line = $('#mode-status');
        run(line, async () => {
          const { id } = await api('mode', 'POST', { profile, expectedRevision: controller.revision, ...(recover ? { recover } : {}) });
          follow(line, id, 'Сервер принял запрос: запускаем игровой режим.');
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…';
        }, $('#mode-options'));
      }
      /** «Включить мастерскую»: which maps for a fresh session, or resume the previous one as-is. */
      async function startWorkshop() {
        const known = Object.keys(MAP_NAMES);
        const checks = el('div', { className: 'checks' }, ...known.map(id => el('label', { className: 'check' }, el('input', { type: 'checkbox', name: 'map', value: id, checked: true }), MAP_NAMES[id])));
        const all = el('input', { type: 'checkbox', checked: true }) as HTMLInputElement;
        all.addEventListener('change', () => checks.querySelectorAll('input').forEach(i => ((i as HTMLInputElement).checked = all.checked)));
        const mapsBlock = el('div', {}, el('label', { className: 'check' }, all, 'Все карты'), checks);
        const fields: Node[] = [];
        if (session) {
          const label = session.maps ? session.maps.map((id: string) => MAP_NAMES[id] ?? id).join(', ') : 'все карты';
          const resume = el('input', { type: 'radio', name: 'session', value: 'resume', checked: true }) as HTMLInputElement;
          const fresh = el('input', { type: 'radio', name: 'session', value: 'new' }) as HTMLInputElement;
          const toggle = () => mapsBlock.querySelectorAll('input').forEach(i => ((i as HTMLInputElement).disabled = !fresh.checked));
          resume.addEventListener('change', toggle); fresh.addEventListener('change', toggle); toggle();
          fields.push(el('fieldset', { className: 'plain' }, el('legend', { textContent: 'Сеанс' }),
            el('label', { className: 'radio' }, resume, el('span', {}, `Продолжить прошлый сеанс (${date(session.startedAt)}, ${label})`)),
            el('label', { className: 'radio' }, fresh, 'Новый сеанс')));
        }
        fields.push(mapsBlock);
        const answer = await ask({ title: 'Включить мастерскую?', text: 'Новые матчи перестанут начинаться. Когда закончатся идущие (это может занять целую кампанию), сервер сохранит мир и перезапустится в мастерскую. Пока она открыта, обычные игроки не смогут зайти.', ok: 'Включить мастерскую', danger: true, fields });
        if (!answer) return;
        const resuming = !!session && answer.get('session') !== 'new';
        const ids = answer.getAll('map').map(String);
        const body: Record<string, unknown> = { profile: 'workshop', expectedRevision: controller.revision, session: resuming ? 'resume' : 'new', ...(resuming ? {} : { maps: ids.length === known.length ? null : ids }) };
        const line = $('#mode-status');
        run(line, async () => {
          const { id } = await api('mode', 'POST', body);
          follow(line, id, 'Сервер принял запрос: переключение в мастерскую началось.');
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…';
        }, $('#mode-options'));
      }
      async function resumeWorkshop() {
        if (!(await ask({ title: 'Вернуться в мастерскую?', text: 'Тестовый матч остановится, сервер вернётся в мастерскую с тем же сеансом.', ok: 'Вернуться в мастерскую' }))) return;
        const line = $('#mode-status');
        run(line, async () => {
          const { id } = await api('mode', 'POST', { profile: 'workshop', expectedRevision: controller.revision, session: 'resume' });
          follow(line, id, 'Сервер принял запрос: возвращаемся в мастерскую.');
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…';
        }, $('#mode-options'));
      }

      function renderRooms(rooms: any) {
        const list = $('#room-list');
        if (!rooms.available) { list.replaceChildren(el('p', { className: 'empty', textContent: rooms.maintenance ? 'Вход на сервер закрыт — матчей сейчас нет.' : 'Игровой сервер не отвечает, список матчей недоступен.' })); return; }
        if (!rooms.rooms.length) { list.replaceChildren(el('p', { className: 'empty', textContent: 'Сейчас не идёт ни одного матча.' })); return; }
        list.replaceChildren(...rooms.rooms.map((room: any) => {
          const facts: [string, string][] = [['Карта', room.map || 'выбирается'], ['Режим', room.mode], ['Сейчас', PHASES[room.phase] ?? 'Идёт'], ['Игроков', String(room.players)]];
          if (room.battle) facts.push(['Тикеты', `красные ${room.battle.red} · синие ${room.battle.blue}`]);
          const card = el('article', { className: 'card room', ariaLabel: room.name },
            el('div', { className: 'card-head' }, el('h3', { textContent: room.name }), el('span', { className: `badge ${room.joinable ? 'ok' : ''}`, textContent: room.joinable ? 'Можно зайти' : 'Набор закрыт' })),
            el('dl', { className: 'facts' }, ...facts.flatMap(([k, v]) => [el('dt', { textContent: k }), el('dd', { textContent: v })])));
          if (can('moderate')) card.append(button('Завершить матч', () => stopRoom(room), 'danger', `Завершить матч «${room.name}»`));
          return card;
        }));
      }
      async function stopRoom(room: any) {
        const radios = el('fieldset', { className: 'plain' }, el('legend', { textContent: 'Чем закончить матч' }), el('div', { className: 'radios' },
          ...OUTCOMES.map(([value, label, about], i) => el('label', { className: 'radio' }, el('input', { type: 'radio', name: 'outcome', value, required: true, checked: i === 0 }), el('span', {}, label, about ? el('small', { textContent: about }) : null)))));
        const answer = await ask({ title: `Завершить матч «${room.name}»?`, text: 'Все игроки вернутся в лобби. Итог попадёт в статистику.', ok: 'Завершить матч', danger: true, fields: [radios, reasonField('Причина (увидят игроки)')] });
        if (!answer) return;
        const outcome = String(answer.get('outcome')), reason = String(answer.get('reason') ?? '');
        run($('#room-status'), async () => {
          await api('rcon', 'POST', { action: 'stop-room', roomId: room.id, outcome, reason: outcome === 'none' && /^(win|draw)\b/i.test(reason) ? `— ${reason}` : reason });
          loadOverview();
          return `Матч «${room.name}» завершён.`;
        });
      }

      // ---------- Players ----------
      const PLAYER_ACTIONS: Record<string, { ok: string; title: (p: string) => string; text: (p: string) => string; done: (p: string) => string; reason: boolean }> = {
        kick: { ok: 'Выгнать', title: p => `Выгнать ${p}?`, text: p => `${p} будет отключён от сервера, но сможет сразу зайти снова.`, done: p => `${p} выгнан с сервера.`, reason: true },
        'team-kick': { ok: 'Убрать из матча', title: p => `Убрать ${p} из матча?`, text: p => `${p} покинет команду в текущем матче. С сервера его не выгонит.`, done: p => `${p} убран из матча.`, reason: false },
        ban: { ok: 'Забанить', title: p => `Забанить ${p}?`, text: p => `${p} будет отключён и не сможет зайти на сервер, пока его не разбанят.`, done: p => `${p} забанен.`, reason: true },
        pardon: { ok: 'Разбанить', title: p => `Разбанить ${p}?`, text: p => `${p} снова сможет заходить на сервер.`, done: p => `${p} разбанен.`, reason: false },
      };
      async function playerAction(action: string, player: string, line: HTMLElement) {
        const spec = PLAYER_ACTIONS[action];
        const answer = await ask({ title: spec.title(player), text: spec.text(player), ok: spec.ok, danger: action !== 'pardon', fields: spec.reason ? [reasonField()] : [] });
        if (!answer) return;
        await run(line, async () => {
          await api('rcon', 'POST', { action, player, reason: String(answer.get('reason') ?? '') });
          if (action === 'ban' || action === 'pardon') loadBans();
          if (action !== 'pardon') setTimeout(loadOnline, 1000);
          return spec.done(player);
        });
      }
      async function loadOnline() {
        const summary = $('#online-summary');
        try {
          const { players } = await api('rcon', 'POST', { action: 'list' });
          summary.className = 'muted';
          summary.textContent = players.length ? `Игроков на сервере: ${players.length}.` : 'Сейчас на сервере никого нет.';
          $('#online-list').replaceChildren(...players.map((name: string) => el('li', { className: 'row' }, el('div', { className: 'row-main' }, el('strong', { textContent: name })),
            el('div', { className: 'actions' },
              button('Выгнать', () => playerAction('kick', name, summary), 'small', `Выгнать ${name}`),
              button('Убрать из матча', () => playerAction('team-kick', name, summary), 'small', `Убрать ${name} из матча`),
              can('ban') ? button('Забанить', () => playerAction('ban', name, summary), 'small danger', `Забанить ${name}`) : null))));
        } catch (error) { say(summary, (error as Error).message, 'error'); $('#online-list').replaceChildren(); }
      }
      async function loadBans() {
        const { bans } = await api('bans');
        $('#ban-list').replaceChildren(...(bans.length ? bans.map((b: any) => el('li', { className: 'row' },
          el('div', { className: 'row-main' }, el('strong', { textContent: b.player }), el('small', { textContent: `Забанил ${b.by} ${ago(b.at)}${b.reason ? ` · причина: «${b.reason}»` : ''}` })),
          button('Разбанить', () => playerAction('pardon', b.player, $('#ban-status')), 'small', `Разбанить ${b.player}`)))
          : [el('li', { className: 'empty', textContent: 'Никто не забанен.' })]));
      }

      // ---------- Settings ----------
      type Rule = { type: 'int' | 'double' | 'bool'; min?: number; max?: number };
      let rules: Record<string, Rule> = {}, settingsRevision = 0, balance: Record<string, Record<string, number | boolean>> = {}, scope = '*', extraLocks: string[] = [], hadLocks = false;
      // Every field's server default, keyed by its form name, in the shape settingsBody compares against (strings for numbers, 'true'/'false' for bools).
      let defaults: Record<string, string> = {};
      const LOBBY = [{ key: 'pvpCooldownSeconds', label: 'Задержка перед выключением PvP', unit: 'сек', min: 0, max: 600, def: 10 }];
      const ROOMS = [
        { key: 'maxRooms', label: 'Матчей одновременно', unit: 'шт', min: 1, max: 16, def: 2 },
        { key: 'idleCloseSeconds', label: 'Закрывать пустую комнату через', unit: 'сек', min: 30, max: 3600, def: 600 },
        { key: 'abandonCloseSeconds', label: 'Завершать матч без игроков через', unit: 'сек', min: 5, max: 600, def: 30 },
      ];
      const DEATHMATCH = [{ key: 'minPlayers', label: 'Игроков для старта', unit: 'чел', min: 1, max: 24, def: 2 }];
      const SETTING_LABELS: Record<string, string> = { pvpEnabled: 'PvP в лобби', classLocks: 'Закрытые классы', classCosts: 'Стоимость высадки', ...Object.fromEntries([...LOBBY, ...ROOMS, ...DEATHMATCH].map(f => [f.key, f.label])), ...BALANCE_LABELS };
      function numberField(label: string, name: string, min: number, max: number, step: string, value: number, unit?: string, about?: string) {
        const input = el('input', { type: 'number', name, min, max, step, inputMode: step === '1' ? 'numeric' : 'decimal', value });
        const wrap = unit ? el('div', { className: 'unit' }, input, el('span', { className: 'unit__suffix', textContent: unit, ariaHidden: 'true' })) : undefined;
        return field(label, input, `${about ? `${about} ` : ''}${number(min)}–${number(max)}`, wrap);
      }
      const shown = (v: number | boolean) => (typeof v === 'boolean' ? (v ? 'да' : 'нет') : number(v));
      /** The value the mod uses for `key` at the current scope: the campaign/room file default, overridden by the site's «Все матчи», like the mod merges them. */
      const scopeDefault = (key: string) => scope === '*' ? BALANCE_DEFAULTS.room[key] : balance['*']?.[key] ?? BALANCE_DEFAULTS[scope][key];
      function renderBalance() {
        const values = balance[scope] ?? {};
        $('#scope-hint').textContent = scope === '*' ? 'Общие значения для всех кампаний и обычных боёв.' : 'Значения только для этих матчей, поверх общих.';
        $('#balance-fields').replaceChildren(...BALANCE_GROUPS.map(group => el('div', { className: 'group' }, el('h4', { textContent: group.title }), el('div', { className: 'fields' }, ...group.fields.map(f => {
          const rule = rules[f.key], name = `b_${f.key}`, def = scopeDefault(f.key);
          defaults[f.key] = rule.type === 'bool' ? String(def) : String(def);
          if (rule.type === 'bool') {
            const value = values[f.key] ?? def;
            const select = el('select', { name }, ...[['true', 'Да'], ['false', 'Нет']].map(([v, text]) => el('option', { value: v, textContent: text, selected: String(value) === v })));
            // customSelect() must run after the select has a parent — it inserts its painted button as select's
            // next sibling, which is a no-op on a detached node (this select is field()'s child, not yet attached here).
            const wrapped = field(f.label, select, f.hint);
            customSelect(select);
            return wrapped;
          }
          return numberField(f.label, name, rule.min!, rule.max!, rule.type === 'int' ? '1' : '0.1', Number(values[f.key] ?? def), f.unit, f.hint);
        })))));
      }
      function collectBalance() {
        const form = $<HTMLFormElement>('#settings-form'), values: Record<string, number | boolean> = {};
        for (const key of Object.keys(rules)) {
          const raw = (form.elements.namedItem(`b_${key}`) as HTMLInputElement | null)?.value ?? '';
          if (raw !== '' && raw !== defaults[key]) values[key] = rules[key].type === 'bool' ? raw === 'true' : Number(raw);
        }
        if (Object.keys(values).length) balance[scope] = values; else delete balance[scope];
      }
      function renderScopes() {
        const known = new Set(BALANCE_SCOPES.map(s => s.id));
        $('#scope').replaceChildren(...BALANCE_SCOPES.map(s => el('option', { value: s.id, textContent: `${s.name}${balance[s.id] ? ' — есть изменения' : ''}`, selected: s.id === scope })));
        // Sections for campaigns the site does not know are kept as they are.
        for (const id of Object.keys(balance)) if (!known.has(id)) $('#scope').append(el('option', { value: id, textContent: 'Другая кампания — есть изменения', selected: id === scope }));
        customSelect($<HTMLSelectElement>('#scope'));
      }
      $('#scope').addEventListener('change', e => { collectBalance(); scope = (e.target as HTMLSelectElement).value; renderScopes(); renderBalance(); });

      function appliedErrors(errors: string[]) {
        return errors.map(error => {
          const key = Object.keys(SETTING_LABELS).find(k => error.includes(k));
          if (!key) return 'сервер не смог прочитать часть настроек';
          return /clamp/i.test(error) ? `«${SETTING_LABELS[key]}» — значение вне допустимых границ, сервер его ограничил` : `«${SETTING_LABELS[key]}» — сервер оставил прежнее значение`;
        });
      }
      let settingsPoll: ReturnType<typeof setTimeout> | undefined;
      async function loadSettings(waitStarted = 0, statusOnly = false) {
        const { settings, applied, balance: balanceRules } = await api('settings');
        rules = balanceRules; settingsRevision = settings.revision ?? 0;
        if (!statusOnly) {
        const form = $<HTMLFormElement>('#settings-form');
        defaults = Object.fromEntries([...LOBBY, ...ROOMS, ...DEATHMATCH].map(f => [f.key, String(f.def)]));
        defaults.pvpEnabled = 'true';
        const pvp = form.elements.namedItem('pvpEnabled') as HTMLSelectElement;
        pvp.value = String(settings.lobby?.pvpEnabled ?? true);
        customSelect(pvp);
        hadLocks = Array.isArray(settings.classLocks);
        $('#lobby-fields').replaceChildren(...LOBBY.map(f => numberField(f.label, f.key, f.min, f.max, '1', settings.lobby?.[f.key] ?? f.def, f.unit)));
        $('#room-fields').replaceChildren(...ROOMS.map(f => numberField(f.label, f.key, f.min, f.max, '1', settings.rooms?.[f.key] ?? f.def, f.unit)));
        $('#deathmatch-fields').replaceChildren(...DEATHMATCH.map(f => numberField(f.label, f.key, f.min, f.max, '1', settings.deathmatch?.[f.key] ?? f.def, f.unit)));
        $('#class-costs').replaceChildren(...Object.entries(CLASS_COSTS).map(([id, price]) => {
          const item = numberField(CLASS_NAMES[id], `cost_${id}`, 0, 10000, '1', settings.classCosts?.[id] ?? price, 'БК');
          item.querySelector('input')!.required = true;
          return item;
        }));
        const locks: string[] = settings.classLocks ?? [];
        extraLocks = locks.filter(id => !Object.hasOwn(CLASS_NAMES, id));
        $('#class-list').replaceChildren(...Object.entries(CLASS_NAMES).map(([id, name]) => el('label', { className: 'check' }, el('input', { type: 'checkbox', name: 'class', value: id, checked: !locks.includes(id) }), name)));
        balance = structuredClone(settings.campaignBalance ?? {});
        renderScopes(); renderBalance();
        }

        clearTimeout(settingsPoll);
        const who = settings.updatedBy ? ` Последнее изменение: ${settings.updatedBy}, ${ago(settings.updatedAt)}.` : '';
        if (!settings.revision) settingsStatus('Настройки ещё не меняли — сервер работает на своих значениях по умолчанию.', 'ok', '');
        else if (applied?.revision >= settings.revision && applied.errors?.length) settingsStatus(`Сохранено, но сервер применил не всё: ${appliedErrors(applied.errors).join('; ')}.${who}`, 'error', 'Применено не всё — подробности вверху.');
        else if (applied?.revision >= settings.revision) settingsStatus(`Применено на сервере.${who}`, 'ok', 'Применено на сервере.');
        else if (waitStarted && Date.now() - waitStarted > 60_000) settingsStatus(`Сохранено, но сервер пока не подтвердил применение. Возможно, он перезапускается или открыта мастерская — настройки применятся, когда игра запустится.${who}`, 'pending', 'Сохранено, сервер пока не подтвердил.');
        else {
          settingsStatus('Сохранено, сервер применяет настройки (обычно до 5 секунд)…', 'pending', 'Сохранено, сервер применяет…');
          settingsPoll = setTimeout(() => loadSettings(waitStarted || Date.now(), true).catch(() => {}), 3000);
        }
      }
      /** One status in two places: the banner at the top and the sticky save bar. */
      function settingsStatus(text: string, tone: 'ok' | 'error' | 'pending', short: string) {
        say($('#settings-state'), text, tone);
        const line = $('#settings-form .savebar .form-status');
        if (short) say(line, short, tone); else line.textContent = '';
      }
      $<HTMLFormElement>('#settings-form').addEventListener('submit', async e => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement, save = form.querySelector<HTMLButtonElement>('.savebar button')!;
        collectBalance();
        const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value;
        const body = settingsBody(settingsRevision, {
          pvpEnabled: value('pvpEnabled'),
          classCosts: Object.fromEntries(Object.keys(CLASS_COSTS).map(id => [id, value(`cost_${id}`)])),
          lobby: Object.fromEntries(LOBBY.map(f => [f.key, value(f.key)])), rooms: Object.fromEntries(ROOMS.map(f => [f.key, value(f.key)])),
          deathmatch: Object.fromEntries(DEATHMATCH.map(f => [f.key, value(f.key)])),
          lockedClasses: [...[...form.querySelectorAll<HTMLInputElement>('input[name=class]')].filter(c => !c.checked).map(c => c.value), ...extraLocks],
          hadLocks, balance,
        }, defaults);
        save.disabled = true;
        settingsStatus('Сохраняем…', 'pending', 'Сохраняем…');
        try { await api('settings', 'PUT', body); await loadSettings(); }
        catch (error) { settingsStatus((error as Error).message, 'error', (error as Error).message); }
        finally { save.disabled = false; }
      });

      // ---------- Team ----------
      const assignable = () => (can('roles-admin') ? ['builder', 'moderator', 'admin'] : ['builder', 'moderator']);
      async function loadTeam() {
        const data = await api('staff');
        $('#role-legend').replaceChildren(...Object.values(ROLES).map(r => el('div', {}, el('dt', { textContent: r.name }), el('dd', { textContent: r.about }))));
        const line = $('#staff-status');
        const rows = data.owners.map((o: any) => el('li', { className: 'row' }, el('div', { className: 'row-main' }, el('strong', { textContent: o.name }), el('small', { textContent: 'Владелец. Назначается в настройках сервера, здесь не меняется.' }))));
        const roleSelects: HTMLSelectElement[] = [];
        for (const s of data.staff) {
          const editable = s.name !== me.name && (s.role !== 'admin' || can('roles-admin'));
          const main = el('div', { className: 'row-main' }, el('strong', { textContent: s.name }), el('small', { textContent: `${ROLES[s.role]?.name ?? 'Участник'} · добавил ${s.grantedBy} ${ago(s.grantedAt)}` }));
          const row = el('li', { className: 'row' }, main);
          if (editable) {
            const select = el('select', { ariaLabel: `Роль игрока ${s.name}` }, ...assignable().map(r => el('option', { value: r, textContent: ROLES[r].name, selected: r === s.role })));
            roleSelects.push(select);
            select.addEventListener('change', async () => {
              const role = select.value;
              if (!(await ask({ title: `Сделать ${s.name} — ${ROLES[role].name.toLowerCase()}?`, text: ROLES[role].about, ok: 'Сменить роль' }))) { select.value = s.role; customSelect(select); return; }
              changeRole({ uuid: s.uuid, role }, `${s.name} теперь ${ROLES[role].name.toLowerCase()}.`, line);
            });
            const actions = el('div', { className: 'actions' }, select);
            if (can('workshop') && s.role === 'builder') actions.append(button(`Карты: ${mapsLabel(s.maps)}`, () => editMaps(s, line), 'small', `Карты для ${s.name} в мастерской`));
            actions.append(button('Убрать из команды', async () => {
              if (await ask({ title: `Убрать ${s.name} из команды?`, text: `${s.name} потеряет доступ к панели и мастерской. Играть на сервере он сможет как обычно.`, ok: 'Убрать', danger: true }))
                changeRole({ uuid: s.uuid, role: null }, `${s.name} больше не в команде.`, line);
            }, 'small danger', `Убрать ${s.name} из команды`));
            row.append(actions);
          }
          rows.push(row);
        }
        $('#staff-list').replaceChildren(...rows);
        roleSelects.forEach(customSelect);
        $('#grant-roles').replaceChildren(...assignable().map((r, i) => el('label', { className: 'radio' }, el('input', { type: 'radio', name: 'role', value: r, required: true, checked: i === 0 }), el('span', {}, ROLES[r].name, el('small', { textContent: ROLES[r].about })))));
        const key = (list: any[]) => JSON.stringify((list ?? []).map(m => [m.draslId, m.role]).sort());
        const inSync = Array.isArray(data.workshop) && key(data.workshop) === key(data.expected);
        const last = data.lastSync ? ` Последнее обновление ${ago(data.lastSync.at)}${data.lastSync.result && !data.lastSync.result.ok ? ' — не удалось' : ''}.` : '';
        await renderMapAccess(data.staff);
        say($('#workshop-state'), inSync ? `Мастерская пускает ровно тех, кто в команде.${last}` : `Список доступа в мастерскую отличается от команды — нажмите «Обновить доступ».${last}`, inSync ? 'ok' : 'pending');
      }
      async function changeRole(body: Record<string, unknown>, done: string, line: HTMLElement) {
        await run(line, async () => {
          const data = await api('staff', 'POST', body);
          await loadTeam();
          return data.sync.error ? `${done} Но доступ в мастерскую обновить не удалось — нажмите «Обновить доступ» позже.` : done;
        });
      }
      /** `null`/absent = every map, including ones added later; `[]` = the builder enters the workshop hub but can edit nothing. */
      const mapsLabel = (maps: string[] | null) => maps === null ? 'все' : !maps.length ? 'нет' : maps.length > 3 ? `${maps.length} из ${Object.keys(WORKSHOP_PLACES).length}` : maps.map(id => WORKSHOP_PLACES[id] ?? id).join(', ');
      async function editMaps(s: { uuid: string; name: string; maps: string[] | null }, line: HTMLElement) {
        const known = Object.keys(WORKSHOP_PLACES), current = new Set(s.maps ?? known);
        const list = el('div', { className: 'checks' }, ...known.map(id => el('label', { className: 'check' }, el('input', { type: 'checkbox', name: 'map', value: id, checked: current.has(id) }), WORKSHOP_PLACES[id])));
        const answer = await ask({ title: `Карты для ${s.name} в мастерской`, text: 'Отметьте карты, которые строитель может редактировать. Все отмечены — доступ ко всем картам, включая новые.', ok: 'Сохранить', fields: [list] });
        if (!answer) return;
        const ids = answer.getAll('map').map(String), maps = ids.length === known.length ? null : ids;
        await run(line, async () => {
          await api('staff/maps', 'POST', { uuid: s.uuid, maps });
          await loadTeam();
          return `Карты для ${s.name} обновлены.`;
        });
      }
      /** The same `maps` lists as «Карты: …» in the team tab, seen from each map. */
      async function renderMapAccess(staff: { uuid: string; name: string; role: string; maps: string[] | null }[]) {
        const builders = staff.filter(s => s.role === 'builder'), line = $('#map-access-status');
        const editors = (id: string) => builders.filter(b => b.maps === null || b.maps.includes(id));
        // Overlays: maps currently published through the workshop whose in-game markup drifted from what's committed to the repo.
        const { overlays } = await api('candidates').catch(() => ({ overlays: {} }));
        $('#map-access').replaceChildren(...Object.entries(WORKSHOP_PLACES).map(([id, name]) => {
          const who = editors(id).map(b => b.name);
          const main = el('div', { className: 'row-main' }, el('strong', { textContent: name }),
            el('small', { textContent: builders.length ? `Строители: ${who.length ? who.join(', ') : 'никто'}` : 'Строителей в команде нет' }),
            overlays?.[id]?.differsFromRepo ? el('small', { textContent: `Опубликованная разметка «${name}» отличается от репозитория — перенесите её в git: tools/workshop/fetch-map.py ${id}` }) : null);
          const actions = el('div', { className: 'actions' },
            builders.length ? button('Кто строит', () => editMapAccess(id, name, builders, new Set(editors(id).map(b => b.uuid)), line), 'small', `Кто строит: ${name}`) : null,
            id in MAP_NAMES ? button('На проверку', () => submitMap(id, name), 'small', `Отправить карту ${name} на проверку`) : null);
          return el('li', { className: 'row' }, main, actions);
        }));
      }
      // ---------- Map candidates ----------
      const CANDIDATE_STATUS: Record<string, [string, string]> = {
        pending: ['Ждёт проверки', 'warn'], accepted: ['Принята · ждёт релиза', 'ok'], published: ['В игре', 'ok'], rejected: ['Отклонена', ''], superseded: ['Заменена новой', ''], rolled_back: ['Откачена', ''],
      };
      async function loadCandidates() {
        const { candidates } = await api('candidates');
        const line = $('#candidates-status');
        const rows = (candidates ?? []).slice(0, 15).map((c: any) => {
          const name = WORKSHOP_PLACES[c.mapId] ?? c.mapId, [label, tone] = CANDIDATE_STATUS[c.status] ?? [c.status, ''];
          const decided = c.decidedBy ? ` · решил ${c.decidedBy.name} ${ago(c.decidedAt)}` : '';
          // baseMatches: false — the map's reference changed since editing started; null — unknown base (older drafts). Either needs a forced publish.
          const baseWarn = c.baseMatches === false ? 'эталон карты изменился после начала правки' : c.baseMatches === null ? 'база неизвестна' : null;
          const main = el('div', { className: 'row-main' }, el('strong', {}, `${name} `, el('span', { className: `badge ${tone}`, textContent: label }),
            baseWarn ? el('span', { className: 'badge warn', textContent: baseWarn }) : null),
            el('small', { textContent: `Отправил ${c.author?.name ?? '?'} ${ago(c.createdAt)} · ${(c.size / 1048576).toFixed(1)} МБ, регионов ${c.regions}${decided}` }));
          const actions = el('div', { className: 'actions' });
          const confirmForce = (reason: string) => ask({ title: `Принять «${name}» с другой базой?`, text: `${reason} Пакет сохранится с отметкой об изменившейся базе. Выпуск требует отдельной проверки.`, ok: 'Принять с отметкой', danger: true });
          const publish = (force: boolean) => run(line, async () => {
            const { id } = await api('candidates/publish', 'POST', { candidateId: c.id, mapId: c.mapId, ...(force ? { force: true } : {}) });
            follow(line, id, `Карта «${name}» принята. Выпуск — отдельный шаг.`, async error => {
              if (!/^base (changed|unknown)/.test(error)) return false;
              if (await confirmForce('Эталон карты, возможно, изменился с начала правки.')) publish(true); else say(line, 'Публикация отменена.', 'error');
              return true;
            }).then(loadCandidates);
            return 'Запрос отправлен. Сервер применит его в течение 15 секунд…';
          });
          if (can('workshop') && c.status === 'pending') {
            actions.append(button('Принять', async () => {
              if (!(await ask({ title: `Принять «${name}»?`, text: `Будет принят именно этот пакет. Игровая карта изменится только после проверки и выпуска новой версии сборки.`, ok: 'Принять' }))) return;
              if (baseWarn && !(await confirmForce(`Эта версия правилась поверх карты, у которой ${baseWarn}.`))) return;
              publish(!!baseWarn);
            }, 'small primary', `Принять ${name}`),
            button('Отклонить', async () => {
              if (!(await ask({ title: `Отклонить эту версию «${name}»?`, text: 'Версия останется в списке как отклонённая, в игру она не попадёт.', ok: 'Отклонить', danger: true }))) return;
              run(line, async () => { const { id } = await api('candidates/reject', 'POST', { candidateId: c.id, mapId: c.mapId }); follow(line, id, 'Версия отклонена.').then(loadCandidates); return 'Запрос отправлен…'; });
            }, 'small danger', `Отклонить ${name}`));
          }
          if (can('mode') && c.status === 'pending' && controller?.phase === 'workshop') {
            actions.append(button('Тест', async () => {
              if (!(await ask({ title: `Тестовый матч «${name}»?`, text: 'Мастерская перезапустится в закрытый тестовый матч на копии этой версии карты — это займёт около 2–3 минут. Строителей переведёт с собой сервер. Результат теста не идёт в статистику.', ok: 'Начать тест', danger: true }))) return;
              run(line, async () => {
                const { id } = await api('mode', 'POST', { profile: 'test', expectedRevision: controller.revision, candidateId: c.id });
                follow(line, id, `Тестовый матч «${name}» начат.`).then(loadOverview);
                return 'Запрос отправлен. Сервер применит его в течение 15 секунд…';
              });
            }, 'small', `Тестовый матч ${name}`));
          }
          if (can('workshop') && c.status === 'accepted') {
            const link = el('a', { className: 'small', textContent: 'Скачать пакет', href: `/api/admin/candidates/download?id=${encodeURIComponent(c.id)}` });
            actions.append(link);
          }
          return el('li', { className: 'row' }, main, actions);
        });
        $('#candidate-list').replaceChildren(...(rows.length ? rows : [el('li', { className: 'empty', textContent: 'Пока ничего не отправляли.' })]));
      }
      async function submitMap(mapId: string, name: string) {
        if (!(await ask({ title: `Отправить «${name}» на проверку?`, text: 'Сервер снимет копию мира и разметки карты из мастерской. В игру она попадёт после принятия и выпуска новой версии сборки.', ok: 'Отправить' }))) return;
        const line = $('#candidates-status');
        run(line, async () => { const { id } = await api('candidates/create', 'POST', { mapId }); follow(line, id, `Копия «${name}» готова к проверке.`).then(loadCandidates); return 'Запрос отправлен. Сервер снимет копию в течение 15 секунд…'; });
      }

      async function editMapAccess(mapId: string, name: string, builders: { uuid: string; name: string }[], current: Set<string>, line: HTMLElement) {
        const list = el('div', { className: 'checks' }, ...builders.map(b => el('label', { className: 'check' }, el('input', { type: 'checkbox', name: 'builder', value: b.uuid, checked: current.has(b.uuid) }), b.name)));
        const answer = await ask({ title: `Кто строит: «${name}»`, text: 'Отметьте строителей, которые могут здесь строить. Остальные зайдут только посмотреть.', ok: 'Сохранить', fields: [list] });
        if (!answer) return;
        await run(line, async () => {
          const { changed, sync } = await api('staff/map-access', 'POST', { mapId, uuids: answer.getAll('builder').map(String) });
          await loadTeam();
          if (!changed.length) return 'Ничего не изменилось.';
          return sync?.error ? `Доступ к карте «${name}» сохранён, но мастерская его ещё не получила — нажмите «Обновить доступ».` : `Доступ к карте «${name}» обновлён.`;
        }, $('#map-access'));
      }
      $<HTMLFormElement>('#grant-form').addEventListener('submit', async e => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement, data = new FormData(form), name = String(data.get('nickname')), role = String(data.get('role'));
        if (!(await ask({ title: `Добавить ${name} в команду?`, text: `Роль: ${ROLES[role].name}. ${ROLES[role].about}`, ok: 'Добавить' }))) return;
        const line = form.querySelector<HTMLElement>('.form-status')!;
        await changeRole({ name, role }, `${name} добавлен в команду.`, line);
        if (line.classList.contains('ok')) form.reset();
      });
      $('#sync').addEventListener('click', () => {
        const line = $('#sync-status');
        run(line, async () => { const { id } = await api('staff/sync', 'POST', {}); follow(line, id, 'Доступ в мастерскую обновлён.').then(loadTeam); return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'; }, $('#sync').parentElement);
      });

      // ---------- Statistics ----------
      const REASONS: Record<string, string> = { draw: 'Ничья', abandoned: 'Прерван: все игроки вышли', stopped: 'Остановлен вручную', shutdown: 'Прерван: сервер выключился', error: 'Прерван из-за ошибки' };
      const matchTitle = (r: { kind: string; mode: string; mapId: string | null }) => `${MODE_NAMES[r.mode] ?? 'Матч'} · ${r.kind === 'campaign' ? 'итог кампании' : MAP_NAMES[r.mapId ?? ''] ?? 'другая карта'}`;
      function outcome(r: any) {
        if (r.reason !== 'completed') return REASONS[r.reason] ?? 'Завершён';
        if (r.winnerName) return `Победил ${r.winnerName}`;
        return TEAM_NAMES[r.winner] ? `Победа ${TEAM_NAMES[r.winner]}` : 'Завершён';
      }
      let resultPage = 1;
      async function loadResults() {
        const mode = $<HTMLSelectElement>('#result-mode').value, data = await api(`results?page=${resultPage}${mode ? `&mode=${mode}` : ''}`);
        const line = $('#result-status');
        $('#result-list').replaceChildren(...(data.results.length ? data.results.map((r: any) => {
          const voided = r.voidedAt !== null, title = matchTitle(r);
          const players = el('small', {}, `Игроки (${r.participants}): `, ...r.players.flatMap((p: any, i: number) => [i ? ', ' : '', el('span', { className: `team-${p.team}`, textContent: p.name })]), r.participants > r.players.length ? '…' : '');
          const main = el('div', { className: 'row-main' },
            el('strong', { textContent: title }),
            el('span', {}, `${date(r.endedAt)} · ${outcome(r)}`, voided ? el('span', { className: 'badge warn', textContent: ` Не учитывается — решил ${r.voidedBy}` }) : null),
            players);
          const toggle = button(voided ? 'Вернуть в статистику' : 'Не учитывать матч', async () => {
            const answer = await ask(voided
              ? { title: 'Вернуть матч в статистику?', text: `«${title}», ${date(r.endedAt)}. Матч снова появится в лидерборде и профилях игроков.${r.rated ? ' Рейтинг сезона пересчитается.' : ''}`, ok: 'Вернуть' }
              : { title: 'Не учитывать этот матч?', text: `«${title}», ${date(r.endedAt)}. Матч пропадёт из лидерборда и профилей игроков.${r.rated ? ' Рейтинг сезона пересчитается.' : ''} Решение можно отменить.`, ok: 'Не учитывать', danger: true });
            if (!answer) return;
            await run(line, async () => { await api('results/void', 'POST', { serverId: r.serverId, eventId: r.eventId, voided: !voided }); await loadResults(); return voided ? 'Матч снова учитывается.' : 'Матч больше не учитывается.'; });
          }, voided ? 'small' : 'small danger', `${voided ? 'Вернуть в статистику' : 'Не учитывать'}: ${title}, ${date(r.endedAt)}`);
          return el('li', { className: `row${voided ? ' voided' : ''}` }, main, toggle);
        }) : [el('li', { className: 'empty', textContent: 'Матчей пока нет.' })]));
        const from = data.total ? (resultPage - 1) * data.limit + 1 : 0, to = Math.min(data.total, resultPage * data.limit);
        $('#page').textContent = data.total ? `Матчи ${from}–${to} из ${data.total}` : '';
        $<HTMLButtonElement>('#prev').disabled = resultPage <= 1;
        $<HTMLButtonElement>('#next').disabled = resultPage * data.limit >= data.total;
      }
      $('#result-mode').addEventListener('change', () => { resultPage = 1; loadResults(); });
      customSelect($<HTMLSelectElement>('#result-mode'));
      $('#prev').addEventListener('click', () => { resultPage--; loadResults(); });
      $('#next').addEventListener('click', () => { resultPage++; loadResults(); });
      const dayFormat = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
      async function loadSeasons() {
        const { seasons } = await api('seasons');
        $('#season-list').replaceChildren(...seasons.slice().reverse().map((s: any) => el('li', { textContent: `${s.name}: ${dayFormat.format(Date.parse(s.startsAt))} — ${dayFormat.format(Date.parse(s.endsAt))}` })));
      }
      async function loadKeys() {
        const { keys } = await api('keys');
        $('#key-list').replaceChildren(...keys.map((k: any) => el('li', { className: 'row' },
          el('div', { className: 'row-main' }, el('strong', { textContent: k.label }), el('small', { textContent: k.revokedAt ? `Отозван ${ago(k.revokedAt)}` : `Действует, создан ${ago(k.createdAt)}` })),
          k.revokedAt ? null : button('Отозвать', async () => {
            if (!(await ask({ title: `Отозвать ключ «${k.label}»?`, text: 'Сервер с этим ключом перестанет отправлять результаты матчей, пока ему не выдадут новый.', ok: 'Отозвать', danger: true }))) return;
            await run($('#key-form .form-status'), async () => { await api('keys/revoke', 'POST', { id: k.id }); await loadKeys(); return 'Ключ отозван.'; });
          }, 'small danger', `Отозвать ключ «${k.label}»`))));
      }
      $<HTMLFormElement>('#key-form').addEventListener('submit', e => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement, line = form.querySelector<HTMLElement>('.form-status')!;
        run(line, async () => {
          const { key } = await api('keys', 'POST', { serverId: (form.elements.namedItem('serverId') as HTMLInputElement).value.trim().toLowerCase(), label: (form.elements.namedItem('label') as HTMLInputElement).value });
          form.reset(); loadKeys();
          line.replaceChildren('Ключ создан. Скопируйте его сейчас — больше он показан не будет:', el('div', { className: 'secret', textContent: key }));
        }, form).then(() => { if (!line.firstElementChild && line.textContent === 'Выполняем…') line.textContent = ''; });
      });

      // ---------- Journal ----------
      /** [past tense, infinitive for a failed attempt, rest of the sentence]. */
      function sentence(a: any): [string, string, string] {
        let d: any = {};
        try { d = a.detail ? JSON.parse(a.detail) : {}; } catch {}
        const player = d.player ?? a.target, reason = d.reason ? `, причина: «${d.reason}»` : '';
        const match = d.room ? ` «${d.room.name}»${d.room.map ? ` на карте ${d.room.map}` : ''}` : '';
        const result = d.mode ? ` «${matchTitle(d)}» от ${date(d.endedAt)}` : '';
        const cls = ` «${CLASS_NAMES[a.target] ?? 'неизвестный'}»`;
        switch (a.action) {
          case 'mode': return a.target === 'workshop' ? ['включил', 'включить', ' мастерскую'] : d.recover ? ['восстановил', 'восстановить', ' игровой режим'] : ['вернул', 'вернуть', ' игровой режим'];
          case 'cancel': return ['отменил', 'отменить', ' переключение режима'];
          case 'message': return ['изменил', 'изменить', ` сообщение для игроков: «${d.message ?? ''}»`];
          case 'rcon:say': return ['написал', 'написать', ` всем: «${d.text ?? ''}»`];
          case 'rcon:kick': return ['выгнал', 'выгнать', ` игрока ${player}${reason}`];
          case 'rcon:ban': return ['забанил', 'забанить', ` игрока ${player}${reason}`];
          case 'rcon:pardon': return ['разбанил', 'разбанить', ` игрока ${player}`];
          case 'rcon:team-kick': return ['убрал', 'убрать', ` игрока ${player} из матча`];
          case 'rcon:class-lock': return ['закрыл', 'закрыть', ` класс${cls}`];
          case 'rcon:class-unlock': return ['открыл', 'открыть', ` класс${cls}`];
          case 'rcon:range': return a.target === 'open' ? ['открыл', 'открыть', ' полигон'] : a.target === 'close' ? ['закрыл', 'закрыть', ' полигон'] : ['сбросил', 'сбросить', ' полигон'];
          case 'rcon:stop-room': return ['завершил', 'завершить', ` матч${match} — ${(OUTCOMES.find(o => o[0] === d.outcome)?.[1] ?? 'без итога').toLowerCase()}${reason}`];
          case 'rcon:maintenance-status': return ['проверил', 'проверить', ' состояние техработ'];
          case 'rcon:drain': return ['запретил', 'запретить', ' начинать новые матчи'];
          case 'rcon:interrupt': return ['прервал', 'прервать', ` все матчи${reason}`];
          case 'settings': return ['изменил', 'изменить', ' настройки игры'];
          case 'role-grant': return ['назначил', 'назначить', ` ${d.name ?? 'игрока'} на роль «${ROLES[d.role]?.name ?? 'участник'}»`];
          case 'role-revoke': return ['убрал', 'убрать', ` ${d.name ?? 'игрока'} из команды`];
          case 'workshop-sync': return ['обновил', 'обновить', ' доступ в мастерскую'];
          case 'workshop-maps': return ['изменил', 'изменить', ` карты для ${d.name ?? 'строителя'} в мастерской`];
          case 'workshop-candidate': return ['отправил', 'отправить', ` на проверку карту «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»${d.from === 'game' ? ' (из игры)' : ''}`];
          case 'workshop-publish': return ['выложил', 'выложить', ` в игру карту «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`];
          case 'workshop-reject': return ['отклонил', 'отклонить', ` версию карты «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`];
          case 'workshop-rollback': return ['откатил', 'откатить', ` карту «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`];
          case 'workshop-map-access': return d.from === 'game'
            ? [d.allowed ? 'разрешил' : 'запретил', d.allowed ? 'разрешить' : 'запретить', ` ${d.target ?? 'строителю'} строить: «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}» (из игры)`]
            : ['изменил', 'изменить', ` список строителей: «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`];
          case 'result-void': return ['исключил', 'исключить', ` из статистики матч${result}`];
          case 'result-restore': return ['вернул', 'вернуть', ` в статистику матч${result}`];
          case 'ingest-key-create': return ['создал', 'создать', ` ключ приёма результатов «${d.label ?? ''}»`];
          case 'ingest-key-revoke': return ['отозвал', 'отозвать', ' ключ приёма результатов'];
          default: return ['выполнил', 'выполнить', ' действие в панели'];
        }
      }
      async function loadAudit() {
        const { entries } = await api('audit');
        const shown = entries.filter((a: any) => a.action !== 'rcon:list');
        $('#audit-list').replaceChildren(...(shown.length ? shown.map((a: any) => {
          const [past, attempt, rest] = sentence(a), error = friendly(String(a.error ?? '').replace(/\s\(.*\)$/, ''), 400);
          return el('li', { className: a.ok ? '' : 'failed' },
            el('span', {}, el('strong', { textContent: a.actorName }), a.ok ? ` ${past}${rest}` : ` пытался ${attempt}${rest} — `,
              a.ok ? null : el('span', { className: 'fail', textContent: `не получилось: ${error.charAt(0).toLowerCase()}${error.slice(1)}` })),
            el('time', { dateTime: new Date(a.at).toISOString(), title: date(a.at), textContent: ago(a.at) }));
        })
          : [el('li', { className: 'empty', textContent: 'Пока никто ничего не делал.' })]));
      }

      // ---------- Tabs and start ----------
      function showTab(id: string, focus: boolean) {
        const tabs = [...document.querySelectorAll<HTMLAnchorElement>('#tabs a')];
        const current = tabs.find(t => t.hash === `#${id}`) ?? tabs[0];
        if (!current) return;
        tabs.forEach(t => (t === current ? t.setAttribute('aria-current', 'page') : t.removeAttribute('aria-current')));
        document.querySelectorAll<HTMLElement>('main > section').forEach(s => (s.hidden = `#${s.id}` !== current.hash));
        if (focus) document.querySelector<HTMLElement>(`${current.hash} h2`)?.focus();
      }
      addEventListener('hashchange', () => showTab(location.hash.slice(1), true));

      $<HTMLFormElement>('#message-form').addEventListener('submit', e => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement, line = form.querySelector<HTMLElement>('.form-status')!;
        run(line, async () => { const { id } = await api('message', 'POST', { message: $<HTMLTextAreaElement>('#message').value }); follow(line, id, 'Сообщение сохранено. Игроки увидят его, когда сервер будет закрыт.'); return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'; }, form);
      });
      const RANGE: Record<string, { title: string; text: string; ok: string; done: string }> = {
        open: { title: 'Открыть полигон?', text: 'Игроки смогут заходить на тренировочную площадку.', ok: 'Открыть', done: 'Полигон открыт.' },
        close: { title: 'Закрыть полигон?', text: 'Все, кто сейчас на полигоне, вернутся в лобби.', ok: 'Закрыть', done: 'Полигон закрыт.' },
        reset: { title: 'Сбросить полигон?', text: 'Площадка вернётся в исходное состояние, игроки на ней вернутся в лобби.', ok: 'Сбросить', done: 'Полигон сброшен.' },
      };
      document.querySelectorAll<HTMLButtonElement>('[data-range]').forEach(b => b.addEventListener('click', async () => {
        const spec = RANGE[b.dataset.range!];
        if (!(await ask({ ...spec, danger: b.dataset.range !== 'open' }))) return;
        run($('#range-status'), async () => { await api('rcon', 'POST', { action: 'range', op: b.dataset.range }); return spec.done; }, b.parentElement);
      }));
      $('#drain').addEventListener('click', async () => {
        if (!(await ask({ title: 'Не начинать новые матчи?', text: 'Идущие матчи доиграют, а новые начаться не смогут. Используйте перед техработами, если мастерская не нужна.', ok: 'Не начинать новые', danger: true }))) return;
        run($('#maint-status'), async () => { await api('rcon', 'POST', { action: 'drain' }); return 'Новые матчи больше не начинаются.'; }, $('#drain').parentElement);
      });
      $('#interrupt').addEventListener('click', async () => {
        const answer = await ask({ title: 'Прервать все матчи?', text: 'Все идущие матчи сразу остановятся без победителя, игроки вернутся в лобби. Это нельзя отменить.', ok: 'Прервать все матчи', danger: true, fields: [reasonField('Причина (увидят все игроки)', true)] });
        if (!answer) return;
        run($('#maint-status'), async () => { await api('rcon', 'POST', { action: 'interrupt', reason: String(answer.get('reason')) }); loadOverview(); return 'Все матчи прерваны.'; }, $('#interrupt').parentElement);
      });
      $<HTMLFormElement>('#say-form').addEventListener('submit', e => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement, input = $<HTMLInputElement>('#say-text');
        run(form.querySelector<HTMLElement>('.form-status')!, async () => { await api('rcon', 'POST', { action: 'say', text: input.value }); input.value = ''; return 'Объявление отправлено.'; }, form);
      });
      $<HTMLFormElement>('#byname-form').addEventListener('submit', e => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement;
        playerAction((e.submitter as HTMLButtonElement | null)?.value || 'kick', $<HTMLInputElement>('#byname').value, form.querySelector<HTMLElement>('.form-status')!);
      });
      $('#online-refresh').addEventListener('click', () => { $('#online-summary').textContent = 'Обновляем…'; loadOnline(); });

      /** Знакомые никнеймы в поля ввода: подсказка, а не ограничение — своё значение всегда можно вписать. */
      async function loadPlayerHints() {
        const inputs = [$<HTMLInputElement>('#byname'), $<HTMLInputElement>('#grant-name')].filter(Boolean);
        if (!inputs.length) return;
        const setters = inputs.map(input => customCombo(input));
        const { players } = await api('players');
        setters.forEach(set => set(players));
      }

      const failed = (where: string) => (error: Error) => { const w = $('#whoami'); w.append(el('span', { className: 'error', textContent: ` ${where}: ${error.message}` })); };
      api('me').then(async (data: Me & { role: string | null }) => {
        me = data;
        const who = $('#whoami');
        if (!me.role) { who.textContent = 'У вашего аккаунта нет доступа к панели. Попросите администратора добавить вас в команду.'; return; }
        who.replaceChildren('Вы вошли как ', el('strong', { textContent: me.name }), ` — ${ROLES[me.role].name.toLowerCase()}. ${ROLES[me.role].about}`);
        document.querySelectorAll<HTMLElement>('[data-perm]').forEach(node => { node.hidden = !can(node.dataset.perm!); });
        if (!can('ban')) $('#byname-about').textContent = 'Если игрока нет в списке «Сейчас на сервере», его можно выгнать по никнейму.';
        const sections = [...document.querySelectorAll<HTMLElement>('main > section:not([hidden])')];
        const nav = $('#tabs');
        nav.replaceChildren(...sections.map(s => el('a', { href: `#${s.id}`, textContent: s.dataset.tab })));
        nav.hidden = false;
        showTab(location.hash.slice(1), false);
        const loaders: [string, () => Promise<void>, string][] = [['view', loadOverview, 'Обзор'], ['moderate', loadOnline, 'Игроки'], ['ban', loadBans, 'Забаненные'], ['settings', () => loadSettings(), 'Настройки'],
          ['roles', loadTeam, 'Команда'], ['workshop', loadCandidates, 'Кандидаты'], ['stats', loadResults, 'Статистика'], ['stats', loadSeasons, 'Сезоны'], ['stats', loadKeys, 'Ключи'], ['audit', loadAudit, 'Журнал'],
          ['moderate', loadPlayerHints, 'Подсказки игроков']];
        await Promise.all(loaders.filter(([permission]) => can(permission)).map(([, load, where]) => load().catch(failed(where))));
        setInterval(() => { if (document.visibilityState === 'visible') loadOverview().catch(() => {}); }, 15_000);
      }, (error: Error & { raw?: string }) => {
        const who = $('#whoami');
        if (/Войдите|Сессия/.test(error.raw ?? '')) who.replaceChildren('Войдите в ', el('a', { href: '/account', textContent: 'аккаунт' }), ', чтобы открыть панель управления.');
        else say(who, error.message, 'error');
      });
    </script>
  </body>
</html>
