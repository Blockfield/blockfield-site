---
import Site from '../layouts/Site.astro'
Astro.response.headers.set('Cache-Control', 'no-store')
---

<Site title="Панель управления — Blockfield" noindex>
  <main id="content" class="page-main admin-main">
    <div class="console-head">
      <div>
        <h1>Панель управления</h1>
        <p id="whoami" class="whoami" role="status">
          Проверяем доступ…
        </p>
      </div>
    </div>
    <nav id="tabs" class="tabs" aria-label="Разделы панели" hidden></nav>

    <section
      id="overview"
      data-perm="view"
      data-tab="Обзор"
      hidden
      aria-labelledby="overview-title"
    >
      <h2 id="overview-title" tabindex="-1">
        Обзор
      </h2>
      <div id="server-card" class="hero" data-tone="wait">
        <span class="dot" aria-hidden="true"></span>
        <div>
          <p class="headline" id="server-headline">
            Загружаем состояние сервера…
          </p>
          <p id="server-detail" class="muted"></p>
        </div>
      </div>
      <div class="panel" data-perm="view" aria-labelledby="mode-title">
        <div class="stack-head">
          <h3 id="mode-title">Игра и мастерская</h3>
          <p class="muted">
            Работают независимо. Смена сеанса или тест карты перезапускает мастерскую.
          </p>
        </div>
        <p class="form-status" id="mode-progress" role="status"></p>
        <div id="mode-options" class="options"></div>
        <p class="form-status" id="mode-status" role="status"></p>
      </div>
      <div class="panel" data-perm="message" aria-labelledby="message-title">
        <div class="stack-head">
          <h3 id="message-title">Сообщение мастерской</h3>
          <p class="muted">Что участники увидят при входе, пока мастерская недоступна.</p>
        </div>
        <form id="message-form" class="form-stack">
          <label for="message">Текст сообщения</label>
          <textarea
            id="message"
            name="message"
            maxlength="200"
            rows="3"
            required
            aria-describedby="message-hint"
          ></textarea>
          <small id="message-hint">
            Например: «Обновляем карты, вернёмся к 20:00». До 200 символов.
          </small>
          <div class="actions">
            <button class="primary" type="submit">
              Сохранить сообщение
            </button>
          </div>
          <p class="form-status" role="status"></p>
        </form>
      </div>
      <div class="panel" data-perm="moderate" aria-labelledby="quick-title">
        <div class="stack-head">
          <h3 id="quick-title">Быстрые действия</h3>
        </div>
        <div class="quick-group">
          <h4 id="range-title">Полигон</h4>
          <p class="muted">Площадка в лобби, где пристреливают оружие.</p>
          <div class="actions">
            <button type="button" data-range="open">
              Открыть
            </button>
            <button type="button" data-range="close">
              Закрыть
            </button>
            <button type="button" data-range="reset">
              Сбросить
            </button>
          </div>
          <p class="form-status" id="range-status" role="status"></p>
        </div>
        <div class="quick-group quick-group--warn" data-perm="maintenance">
          <h4 id="maint-title">Техработы и аварии</h4>
          <p class="muted">
            Эти действия относятся к игре. Перед техработами дождитесь конца матчей или прервите их.
          </p>
          <div class="actions">
            <button type="button" id="drain">
              Не начинать новые матчи
            </button>
            <button type="button" id="interrupt" class="danger">
              Прервать все матчи
            </button>
          </div>
          <p class="form-status" id="maint-status" role="status"></p>
        </div>
      </div>
    </section>

    <section
      id="players"
      data-perm="moderate"
      data-tab="Игроки"
      hidden
      aria-labelledby="players-title"
    >
      <h2 id="players-title" tabindex="-1">
        Игроки
      </h2>
      <div class="panel" aria-labelledby="online-title">
        <div class="stack-head stack-head--row">
          <h3 id="online-title">Сейчас на сервере</h3>
          <button type="button" id="online-refresh" class="small">
            Обновить
          </button>
        </div>
        <p id="online-summary" class="muted" role="status">
          Загружаем список…
        </p>
        <ul id="online-list" class="rows"></ul>
      </div>
      <div class="panel" aria-labelledby="say-title">
        <div class="stack-head">
          <h3 id="say-title">Объявление всем</h3>
          <p class="muted">Сообщение сразу появится в чате у всех, кто сейчас на сервере.</p>
        </div>
        <form id="say-form" class="form-stack">
          <label for="say-text">Текст объявления</label>
          <input id="say-text" name="text" maxlength="120" required autocomplete="off" />
          <div class="actions">
            <button class="primary" type="submit">
              Отправить всем
            </button>
          </div>
          <p class="form-status" role="status"></p>
        </form>
      </div>
      <div class="panel" aria-labelledby="byname-title">
        <div class="stack-head">
          <h3 id="byname-title">Найти по никнейму</h3>
          <p class="muted" id="byname-about">
            Для тех, кого сейчас нет на сервере. Начните вводить никнейм — подскажем знакомые.
          </p>
        </div>
        <form id="byname-form" class="form-stack">
          <label for="byname">Никнейм игрока</label>
          <input
            id="byname"
            name="player"
            required
            pattern="[A-Za-z0-9_]{3,16}"
            autocomplete="off"
            aria-describedby="byname-hint"
          />
          <small id="byname-hint">Точно как в игре: латинские буквы, цифры и _.</small>
          <div class="actions">
            <button type="submit" value="kick">
              Выгнать
            </button>
            <button type="submit" value="ban" data-perm="ban" class="danger">
              Забанить
            </button>
            <button type="submit" value="pardon" data-perm="ban">
              Разбанить
            </button>
          </div>
          <p class="form-status" role="status"></p>
        </form>
      </div>
      <div class="panel" data-perm="ban" aria-labelledby="bans-title">
        <div class="stack-head">
          <h3 id="bans-title">Забаненные игроки</h3>
          <p class="muted">
            Кого забанили отсюда. Если бан выдали прямо в игре, снимайте его в «Найти по никнейму».
          </p>
        </div>
        <ul id="ban-list" class="rows"></ul>
        <p class="form-status" id="ban-status" role="status"></p>
      </div>
    </section>

    <section id="matches" data-perm="view" data-tab="Матчи" hidden aria-labelledby="matches-title">
      <h2 id="matches-title" tabindex="-1">
        Матчи
      </h2>
      <p class="muted">Что сейчас идёт на сервере. Список обновляется сам.</p>
      <p class="form-status" id="room-status" role="status"></p>
      <div id="room-list" class="cards"></div>
    </section>

    <section
      id="settings"
      data-perm="settings"
      data-tab="Настройки игры"
      hidden
      aria-labelledby="settings-title"
    >
      <h2 id="settings-title" tabindex="-1">
        Настройки игры
      </h2>
      <p id="settings-state" class="banner" role="status">
        Загружаем настройки…
      </p>
      <form id="settings-form" class="form-stack">
        <details class="panel settings-group" open>
          <summary>Лобби</summary>
          <div class="fields">
            <div class="field">
              <label for="pvp">PvP в лобби</label>
              <select id="pvp" name="pvpEnabled">
                <option value="true">Включено</option>
                <option value="false">Выключено</option>
              </select>
            </div>
          </div>
          <div id="lobby-fields" class="fields"></div>
        </details>
        <details class="panel settings-group" open>
          <summary>Комнаты</summary>
          <div id="room-fields" class="fields"></div>
        </details>
        <details class="panel settings-group" open>
          <summary>Каждый сам за себя</summary>
          <div id="deathmatch-fields" class="fields"></div>
        </details>
        <details class="panel settings-group" open>
          <summary>Стоимость высадки</summary>
          <small class="muted">
            Боевые кредиты (БК) зарабатываются в бою и сбрасываются в конце матча. Цена списывается
            за каждую высадку. Изменения действуют со следующей высадки, включая текущие матчи. 0 —
            бесплатно.
          </small>
          <div id="class-costs" class="fields"></div>
          <small class="muted">
            Штурмовик и марксман всегда бесплатны. Численность команды не закрывает сильные классы.
          </small>
        </details>
        <details class="panel settings-group" open>
          <summary>Аварийное отключение классов</summary>
          <small class="muted">Кто уже играет этим классом, доиграет ещё три минуты.</small>
          <div id="class-list" class="checks"></div>
        </details>
        <details class="panel settings-group">
          <summary>Ограничения паркура</summary>
          <small class="muted">
            Какие действия паркура разрешены игрокам. Выключено — сервер сам решает по своему
            базовому файлу.
          </small>
          <label class="switch">
            <input type="checkbox" id="parcool-on" />
            Задать список действий на сайте
          </label>
          <div id="parcool-list" class="checks"></div>
        </details>
        <details class="panel settings-group">
          <summary>Баланс матчей</summary>
          <small class="muted">Новые значения подхватит следующий матч.</small>
          <div class="scope">
            <label for="scope">Для каких матчей</label>
            <select id="scope"></select>
            <small id="scope-hint"></small>
          </div>
          <div id="balance-fields"></div>
        </details>
        <div class="savebar">
          <button class="primary" type="submit" id="settings-save">
            Сохранить и применить
          </button>
          <p class="savebar__meta" id="settings-meta" role="status"></p>
          <p class="form-status" role="status"></p>
        </div>
      </form>
    </section>

    <section
      id="weapons"
      data-perm="settings"
      data-tab="Оружие"
      hidden
      aria-labelledby="weapons-title"
    >
      <h2 id="weapons-title" tabindex="-1">
        Оружие
      </h2>
      <p class="muted">
        Изменения применяются к игрокам онлайн без перезагрузки сервера. Анимации, модели, звуки и
        код скриптов остаются из клиентского пака.
      </p>
      <p id="gun-balance-status" class="form-status" role="status">
        Получаем каталог оружия…
      </p>
      <form id="gun-balance-form" class="form-stack" hidden>
        <div class="scope">
          <label for="gun-search">Найти оружие</label>
          <input id="gun-search" type="search" placeholder="Название, ID или тип оружия" />
          <label for="gun-select">Оружие</label>
          <select id="gun-select"></select>
        </div>
        <p id="gun-about" class="muted"></p>
        <p id="gun-warnings" class="form-status"></p>
        <p class="muted">
          Отметьте поле, чтобы изменить его. Снятая отметка возвращает исходное значение. Множители
          частей тела задаются отдельно для каждого оружия. Составные поля TaCZ редактируются как
          JSON; доступные вложенные поля указаны под ними.
        </p>
        <div id="gun-fields"></div>
        <div class="savebar">
          <button class="primary" type="submit">
            Применить баланс оружия
          </button>
          <button id="gun-reset" type="button">
            Сбросить это оружие
          </button>
          <button id="gun-refresh" type="button">
            Обновить каталог
          </button>
          <p class="form-status" role="status"></p>
        </div>
      </form>
    </section>

    <section id="kits" data-perm="settings" data-tab="Наборы" hidden aria-labelledby="kits-title">
      <h2 id="kits-title" tabindex="-1">
        Наборы снаряжения
      </h2>
      <p class="muted">
        Создавайте наборы и варианты, выбирайте оружие, обвесы, броню и аксессуары из каталога
        сервера. Доступ по режимам и фиксированный набор определяют, что игрок получит при следующей
        выдаче. Уже выданное снаряжение не заменяется.
      </p>
      <p id="kits-status" class="form-status" role="status">
        Получаем каталог наборов…
      </p>
      <form id="kits-form" class="form-stack" hidden>
        <div class="scope">
          <label for="kit-select">Набор</label>
          <select id="kit-select"></select>
        </div>
        <p id="kit-about" class="muted"></p>
        <div class="actions">
          <button id="kit-new" type="button">
            Создать набор
          </button>
          <button id="kit-reset" type="button">
            Вернуть стандартный набор
          </button>
          <button id="kits-refresh" type="button">
            Обновить каталог
          </button>
        </div>
        <div id="kit-fields" class="stack"></div>
        <details class="panel">
          <summary>Фиксированные наборы режимов</summary>
          <p class="muted">
            Фиксированный набор выдаётся бесплатно и убирает меню выбора. «Меню выбора» возвращает
            доступные этому режиму наборы.
          </p>
          <div id="kit-bindings" class="stack"></div>
        </details>
        <div class="savebar">
          <button type="submit" class="primary">
            Сохранить наборы
          </button>
          <p id="kits-meta" class="savebar__meta" role="status"></p>
        </div>
      </form>
    </section>

    <section id="team" data-perm="roles" data-tab="Команда" hidden aria-labelledby="team-title">
      <h2 id="team-title" tabindex="-1">
        Команда
      </h2>
      <p class="muted">
        Кто помогает вести сервер. Каждая роль умеет всё, что предыдущая, и чуть больше.
      </p>
      <dl id="role-legend" class="legend"></dl>
      <ul id="staff-list" class="rows"></ul>
      <p class="form-status" id="staff-status" role="status"></p>
      <div class="panel" aria-labelledby="grant-title">
        <div class="stack-head">
          <h3 id="grant-title">Добавить в команду</h3>
        </div>
        <form id="grant-form" class="form-stack">
          <label for="grant-name">Никнейм игрока</label>
          <input
            id="grant-name"
            name="nickname"
            required
            pattern="[A-Za-z0-9_]{3,16}"
            autocomplete="off"
            aria-describedby="grant-hint"
          />
          <small id="grant-hint">
            Начните вводить — подскажем тех, кто уже играл. Нужен аккаунт Blockfield.
          </small>
          <fieldset class="plain">
            <legend>Роль</legend>
            <div id="grant-roles" class="radios"></div>
          </fieldset>
          <div class="actions">
            <button class="primary" type="submit">
              Добавить в команду
            </button>
          </div>
          <p class="form-status" role="status"></p>
        </form>
      </div>
    </section>

    <section
      id="workshop"
      data-perm="view"
      data-tab="Мастерская"
      hidden
      aria-labelledby="workshop-title"
    >
      <h2 id="workshop-title" tabindex="-1">
        Мастерская
      </h2>
      <p class="muted">
        Кто какие карты правит. Модераторы и администраторы правят все карты, строителям доступ
        выдаётся по картам. В игре строители переходят между картами планшетом (M).
      </p>
      <p id="editor-state" class="form-status" role="status">
        Проверяем состояние мастерской…
      </p>
      <details class="disclosure" data-perm="settings">
        <summary>Бюджет AI</summary>
        <p class="muted">
          Общий бюджет текущего сеанса или отдельный для участника. Настраивают только
          администраторы сайта; владение картой или сеансом не даёт дополнительных прав.
        </p>
        <p id="ai-budget-status" class="form-status" role="status">
          Получаем политику бюджета…
        </p>
        <div id="ai-budget-form"></div>
        <button id="ai-budget-refresh" type="button" class="small">
          Обновить состояние бюджета
        </button>
      </details>
      <div class="stack" data-perm="mode" aria-labelledby="map-create-title">
        <h3 id="map-create-title">Новая карта</h3>
        <p class="muted">
          Пустой мир и отдельная рабочая ветка. Мастерская сохранит текущий черновик и откроет новую
          карту; игра продолжит работать. Стройте и размечайте карту планшетом (M), затем сохраните
          коммит и отправьте его на проверку.
        </p>
        <div id="map-create-controls"></div>
        <p id="map-create-status" class="form-status" role="status"></p>
      </div>
      <div class="stack" aria-labelledby="candidates-title">
        <div class="stack-head">
          <h3 id="candidates-title">Карты на проверке</h3>
          <p class="muted">
            Сначала зафиксируйте изменения в ветке, затем отправьте коммит на проверку. Новые правки
            в мире в эту проверку не входят. Администратор сравнивает версии и сливает изменения в
            main. Уже начатые матчи сохраняют свою копию.
          </p>
        </div>
        <p class="form-status" id="candidates-status" role="status"></p>
        <ul id="candidate-list" class="rows"></ul>
      </div>
      <div class="stack" aria-labelledby="map-history-title">
        <div class="stack-head">
          <h3 id="map-history-title">Ветки и история карт</h3>
          <p class="muted">
            main — версия для игры. Рабочие ветки и коммиты сохраняются отдельно. Восстановление
            старой карты создаёт новый коммит и сохраняет всю историю.
          </p>
          <button id="maps-refresh" class="small" type="button">
            Обновить историю
          </button>
        </div>
        <p id="map-history-status" class="form-status" role="status">
          Получаем историю…
        </p>
        <div id="map-history"></div>
      </div>
      <div class="stack" aria-labelledby="map-drafts-title">
        <h3 id="map-drafts-title">Сохранённые черновики</h3>
        <p class="muted">
          При смене ветки прежние рабочие копии сохраняются. Модератор может открыть их снова.
        </p>
        <p id="map-drafts-status" class="form-status" role="status"></p>
        <ul id="map-drafts" class="rows"></ul>
        <button id="map-drafts-more" class="small" type="button" hidden>
          Показать ещё
        </button>
      </div>
      <div class="stack" data-perm="workshop" aria-labelledby="map-access-title">
        <div class="stack-head">
          <h3 id="map-access-title">Кто строит</h3>
        </div>
        <p class="form-status" id="map-access-status" role="status"></p>
        <ul id="map-access" class="rows"></ul>
      </div>
      <div class="stack" data-perm="workshop" aria-labelledby="ws-title">
        <div class="stack-head">
          <h3 id="ws-title">Доступ в мастерскую</h3>
          <p id="workshop-state" class="muted">
            Проверяем список…
          </p>
          <button type="button" id="sync">
            Обновить доступ
          </button>
        </div>
        <p class="form-status" id="sync-status" role="status"></p>
      </div>
    </section>

    <section
      id="stats"
      data-perm="stats"
      data-tab="Статистика"
      hidden
      aria-labelledby="stats-title"
    >
      <h2 id="stats-title" tabindex="-1">
        Статистика
      </h2>
      <p class="muted">
        Матчи, которые попали в лидерборд. Время UTC. Нечестный или сломанный матч можно убрать из
        статистики — и вернуть обратно, если передумаете.
      </p>
      <div class="scope">
        <label for="result-mode">Показать</label>
        <select id="result-mode">
          <option value="">Все матчи</option>
          <option value="campaign">Ranked-кампании</option>
          <option value="room">Обычные бои</option>
          <option value="deathmatch">Каждый сам за себя</option>
        </select>
      </div>
      <p class="form-status" id="result-status" role="status"></p>
      <ul id="result-list" class="rows"></ul>
      <div class="actions pager">
        <button type="button" id="prev" class="small">
          ← Новее
        </button>
        <span id="page" class="muted"></span>
        <button type="button" id="next" class="small">
          Старее →
        </button>
      </div>
      <h3>Сезоны</h3>
      <ul id="season-list" class="plain-list"></ul>
      <details class="disclosure">
        <summary>Ключи для игровых серверов</summary>
        <p class="muted">
          Игровой сервер отправляет результаты матчей с секретным ключом. Заведите ключ, когда
          подключаете новый сервер, и отзовите, если он мог утечь. Ключ показывается один раз.
        </p>
        <form id="key-form" class="form-stack">
          <label for="key-server">ID игрового сервера</label>
          <input
            id="key-server"
            name="serverId"
