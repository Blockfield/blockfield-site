  <script>
    import {
      BALANCE_DEFAULTS,
      BALANCE_GROUPS,
      BALANCE_LABELS,
      BALANCE_SCOPES,
      CLASS_COSTS,
      CLASS_NAMES,
      KIT_GUNS,
      MAP_NAMES,
      MODE_NAMES,
      PARCOOL_ACTIONS,
      PARCOOL_FILE_DEFAULT,
      WORKSHOP_PLACES,
      TEAM_NAMES,
    } from '../lib/game-names'
    import { settingsBody, settingsReceipt } from '../lib/settings-form'
    import { customSelect, customCombo } from '../lib/custom-select'
    import { switchView } from '../lib/switch-status'
    import { dangerousCommand } from '../lib/console'
    import type {
      GunBalanceCatalog,
      GunDefinition,
      GunField,
      GunOverrides,
    } from '../lib/gun-balance'
    import type { MapCatalogEntry, MapSession } from '../lib/admin'

    type Me = { name: string; role: string | null; permissions: string[] }
    const $ = <T extends HTMLElement = HTMLElement>(selector: string) =>
      document.querySelector<T>(selector)!
    const ROLES: Record<string, { name: string; about: string }> = {
      builder: {
        name: 'Строитель',
        about: 'Делает карты в мастерской. В панели только смотрит, что происходит на сервере.',
      },
      moderator: {
        name: 'Модератор',
        about:
          'Следит за порядком в игре: может выгнать, объявить что-то всем и завершить зависший матч.',
      },
      admin: {
        name: 'Администратор',
        about:
          'Отвечает за сервер целиком: баны, настройки игры, честность статистики и состав команды.',
      },
      owner: {
        name: 'Владелец',
        about:
          'Полный доступ, включая назначение администраторов. Владельцы задаются в настройках сервера.',
      },
    }
    const PHASES: Record<string, string> = {
      IDLE: 'Ждёт игроков',
      VOTING: 'Голосование за карту',
      PREPARING: 'Подготовка к бою',
      GAME: 'Идёт бой',
      MATCH_END: 'Подведение итогов',
    }
    const OUTCOMES: [string, string, string][] = [
      ['draw', 'Ничья', 'Никто не побеждает.'],
      ['RED', 'Победа красных', ''],
      ['BLUE', 'Победа синих', ''],
      ['none', 'Без итога', 'Матч просто останавливается, победитель не записывается.'],
    ]
    let me: Me
    const can = (permission: string) => me.permissions.includes(permission)

    // The whole site shows times in UTC (leaderboard and player pages too), always labelled.
    const dateFormat = new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'long',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'UTC',
    })
    const relative = new Intl.RelativeTimeFormat('ru', { numeric: 'auto' })
    const date = (ms: number) => `${dateFormat.format(ms)} UTC`
    function ago(ms: number) {
      const seconds = (ms - Date.now()) / 1000
      for (const [unit, size] of [
        ['year', 31536000],
        ['month', 2592000],
        ['week', 604800],
        ['day', 86400],
        ['hour', 3600],
        ['minute', 60],
      ] as const)
        if (Math.abs(seconds) >= size) return relative.format(Math.round(seconds / size), unit)
      return 'только что'
    }
    const number = (n: number) => n.toLocaleString('ru-RU')

    /** Server errors are mostly Russian already; technical or English ones are replaced with plain words. */
    function friendly(message: string | undefined, status: number) {
      const rules: [RegExp, string][] = [
        [
          /^Сервер не принял команду/,
          'Игровой сервер не выполнил действие. Возможно, игрок уже вышел или матч уже закончился.',
        ],
        [/^(Недостаточно прав|Нет доступа)/, 'У вашей роли нет прав на это действие.'],
        [
          /^RCON не настроен/,
          'Управление игровым сервером с сайта не настроено. Сообщите владельцу.',
        ],
        [/already voided/, 'Этот матч уже не учитывается. Обновите страницу.'],
        [/is not voided/, 'Этот матч уже учитывается. Обновите страницу.'],
        [/Result not found/, 'Матч не найден. Обновите страницу.'],
        [/^Нет ревизии/, 'Состояние сервера изменилось. Обновите страницу и попробуйте снова.'],
        [/Участник не найден/, 'Этого участника уже нет в команде. Обновите страницу.'],
      ]
      if (!message)
        return status >= 500
          ? 'Сайт сейчас не отвечает. Попробуйте через минуту.'
          : 'Не получилось. Обновите страницу и попробуйте ещё раз.'
      const rule = rules.find(([pattern]) => pattern.test(message))
      if (rule) return rule[1]
      return /[а-яё]/i.test(message)
        ? message
        : 'Что-то пошло не так. Обновите страницу и попробуйте ещё раз.'
    }
    async function api(path: string, method = 'GET', body?: unknown) {
      // Content-Type is sent even without a body: Astro's origin check rejects bodiless non-GET requests behind the proxy.
      const response = await fetch(`/api/admin/${path}`, {
        method,
        cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body),
      }).catch(() => null)
      if (!response) throw new Error('Нет связи с сайтом. Проверьте интернет и попробуйте ещё раз.')
      const data = await response.json().catch(() => null)
      if (method !== 'GET' && can('audit')) loadAudit().catch(() => {})
      if (!response.ok)
        throw Object.assign(new Error(friendly(data?.error, response.status)), {
          raw: data?.error ?? '',
        })
      return data
    }
    function el<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      props: Record<string, any> = {},
      ...children: (Node | string | null | undefined | false)[]
    ) {
      const node = document.createElement(tag)
      for (const [key, value] of Object.entries(props)) {
        if (key.startsWith('aria') || key.startsWith('data') || key === 'role' || key === 'for')
          node.setAttribute(
            key
              .replace(/^aria([A-Z])/, (_, c) => `aria-${c.toLowerCase()}`)
              .replace(/^data([A-Z])/, (_, c) => `data-${c.toLowerCase()}`),
            String(value),
          )
        else (node as any)[key] = value
      }
      node.append(
        ...children.filter((c): c is Node | string => c !== null && c !== undefined && c !== false),
      )
      return node
    }
    const button = (text: string, onclick: () => void, className = 'small', label?: string) =>
      el('button', {
        type: 'button',
        className,
        textContent: text,
        onclick,
        ...(label ? { ariaLabel: label } : {}),
      })
    function say(line: HTMLElement, text: string, tone: 'ok' | 'error' | 'pending' = 'ok') {
      line.textContent = text
      line.classList.remove('ok', 'error', 'pending')
      line.classList.add(tone)
    }
    /** Runs an action with its buttons disabled and reports progress, success or a friendly error on `line`. */
    async function run(
      line: HTMLElement,
      action: () => Promise<string | void>,
      scope: HTMLElement | null = null,
    ) {
      const buttons = scope ? [...scope.querySelectorAll('button')].filter((b) => !b.disabled) : []
      buttons.forEach((b) => (b.disabled = true))
      say(line, 'Выполняем…', 'pending')
      try {
        const text = await action()
        if (text) say(line, text)
        else line.textContent = ''
      } catch (error) {
        say(line, (error as Error).message, 'error')
      } finally {
        buttons.forEach((b) => (b.disabled = false))
      }
    }

    // Accessible confirmation: native <dialog> traps focus, Escape cancels, focus returns to the opener.
    const dialog = $<HTMLDialogElement>('#dialog')
    function ask({
      title,
      text,
      ok,
      danger = false,
      fields = [],
    }: {
      title: string
      text: string
      ok: string
      danger?: boolean
      fields?: Node[]
    }): Promise<FormData | null> {
      const opener = document.activeElement as HTMLElement | null
      $('#dialog-title').textContent = title
      $('#dialog-text').textContent = text
      $('#dialog-fields').replaceChildren(...fields)
      Object.assign($('#dialog-ok'), {
        textContent: ok,
        className: danger ? 'primary danger' : 'primary',
      })
      dialog.returnValue = ''
      dialog.showModal()
      return new Promise((resolve) =>
        dialog.addEventListener(
          'close',
          () => {
            const form = dialog.querySelector('form')!
            resolve(dialog.returnValue === 'ok' ? new FormData(form) : null)
            opener?.focus()
          },
          { once: true },
        ),
      )
    }
    let fieldId = 0
    function field(label: string, input: HTMLElement, hint?: string, wrap?: HTMLElement) {
      const id = `f${++fieldId}`
      input.id = id
      if (hint) input.setAttribute('aria-describedby', `${id}-hint`)
      return el(
        'div',
        { className: 'field' },
        el('label', { for: id, textContent: label }),
        wrap ?? input,
        hint ? el('small', { id: `${id}-hint`, textContent: hint }) : null,
      )
    }
    const reasonField = (label = 'Причина (игрок её увидит)', required = false) =>
      field(
        label,
        el('input', { name: 'reason', maxLength: 120, required, autocomplete: 'off' }),
        required ? undefined : 'Необязательно.',
      )

    /**
     * Controller requests are applied by the host within ~15 s; poll its result file for up to a minute.
     * `onError`, when given, sees the raw error text first and may handle it itself (return true) instead of the generic message.
     */
    async function follow(
      line: HTMLElement,
      id: string,
      done: string,
      onError?: (error: string) => Promise<boolean> | boolean,
    ) {
      say(line, 'Запрос отправлен. Сервер применит его в течение 15 секунд…', 'pending')
      for (let i = 0; i < 30; i++) {
        await new Promise((r) => setTimeout(r, 2000))
        const { result } = await api(`request?id=${id}`).catch(() => ({ result: null }))
        if (result) {
          if (result.ok) say(line, done)
          else if (!(await onError?.(String(result.error))))
            say(
              line,
              /revision/i.test(String(result.error))
                ? 'Состояние сервера успело измениться. Обновите страницу и попробуйте снова.'
                : 'Сервер не смог выполнить запрос. Попробуйте ещё раз или сообщите владельцу.',
              'error',
            )
          loadOverview()
          return
        }
      }
      say(
        line,
        'Сервер не ответил за минуту. Возможно, управляющая программа выключена — проверьте состояние позже.',
        'error',
      )
    }

    // ---------- Overview and matches ----------
    let controller: any = null
    let session: any = null
    /** since/deadline are ms timestamps; ago() naturally reads a future one as "через …" and a past one as "… назад". */
    function timing(view: ReturnType<typeof switchView>): string {
      return [
        typeof view.since === 'number' ? `началось ${ago(view.since)}` : null,
        typeof view.deadline === 'number' ? `автоматический откат ${ago(view.deadline)}` : null,
      ]
        .filter(Boolean)
        .join(' · ')
    }
    /** «Мастерская»/«Тестовый матч» status: who started the session, when, and which maps it covers. */
    function sessionLine(current: any): string | null {
      if (!current) return null
      const maps = current.maps
        ? current.maps.map((id: string) => MAP_NAMES[id] ?? id).join(', ')
        : 'все карты'
      return `Сеанс: ${maps} · начал ${current.startedBy?.name ?? '?'} ${ago(current.startedAt)}.`
    }
    function describe(
      state: any,
      rooms: any,
      current: any,
      testCandidate: any,
    ): { tone: string; title: string; detail: string } {
      const matches = rooms.rooms?.length ?? 0
      const counts = [
        typeof rooms.online === 'number' ? `Игроков онлайн: ${rooms.online}` : null,
        rooms.available ? `Идёт матчей: ${matches}` : null,
      ]
        .filter(Boolean)
        .join(' · ')
      const target =
        state?.desired?.profile === 'workshop'
          ? 'мастерскую'
          : state?.desired?.profile === 'test'
            ? 'тестовый режим'
            : 'игровой режим'
      const view = switchView(state),
        when = timing(view)
      switch (state?.phase) {
        case 'workshop':
          return {
            tone: 'warn',
            title: 'Открыта мастерская',
            detail: [
              sessionLine(current),
              'Заходить могут только участники команды. Обычные игроки видят сообщение о техработах.',
            ]
              .filter(Boolean)
              .join(' '),
          }
        case 'test': {
          const name = testCandidate
            ? (WORKSHOP_PLACES[testCandidate.mapId] ?? testCandidate.mapId)
            : 'карта'
          const who = testCandidate?.author?.name
            ? ` (кандидат от ${testCandidate.author.name}, ${ago(testCandidate.createdAt)})`
            : ''
          return {
            tone: 'warn',
            title: `Тестовый матч: ${name}${who}`,
            detail: [sessionLine(current), 'Заходить могут только тестеры.']
              .filter(Boolean)
              .join(' '),
          }
        }
        case 'DRAINING':
          return {
            tone: 'warn',
            title: 'Готовимся к мастерской',
            detail: [
              `${view.step}: новые матчи не начинаются, сервер ждёт, пока закончатся идущие.`,
              counts,
              when,
            ]
              .filter(Boolean)
              .join(' · '),
          }
        case 'REQUESTED':
        case 'SAVING':
        case 'STARTING':
          return {
            tone: 'warn',
            title: `Сервер переключается в ${target}`,
            detail:
              [`${view.step}.`, when].filter(Boolean).join(' · ') || 'Игроки пока не могут зайти.',
          }
        case 'ERROR':
          return {
            tone: 'bad',
            title: 'Вход закрыт из-за ошибки',
            detail: [
              view.errorMessage ? `Причина: ${view.errorMessage}.` : null,
              can('recover')
                ? 'Игроки не могут зайти. Восстановите игровой режим в карточке «Режим сервера».'
                : 'Игроки не могут зайти. Сообщите администратору.',
            ]
              .filter(Boolean)
              .join(' '),
          }
      }
      if (rooms.maintenance)
        return { tone: 'warn', title: 'Вход на сервер закрыт', detail: rooms.maintenance.message }
      if (rooms.available) return { tone: 'ok', title: 'Сервер работает', detail: counts }
      return {
        tone: 'bad',
        title: 'Игровой сервер не отвечает',
        detail: rooms.lobby
          ? 'Лобби работает, но матчи сейчас недоступны.'
          : 'Игроки сейчас не могут зайти.',
      }
    }
    async function loadOverview() {
      const { status: state, session: sessionData, rooms } = await api('overview')
      controller = state
      session = sessionData
      // The candidate behind a running test match: same source the candidates card reads, "view" permission covers it.
      const testCandidate =
        state?.phase === 'test' && state?.desired?.candidate
          ? ((await api('candidates').catch(() => ({ candidates: [] }))).candidates?.find(
              (c: any) => c.sha256 === state.desired.candidate,
            ) ?? null)
          : null
      const view = describe(state, rooms, session, testCandidate)
      $('#server-card').dataset.tone = view.tone
      $('#server-headline').textContent = view.title
      $('#server-detail').textContent = [
        view.detail,
        `проверено ${ago(rooms.checkedAt || Date.now())}`,
      ]
        .filter(Boolean)
        .join(' · ')
      const message = $<HTMLTextAreaElement>('#message')
      if (!message.value && rooms.maintenance?.message && document.activeElement !== message)
        message.value = rooms.maintenance.message
      renderModes()
      renderRooms(rooms)
      // The candidates card's «Тест» button depends on the phase just learned above; keep it in sync (cheap local read).
      if (can('workshop')) loadCandidates().catch(() => {})
    }

    const MODES = [
      { id: 'game', title: 'Игра', about: 'Обычный режим: все игроки заходят и играют матчи.' },
      {
        id: 'workshop',
        title: 'Мастерская',
        about: 'Сервер для строителей карт. Обычные игроки зайти не смогут.',
      },
    ]
    /** Empty text collapses per the status-line convention; busy wins over an error, which wins over a stale rollback notice. */
    function renderProgress(view: ReturnType<typeof switchView>) {
      const line = $('#mode-progress')
      if (view.busy) say(line, [view.step, timing(view)].filter(Boolean).join(' · '), 'pending')
      else if (view.errorMessage) say(line, `Причина: ${view.errorMessage}.`, 'error')
      else if (view.notice) say(line, view.notice, 'error')
      else say(line, '')
    }
    function renderModes() {
      const box = $('#mode-options')
      if (!controller || controller.phase === 'UNINITIALIZED') {
        box.replaceChildren(
          el('p', {
            className: 'muted',
            textContent:
              'Переключение режимов недоступно: управляющая программа сервера ещё не сообщила своё состояние.',
          }),
        )
        say($('#mode-progress'), '')
        return
      }
      const view = switchView(controller)
      renderProgress(view)
      // "test" is not a switchable target from here (only from a candidate's «Тест»), so it gets its own box instead of a MODES entry.
      if (controller.phase === 'test' && !view.busy) {
        box.replaceChildren(
          el(
            'div',
            { className: 'option', dataCurrent: '' },
            el(
              'div',
              { className: 'option-head' },
              'Тестовый матч',
              el('span', { className: 'badge ok', textContent: 'Включено сейчас' }),
            ),
            el('p', {
              textContent: 'Закрытый тест версии карты. Обычные игроки зайти не смогут.',
            }),
            can('mode') ? button('Вернуться в мастерскую', resumeWorkshop, 'small') : null,
            can('mode')
              ? button('Вернуть игровой режим', () => switchMode('game', false), 'small danger')
              : null,
          ),
        )
        return
      }
      const busy = view.busy,
        broken = controller.phase === 'ERROR'
      const target = controller.desired?.profile
      box.replaceChildren(
        ...MODES.map((mode) => {
          const current = !busy && !broken && controller.phase === mode.id,
            pending = busy && target === mode.id
          const head = el(
            'div',
            { className: 'option-head' },
            mode.title,
            current
              ? el('span', { className: 'badge ok', textContent: 'Включено сейчас' })
              : pending
                ? el('span', { className: 'badge warn', textContent: 'Переключается…' })
                : null,
          )
          const option = el(
            'div',
            { className: 'option', ...(current ? { dataCurrent: '' } : {}) },
            head,
            el('p', { textContent: mode.about }),
          )
          if (!current && !pending && !broken)
            option.append(
              button(
                mode.id === 'game' ? 'Вернуть игровой режим' : 'Включить мастерскую',
                () => (mode.id === 'workshop' ? startWorkshop() : switchMode('game', false)),
                'small',
                undefined,
              ),
            )
          if (busy && !pending)
            option.lastElementChild instanceof HTMLButtonElement &&
              ((option.lastElementChild as HTMLButtonElement).disabled = true)
          if (pending && view.canCancel && can('mode'))
            option.append(button('Отменить переключение', cancelSwitch, 'small danger'))
          if (broken && mode.id === 'game' && can('recover'))
            option.append(
              button('Восстановить игровой режим', () => switchMode('game', true), 'small primary'),
            )
          return option
        }),
      )
    }
    async function cancelSwitch() {
      if (
        !(await ask({
          title: 'Отменить переключение?',
          text: 'Сервер вернётся в тот режим, в котором был до переключения. Отменить можно только пока идёт переключение — позже потребуется восстановление вручную.',
          ok: 'Отменить переключение',
          danger: true,
        }))
      )
        return
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('cancel', 'POST', {})
          follow(line, id, 'Переключение отменено, сервер возвращается в прежний режим.')
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
        },
        $('#mode-options'),
      )
    }
    async function switchMode(profile: 'game', recover: boolean) {
      const texts = recover
        ? {
            title: 'Восстановить игровой режим?',
            text: 'Сервер остановит всё, что сейчас запущено, и заново запустит игру. Используйте это, если сервер застрял в ошибке.',
            ok: 'Восстановить',
          }
        : {
            title: 'Вернуть игровой режим?',
            text: 'Мастерская закроется, строители будут отключены. Сервер перезапустится для всех игроков, обычно это занимает несколько минут.',
            ok: 'Вернуть игровой режим',
          }
      if (!(await ask({ ...texts, danger: true }))) return
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('mode', 'POST', {
            profile,
            expectedRevision: controller.revision,
            ...(recover ? { recover } : {}),
          })
          follow(line, id, 'Сервер принял запрос: запускаем игровой режим.')
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
        },
        $('#mode-options'),
      )
    }
    /** «Включить мастерскую»: which maps for a fresh session, or resume the previous one as-is. */
    async function startWorkshop() {
      const known = mapScopes()
      const checks = el(
        'div',
        { className: 'checks' },
        ...known.map((id) =>
          el(
            'label',
            { className: 'check' },
            el('input', { type: 'checkbox', name: 'map', value: id, checked: true }),
            mapName(id),
          ),
        ),
      )
      const all = el('input', { type: 'checkbox', checked: true }) as HTMLInputElement
      all.addEventListener('change', () =>
        checks
          .querySelectorAll('input')
          .forEach((i) => ((i as HTMLInputElement).checked = all.checked)),
      )
      const mapsBlock = el('div', {}, el('label', { className: 'check' }, all, 'Все карты'), checks)
      const fields: Node[] = []
      if (session) {
        const label = session.maps
          ? session.maps.map((id: string) => MAP_NAMES[id] ?? id).join(', ')
          : 'все карты'
        const resume = el('input', {
          type: 'radio',
          name: 'session',
          value: 'resume',
          checked: true,
        }) as HTMLInputElement
        const fresh = el('input', {
          type: 'radio',
          name: 'session',
          value: 'new',
        }) as HTMLInputElement
        const toggle = () =>
          mapsBlock
            .querySelectorAll('input')
            .forEach((i) => ((i as HTMLInputElement).disabled = !fresh.checked))
        resume.addEventListener('change', toggle)
        fresh.addEventListener('change', toggle)
        toggle()
        fields.push(
          el(
            'fieldset',
            { className: 'plain' },
            el('legend', { textContent: 'Сеанс' }),
            el(
              'label',
              { className: 'radio' },
              resume,
              el('span', {}, `Продолжить прошлый сеанс (${date(session.startedAt)}, ${label})`),
            ),
            el('label', { className: 'radio' }, fresh, 'Новый сеанс'),
          ),
        )
      }
      fields.push(mapsBlock)
      const answer = await ask({
        title: 'Включить мастерскую?',
        text: 'Новые матчи перестанут начинаться. Когда закончатся идущие (это может занять целую кампанию), сервер сохранит мир и перезапустится в мастерскую. Пока она открыта, обычные игроки не смогут зайти.',
        ok: 'Включить мастерскую',
        danger: true,
        fields,
      })
      if (!answer) return
      const resuming = !!session && answer.get('session') !== 'new'
      const ids = answer.getAll('map').map(String)
      const body: Record<string, unknown> = {
        profile: 'workshop',
        expectedRevision: controller.revision,
        session: resuming ? 'resume' : 'new',
        ...(resuming ? {} : { maps: ids.length === known.length ? null : ids }),
      }
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('mode', 'POST', body)
          follow(line, id, 'Сервер принял запрос: переключение в мастерскую началось.')
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
        },
        $('#mode-options'),
      )
    }
    async function resumeWorkshop() {
      if (
        !(await ask({
          title: 'Вернуться в мастерскую?',
          text: 'Тестовый матч остановится, сервер вернётся в мастерскую с тем же сеансом.',
          ok: 'Вернуться в мастерскую',
        }))
      )
        return
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('mode', 'POST', {
            profile: 'workshop',
            expectedRevision: controller.revision,
            session: 'resume',
          })
          follow(line, id, 'Сервер принял запрос: возвращаемся в мастерскую.')
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
        },
        $('#mode-options'),
      )
    }

    function renderRooms(rooms: any) {
      const list = $('#room-list')
      if (!rooms.available) {
        list.replaceChildren(
          el('p', {
            className: 'empty',
            textContent: rooms.maintenance
              ? 'Вход на сервер закрыт — матчей сейчас нет.'
              : 'Игровой сервер не отвечает, список матчей недоступен.',
          }),
        )
        return
      }
      if (!rooms.rooms.length) {
        list.replaceChildren(
          el('p', { className: 'empty', textContent: 'Сейчас не идёт ни одного матча.' }),
        )
        return
      }
      list.replaceChildren(
        ...rooms.rooms.map((room: any) => {
          const facts: [string, string][] = [
            ['Карта', room.map || 'выбирается'],
            ['Режим', room.mode],
            ['Сейчас', PHASES[room.phase] ?? 'Идёт'],
            ['Игроков', String(room.players)],
          ]
          if (room.battle)
            facts.push(['Тикеты', `красные ${room.battle.red} · синие ${room.battle.blue}`])
          const card = el(
            'article',
            { className: 'card room', ariaLabel: room.name },
            el(
              'div',
              { className: 'card-head' },
              el('h3', { textContent: room.name }),
              el('span', {
                className: `badge ${room.joinable ? 'ok' : ''}`,
                textContent: room.joinable ? 'Можно зайти' : 'Набор закрыт',
              }),
            ),
            el(
              'dl',
              { className: 'facts' },
              ...facts.flatMap(([k, v]) => [
                el('dt', { textContent: k }),
                el('dd', { textContent: v }),
              ]),
            ),
          )
          if (can('moderate'))
            card.append(
              button(
                'Завершить матч',
                () => stopRoom(room),
                'danger',
                `Завершить матч «${room.name}»`,
              ),
            )
          return card
        }),
      )
    }
    async function stopRoom(room: any) {
      const radios = el(
        'fieldset',
        { className: 'plain' },
        el('legend', { textContent: 'Чем закончить матч' }),
        el(
          'div',
          { className: 'radios' },
          ...OUTCOMES.map(([value, label, about], i) =>
            el(
              'label',
              { className: 'radio' },
              el('input', {
                type: 'radio',
                name: 'outcome',
                value,
                required: true,
                checked: i === 0,
              }),
              el('span', {}, label, about ? el('small', { textContent: about }) : null),
            ),
          ),
        ),
      )
      const answer = await ask({
        title: `Завершить матч «${room.name}»?`,
        text: 'Все игроки вернутся в лобби. Итог попадёт в статистику.',
        ok: 'Завершить матч',
        danger: true,
        fields: [radios, reasonField('Причина (увидят игроки)')],
      })
      if (!answer) return
      const outcome = String(answer.get('outcome')),
        reason = String(answer.get('reason') ?? '')
      run($('#room-status'), async () => {
        await api('rcon', 'POST', {
          action: 'stop-room',
          roomId: room.id,
          outcome,
          reason: outcome === 'none' && /^(win|draw)\b/i.test(reason) ? `— ${reason}` : reason,
        })
        loadOverview()
        return `Матч «${room.name}» завершён.`
      })
    }

    // ---------- Players ----------
    const PLAYER_ACTIONS: Record<
      string,
      {
        ok: string
        title: (p: string) => string
        text: (p: string) => string
        done: (p: string) => string
        reason: boolean
      }
    > = {
      kick: {
        ok: 'Выгнать',
        title: (p) => `Выгнать ${p}?`,
        text: (p) => `${p} будет отключён от сервера, но сможет сразу зайти снова.`,
        done: (p) => `${p} выгнан с сервера.`,
        reason: true,
      },
      'team-kick': {
        ok: 'Убрать из матча',
        title: (p) => `Убрать ${p} из матча?`,
        text: (p) => `${p} покинет команду в текущем матче. С сервера его не выгонит.`,
        done: (p) => `${p} убран из матча.`,
        reason: false,
      },
      ban: {
        ok: 'Забанить',
        title: (p) => `Забанить ${p}?`,
        text: (p) => `${p} будет отключён и не сможет зайти на сервер, пока его не разбанят.`,
        done: (p) => `${p} забанен.`,
        reason: true,
      },
      pardon: {
        ok: 'Разбанить',
        title: (p) => `Разбанить ${p}?`,
        text: (p) => `${p} снова сможет заходить на сервер.`,
        done: (p) => `${p} разбанен.`,
        reason: false,
      },
    }
    async function playerAction(action: string, player: string, line: HTMLElement) {
      const spec = PLAYER_ACTIONS[action]
      const answer = await ask({
        title: spec.title(player),
        text: spec.text(player),
        ok: spec.ok,
        danger: action !== 'pardon',
        fields: spec.reason ? [reasonField()] : [],
      })
      if (!answer) return
      await run(line, async () => {
        await api('rcon', 'POST', { action, player, reason: String(answer.get('reason') ?? '') })
        if (action === 'ban' || action === 'pardon') loadBans()
        if (action !== 'pardon') setTimeout(loadOnline, 1000)
        return spec.done(player)
      })
    }
    async function loadOnline() {
      const summary = $('#online-summary')
      try {
        const { players } = await api('rcon', 'POST', { action: 'list' })
        summary.className = 'muted'
        summary.textContent = players.length
          ? `Игроков на сервере: ${players.length}.`
          : 'Сейчас на сервере никого нет.'
        $('#online-list').replaceChildren(
          ...players.map((name: string) =>
            el(
              'li',
              { className: 'row' },
              el('div', { className: 'row-main' }, el('strong', { textContent: name })),
              el(
                'div',
                { className: 'actions' },
                button(
                  'Выгнать',
                  () => playerAction('kick', name, summary),
                  'small',
                  `Выгнать ${name}`,
                ),
                button(
                  'Убрать из матча',
                  () => playerAction('team-kick', name, summary),
                  'small',
                  `Убрать ${name} из матча`,
                ),
                can('ban')
                  ? button(
                      'Забанить',
                      () => playerAction('ban', name, summary),
                      'small danger',
                      `Забанить ${name}`,
                    )
                  : null,
              ),
            ),
          ),
        )
      } catch (error) {
        say(summary, (error as Error).message, 'error')
        $('#online-list').replaceChildren()
      }
    }
    async function loadBans() {
      const { bans } = await api('bans')
      $('#ban-list').replaceChildren(
        ...(bans.length
          ? bans.map((b: any) =>
              el(
                'li',
                { className: 'row' },
                el(
                  'div',
                  { className: 'row-main' },
                  el('strong', { textContent: b.player }),
                  el('small', {
                    textContent: `Забанил ${b.by} ${ago(b.at)}${b.reason ? ` · причина: «${b.reason}»` : ''}`,
                  }),
                ),
                button(
                  'Разбанить',
                  () => playerAction('pardon', b.player, $('#ban-status')),
                  'small',
                  `Разбанить ${b.player}`,
                ),
              ),
            )
          : [el('li', { className: 'empty', textContent: 'Никто не забанен.' })]),
      )
    }

    // ---------- Settings ----------
    const GUN_LABELS: Record<string, string> = {
      ammo: 'Боеприпас',
      ammo_amount: 'Вместимость магазина',
      extended_mag_ammo_amount: 'Расширенные магазины',
      can_crawl: 'Стрельба ползком',
      can_slide: 'Стрельба в подкате',
      bolt: 'Затвор',
      rpm: 'Выстрелов в минуту',
      bullet: 'Пуля и урон',
      draw_time: 'Доставание, секунды',
      put_away_time: 'Убирание, секунды',
      sprint_time: 'Выход из спринта, секунды',
      aim_time: 'Прицеливание, секунды',
      bolt_action_time: 'Работа затвора, секунды',
      bolt_feed_time: 'Подача патрона, секунды',
      fire_sound: 'Дальность звука выстрела',
      reload: 'Перезарядка',
      fire_mode: 'Режимы огня',
      fire_mode_adjust: 'Настройки режимов огня',
      burst_data: 'Очередь',
      crawl_recoil_multiplier: 'Множитель отдачи ползком',
      recoil: 'Отдача',
      hurt_bob_tweak_multiplier: 'Множитель качания при уроне',
      inaccuracy: 'Разброс',
      movement_speed: 'Скорость движения',
      melee: 'Ближний бой',
      heat: 'Нагрев',
      allow_attachment_types: 'Типы обвесов',
      exclusive_attachments: 'Разрешённые обвесы',
      weight: 'Вес',
      builtin_attachments: 'Встроенные обвесы',
      script: 'ID скрипта',
      script_param: 'Параметры скрипта',
      charging: 'Зарядка',
    }
    let gunCatalog: GunBalanceCatalog | undefined,
      gunOverrides: GunOverrides = {},
      gunRevision = 0
    let selectedGun: GunDefinition | undefined
    const gunReaders = new Map<string, () => unknown>()
    const gunText = (value: unknown) => JSON.stringify(value, null, 2) ?? 'null'
    function gunValues(base: any, overrides: any): any {
      if (
        !base ||
        !overrides ||
        typeof base !== 'object' ||
        typeof overrides !== 'object' ||
        Array.isArray(base) ||
        Array.isArray(overrides)
      )
        return overrides
      return Object.fromEntries([
        ...Object.entries(base),
        ...Object.entries(overrides).map(([key, value]) => [key, gunValues(base[key], value)]),
      ])
    }
    const gunLabel = (gun: GunDefinition) =>
      gun.name.endsWith('.name') ? gun.id : `${gun.name} · ${gun.id}`
    function gunShape(field: GunField): string {
      if (field.type === 'object')
        return Object.entries(field.fields ?? {})
          .map(([key, child]) => `${key}: ${gunShape(child)}`)
          .join('; ')
      if (field.type === 'array') return `массив (${gunShape(field.items!)})`
      if (field.type === 'map')
        return `ключ: ${field.keys?.values?.join(' / ') ?? field.keys?.type}; значение: ${gunShape(field.items!)}`
      return field.values?.join(' / ') ?? field.type
    }
    function collectGun() {
      if (!selectedGun) return
      const values = Object.fromEntries(
        [...gunReaders]
          .map(([key, read]) => [key, read()])
          .filter(([, value]) => value !== undefined),
      )
      if (Object.keys(values).length) gunOverrides[selectedGun.id] = values as GunOverrides[string]
      else delete gunOverrides[selectedGun.id]
    }
    function renderGun() {
      const gun = selectedGun
      gunReaders.clear()
      if (!gun || !gunCatalog) {
        $('#gun-fields').replaceChildren()
        return
      }
      $('#gun-about').textContent =
        `${gun.id} · данные ${gun.data} · ${gun.type}. Оружие с тем же ID данных получает тот же баланс.`
      $('#gun-warnings').textContent = gun.warnings.join(' ')
      $('#gun-fields').replaceChildren(
        ...Object.entries(gunCatalog.fields.fields!).map(([key, field]) => {
          const hasOverride = Object.hasOwn(gunOverrides[gun.id] ?? {}, key)
          const value = hasOverride
            ? gunValues(gun.defaults[key], gunOverrides[gun.id][key])
            : gun.defaults[key]
          const id = `gun-field-${key}`
          const edit = el('input', {
            type: 'checkbox',
            checked: hasOverride,
            ariaLabel: `Изменить ${GUN_LABELS[key] ?? key}`,
          })
          const nullable = field.nullable
            ? el('input', { type: 'checkbox', checked: value === null, ariaLabel: `${key}: null` })
            : null
          const complex =
            ['object', 'array', 'map', 'json'].includes(field.type) || field.acceptsInfinite
          const input = complex
            ? el('textarea', { id, rows: 5, value: gunText(value), spellcheck: false })
            : field.type === 'boolean' || field.values
              ? el(
                  'select',
                  { id },
                  ...(field.values ?? ['true', 'false']).map((v) =>
                    el('option', { value: v, textContent: v }),
                  ),
                )
              : el('input', {
                  id,
                  type: ['integer', 'number'].includes(field.type) ? 'number' : 'text',
                  value: value === null ? '' : String(value ?? ''),
                  step: field.type === 'integer' ? '1' : 'any',
                  ...(field.min === undefined ? {} : { min: field.min, max: field.max }),
                  maxLength: 256,
                })
          if (input instanceof HTMLSelectElement) input.value = String(value)
          const sync = () => {
            input.disabled = !edit.checked || !!nullable?.checked
            if (nullable) nullable.disabled = !edit.checked
          }
          edit.onchange = sync
          if (nullable) nullable.onchange = sync
          sync()
          gunReaders.set(key, () => {
            if (!edit.checked) return undefined
            if (nullable?.checked) return null
            if (complex) {
              try {
                return JSON.parse(input.value)
              } catch {
                throw new Error(`${key}: исправьте JSON.`)
              }
            }
            if (field.type === 'boolean') return input.value === 'true'
            if (['integer', 'number'].includes(field.type)) {
              if (!input.value.trim() || !Number.isFinite(Number(input.value)))
                throw new Error(`${key}: введите число.`)
              return Number(input.value)
            }
            return input.value
          })
          return el(
            'details',
            { className: 'disclosure', open: hasOverride },
            el('summary', {
              textContent: `${GUN_LABELS[key] ?? key} · ${key}${hasOverride ? ' · изменено' : ''}`,
            }),
            el('label', { className: 'check' }, edit, 'Изменить'),
            nullable ? el('label', { className: 'check' }, nullable, 'Значение null') : null,
            el('label', { htmlFor: id, textContent: GUN_LABELS[key] ?? key }),
            input,
            el('small', {
              className: 'muted',
              textContent: `${gunShape(field)}${field.min === undefined ? '' : ` · от ${field.min} до ${field.max}`}`,
            }),
            el(
              'details',
              {},
              el('summary', { textContent: 'Значение ганпака' }),
              el('pre', { textContent: gunText(gun.defaults[key]) }),
            ),
          )
        }),
      )
    }
    function filterGuns() {
      if (!gunCatalog) return
      const query = $<HTMLInputElement>('#gun-search').value.toLowerCase().trim()
      const guns = gunCatalog.guns
        .filter((gun) => `${gun.name} ${gun.id} ${gun.type}`.toLowerCase().includes(query))
        .sort(
          (a, b) =>
            Number(KIT_GUNS.has(b.id)) - Number(KIT_GUNS.has(a.id)) ||
            Number(!!gunOverrides[b.id]) - Number(!!gunOverrides[a.id]) ||
            a.id.localeCompare(b.id),
        )
      const select = $<HTMLSelectElement>('#gun-select')
      select.replaceChildren(
        ...guns.map((gun) =>
          el('option', {
            value: gun.id,
            textContent: `${gunLabel(gun)}${gunOverrides[gun.id] ? ' · изменено' : ''}`,
          }),
        ),
      )
      select.value =
        selectedGun && guns.some((gun) => gun.id === selectedGun!.id)
          ? selectedGun.id
          : (guns[0]?.id ?? '')
      selectedGun = gunCatalog.guns.find((gun) => gun.id === select.value)
      renderGun()
      if (!guns.length) $('#gun-about').textContent = 'Оружие не найдено. Измените запрос.'
    }
    async function loadGunBalance() {
      const [availability, { settings }] = await Promise.all([api('gun-balance'), api('settings')])
      const form = $<HTMLFormElement>('#gun-balance-form')
      form.hidden = !availability.available
      if (!availability.available) {
        say($('#gun-balance-status'), availability.error, 'error')
        return
      }
      gunCatalog = availability.catalog
      gunOverrides = structuredClone(settings.gunBalance ?? {})
      gunRevision = settings.revision ?? 0
      filterGuns()
      say(
        $('#gun-balance-status'),
        `${gunCatalog!.guns.length} оружий. Изменения хранятся поверх ганпака.`,
      )
    }
    $<HTMLInputElement>('#gun-search').oninput = () => {
      try {
        collectGun()
        filterGuns()
      } catch (error) {
        say($('#gun-balance-status'), (error as Error).message, 'error')
      }
    }
    $<HTMLSelectElement>('#gun-select').onchange = (event) => {
      try {
        collectGun()
        selectedGun = gunCatalog?.guns.find(
          (gun) => gun.id === (event.target as HTMLSelectElement).value,
        )
        renderGun()
      } catch (error) {
        say($('#gun-balance-status'), (error as Error).message, 'error')
        if (selectedGun) $<HTMLSelectElement>('#gun-select').value = selectedGun.id
      }
    }
    $('#gun-reset').onclick = () => {
      if (selectedGun) {
        delete gunOverrides[selectedGun.id]
        renderGun()
      }
    }
    $('#gun-refresh').onclick = async () => {
      if (
        await ask({
          title: 'Обновить каталог?',
          text: 'Несохранённые изменения баланса оружия будут заменены текущими настройками сервера.',
          ok: 'Обновить',
        })
      )
        run($('#gun-balance-status'), loadGunBalance, $('#gun-balance-form'))
    }
    $<HTMLFormElement>('#gun-balance-form').onsubmit = async (event) => {
      event.preventDefault()
      await run(
        $('#gun-balance-status'),
        async () => {
          collectGun()
          const { settings } = await api('gun-balance', 'PUT', {
            expectedRevision: gunRevision,
            gunBalance: gunOverrides,
          })
          if (settingsRevision === gunRevision) settingsRevision = settings.revision
          gunRevision = settings.revision
          gunOverrides = structuredClone(settings.gunBalance ?? {})
          renderGun()
          await loadSettings(Date.now(), true)
          return 'Сохранено. Подтверждение применения — в состоянии настроек выше.'
        },
        $('#gun-balance-form'),
      )
    }
    type Rule = { type: 'int' | 'double' | 'bool'; min?: number; max?: number }
    let rules: Record<string, Rule> = {},
      settingsRevision = 0,
      balance: Record<string, Record<string, number | boolean>> = {},
      scope = '*',
      extraLocks: string[] = [],
      hadLocks = false
    // Every field's server default, keyed by its form name, in the shape settingsBody compares against (strings for numbers, 'true'/'false' for bools).
    let defaults: Record<string, string> = {}
    const LOBBY = [
      {
        key: 'pvpCooldownSeconds',
        label: 'Задержка перед выключением PvP',
        unit: 'сек',
        min: 0,
        max: 600,
        def: 10,
      },
    ]
    const ROOMS = [
      { key: 'maxRooms', label: 'Матчей одновременно', unit: 'шт', min: 1, max: 16, def: 2 },
      {
        key: 'idleCloseSeconds',
        label: 'Закрывать пустую комнату через',
        unit: 'сек',
        min: 30,
        max: 3600,
        def: 600,
      },
      {
        key: 'abandonCloseSeconds',
        label: 'Завершать матч без игроков через',
        unit: 'сек',
        min: 5,
        max: 600,
        def: 30,
      },
    ]
    const DEATHMATCH = [
      { key: 'minPlayers', label: 'Игроков для старта', unit: 'чел', min: 1, max: 24, def: 2 },
    ]
    const SETTING_LABELS: Record<string, string> = {
      pvpEnabled: 'PvP в лобби',
      classLocks: 'Закрытые классы',
      classCosts: 'Стоимость высадки',
      parcool: 'Ограничения паркура',
      ...Object.fromEntries([...LOBBY, ...ROOMS, ...DEATHMATCH].map((f) => [f.key, f.label])),
      ...BALANCE_LABELS,
    }
    function numberField(
      label: string,
      name: string,
      min: number,
      max: number,
      step: string,
      value: number,
      unit?: string,
      about?: string,
    ) {
      const input = el('input', {
        type: 'number',
        name,
        min,
        max,
        step,
        inputMode: step === '1' ? 'numeric' : 'decimal',
        value,
      })
      const wrap = unit
        ? el(
            'div',
            { className: 'unit' },
            input,
            el('span', { className: 'unit__suffix', textContent: unit, ariaHidden: 'true' }),
          )
        : undefined
      return field(label, input, `${about ? `${about} ` : ''}${number(min)}–${number(max)}`, wrap)
    }
    /** The value the mod uses for `key` at the current scope: the campaign/room file default, overridden by the site's «Все матчи», like the mod merges them. */
    const scopeDefault = (key: string) =>
      scope === '*'
        ? BALANCE_DEFAULTS.room[key]
        : (balance['*']?.[key] ?? BALANCE_DEFAULTS[scope][key])
    function renderBalance() {
      const values = balance[scope] ?? {}
      $('#scope-hint').textContent =
        scope === '*'
          ? 'Общие значения для всех кампаний и обычных боёв.'
          : 'Значения только для этих матчей, поверх общих.'
      $('#balance-fields').replaceChildren(
        ...BALANCE_GROUPS.map((group) =>
          el(
            'div',
            { className: 'group' },
            el('h4', { textContent: group.title }),
            el(
              'div',
              { className: 'fields' },
              ...group.fields.map((f) => {
                const rule = rules[f.key],
                  name = `b_${f.key}`,
                  def = scopeDefault(f.key)
                defaults[f.key] = rule.type === 'bool' ? String(def) : String(def)
                if (rule.type === 'bool') {
                  const value = values[f.key] ?? def
                  const select = el(
                    'select',
                    { name },
                    ...[
                      ['true', 'Да'],
                      ['false', 'Нет'],
                    ].map(([v, text]) =>
                      el('option', {
                        value: v,
                        textContent: text,
                        selected: String(value) === v,
                      }),
                    ),
                  )
                  // customSelect() must run after the select has a parent — it inserts its painted button as select's
                  // next sibling, which is a no-op on a detached node (this select is field()'s child, not yet attached here).
                  const wrapped = field(f.label, select, f.hint)
                  customSelect(select)
                  return wrapped
                }
                return numberField(
                  f.label,
                  name,
                  rule.min!,
                  rule.max!,
                  rule.type === 'int' ? '1' : '0.1',
                  Number(values[f.key] ?? def),
                  f.unit,
                  f.hint,
                )
              }),
            ),
          ),
        ),
      )
    }
    function collectBalance() {
      const form = $<HTMLFormElement>('#settings-form'),
        values: Record<string, number | boolean> = {}
      for (const key of Object.keys(rules)) {
        const raw = (form.elements.namedItem(`b_${key}`) as HTMLInputElement | null)?.value ?? ''
        if (raw !== '' && raw !== defaults[key])
          values[key] = rules[key].type === 'bool' ? raw === 'true' : Number(raw)
      }
      if (Object.keys(values).length) balance[scope] = values
      else delete balance[scope]
    }
    function renderScopes() {
      const known = new Set(BALANCE_SCOPES.map((s) => s.id))
      $('#scope').replaceChildren(
        ...BALANCE_SCOPES.map((s) =>
          el('option', {
            value: s.id,
            textContent: `${s.name}${balance[s.id] ? ' — есть изменения' : ''}`,
            selected: s.id === scope,
          }),
        ),
      )
      // Sections for campaigns the site does not know are kept as they are.
      for (const id of Object.keys(balance))
        if (!known.has(id))
          $('#scope').append(
            el('option', {
              value: id,
              textContent: 'Другая кампания — есть изменения',
              selected: id === scope,
            }),
          )
      customSelect($<HTMLSelectElement>('#scope'))
    }
    $('#scope').addEventListener('change', (e) => {
      collectBalance()
      scope = (e.target as HTMLSelectElement).value
      renderScopes()
      renderBalance()
    })
    $('#parcool-on').addEventListener('change', (e) => {
      const on = (e.target as HTMLInputElement).checked
      $('#parcool-list')
        .querySelectorAll('input')
        .forEach((i) => ((i as HTMLInputElement).disabled = !on))
    })

    function appliedErrors(errors: string[]) {
      return errors.map((error) => {
        const key = Object.keys(SETTING_LABELS).find((k) => error.includes(k))
        if (!key)
          return error.startsWith('gunBalance')
            ? `баланс оружия: ${error}`
            : 'сервер не смог прочитать часть настроек'
        return /clamp/i.test(error)
          ? `«${SETTING_LABELS[key]}» — значение вне допустимых границ, сервер его ограничил`
          : `«${SETTING_LABELS[key]}» — сервер оставил прежнее значение`
      })
    }
    let settingsPoll: ReturnType<typeof setTimeout> | undefined
    async function loadSettings(waitStarted = 0, statusOnly = false) {
      const { settings, applied, balance: balanceRules } = await api('settings')
      rules = balanceRules
      if (!statusOnly) {
        settingsRevision = settings.revision ?? 0
        const form = $<HTMLFormElement>('#settings-form')
        defaults = Object.fromEntries(
          [...LOBBY, ...ROOMS, ...DEATHMATCH].map((f) => [f.key, String(f.def)]),
        )
        defaults.pvpEnabled = 'true'
        const pvp = form.elements.namedItem('pvpEnabled') as HTMLSelectElement
        pvp.value = String(settings.lobby?.pvpEnabled ?? true)
        customSelect(pvp)
        hadLocks = Array.isArray(settings.classLocks)
        $('#lobby-fields').replaceChildren(
          ...LOBBY.map((f) =>
            numberField(
              f.label,
              f.key,
              f.min,
              f.max,
              '1',
              settings.lobby?.[f.key] ?? f.def,
              f.unit,
            ),
          ),
        )
        $('#room-fields').replaceChildren(
          ...ROOMS.map((f) =>
            numberField(
              f.label,
              f.key,
              f.min,
              f.max,
              '1',
              settings.rooms?.[f.key] ?? f.def,
              f.unit,
            ),
          ),
        )
        $('#deathmatch-fields').replaceChildren(
          ...DEATHMATCH.map((f) =>
            numberField(
              f.label,
              f.key,
              f.min,
              f.max,
              '1',
              settings.deathmatch?.[f.key] ?? f.def,
              f.unit,
            ),
          ),
        )
        $('#class-costs').replaceChildren(
          ...Object.entries(CLASS_COSTS).map(([id, price]) => {
            const item = numberField(
              CLASS_NAMES[id],
              `cost_${id}`,
              0,
              10000,
              '1',
              settings.classCosts?.[id] ?? price,
              'БК',
            )
            item.querySelector('input')!.required = true
            return item
          }),
        )
        const locks: string[] = settings.classLocks ?? []
        extraLocks = locks.filter((id) => !Object.hasOwn(CLASS_NAMES, id))
        $('#class-list').replaceChildren(
          ...Object.entries(CLASS_NAMES).map(([id, name]) =>
            el(
              'label',
              { className: 'check' },
              el('input', {
                type: 'checkbox',
                name: 'class',
                value: id,
                checked: !locks.includes(id),
              }),
              name,
            ),
          ),
        )
        const parcoolOn = $<HTMLInputElement>('#parcool-on')
        parcoolOn.checked = settings.parcool !== undefined
        // Effective value while off: the server's base file, shown but disabled — this is not what will be saved.
        const parcoolChecked = new Set(settings.parcool?.allowedActions ?? PARCOOL_FILE_DEFAULT)
        $('#parcool-list').replaceChildren(
          ...PARCOOL_ACTIONS.map(({ id, label, hint }) =>
            el(
              'label',
              { className: 'check', ...(hint ? { title: hint } : {}) },
              el('input', {
                type: 'checkbox',
                name: 'parcool',
                value: id,
                checked: parcoolChecked.has(id),
                disabled: !parcoolOn.checked,
              }),
              el('span', {}, label, el('small', { textContent: id })),
            ),
          ),
        )
        balance = structuredClone(settings.campaignBalance ?? {})
        renderScopes()
        renderBalance()
      }

      clearTimeout(settingsPoll)
      if (statusOnly && (settings.revision ?? 0) !== settingsRevision) {
        settingsStatus(
          'Настройки изменены в другой сессии. Обновите страницу перед сохранением.',
          'error',
          'Настройки изменились — обновите страницу.',
        )
        return
      }
      const who = settings.updatedBy
        ? ` Последнее изменение: ${settings.updatedBy}, ${ago(settings.updatedAt)}.`
        : ''
      const receipt = settingsReceipt(settings.revision ?? 0, applied)
      if (!settings.revision)
        settingsStatus(
          'Настройки ещё не меняли — сервер работает на своих значениях по умолчанию.',
          'ok',
          '',
        )
      else if (receipt === 'rejected' || receipt === 'partial')
        settingsStatus(
          `${receipt === 'rejected' ? 'Сервер отклонил изменения; действуют прежние настройки' : 'Сохранено, но сервер применил не всё'}: ${appliedErrors(applied.errors).join('; ')}.${who}`,
          'error',
          'Применено не всё — подробности вверху.',
        )
      else if (receipt === 'applied')
        settingsStatus(`Применено на сервере.${who}`, 'ok', 'Применено на сервере.')
      else if (waitStarted && Date.now() - waitStarted > 60_000)
        settingsStatus(
          `Сохранено, но сервер пока не подтвердил применение. Возможно, он перезапускается или открыта мастерская — настройки применятся, когда игра запустится.${who}`,
          'pending',
          'Сохранено, сервер пока не подтвердил.',
        )
      else {
        settingsStatus(
          'Сохранено, сервер применяет настройки (обычно до 5 секунд)…',
          'pending',
          'Сохранено, сервер применяет…',
        )
        settingsPoll = setTimeout(
          () => loadSettings(waitStarted || Date.now(), true).catch(() => {}),
          3000,
        )
      }
    }
    /** One status in two places: the banner at the top and the sticky save bar. */
    function settingsStatus(text: string, tone: 'ok' | 'error' | 'pending', short: string) {
      say($('#settings-state'), text, tone)
      const line = $('#settings-form .savebar .form-status')
      if (short) say(line, short, tone)
      else line.textContent = ''
    }
    $<HTMLFormElement>('#settings-form').addEventListener('submit', async (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement,
        save = form.querySelector<HTMLButtonElement>('.savebar button')!
      collectBalance()
      const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value
      const body = settingsBody(
        settingsRevision,
        {
          pvpEnabled: value('pvpEnabled'),
          classCosts: Object.fromEntries(
            Object.keys(CLASS_COSTS).map((id) => [id, value(`cost_${id}`)]),
          ),
          lobby: Object.fromEntries(LOBBY.map((f) => [f.key, value(f.key)])),
          rooms: Object.fromEntries(ROOMS.map((f) => [f.key, value(f.key)])),
          deathmatch: Object.fromEntries(DEATHMATCH.map((f) => [f.key, value(f.key)])),
          lockedClasses: [
            ...[...form.querySelectorAll<HTMLInputElement>('input[name=class]')]
              .filter((c) => !c.checked)
              .map((c) => c.value),
            ...extraLocks,
          ],
          hadLocks,
          balance,
          parcool: {
            active: $<HTMLInputElement>('#parcool-on').checked,
            actions: [
              ...form.querySelectorAll<HTMLInputElement>('input[name=parcool]:checked'),
            ].map((c) => c.value),
          },
        },
        defaults,
      )
      save.disabled = true
      settingsStatus('Сохраняем…', 'pending', 'Сохраняем…')
      try {
        const { settings } = await api('settings', 'PUT', body)
        if (gunRevision === settingsRevision) gunRevision = settings.revision
        await loadSettings()
      } catch (error) {
        settingsStatus((error as Error).message, 'error', (error as Error).message)
      } finally {
        save.disabled = false
      }
    })

    // ---------- Team ----------
    const assignable = () =>
      can('roles-admin') ? ['builder', 'moderator', 'admin'] : ['builder', 'moderator']
    async function loadTeam() {
      const data = await api('staff')
      $('#role-legend').replaceChildren(
        ...Object.values(ROLES).map((r) =>
          el('div', {}, el('dt', { textContent: r.name }), el('dd', { textContent: r.about })),
        ),
      )
      const line = $('#staff-status')
      const rows = data.owners.map((o: any) =>
        el(
          'li',
          { className: 'row' },
          el(
            'div',
            { className: 'row-main' },
            el('strong', { textContent: o.name }),
            el('small', {
              textContent: 'Владелец. Назначается в настройках сервера, здесь не меняется.',
            }),
          ),
        ),
      )
      const roleSelects: HTMLSelectElement[] = []
      for (const s of data.staff) {
        const editable = s.name !== me.name && (s.role !== 'admin' || can('roles-admin'))
        const main = el(
          'div',
          { className: 'row-main' },
          el('strong', { textContent: s.name }),
          el('small', {
            textContent: `${ROLES[s.role]?.name ?? 'Участник'} · добавил ${s.grantedBy} ${ago(s.grantedAt)}`,
          }),
        )
        const row = el('li', { className: 'row' }, main)
        if (editable) {
          const select = el(
            'select',
            { ariaLabel: `Роль игрока ${s.name}` },
            ...assignable().map((r) =>
              el('option', { value: r, textContent: ROLES[r].name, selected: r === s.role }),
            ),
          )
          roleSelects.push(select)
          select.addEventListener('change', async () => {
            const role = select.value
            if (
              !(await ask({
                title: `Сделать ${s.name} — ${ROLES[role].name.toLowerCase()}?`,
                text: ROLES[role].about,
                ok: 'Сменить роль',
              }))
            ) {
              select.value = s.role
              customSelect(select)
              return
            }
            changeRole(
              { uuid: s.uuid, role },
              `${s.name} теперь ${ROLES[role].name.toLowerCase()}.`,
              line,
            )
          })
          const actions = el('div', { className: 'actions' }, select)
          if (can('workshop') && s.role === 'builder')
            actions.append(
              button(
                `Карты: ${mapsLabel(s.maps)}`,
                () => editMaps(s, line),
                'small',
                `Карты для ${s.name} в мастерской`,
              ),
            )
          actions.append(
            button(
              'Убрать из команды',
              async () => {
                if (
                  await ask({
                    title: `Убрать ${s.name} из команды?`,
                    text: `${s.name} потеряет доступ к панели и мастерской. Играть на сервере он сможет как обычно.`,
                    ok: 'Убрать',
                    danger: true,
                  })
                )
                  changeRole({ uuid: s.uuid, role: null }, `${s.name} больше не в команде.`, line)
              },
              'small danger',
              `Убрать ${s.name} из команды`,
            ),
          )
          row.append(actions)
        }
        rows.push(row)
      }
      $('#staff-list').replaceChildren(...rows)
      roleSelects.forEach(customSelect)
      $('#grant-roles').replaceChildren(
        ...assignable().map((r, i) =>
          el(
            'label',
            { className: 'radio' },
            el('input', {
              type: 'radio',
              name: 'role',
              value: r,
              required: true,
              checked: i === 0,
            }),
            el('span', {}, ROLES[r].name, el('small', { textContent: ROLES[r].about })),
          ),
        ),
      )
      const key = (list: any[]) =>
        JSON.stringify((list ?? []).map((m) => [m.draslId, m.role]).sort())
      const inSync = Array.isArray(data.workshop) && key(data.workshop) === key(data.expected)
      const last = data.lastSync
        ? ` Последнее обновление ${ago(data.lastSync.at)}${data.lastSync.result && !data.lastSync.result.ok ? ' — не удалось' : ''}.`
        : ''
      await renderMapAccess(data.staff)
      say(
        $('#workshop-state'),
        inSync
          ? `Мастерская пускает ровно тех, кто в команде.${last}`
          : `Список доступа в мастерскую отличается от команды — нажмите «Обновить доступ».${last}`,
        inSync ? 'ok' : 'pending',
      )
    }
    async function changeRole(body: Record<string, unknown>, done: string, line: HTMLElement) {
      await run(line, async () => {
        const data = await api('staff', 'POST', body)
        await loadTeam()
        return data.sync.error
          ? `${done} Но доступ в мастерскую обновить не удалось — нажмите «Обновить доступ» позже.`
          : done
      })
    }
    /** `null`/absent = every map, including ones added later; `[]` = the builder enters the workshop hub but can edit nothing. */
    const mapsLabel = (maps: string[] | null) =>
      maps === null
        ? 'все'
        : !maps.length
          ? 'нет'
          : maps.length > 3
            ? `${maps.length} из ${Object.keys(WORKSHOP_PLACES).length}`
            : maps.map((id) => WORKSHOP_PLACES[id] ?? id).join(', ')
    async function editMaps(
      s: { uuid: string; name: string; maps: string[] | null },
      line: HTMLElement,
    ) {
      const known = ['hub', ...mapScopes()],
        current = new Set(s.maps ?? known)
      const list = el(
        'div',
        { className: 'checks' },
        ...known.map((id) =>
          el(
            'label',
            { className: 'check' },
            el('input', { type: 'checkbox', name: 'map', value: id, checked: current.has(id) }),
            WORKSHOP_PLACES[id],
          ),
        ),
      )
      const answer = await ask({
        title: `Карты для ${s.name} в мастерской`,
        text: 'Отметьте карты, которые строитель может редактировать. Все отмечены — доступ ко всем картам, включая новые.',
        ok: 'Сохранить',
        fields: [list],
      })
      if (!answer) return
      const ids = answer.getAll('map').map(String),
        maps = ids.length === known.length ? null : ids
      await run(line, async () => {
        await api('staff/maps', 'POST', { uuid: s.uuid, maps })
        await loadTeam()
        return `Карты для ${s.name} обновлены.`
      })
    }
    /** The same `maps` lists as «Карты: …» in the team tab, seen from each map. */
    async function renderMapAccess(
      staff: { uuid: string; name: string; role: string; maps: string[] | null }[],
    ) {
      const builders = staff.filter((s) => s.role === 'builder'),
        line = $('#map-access-status')
      const editors = (id: string) => builders.filter((b) => b.maps === null || b.maps.includes(id))
      $('#map-access').replaceChildren(
        ...['hub', ...mapScopes()].map((id) => {
          const name = mapName(id)
          const who = editors(id).map((b) => b.name)
          const main = el(
            'div',
            { className: 'row-main' },
            el('strong', { textContent: name }),
            el('small', {
              textContent: builders.length
                ? `Строители: ${who.length ? who.join(', ') : 'никто'}`
                : 'Строителей в команде нет',
            }),
          )
          const actions = el(
            'div',
            { className: 'actions' },
            builders.length
              ? button(
                  'Кто строит',
                  () =>
                    editMapAccess(
                      id,
                      name,
                      builders,
                      new Set(editors(id).map((b) => b.uuid)),
                      line,
                    ),
                  'small',
                  `Кто строит: ${name}`,
                )
              : null,
            id !== 'hub'
              ? button(
                  'На проверку',
                  () => submitMap(id, name),
                  'small',
                  `Отправить карту ${name} на проверку`,
                )
              : null,
          )
          return el('li', { className: 'row' }, main, actions)
        }),
      )
    }
    let mapCatalog: MapCatalogEntry[] | undefined, mapSession: MapSession | undefined
    const mapName = (id: string) =>
      WORKSHOP_PLACES[id] ?? String(mapCatalog?.find((map) => map.mapId === id)?.mapJson.name ?? id)
    const mapScopes = () =>
      mapCatalog
        ? mapCatalog.map((map) => map.mapId)
        : Object.keys(WORKSHOP_PLACES).filter((id) => id !== 'hub')
    async function loadMapHistory() {
      const data = await api('maps')
      const line = $('#map-history-status')
      if (!data.available) {
        say(line, data.error, 'error')
        $('#map-history').replaceChildren()
        return
      }
      mapCatalog = data.maps
      mapSession = data.session
      say(
        line,
        mapSession
          ? `Рабочая копия сеанса: ${mapSession.id}. Архивы карт независимы.`
          : 'Мастерская сейчас не редактирует активный сеанс. История доступна для выбора версии.',
      )
      $('#map-history').replaceChildren(
        ...mapCatalog!.map((map) => {
          const name = mapName(map.mapId),
            head = map.head?.versionDigest ?? null
          const versions = map.versions.map((version) => {
            const current = version.versionDigest === head
            const main = el(
              'div',
              { className: 'row-main' },
              el('strong', {
                textContent: `${date(version.createdAt)}${current ? ' · выбрана' : ''}`,
              }),
              el('small', {
                textContent: `${String(version.author.name ?? 'Не указан автор')} · изменено файлов ${version.changed.length}, удалено ${version.deleted.length} · всего ${version.fileCount}`,
              }),
              version.note ? el('p', { textContent: version.note }) : null,
              el('small', { textContent: version.versionDigest }),
            )
            const choose = button(
              'Выбрать версию',
              async () => {
                if (
                  !(await ask({
                    title: `Выбрать эту версию «${name}»?`,
                    text:
                      map.kind === 'arena'
                        ? 'Следующие матчи используют выбранную копию. Уже начатые матчи и весь архив сохранятся.'
                        : map.kind === 'limbo'
                          ? 'Сначала подготовьте эту версию для прокси. Выбор доступен только при остановленном прокси; геометрия и точка входа применятся вместе при следующем запуске.'
                          : 'Будет выбрана эта версия игрового лобби. Она применяется при следующем безопасном запуске сервера.',
                    ok: 'Выбрать версию',
                    danger: true,
                  }))
                )
                  return
                await run(line, async () => {
                  const { id } = await api('candidates/rollback', 'POST', {
                    mapId: map.mapId,
                    versionDigest: version.versionDigest,
                    expectedHead: head,
                  })
                  follow(line, id, `Версия «${name}» выбрана.`).then(loadMapHistory)
                  return 'Запрос отправлен. Ожидаем подтверждение контроллера…'
                })
              },
              'small',
              `Выбрать ${name}, версия ${version.versionDigest.slice(0, 8)}`,
            )
            choose.disabled = current || !can('workshop')
            const actions = el('div', { className: 'actions' }, choose)
            if (map.kind === 'limbo' && can('workshop')) {
              const prepare = button(
                'Подготовить для прокси',
                () =>
                  run(line, async () => {
                    const { id } = await api('maps/export-limbo', 'POST', {
                      versionDigest: version.versionDigest,
                    })
                    follow(line, id, 'Версия подготовлена. Прокси не перезапущен.')
                    return 'Проверяем и подготавливаем выбранную версию…'
                  }),
                'small',
                `Подготовить лобби прокси, версия ${version.versionDigest.slice(0, 8)}`,
              )
              prepare.disabled = !mapSession
              actions.append(prepare)
            }
            return el('li', { className: 'row' }, main, actions)
          })
          return el(
            'details',
            { className: 'disclosure' },
            el('summary', {
              textContent: `${name} · версий: ${map.versions.length}`,
            }),
            map.kind === 'limbo'
              ? el('p', {
                  textContent:
                    'Подготовка версии доступна в режиме мастерской. Выбор версии требует остановленного прокси и не запускает его автоматически.',
                })
              : null,
            el(
              'ul',
              { className: 'rows' },
              ...(versions.length
                ? versions
                : [
                    el('li', {
                      className: 'empty',
                      textContent:
                        'Эталон ещё не импортирован в архив. Рабочая копия появится после проверенного импорта.',
                    }),
                  ]),
            ),
          )
        }),
      )
    }
    $('#maps-refresh').onclick = () => run($('#map-history-status'), loadMapHistory)
    // ---------- Map candidates ----------
    const CANDIDATE_STATUS: Record<string, [string, string]> = {
      pending: ['Ждёт проверки', 'warn'],
      accepted: ['Принята', 'ok'],
      published: ['В игре', 'ok'],
      rejected: ['Отклонена', ''],
      superseded: ['Заменена новой', ''],
      rolled_back: ['Откачена', ''],
    }
    async function loadCandidates() {
      const { candidates } = await api('candidates')
      const line = $('#candidates-status')
      const rows = (candidates ?? []).slice(0, 15).map((c: any) => {
        const name = WORKSHOP_PLACES[c.mapId] ?? c.mapId,
          [label, tone] = CANDIDATE_STATUS[c.status] ?? [c.status, '']
        const decided = c.decidedBy ? ` · решил ${c.decidedBy.name} ${ago(c.decidedAt)}` : ''
        // baseMatches: false — the map's reference changed since editing started; null — unknown base (older drafts). Either needs a forced publish.
        // Two versions of one map need distinct accessible names on their buttons.
        const version = c.id.slice(0, 6)
        const baseWarn =
          c.baseMatches === false
            ? 'эталон карты изменился после начала правки'
            : c.baseMatches === null
              ? 'база неизвестна'
              : null
        const main = el(
          'div',
          { className: 'row-main' },
          el(
            'strong',
            {},
            `${name} `,
            el('span', { className: `badge ${tone}`, textContent: label }),
            baseWarn ? el('span', { className: 'badge warn', textContent: baseWarn }) : null,
          ),
          el('small', {
            textContent: `Отправил ${c.author?.name ?? '?'} ${ago(c.createdAt)} · ${c.native ? 'сохранены изменения в архиве' : `${(c.size / 1048576).toFixed(1)} МБ`}, регионов ${c.regions}${decided}`,
          }),
        )
        const actions = el('div', { className: 'actions' })
        const confirmForce = (reason: string) =>
          ask({
            title: `Принять «${name}» с другой базой?`,
            text: `${reason} Пакет сохранится с отметкой об изменившейся базе. Выпуск требует отдельной проверки.`,
            ok: 'Принять с отметкой',
            danger: true,
          })
        const publish = (force: boolean) =>
          run(line, async () => {
            const map = mapCatalog?.find((entry) => entry.mapId === c.mapId)
            if (!map)
              throw new Error('Сначала обновите историю карт. Текущая версия не подтверждена.')
            const { id } = await api('candidates/publish', 'POST', {
              candidateId: c.id,
              mapId: c.mapId,
              expectedHead: map.head?.versionDigest ?? null,
              ...(force ? { force: true } : {}),
            })
            follow(line, id, `Версия «${name}» принята и выбрана.`, async (error) => {
              // The controller never lets an older version replace a newer accepted one: retrying cannot help.
              if (/newer version/.test(error)) {
                say(
                  line,
                  'Уже принята более новая версия этой карты. Эту версию можно только отклонить.',
                  'error',
                )
                return true
              }
              if (!/^base (changed|unknown)/.test(error)) return false
              if (await confirmForce('Эталон карты, возможно, изменился с начала правки.'))
                publish(true)
              else say(line, 'Публикация отменена.', 'error')
              return true
            }).then(() => Promise.all([loadCandidates(), loadMapHistory()]))
            return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
          })
        if (can('workshop') && c.status === 'pending') {
          actions.append(
            button(
              'Принять',
              async () => {
                if (
                  !(await ask({
                    title: `Принять «${name}»?`,
                    text: 'Будет принята и выбрана именно эта версия. Новые матчи используют её копию; уже начатые матчи сохранят прежнюю. Лобби применяются при безопасной смене игрового мира.',
                    ok: 'Принять',
                  }))
                )
                  return
                if (
                  baseWarn &&
                  !(await confirmForce(`Эта версия правилась поверх карты, у которой ${baseWarn}.`))
                )
                  return
                publish(!!baseWarn)
              },
              'small primary',
              `Принять ${name}, версия ${version}`,
            ),
            button(
              'Отклонить',
              async () => {
                if (
                  !(await ask({
                    title: `Отклонить эту версию «${name}»?`,
                    text: 'Версия останется в списке как отклонённая, в игру она не попадёт.',
                    ok: 'Отклонить',
                    danger: true,
                  }))
                )
                  return
                run(line, async () => {
                  const { id } = await api('candidates/reject', 'POST', {
                    candidateId: c.id,
                    mapId: c.mapId,
                  })
                  follow(line, id, 'Версия отклонена.').then(loadCandidates)
                  return 'Запрос отправлен…'
                })
              },
              'small danger',
              `Отклонить ${name}, версия ${version}`,
            ),
          )
        }
        if (can('mode') && c.status === 'pending' && controller?.phase === 'workshop') {
          actions.append(
            button(
              'Тест',
              async () => {
                if (
                  !(await ask({
                    title: `Тестовый матч «${name}»?`,
                    text: 'Мастерская перезапустится в закрытый тестовый матч на копии этой версии карты — это займёт около 2–3 минут. Строителей переведёт с собой сервер. Результат теста не идёт в статистику.',
                    ok: 'Начать тест',
                    danger: true,
                  }))
                )
                  return
                run(line, async () => {
                  const { id } = await api('mode', 'POST', {
                    profile: 'test',
                    expectedRevision: controller.revision,
                    candidateId: c.id,
                  })
                  follow(line, id, `Тестовый матч «${name}» начат.`).then(loadOverview)
                  return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
                })
              },
              'small',
              `Тестовый матч ${name}, версия ${version}`,
            ),
          )
        }
        if (can('workshop') && c.status === 'accepted' && c.sha256) {
          const link = el('a', {
            className: 'small',
            textContent: 'Скачать пакет',
            href: `/api/admin/candidates/download?id=${encodeURIComponent(c.id)}`,
          })
          actions.append(link)
        }
        if (can('workshop') && c.status === 'accepted' && c.native && !c.sha256) {
          actions.append(
            button(
              'Экспортировать ZIP',
              () =>
                run(line, async () => {
                  const { id } = await api('candidates/export', 'POST', {
                    candidateId: c.id,
                    mapId: c.mapId,
                  })
                  follow(line, id, 'Пакет готов к скачиванию.').then(loadCandidates)
                  return 'Создаём архив выбранной версии…'
                }),
              'small',
              `Экспортировать ${name}, версия ${version}`,
            ),
          )
        }
        return el('li', { className: 'row' }, main, actions)
      })
      $('#candidate-list').replaceChildren(
        ...(rows.length
          ? rows
          : [el('li', { className: 'empty', textContent: 'Пока ничего не отправляли.' })]),
      )
    }
    async function submitMap(mapId: string, name: string) {
      if (
        !(await ask({
          title: `Отправить «${name}» на проверку?`,
          text: 'Сервер сохранит изменения мира и разметки из рабочей копии текущего сеанса. Активная версия не изменится до отдельного принятия.',
          ok: 'Отправить',
        }))
      )
        return
      const line = $('#candidates-status')
      run(line, async () => {
        const { id } = await api('candidates/create', 'POST', { mapId })
        follow(line, id, `Копия «${name}» готова к проверке.`).then(loadCandidates)
        return 'Запрос отправлен. Сервер снимет копию в течение 15 секунд…'
      })
    }

    async function editMapAccess(
      mapId: string,
      name: string,
      builders: { uuid: string; name: string }[],
      current: Set<string>,
      line: HTMLElement,
    ) {
      const list = el(
        'div',
        { className: 'checks' },
        ...builders.map((b) =>
          el(
            'label',
            { className: 'check' },
            el('input', {
              type: 'checkbox',
              name: 'builder',
              value: b.uuid,
              checked: current.has(b.uuid),
            }),
            b.name,
          ),
        ),
      )
      const answer = await ask({
        title: `Кто строит: «${name}»`,
        text: 'Отметьте строителей, которые могут здесь строить. Остальные зайдут только посмотреть.',
        ok: 'Сохранить',
        fields: [list],
      })
      if (!answer) return
      await run(
        line,
        async () => {
          const { changed, sync } = await api('staff/map-access', 'POST', {
            mapId,
            uuids: answer.getAll('builder').map(String),
          })
          await loadTeam()
          if (!changed.length) return 'Ничего не изменилось.'
          return sync?.error
            ? `Доступ к карте «${name}» сохранён, но мастерская его ещё не получила — нажмите «Обновить доступ».`
            : `Доступ к карте «${name}» обновлён.`
        },
        $('#map-access'),
      )
    }
    $<HTMLFormElement>('#grant-form').addEventListener('submit', async (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement,
        data = new FormData(form),
        name = String(data.get('nickname')),
        role = String(data.get('role'))
      if (
        !(await ask({
          title: `Добавить ${name} в команду?`,
          text: `Роль: ${ROLES[role].name}. ${ROLES[role].about}`,
          ok: 'Добавить',
        }))
      )
        return
      const line = form.querySelector<HTMLElement>('.form-status')!
      await changeRole({ name, role }, `${name} добавлен в команду.`, line)
      if (line.classList.contains('ok')) form.reset()
    })
    $('#sync').addEventListener('click', () => {
      const line = $('#sync-status')
      run(
        line,
        async () => {
          const { id } = await api('staff/sync', 'POST', {})
          follow(line, id, 'Доступ в мастерскую обновлён.').then(loadTeam)
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
        },
        $('#sync').parentElement,
      )
    })

    // ---------- Statistics ----------
    const REASONS: Record<string, string> = {
      draw: 'Ничья',
      abandoned: 'Прерван: все игроки вышли',
      stopped: 'Остановлен вручную',
      shutdown: 'Прерван: сервер выключился',
      error: 'Прерван из-за ошибки',
    }
    const matchTitle = (r: { kind: string; mode: string; mapId: string | null }) =>
      `${MODE_NAMES[r.mode] ?? 'Матч'} · ${r.kind === 'campaign' ? 'итог кампании' : (MAP_NAMES[r.mapId ?? ''] ?? 'другая карта')}`
    function outcome(r: any) {
      if (r.reason !== 'completed') return REASONS[r.reason] ?? 'Завершён'
      if (r.winnerName) return `Победил ${r.winnerName}`
      return TEAM_NAMES[r.winner] ? `Победа ${TEAM_NAMES[r.winner]}` : 'Завершён'
    }
    let resultPage = 1
    async function loadResults() {
      const mode = $<HTMLSelectElement>('#result-mode').value,
        data = await api(`results?page=${resultPage}${mode ? `&mode=${mode}` : ''}`)
      const line = $('#result-status')
      $('#result-list').replaceChildren(
        ...(data.results.length
          ? data.results.map((r: any) => {
              const voided = r.voidedAt !== null,
                title = matchTitle(r)
              const players = el(
                'small',
                {},
                `Игроки (${r.participants}): `,
                ...r.players.flatMap((p: any, i: number) => [
                  i ? ', ' : '',
                  el('span', { className: `team-${p.team}`, textContent: p.name }),
                ]),
                r.participants > r.players.length ? '…' : '',
              )
              const main = el(
                'div',
                { className: 'row-main' },
                el('strong', { textContent: title }),
                el(
                  'span',
                  {},
                  `${date(r.endedAt)} · ${outcome(r)}`,
                  voided
                    ? el('span', {
                        className: 'badge warn',
                        textContent: ` Не учитывается — решил ${r.voidedBy}`,
                      })
                    : null,
                ),
                players,
              )
              const toggle = button(
                voided ? 'Вернуть в статистику' : 'Не учитывать матч',
                async () => {
                  const answer = await ask(
                    voided
                      ? {
                          title: 'Вернуть матч в статистику?',
                          text: `«${title}», ${date(r.endedAt)}. Матч снова появится в лидерборде и профилях игроков.${r.rated ? ' Рейтинг сезона пересчитается.' : ''}`,
                          ok: 'Вернуть',
                        }
                      : {
                          title: 'Не учитывать этот матч?',
                          text: `«${title}», ${date(r.endedAt)}. Матч пропадёт из лидерборда и профилей игроков.${r.rated ? ' Рейтинг сезона пересчитается.' : ''} Решение можно отменить.`,
                          ok: 'Не учитывать',
                          danger: true,
                        },
                  )
                  if (!answer) return
                  await run(line, async () => {
                    await api('results/void', 'POST', {
                      serverId: r.serverId,
                      eventId: r.eventId,
                      voided: !voided,
                    })
                    await loadResults()
                    return voided ? 'Матч снова учитывается.' : 'Матч больше не учитывается.'
                  })
                },
                voided ? 'small' : 'small danger',
                `${voided ? 'Вернуть в статистику' : 'Не учитывать'}: ${title}, ${date(r.endedAt)}`,
              )
              return el('li', { className: `row${voided ? ' voided' : ''}` }, main, toggle)
            })
          : [el('li', { className: 'empty', textContent: 'Матчей пока нет.' })]),
      )
      const from = data.total ? (resultPage - 1) * data.limit + 1 : 0,
        to = Math.min(data.total, resultPage * data.limit)
      $('#page').textContent = data.total ? `Матчи ${from}–${to} из ${data.total}` : ''
      $<HTMLButtonElement>('#prev').disabled = resultPage <= 1
      $<HTMLButtonElement>('#next').disabled = resultPage * data.limit >= data.total
    }
    $('#result-mode').addEventListener('change', () => {
      resultPage = 1
      loadResults()
    })
    customSelect($<HTMLSelectElement>('#result-mode'))
    $('#prev').addEventListener('click', () => {
      resultPage--
      loadResults()
    })
    $('#next').addEventListener('click', () => {
      resultPage++
      loadResults()
    })
    const dayFormat = new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    })
    async function loadSeasons() {
      const { seasons } = await api('seasons')
      $('#season-list').replaceChildren(
        ...seasons
          .slice()
          .reverse()
          .map((s: any) =>
            el('li', {
              textContent: `${s.name}: ${dayFormat.format(Date.parse(s.startsAt))} — ${dayFormat.format(Date.parse(s.endsAt))}`,
            }),
          ),
      )
    }
    async function loadKeys() {
      const { keys } = await api('keys')
      $('#key-list').replaceChildren(
        ...keys.map((k: any) =>
          el(
            'li',
            { className: 'row' },
            el(
              'div',
              { className: 'row-main' },
              el('strong', { textContent: k.label }),
              el('small', {
                textContent: k.revokedAt
                  ? `Отозван ${ago(k.revokedAt)}`
                  : `Действует, создан ${ago(k.createdAt)}`,
              }),
            ),
            k.revokedAt
              ? null
              : button(
                  'Отозвать',
                  async () => {
                    if (
                      !(await ask({
                        title: `Отозвать ключ «${k.label}»?`,
                        text: 'Сервер с этим ключом перестанет отправлять результаты матчей, пока ему не выдадут новый.',
                        ok: 'Отозвать',
                        danger: true,
                      }))
                    )
                      return
                    await run($('#key-form .form-status'), async () => {
                      await api('keys/revoke', 'POST', { id: k.id })
                      await loadKeys()
                      return 'Ключ отозван.'
                    })
                  },
                  'small danger',
                  `Отозвать ключ «${k.label}»`,
                ),
          ),
        ),
      )
    }
    $<HTMLFormElement>('#key-form').addEventListener('submit', (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement,
        line = form.querySelector<HTMLElement>('.form-status')!
      run(
        line,
        async () => {
          const { key } = await api('keys', 'POST', {
            serverId: (form.elements.namedItem('serverId') as HTMLInputElement).value
              .trim()
              .toLowerCase(),
            label: (form.elements.namedItem('label') as HTMLInputElement).value,
          })
          form.reset()
          loadKeys()
          line.replaceChildren(
            'Ключ создан. Скопируйте его сейчас — больше он показан не будет:',
            el('div', { className: 'secret', textContent: key }),
          )
        },
        form,
      ).then(() => {
        if (!line.firstElementChild && line.textContent === 'Выполняем…') line.textContent = ''
      })
    })

    // ---------- Journal ----------
    /** [past tense, infinitive for a failed attempt, rest of the sentence]. */
    function sentence(a: any): [string, string, string] {
      let d: any = {}
      try {
        d = a.detail ? JSON.parse(a.detail) : {}
      } catch {
        // Legacy journal details may be plain text rather than JSON.
      }
      const player = d.player ?? a.target,
        reason = d.reason ? `, причина: «${d.reason}»` : ''
      const match = d.room ? ` «${d.room.name}»${d.room.map ? ` на карте ${d.room.map}` : ''}` : ''
      const result = d.mode ? ` «${matchTitle(d)}» от ${date(d.endedAt)}` : ''
      const cls = ` «${CLASS_NAMES[a.target] ?? 'неизвестный'}»`
      switch (a.action) {
        case 'mode':
          return a.target === 'workshop'
            ? ['включил', 'включить', ' мастерскую']
            : d.recover
              ? ['восстановил', 'восстановить', ' игровой режим']
              : ['вернул', 'вернуть', ' игровой режим']
        case 'cancel':
          return ['отменил', 'отменить', ' переключение режима']
        case 'message':
          return ['изменил', 'изменить', ` сообщение для игроков: «${d.message ?? ''}»`]
        case 'rcon:say':
          return ['написал', 'написать', ` всем: «${d.text ?? ''}»`]
        case 'rcon:kick':
          return ['выгнал', 'выгнать', ` игрока ${player}${reason}`]
        case 'rcon:ban':
          return ['забанил', 'забанить', ` игрока ${player}${reason}`]
        case 'rcon:pardon':
          return ['разбанил', 'разбанить', ` игрока ${player}`]
        case 'rcon:team-kick':
          return ['убрал', 'убрать', ` игрока ${player} из матча`]
        case 'rcon:class-lock':
          return ['закрыл', 'закрыть', ` класс${cls}`]
        case 'rcon:class-unlock':
          return ['открыл', 'открыть', ` класс${cls}`]
        case 'rcon:range':
          return a.target === 'open'
            ? ['открыл', 'открыть', ' полигон']
            : a.target === 'close'
              ? ['закрыл', 'закрыть', ' полигон']
              : ['сбросил', 'сбросить', ' полигон']
        case 'rcon:stop-room':
          return [
            'завершил',
            'завершить',
            ` матч${match} — ${(OUTCOMES.find((o) => o[0] === d.outcome)?.[1] ?? 'без итога').toLowerCase()}${reason}`,
          ]
        case 'rcon:maintenance-status':
          return ['проверил', 'проверить', ' состояние техработ']
        case 'rcon:drain':
          return ['запретил', 'запретить', ' начинать новые матчи']
        case 'rcon:interrupt':
          return ['прервал', 'прервать', ` все матчи${reason}`]
        case 'settings':
          return ['изменил', 'изменить', ' настройки игры']
        case 'role-grant':
          return [
            'назначил',
            'назначить',
            ` ${d.name ?? 'игрока'} на роль «${ROLES[d.role]?.name ?? 'участник'}»`,
          ]
        case 'role-revoke':
          return ['убрал', 'убрать', ` ${d.name ?? 'игрока'} из команды`]
        case 'workshop-sync':
          return ['обновил', 'обновить', ' доступ в мастерскую']
        case 'workshop-maps':
          return ['изменил', 'изменить', ` карты для ${d.name ?? 'строителя'} в мастерской`]
        case 'workshop-candidate':
          return [
            'отправил',
            'отправить',
            ` на проверку карту «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»${d.from === 'game' ? ' (из игры)' : ''}`,
          ]
        case 'workshop-publish':
          return [
            'выложил',
            'выложить',
            ` в игру карту «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`,
          ]
        case 'workshop-reject':
          return [
            'отклонил',
            'отклонить',
            ` версию карты «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`,
          ]
        case 'workshop-rollback':
          return ['откатил', 'откатить', ` карту «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`]
        case 'workshop-map-access':
          return d.from === 'game'
            ? [
                d.allowed ? 'разрешил' : 'запретил',
                d.allowed ? 'разрешить' : 'запретить',
                ` ${d.target ?? 'строителю'} строить: «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}» (из игры)`,
              ]
            : [
                'изменил',
                'изменить',
                ` список строителей: «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`,
              ]
        case 'result-void':
          return ['исключил', 'исключить', ` из статистики матч${result}`]
        case 'result-restore':
          return ['вернул', 'вернуть', ` в статистику матч${result}`]
        case 'ingest-key-create':
          return ['создал', 'создать', ` ключ приёма результатов «${d.label ?? ''}»`]
        case 'ingest-key-revoke':
          return ['отозвал', 'отозвать', ' ключ приёма результатов']
        case 'rcon:raw':
          return [
            'выполнил',
            'выполнить',
            a.target
              ? ` в консоли: «${a.target}»${d.rejected ? ' — сервер не принял' : ''}`
              : ' команду в консоли',
          ]
        default:
          return ['выполнил', 'выполнить', ' действие в панели']
      }
    }
    async function loadAudit() {
      const { entries } = await api('audit')
      const shown = entries.filter((a: any) => a.action !== 'rcon:list')
      $('#audit-list').replaceChildren(
        ...(shown.length
          ? shown.map((a: any) => {
              const [past, attempt, rest] = sentence(a),
                error = friendly(String(a.error ?? '').replace(/\s\(.*\)$/, ''), 400)
              return el(
                'li',
                { className: a.ok ? '' : 'failed' },
                el(
                  'span',
                  {},
                  el('strong', { textContent: a.actorName }),
                  a.ok ? ` ${past}${rest}` : ` пытался ${attempt}${rest} — `,
                  a.ok
                    ? null
                    : el('span', {
                        className: 'fail',
                        textContent: `не получилось: ${error.charAt(0).toLowerCase()}${error.slice(1)}`,
                      }),
                ),
                el('time', {
                  dateTime: new Date(a.at).toISOString(),
                  title: date(a.at),
                  textContent: ago(a.at),
                }),
              )
            })
          : [el('li', { className: 'empty', textContent: 'Пока никто ничего не делал.' })]),
      )
    }

    // ---------- Performance ----------
    type Sample = {
      at: number
      tps: number
      msptAvg: number
      msptMax: number
      heapUsedMb: number | null
      heapMaxMb: number | null
      startedAt: number | null
    }
    type ServerEvent = {
      serverId: string
      id: string
      at: number
      kind: string
      durationMs: number | null
      source: string | null
      message: string
      repeats: number
    }
    const EVENT_KINDS: Record<string, string> = {
      freeze: 'Фриз',
      error: 'Ошибка',
      crash: 'Падение',
      warning: 'Предупреждение',
    }
    // Below this the server visibly lags: 18 TPS is a 10% slowdown, a single 1 s tick is a freeze players notice.
    const LAG_TPS = 18
    const hourFormat = new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'UTC',
    })
    const ms = (n: number) => `${number(Math.round(n))} мс`
    const tps = (n: number) => n.toLocaleString('ru-RU', { maximumFractionDigits: 1 })
    let health: { samples: Sample[]; events: ServerEvent[]; lastSampleAt: number | null } = {
      samples: [],
      events: [],
      lastSampleAt: null,
    }
    function memory(s: Sample) {
      return s.heapUsedMb === null
        ? ''
        : `, память ${number(s.heapUsedMb)}${s.heapMaxMb ? ` из ${number(s.heapMaxMb)}` : ''} МБ`
    }
    function renderHealthCard() {
      const card = $('#health-card'),
        last = health.samples.at(-1),
        hourAgo = Date.now() - 3_600_000
      const set = (tone: string, headline: string, detail: string) => {
        card.dataset.tone = tone
        $('#health-headline').textContent = headline
        $('#health-detail').textContent = detail
      }
      // No data is not a healthy server: say so instead of showing green.
      if (health.lastSampleAt === null)
        return set(
          'warn',
          'Сервер не присылал замеров',
          'Пока замеров нет, судить о сервере нельзя. Тики прямо сейчас можно проверить ниже.',
        )
      if (!last || health.lastSampleAt < Date.now() - 3 * 60_000)
        return set(
          'bad',
          `Замеры не приходят с ${date(health.lastSampleAt)}`,
          'Сервер мог зависнуть, упасть или потерять связь с сайтом. Проверьте тики ниже и логи сервера.',
        )
      const recent = health.samples.filter((s) => s.at >= hourAgo),
        freezes = health.events
          .filter((e) => e.kind === 'freeze' && e.at >= hourAgo)
          .reduce((n, e) => n + e.repeats, 0),
        errors = health.events
          .filter((e) => e.kind !== 'freeze' && e.kind !== 'warning' && e.at >= hourAgo)
          .reduce((n, e) => n + e.repeats, 0),
        worst = Math.min(...recent.map((s) => s.tps))
      const now = `Сейчас TPS ${tps(last.tps)}, тик в среднем ${ms(last.msptAvg)}${memory(last)}.`
      if (worst < LAG_TPS || freezes || errors)
        return set(
          'warn',
          'За последний час были проблемы',
          `${now} За час: TPS падал до ${tps(worst)}, фризов ${freezes}, ошибок ${errors}.`,
        )
      set('ok', 'Сервер работает ровно', now)
    }
    function renderHours() {
      const hours = new Map<number, Sample[]>()
      for (const s of health.samples) {
        const hour = Math.floor(s.at / 3_600_000) * 3_600_000
        hours.set(hour, [...(hours.get(hour) ?? []), s])
      }
      $('#hour-list').replaceChildren(
        ...(hours.size
          ? [...hours].reverse().map(([hour, list]) => {
              const inHour = (e: ServerEvent) => e.at >= hour && e.at < hour + 3_600_000,
                freezes = health.events
                  .filter((e) => e.kind === 'freeze' && inHour(e))
                  .reduce((n, e) => n + e.repeats, 0),
                errors = health.events
                  .filter((e) => (e.kind === 'error' || e.kind === 'crash') && inHour(e))
                  .reduce((n, e) => n + e.repeats, 0),
                worst = Math.min(...list.map((s) => s.tps)),
                heap = Math.max(...list.map((s) => s.heapUsedMb ?? 0)),
                restart = list.find(
                  (s) =>
                    s.startedAt !== null && s.startedAt >= hour && s.startedAt < hour + 3_600_000,
                )
              return el(
                'li',
                {},
                el(
                  'span',
                  {},
                  el('span', {
                    className: worst < LAG_TPS ? 'bad' : '',
                    textContent: `TPS от ${tps(worst)}`,
                  }),
                  `, худший тик ${ms(Math.max(...list.map((s) => s.msptMax)))}`,
                  heap ? `, память до ${number(heap)} МБ` : '',
                  freezes ? `, фризов ${freezes}` : '',
                  errors ? `, ошибок ${errors}` : '',
                  restart ? `, перезапуск ${date(restart.startedAt!)}` : '',
                ),
                el('time', {
                  dateTime: new Date(hour).toISOString(),
                  textContent: `${hourFormat.format(hour)} UTC`,
                }),
              )
            })
          : [el('li', { className: 'empty', textContent: 'Замеров за сутки нет.' })]),
      )
    }
    function shownEvents() {
      const kind = $<HTMLSelectElement>('#event-kind').value,
        query = $<HTMLInputElement>('#event-search').value.trim().toLowerCase()
      return health.events.filter(
        (e) =>
          (!kind || e.kind === kind || (kind === 'error' && e.kind === 'crash')) &&
          (!query || `${e.source ?? ''} ${e.message}`.toLowerCase().includes(query)),
      )
    }
    const eventTitle = (e: ServerEvent) =>
      [
        EVENT_KINDS[e.kind] ?? e.kind,
        e.durationMs !== null ? ms(e.durationMs) : '',
        e.source ?? '',
        e.repeats > 1 ? `×${number(e.repeats)}` : '',
      ]
        .filter(Boolean)
        .join(' · ')
    function renderEvents() {
      const list = shownEvents()
      $('#event-list').replaceChildren(
        ...(list.length
          ? list.map((e) =>
              el(
                'li',
                { className: e.kind === 'warning' ? '' : 'failed' },
                el('strong', { textContent: eventTitle(e) }),
                el('time', {
                  dateTime: new Date(e.at).toISOString(),
                  title: date(e.at),
                  textContent: `${hourFormat.format(e.at)} UTC`,
                }),
                el('pre', { className: 'server-text', textContent: e.message }),
              ),
            )
          : [
              el('li', {
                className: 'empty',
                textContent: health.events.length
                  ? 'Под фильтр ничего не подходит.'
                  : 'Сервер не присылал фризов и ошибок за две недели.',
              }),
            ]),
      )
    }
    async function loadHealth() {
      health = await api('diagnostics')
      renderHealthCard()
      renderHours()
      renderEvents()
    }
    $('#event-kind').addEventListener('change', renderEvents)
    $('#event-search').addEventListener('input', renderEvents)
    customSelect($<HTMLSelectElement>('#event-kind'))
    $('#event-copy').addEventListener('click', () =>
      run($('#event-status'), async () => {
        const list = shownEvents()
        if (!list.length) return 'Копировать нечего.'
        await navigator.clipboard.writeText(
          list
            .map((e) => `${new Date(e.at).toISOString()} ${eventTitle(e)}\n${e.message}`)
            .join('\n\n'),
        )
        return `Скопировано записей: ${list.length}.`
      }),
    )
    $('#event-export').addEventListener('click', () => {
      const stamp = new Date().toISOString().replace(/[:.]/g, '-'),
        link = el('a', {
          href: URL.createObjectURL(
            new Blob(
              [
                JSON.stringify(
                  {
                    exportedAt: new Date().toISOString(),
                    samples: health.samples,
                    events: shownEvents(),
                  },
                  null,
                  2,
                ),
              ],
              { type: 'application/json' },
            ),
          ),
          download: `blockfield-diagnostics-${stamp}.json`,
        })
      link.click()
      setTimeout(() => URL.revokeObjectURL(link.href), 0)
    })
    const TICK_STATES: Record<string, string> = {
      running: 'Сервер успевает',
      lagging: 'Сервер не успевает за тиками',
      frozen: 'Тики заморожены командой tick freeze',
      sprinting: 'Идёт ускоренная прокрутка тиков',
    }
    $('#live-check').addEventListener('click', () =>
      run(
        $('#live-status'),
        async () => {
          const t = await api('diagnostics/live')
          const values: [string, string][] = [
            ['TPS', `${tps(t.tps)} из ${tps(t.targetTps)}`],
            ['Тик в среднем', ms(t.msptAvg)],
            ...(t.msptP95 !== null
              ? ([['95% тиков быстрее', ms(t.msptP95)]] as [string, string][])
              : []),
            ...(t.msptP99 !== null
              ? ([['99% тиков быстрее', ms(t.msptP99)]] as [string, string][])
              : []),
          ]
          const dl = $('#live-values')
          dl.replaceChildren(
            ...values.map(([k, v]) =>
              el('div', {}, el('dt', { textContent: v }), el('dd', { textContent: k })),
            ),
          )
          dl.hidden = false
          const verdict = `${TICK_STATES[t.state] ?? t.state} — ${date(t.at)}.`
          // A lagging or frozen server is the bad news this check exists for: show it in the error tone.
          if (t.state === 'lagging' || t.state === 'frozen') throw new Error(verdict)
          return verdict
        },
        $('#live-check').parentElement,
      ),
    )

    // ---------- Console ----------
    const history: string[] = []
    let historyAt = 0
    const consoleInput = $<HTMLInputElement>('#console-input')
    consoleInput.addEventListener('keydown', (e) => {
      if ((e.key !== 'ArrowUp' && e.key !== 'ArrowDown') || !history.length) return
      e.preventDefault()
      historyAt = Math.max(0, Math.min(history.length, historyAt + (e.key === 'ArrowUp' ? -1 : 1)))
      consoleInput.value = history[historyAt] ?? ''
    })
    function consoleLine(command: string, text: string, bad: boolean) {
      const out = $('#console-output')
      out.append(
        el('span', { className: 'cmd', textContent: `> ${command}\n` }),
        el('span', { className: bad ? 'bad' : '', textContent: `${text || '(пустой ответ)'}\n` }),
      )
      // Keep the last 100 exchanges; the full record is the journal.
      while (out.childElementCount > 200) out.firstElementChild!.remove()
      out.scrollTop = out.scrollHeight
    }
    $<HTMLFormElement>('#console-form').addEventListener('submit', async (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement,
        command = consoleInput.value.trim().replace(/^\/+/, '').trim()
      if (!command) return
      if (history.at(-1) !== command) history.push(command)
      historyAt = history.length
      if (
        dangerousCommand(command) &&
        !(await ask({
          title: 'Выполнить опасную команду?',
          text: `«${command}» может остановить сервер, изменить доступ или необратимо изменить мир и игроков.`,
          ok: 'Выполнить',
          danger: true,
        }))
      )
        return
      run(
        form.querySelector<HTMLElement>('.form-status')!,
        async () => {
          const reply = await api('rcon/raw', 'POST', { command }).catch((error: Error) => {
            consoleLine(command, error.message, true)
            throw error
          })
          consoleLine(command, reply.output, reply.rejected)
          consoleInput.value = ''
          if (reply.rejected) throw new Error('Сервер не принял команду.')
        },
        form,
      )
    })

    // ---------- Tabs and start ----------
    function showTab(id: string, focus: boolean) {
      const tabs = [...document.querySelectorAll<HTMLAnchorElement>('#tabs a')]
      const current = tabs.find((t) => t.hash === `#${id}`) ?? tabs[0]
      if (!current) return
      tabs.forEach((t) =>
        t === current ? t.setAttribute('aria-current', 'page') : t.removeAttribute('aria-current'),
      )
      document
        .querySelectorAll<HTMLElement>('main > section')
        .forEach((s) => (s.hidden = `#${s.id}` !== current.hash))
      if (focus) document.querySelector<HTMLElement>(`${current.hash} h2`)?.focus()
    }
    addEventListener('hashchange', () => showTab(location.hash.slice(1), true))

    $<HTMLFormElement>('#message-form').addEventListener('submit', (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement,
        line = form.querySelector<HTMLElement>('.form-status')!
      run(
        line,
        async () => {
          const { id } = await api('message', 'POST', {
            message: $<HTMLTextAreaElement>('#message').value,
          })
          follow(line, id, 'Сообщение сохранено. Игроки увидят его, когда сервер будет закрыт.')
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
        },
        form,
      )
    })
    const RANGE: Record<string, { title: string; text: string; ok: string; done: string }> = {
      open: {
        title: 'Открыть полигон?',
        text: 'Игроки смогут заходить на тренировочную площадку.',
        ok: 'Открыть',
        done: 'Полигон открыт.',
      },
      close: {
        title: 'Закрыть полигон?',
        text: 'Все, кто сейчас на полигоне, вернутся в лобби.',
        ok: 'Закрыть',
        done: 'Полигон закрыт.',
      },
      reset: {
        title: 'Сбросить полигон?',
        text: 'Площадка вернётся в исходное состояние, игроки на ней вернутся в лобби.',
        ok: 'Сбросить',
        done: 'Полигон сброшен.',
      },
    }
    document.querySelectorAll<HTMLButtonElement>('[data-range]').forEach((b) =>
      b.addEventListener('click', async () => {
        const spec = RANGE[b.dataset.range!]
        if (!(await ask({ ...spec, danger: b.dataset.range !== 'open' }))) return
        run(
          $('#range-status'),
          async () => {
            await api('rcon', 'POST', { action: 'range', op: b.dataset.range })
            return spec.done
          },
          b.parentElement,
        )
      }),
    )
    $('#drain').addEventListener('click', async () => {
      if (
        !(await ask({
          title: 'Не начинать новые матчи?',
          text: 'Идущие матчи доиграют, а новые начаться не смогут. Используйте перед техработами, если мастерская не нужна.',
          ok: 'Не начинать новые',
          danger: true,
        }))
      )
        return
      run(
        $('#maint-status'),
        async () => {
          await api('rcon', 'POST', { action: 'drain' })
          return 'Новые матчи больше не начинаются.'
        },
        $('#drain').parentElement,
      )
    })
    $('#interrupt').addEventListener('click', async () => {
      const answer = await ask({
        title: 'Прервать все матчи?',
        text: 'Все идущие матчи сразу остановятся без победителя, игроки вернутся в лобби. Это нельзя отменить.',
        ok: 'Прервать все матчи',
        danger: true,
        fields: [reasonField('Причина (увидят все игроки)', true)],
      })
      if (!answer) return
      run(
        $('#maint-status'),
        async () => {
          await api('rcon', 'POST', { action: 'interrupt', reason: String(answer.get('reason')) })
          loadOverview()
          return 'Все матчи прерваны.'
        },
        $('#interrupt').parentElement,
      )
    })
    $<HTMLFormElement>('#say-form').addEventListener('submit', (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement,
        input = $<HTMLInputElement>('#say-text')
      run(
        form.querySelector<HTMLElement>('.form-status')!,
        async () => {
          await api('rcon', 'POST', { action: 'say', text: input.value })
          input.value = ''
          return 'Объявление отправлено.'
        },
        form,
      )
    })
    $<HTMLFormElement>('#byname-form').addEventListener('submit', (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement
      playerAction(
        (e.submitter as HTMLButtonElement | null)?.value || 'kick',
        $<HTMLInputElement>('#byname').value,
        form.querySelector<HTMLElement>('.form-status')!,
      )
    })
    $('#online-refresh').addEventListener('click', () => {
      $('#online-summary').textContent = 'Обновляем…'
      loadOnline()
    })

    /** Знакомые никнеймы в поля ввода: подсказка, а не ограничение — своё значение всегда можно вписать. */
    async function loadPlayerHints() {
      const inputs = [$<HTMLInputElement>('#byname'), $<HTMLInputElement>('#grant-name')].filter(
        Boolean,
      )
      if (!inputs.length) return
      const setters = inputs.map((input) => customCombo(input))
      const { players } = await api('players')
      setters.forEach((set) => set(players))
    }

    const failed = (where: string) => (error: Error) => {
      const w = $('#whoami')
      w.append(el('span', { className: 'error', textContent: ` ${where}: ${error.message}` }))
    }
    api('me').then(
      async (data: Me & { role: string | null }) => {
        me = data
        const who = $('#whoami')
        if (!me.role) {
          who.textContent =
            'У вашего аккаунта нет доступа к панели. Попросите администратора добавить вас в команду.'
          return
        }
        who.replaceChildren(
          'Вы вошли как ',
          el('strong', { textContent: me.name }),
          ` — ${ROLES[me.role].name.toLowerCase()}. ${ROLES[me.role].about}`,
        )
        document.querySelectorAll<HTMLElement>('[data-perm]').forEach((node) => {
          node.hidden = !can(node.dataset.perm!)
        })
        if (!can('ban'))
          $('#byname-about').textContent =
            'Если игрока нет в списке «Сейчас на сервере», его можно выгнать по никнейму.'
        const sections = [...document.querySelectorAll<HTMLElement>('main > section:not([hidden])')]
        const nav = $('#tabs')
        nav.replaceChildren(
          ...sections.map((s) => el('a', { href: `#${s.id}`, textContent: s.dataset.tab })),
        )
        nav.hidden = false
        showTab(location.hash.slice(1), false)
        const loaders: [string, () => Promise<void>, string][] = [
          ['view', loadOverview, 'Обзор'],
          ['moderate', loadOnline, 'Игроки'],
          ['ban', loadBans, 'Забаненные'],
          ['settings', () => loadSettings(), 'Настройки'],
          ['settings', loadGunBalance, 'Баланс оружия'],
          ['roles', loadTeam, 'Команда'],
          ['workshop', loadCandidates, 'Кандидаты'],
          ['workshop', loadMapHistory, 'Архив карт'],
          ['stats', loadResults, 'Статистика'],
          ['stats', loadSeasons, 'Сезоны'],
          ['stats', loadKeys, 'Ключи'],
          ['audit', loadAudit, 'Журнал'],
          ['diagnostics', loadHealth, 'Производительность'],
          ['moderate', loadPlayerHints, 'Подсказки игроков'],
        ]
        await Promise.all(
          loaders
            .filter(([permission]) => can(permission))
            .map(([, load, where]) => load().catch(failed(where))),
        )
        setInterval(() => {
          if (document.visibilityState === 'visible') loadOverview().catch(() => {})
        }, 15_000)
        if (can('diagnostics'))
          setInterval(() => {
            if (document.visibilityState === 'visible') loadHealth().catch(() => {})
          }, 60_000)
      },
      (error: Error & { raw?: string }) => {
        const who = $('#whoami')
        if (/Войдите|Сессия/.test(error.raw ?? ''))
          who.replaceChildren(
            'Войдите в ',
            el('a', { href: '/account', textContent: 'аккаунт' }),
            ', чтобы открыть панель управления.',
          )
        else say(who, error.message, 'error')
      },
    )
  </script>
</Site>
