---
import Site from '../layouts/Site.astro'
import { siteIdentity } from '../lib/admin'
// Оболочку панели видят только участники команды; права на данные отдельно проверяет /api/admin.
const identity = await siteIdentity(Astro.cookies).catch(() => null)
if (!identity?.hasAdminAccess) return Astro.redirect(identity ? '/' : '/account', 302)
Astro.response.headers.set('Cache-Control', 'no-store')
---

<Site title="Панель управления — Blockfield" noindex>
  <main id="content" class="page-main admin-main">
    <aside class="side" aria-label="Панель управления">
      <h1 class="console-title">Панель управления</h1>
      <nav id="tabs" class="tabs" aria-label="Разделы панели" hidden></nav>
      <div class="now" id="side-now">
        <p class="label">Сейчас на сервере</p>
        <p class="muted">загрузка…</p>
      </div>
      <p id="whoami" class="me" role="status">
        Проверяем доступ…
      </p>
    </aside>
    <div class="workspace">
      <div class="strip" aria-label="Состояние сервера">
        <span class="lamp" id="lamp" data-tone="warn" role="status">
          загрузка…
        </span>
        <span class="stat">
          онлайн <b id="s-online">—</b>
        </span>
        <span class="stat">
          матчей <b id="s-matches">—</b>
        </span>
        <span class="stat">
          TPS <b id="s-tps">—</b>
        </span>
        <span class="who" id="who">
          <span>в панели:</span>
        </span>
        <span class="conn lamp" id="conn" role="status">
          нет связи
        </span>
      </div>
      <div class="admin-content">
        <section
          id="overview"
          data-perm="view"
          data-tab="Обзор"
          hidden
          aria-labelledby="overview-title"
        >
          <h2 id="overview-title" tabindex="-1">
            Обзор
          </h2>
          <div id="server-card" class="hero" data-tone="wait">
            <span class="dot" aria-hidden="true"></span>
            <div>
              <p class="headline" id="server-headline">
                загрузка…
              </p>
              <p id="server-detail" class="muted"></p>
            </div>
          </div>
          <div class="panel group" data-perm="view" aria-labelledby="mode-title">
            <header class="stack-head">
              <h3 id="mode-title">Игра и мастерская</h3>
              <p class="muted">Игра продолжится, пока команда работает над картами.</p>
            </header>
            <p class="form-status" id="mode-progress" role="status"></p>
            <div id="mode-options" class="options"></div>
            <p class="form-status" id="mode-status" role="status"></p>
          </div>
          <div class="panel group" data-perm="message" aria-labelledby="message-title">
            <header class="stack-head">
              <h3 id="message-title">Сообщение мастерской</h3>
              <p class="muted">Что команда увидит при входе, пока мастерская закрыта.</p>
            </header>
            <form id="message-form" class="form-stack">
              <label for="message">Текст сообщения</label>
              <textarea
                id="message"
                name="message"
                maxlength="200"
                rows="3"
                required
                aria-describedby="message-hint"
              ></textarea>
              <small id="message-hint">
                Например: «Обновляем карты, вернёмся к 20:00». До 200 символов.
              </small>
              <p class="form-status" role="status"></p>
            </form>
          </div>
          <div class="panel group" data-perm="moderate" aria-labelledby="quick-title">
            <header class="stack-head">
              <h3 id="quick-title">Быстрые действия</h3>
            </header>
            <div class="quick-group">
              <h4 id="range-title">Полигон</h4>
              <p class="muted">Площадка в лобби, где пристреливают оружие.</p>
              <div class="actions">
                <button type="button" data-range="open">
                  Открыть
                </button>
                <button type="button" data-range="close">
                  Закрыть
                </button>
                <button type="button" data-range="reset">
                  Сбросить
                </button>
              </div>
              <p class="form-status" id="range-status" role="status"></p>
            </div>
            <div class="quick-group quick-group--warn" data-perm="maintenance">
              <h4 id="maint-title">Техработы и аварии</h4>
              <p class="muted">Идущие матчи можно закончить перед техработами игры.</p>
              <div class="actions">
                <button type="button" id="drain">
                  Не начинать новые матчи
                </button>
                <button type="button" id="interrupt" class="danger">
                  Прервать все матчи
                </button>
              </div>
              <p class="form-status" id="maint-status" role="status"></p>
            </div>
          </div>
        </section>

        <section
          id="players"
          data-perm="moderate"
          data-tab="Игроки"
          hidden
          aria-labelledby="players-title"
        >
          <h2 id="players-title" tabindex="-1">
            Игроки
          </h2>
          <div class="panel group" aria-labelledby="online-title">
            <header class="stack-head stack-head--row">
              <h3 id="online-title">Сейчас на сервере</h3>
              <button type="button" id="online-refresh" class="small">
                Обновить
              </button>
            </header>
            <p id="online-summary" class="muted" role="status">
              загрузка…
            </p>
            <ul id="online-list" class="rows"></ul>
          </div>
          <div class="panel group" aria-labelledby="say-title">
            <header class="stack-head">
              <h3 id="say-title">Объявление всем</h3>
              <p class="muted">Сообщение сразу появится в чате у всех, кто сейчас на сервере.</p>
            </header>
            <form id="say-form" class="form-stack">
              <label for="say-text">Текст объявления</label>
              <input id="say-text" name="text" maxlength="120" required autocomplete="off" />
              <div class="actions">
                <button class="primary" type="submit">
                  Отправить всем
                </button>
              </div>
              <p class="form-status" role="status"></p>
            </form>
          </div>
          <div class="panel group" aria-labelledby="byname-title">
            <header class="stack-head">
              <h3 id="byname-title">Найти по никнейму</h3>
              <p class="muted" id="byname-about">
                Для тех, кого сейчас нет на сервере. Начните вводить никнейм — подскажем знакомые.
              </p>
            </header>
            <form id="byname-form" class="form-stack">
              <label for="byname">Никнейм игрока</label>
              <input
                id="byname"
                name="player"
                required
                pattern="[A-Za-z0-9_]{3,16}"
                autocomplete="off"
                aria-describedby="byname-hint"
              />
              <small id="byname-hint">Точно как в игре: латинские буквы, цифры и _.</small>
              <div class="actions">
                <button type="submit" value="kick">
                  Выгнать
                </button>
                <button type="submit" value="ban" data-perm="ban" class="danger">
                  Забанить
                </button>
                <button type="submit" value="pardon" data-perm="ban">
                  Разбанить
                </button>
              </div>
              <p class="form-status" role="status"></p>
            </form>
          </div>
          <div class="panel group" data-perm="ban" aria-labelledby="bans-title">
            <header class="stack-head">
              <h3 id="bans-title">Забаненные игроки</h3>
              <p class="muted">Баны из панели. Бан из игры можно снять по никнейму.</p>
            </header>
            <ul id="ban-list" class="rows"></ul>
            <p class="form-status" id="ban-status" role="status"></p>
          </div>
        </section>

        <section
          id="matches"
          data-perm="view"
          data-tab="Матчи"
          hidden
          aria-labelledby="matches-title"
        >
          <h2 id="matches-title" tabindex="-1">
            Матчи
          </h2>
          <p class="muted">Текущие бои и набор игроков.</p>
          <p class="form-status" id="room-status" role="status"></p>
          <div id="room-list" class="cards"></div>
        </section>

        <section
          id="settings"
          data-perm="settings"
          data-tab="Настройки игры"
          hidden
          aria-labelledby="settings-title"
        >
          <h2 id="settings-title" tabindex="-1">
            Настройки игры
          </h2>
          <p id="settings-state" class="banner" role="status">
            загрузка…
          </p>
          <form id="settings-form" class="form-stack">
            <section class="group settings-group" aria-labelledby="settings-group-1">
              <header>
                <h2 id="settings-group-1">Комнаты</h2>
                <span class="hint">Новые значения увидит следующий матч</span>
              </header>
              <div id="room-fields" class="fields"></div>
            </section>
            <section class="group settings-group" aria-labelledby="settings-group-0">
              <header>
                <h2 id="settings-group-0">Лобби</h2>
              </header>
              <div class="fields">
                <div class="field row">
                  <label for="pvp">PvP в лобби</label>
                  <div class="ctl">
                    <select id="pvp" name="pvpEnabled">
                      <option value="true">Включено</option>
                      <option value="false">Выключено</option>
                    </select>
                  </div>
                  <span class="state" role="status"></span>
                </div>
              </div>
              <div id="lobby-fields" class="fields"></div>
            </section>
            <section class="group settings-group" aria-labelledby="settings-group-3">
              <header>
                <h2 id="settings-group-3">Стоимость высадки</h2>
                <span class="hint">0 — бесплатно · штурмовик и марксман бесплатны</span>
              </header>

              <div id="class-costs" class="fields"></div>
            </section>
            <section class="group settings-group" aria-labelledby="settings-group-4">
              <header>
                <h2 id="settings-group-4">Доступные классы</h2>
                <span class="state" role="status"></span>
                <span class="hint">Кто уже играет, доиграет ещё три минуты</span>
              </header>

              <div id="class-list" class="checks"></div>
            </section>
            <section class="group settings-group" aria-labelledby="settings-group-2">
              <header>
                <h2 id="settings-group-2">Каждый сам за себя</h2>
              </header>
              <div id="deathmatch-fields" class="fields"></div>
            </section>
            <section class="group settings-group" aria-labelledby="settings-group-5">
              <header>
                <h2 id="settings-group-5">Ограничения паркура</h2>
                <span class="state" role="status"></span>
              </header>
              <small class="muted">
                Разрешённые движения. Без своего списка действуют обычные ограничения.
              </small>
              <label class="check">
                <input type="checkbox" id="parcool-on" />
                Свой список движений
              </label>
              <div id="parcool-list" class="checks"></div>
            </section>
            <section class="group settings-group" aria-labelledby="settings-group-6">
              <header>
                <h2 id="settings-group-6">Баланс матчей</h2>
                <span class="hint">Новые значения увидит следующий матч</span>
              </header>

              <div class="scope">
                <label for="scope">Для каких матчей</label>
                <select id="scope"></select>
                <small id="scope-hint"></small>
              </div>
              <div id="balance-fields"></div>
            </section>
            <div class="savebar">
              <p class="savebar__meta" id="settings-meta" role="status"></p>
              <span id="settings-applied-by" hidden></span>
              <p class="form-status" role="status"></p>
            </div>
          </form>
        </section>

        <section
          id="weapons"
          data-perm="settings"
          data-tab="Оружие"
          hidden
          aria-labelledby="weapons-title"
        >
          <h2 id="weapons-title" tabindex="-1">
            Оружие
          </h2>
          <p class="muted">
            Новый баланс действует и в текущих матчах. Внешний вид и звуки оружия сохранятся.
          </p>
          <p id="gun-balance-status" class="form-status" role="status">
            загрузка…
          </p>
          <p id="gun-orphans" class="form-status" role="status" hidden></p>
          <form id="gun-balance-form" class="form-stack" hidden>
            <section class="group settings-group gun-group" aria-labelledby="gun-group-title">
              <header>
                <h2 id="gun-group-title">Оружие</h2>
              </header>
              <div class="fields">
                <div class="field row">
                  <label for="gun-search">Найти оружие</label>
                  <div class="ctl">
                    <input
                      id="gun-search"
                      type="search"
                      placeholder="Название, ID или тип оружия"
                    />
                  </div>
                  <span class="state"></span>
                </div>
                <div class="field row">
                  <label for="gun-select">Оружие</label>
                  <div class="ctl">
                    <select id="gun-select"></select>
                  </div>
                  <span class="state"></span>
                </div>
              </div>
              <p id="gun-about" class="muted"></p>
              <p id="gun-warnings" class="form-status"></p>
            </section>
            <section class="group settings-group gun-group" aria-labelledby="gun-parameters-title">
              <header>
                <h2 id="gun-parameters-title">Параметры</h2>
                <span class="hint">
                  Значения ганпака уже подставлены. Измените поле — сохранится; верните как было или
                  очистите — снова будет значение ганпака.
                </span>
              </header>
              <div id="gun-fields" class="fields"></div>
              <details id="gun-advanced" class="gun-advanced" hidden>
                <summary>Дополнительно</summary>
                <p class="muted">Редкие и сложные настройки, обычному оружию не нужны.</p>
                <div id="gun-advanced-fields" class="fields"></div>
              </details>
            </section>
            <div class="savebar">
              <button id="gun-reset" type="button">
                Сбросить это оружие
              </button>
              <p class="form-status" role="status"></p>
            </div>
          </form>
        </section>

        <section
          id="kits"
          data-perm="settings"
          data-tab="Наборы"
          hidden
          aria-labelledby="kits-title"
        >
          <h2 id="kits-title" tabindex="-1">
            Наборы снаряжения
          </h2>
          <p class="muted">
            Снаряжение для следующих выдач игрокам. Уже выданные предметы останутся у них.
          </p>
          <p id="kits-status" class="form-status" role="status">
            Получаем каталог наборов…
          </p>
          <form id="kits-form" class="form-stack" hidden>
            <div class="panel group">
              <header>
                <h3>Выбрать набор</h3>
              </header>
              <div class="scope">
                <label for="kit-select">Набор</label>
                <select id="kit-select"></select>
              </div>
              <p id="kit-about" class="muted"></p>
              <div class="actions">
                <button id="kit-new" type="button">
                  Создать набор
                </button>
                <button id="kit-reset" type="button">
                  Вернуть стандартный набор
                </button>
                <button id="kits-refresh" type="button">
                  Обновить каталог
                </button>
              </div>
            </div>
            <div id="kit-fields" class="group settings-group"></div>
            <details class="panel group">
              <summary>Фиксированные наборы режимов</summary>
              <p class="muted">
                Фиксированный набор выдаётся бесплатно и убирает меню выбора. «Меню выбора»
                возвращает доступные этому режиму наборы.
              </p>
              <div id="kit-bindings" class="stack group settings-group"></div>
            </details>
            <div class="savebar">
              <p id="kits-meta" class="savebar__meta" role="status"></p>
            </div>
          </form>
        </section>

        <section id="team" data-perm="roles" data-tab="Команда" hidden aria-labelledby="team-title">
          <h2 id="team-title" tabindex="-1">
            Команда
          </h2>
          <p class="muted">Команда и её доступ к игре.</p>
          <section class="group" aria-labelledby="role-legend-title">
            <header>
              <h3 id="role-legend-title">Роли</h3>
            </header>
            <dl id="role-legend" class="legend"></dl>
          </section>
          <div class="group" aria-labelledby="staff-list-title">
            <header>
              <h3 id="staff-list-title">Участники</h3>
            </header>
            <ul id="staff-list" class="rows"></ul>
          </div>
          <p class="form-status" id="staff-status" role="status"></p>
          <div class="panel group" aria-labelledby="grant-title">
            <header class="stack-head">
              <h3 id="grant-title">Добавить в команду</h3>
            </header>
            <form id="grant-form" class="form-stack">
              <label for="grant-name">Никнейм игрока</label>
              <input
                id="grant-name"
                name="nickname"
                required
                pattern="[A-Za-z0-9_]{3,16}"
                autocomplete="off"
                aria-describedby="grant-hint"
              />
              <small id="grant-hint">
                Начните вводить — подскажем тех, кто уже играл. Нужен аккаунт Blockfield.
              </small>
              <fieldset class="plain">
                <legend>Роль</legend>
                <div id="grant-roles" class="radios"></div>
              </fieldset>
              <div class="actions">
                <button class="primary" type="submit">
                  Добавить в команду
                </button>
              </div>
              <p class="form-status" role="status"></p>
            </form>
          </div>
        </section>

        <section
          id="workshop"
          data-perm="view"
          data-tab="Мастерская"
          hidden
          aria-labelledby="workshop-title"
        >
          <h2 id="workshop-title" tabindex="-1">
            Мастерская
          </h2>
          <p class="muted">
            Отдельный сервер, где команда правит карты. Игра в это время работает как обычно.
          </p>
          <div class="hero" id="ws-card" aria-live="polite">
            <span class="dot" aria-hidden="true"></span>
            <div class="ws-card__body">
              <p class="headline" id="ws-headline">
                Проверяем мастерскую…
              </p>
              <p class="muted" id="ws-detail"></p>
              <div class="actions" id="ws-actions"></div>
              <p class="form-status" id="ws-status" role="status"></p>
            </div>
          </div>
          <details class="disclosure ws-flow" open>
            <summary>Как правка попадает в игру</summary>
            <ol>
              <li>
                <strong>Карту открывают в мастерской.</strong> У каждого сеанса своя копия карты —
                ветка. Игроки её не видят.
              </li>
              <li>
                <strong>Строят на сервере мастерской.</strong> Планшет (M) переключает карты и
                размечает точки. Правки в мире копятся в черновике сами.
              </li>
              <li>
                <strong>Сохраняют версию и отправляют на проверку</strong> — в карточке карты ниже
                или с планшета. Несохранённые правки на проверку не попадают.
              </li>
              <li>
                <strong>Администратор принимает версию.</strong> Она идёт в новые матчи, начатые
                доигрывают на прежней. Если те же участки карты за это время успели поменять, он
                выбирает, какой вариант оставить.
              </li>
            </ol>
          </details>
          <div class="stack group" aria-labelledby="candidates-title">
            <header class="stack-head">
              <h3 id="candidates-title">Ждут решения</h3>
            </header>
            <p class="form-status" id="candidates-status" role="status"></p>
            <ul id="candidate-list" class="rows"></ul>
            <details class="disclosure" id="decided" hidden>
              <summary id="decided-summary">Решённые заявки</summary>
              <ul id="decided-list" class="rows"></ul>
            </details>
          </div>
          <div class="stack group" aria-labelledby="map-history-title">
            <header class="stack-head">
              <h3 id="map-history-title">Карты</h3>
              <button id="maps-refresh" class="small" type="button">
                Обновить
              </button>
            </header>
            <p id="map-history-status" class="form-status" role="status">
              Получаем карты…
            </p>
            <div id="map-history" class="maps"></div>
          </div>
          <details class="disclosure" data-perm="mode">
            <summary>Новая карта</summary>
            <p class="muted">
              Пустая площадка с небольшой стартовой платформой. Создать можно, пока мастерская
              открыта: она перезапустится с новой картой, прежний черновик сохранится. Игра
              продолжит работать.
            </p>
            <div id="map-create-controls"></div>
            <p id="map-create-status" class="form-status" role="status"></p>
          </details>
          <div class="stack group" aria-labelledby="map-drafts-title">
            <header class="stack-head">
              <h3 id="map-drafts-title">Сохранённые черновики</h3>
            </header>
            <p class="muted">
              Прошлые сеансы мастерской вместе с несохранёнными правками в мире. К любому можно
              вернуться — текущий черновик тоже сохранится.
            </p>
            <p id="map-drafts-status" class="form-status" role="status"></p>
            <ul id="map-drafts" class="rows"></ul>
            <button id="map-drafts-more" class="small" type="button" hidden>
              Показать ещё
            </button>
          </div>
          <div class="stack group" data-perm="workshop" aria-labelledby="ws-title">
            <header class="stack-head">
              <h3 id="ws-title">Доступ в мастерскую</h3>
              <p id="workshop-state" class="muted">
                Проверяем список…
              </p>
              <button type="button" id="sync" hidden>
                Обновить доступ
              </button>
            </header>
            <p class="form-status" id="sync-status" role="status"></p>
          </div>
          <details class="disclosure" data-perm="settings">
            <summary>Бюджет AI</summary>
            <p class="muted">
              Общий бюджет текущего сеанса или отдельный для участника. Настраивают только
              администраторы сайта; владение картой или сеансом не даёт дополнительных прав.
            </p>
            <p id="ai-budget-status" class="form-status" role="status">
              Получаем политику бюджета…
            </p>
            <div id="ai-budget-form"></div>
            <button id="ai-budget-refresh" type="button" class="small">
              Обновить состояние бюджета
            </button>
          </details>
          <details class="disclosure" data-perm="settings">
            <summary>AI мастерской</summary>
            <p class="muted">
              Включение AI, модели генерации, сторожа и расшифровки, а также ключ OpenRouter. Ключ
              хранится только в мастерской и после сохранения никогда не показывается.
            </p>
            <p id="workshop-ai-status" class="form-status" role="status">
              Получаем настройки…
            </p>
            <form id="workshop-ai-form" class="form-stack">
              <label class="check" for="workshop-ai-enabled">
                <input type="checkbox" id="workshop-ai-enabled" />
                AI включён
              </label>
              <label for="workshop-ai-generation">Модель генерации</label>
              <input
                id="workshop-ai-generation"
                autocomplete="off"
                spellcheck="false"
                maxlength="128"
                placeholder="meta/muse-spark-1.3-contributor"
              />
              <label for="workshop-ai-guard">Сторожевая модель</label>
              <input
                id="workshop-ai-guard"
                autocomplete="off"
                spellcheck="false"
                maxlength="128"
                placeholder="typesafe/jev-1.13"
                aria-describedby="workshop-ai-guard-hint"
              />
              <small id="workshop-ai-guard-hint" class="muted">
                Только typesafe/jev-…: сторож ходит в Typesafe API.
              </small>
              <label for="workshop-ai-transcription">Модель расшифровки</label>
              <select id="workshop-ai-transcription">
                <option value="elevenlabs/scribe-v2">elevenlabs/scribe-v2</option>
                <option value="openai/whisper-1">openai/whisper-1</option>
              </select>
              <div class="actions">
                <button class="primary" type="submit">
                  Сохранить AI мастерской
                </button>
              </div>
            </form>
            <div class="group" aria-labelledby="workshop-ai-key-title">
              <header class="stack-head">
                <h3 id="workshop-ai-key-title">Ключ OpenRouter</h3>
              </header>
              <p class="muted">
                Ключ виден только сейчас: после сохранения поле очищается и значение не
                подставляется.
              </p>
              <label for="workshop-ai-key">Новый ключ</label>
              <input
                id="workshop-ai-key"
                type="password"
                autocomplete="new-password"
                spellcheck="false"
                maxlength="2048"
              />
              <div class="actions">
                <button id="workshop-ai-key-save" type="button" class="primary">
                  Сохранить ключ
                </button>
                <button id="workshop-ai-key-delete" type="button" class="small danger">
                  Удалить ключ
                </button>
              </div>
              <p id="workshop-ai-key-status" class="form-status" role="status">
                Проверяем ключ…
              </p>
            </div>
            <button id="workshop-ai-refresh" type="button" class="small">
              Обновить состояние AI
            </button>
          </details>
        </section>

        <section
          id="stats"
          data-perm="stats"
          data-tab="Статистика"
          hidden
          aria-labelledby="stats-title"
        >
          <h2 id="stats-title" tabindex="-1">
            Статистика
          </h2>
          <p class="muted">
            Матчи, которые попали в лидерборд. Время местное. Нечестный или сломанный матч можно
            убрать из статистики — и вернуть обратно, если передумаете.
          </p>
          <div class="scope">
            <label for="result-mode">Показать</label>
            <select id="result-mode">
              <option value="">Все матчи</option>
              <option value="campaign">Ranked-кампании</option>
              <option value="room">Обычные бои</option>
              <option value="deathmatch">Каждый сам за себя</option>
            </select>
          </div>
          <p class="form-status" id="result-status" role="status"></p>
          <div class="group" aria-labelledby="result-list-title">
            <header>
              <h3 id="result-list-title">Матчи</h3>
            </header>
            <ul id="result-list" class="rows"></ul>
          </div>
          <div class="actions pager">
            <button type="button" id="prev" class="small">
              ← Новее
            </button>
            <span id="page" class="muted"></span>
            <button type="button" id="next" class="small">
              Старее →
            </button>
          </div>
          <h3>Сезоны</h3>
          <ul id="season-list" class="plain-list"></ul>
          <details class="disclosure">
            <summary>Ключи для игровых серверов</summary>
            <p class="muted">
              Игровой сервер отправляет результаты матчей с секретным ключом. Заведите ключ, когда
              подключаете новый сервер, и отзовите, если он мог утечь. Ключ показывается один раз.
            </p>
            <form id="key-form" class="form-stack">
              <label for="key-server">ID игрового сервера</label>
              <input
                id="key-server"
                name="serverId"
                required
                autocomplete="off"
                aria-describedby="key-server-hint"
              />
              <small id="key-server-hint">Лежит в настройках статистики на самом сервере.</small>
              <label for="key-label">Как его называть</label>
              <input
                id="key-label"
                name="label"
                required
                maxlength="64"
                placeholder="Например: основной сервер"
              />
              <button type="submit">Создать ключ</button>
              <p class="form-status" role="status"></p>
            </form>
            <ul id="key-list" class="rows"></ul>
          </details>
        </section>

        <section
          id="health"
          data-perm="diagnostics"
          data-tab="Производительность"
          hidden
          aria-labelledby="health-title"
        >
          <h2 id="health-title" tabindex="-1">
            Производительность
          </h2>
          <p class="muted">Фризы, просадки TPS и ошибки за последние сутки. Время местное.</p>
          <div id="health-card" class="hero" data-tone="wait">
            <span class="dot" aria-hidden="true"></span>
            <div>
              <p class="headline" id="health-headline">
                загрузка…
              </p>
              <p id="health-detail" class="muted"></p>
            </div>
          </div>
          <div class="panel group" aria-labelledby="live-title">
            <header class="stack-head stack-head--row">
              <h3 id="live-title">Тики прямо сейчас</h3>
              <button type="button" id="live-check" class="small">
                Проверить
              </button>
            </header>
            <p class="muted">
              Последние 100 тиков по данным самого сервера. Норма — до 50 мс на тик.
            </p>
            <p class="form-status" id="live-status" role="status"></p>
            <dl id="live-values" class="legend" hidden></dl>
          </div>
          <h3>Последние сутки по часам</h3>
          <ul id="hour-list" class="log"></ul>
          <h3 id="events-title">Фризы и ошибки</h3>
          <div class="filters">
            <div class="scope">
              <label for="event-kind">Показать</label>
              <select id="event-kind">
                <option value="">Все записи</option>
                <option value="freeze">Фризы</option>
                <option value="error">Ошибки и падения</option>
                <option value="warning">Предупреждения</option>
              </select>
            </div>
            <div class="scope">
              <label for="event-search">Найти в тексте</label>
              <input id="event-search" type="search" autocomplete="off" spellcheck="false" />
            </div>
          </div>
          <div class="actions">
            <button type="button" id="event-copy" class="small">
              Скопировать показанное
            </button>
            <button type="button" id="event-export" class="small">
              Скачать JSON
            </button>
          </div>
          <p class="form-status" id="event-status" role="status"></p>
          <ul id="event-list" class="log" aria-labelledby="events-title"></ul>
        </section>

        <section
          id="console"
          data-perm="rcon-raw"
          data-tab="Консоль"
          hidden
          aria-labelledby="console-title"
        >
          <h2 id="console-title" tabindex="-1">
            Консоль
          </h2>
          <p class="muted">
            Команды основного сервера и мастерской, как в их консоли. Каждая команда попадает в
            журнал.
          </p>
          <form id="console-form" class="form-stack console-plate group">
            <div class="scope">
              <label for="console-target">Цель консоли</label>
              <select id="console-target" name="target">
                <option value="game">Основной сервер</option>
                <option value="workshop">Мастерская</option>
              </select>
            </div>
            <label for="console-input">Команда</label>
            <input
              id="console-input"
              name="command"
              maxlength="1000"
              required
              autocomplete="off"
              spellcheck="false"
              aria-describedby="console-hint"
            />
            <small id="console-hint">
              Без «/». Стрелки ↑ и ↓ листают введённые команды. Опасные команды попросят
              подтверждения.
            </small>
            <button class="primary" type="submit">
              Выполнить
            </button>
            <p class="form-status" role="status"></p>
          </form>
          <pre
            id="console-output"
            class="console-output"
            role="log"
            aria-label="Ответы сервера"
          ></pre>
        </section>

        <section
          id="journal"
          data-perm="audit"
          data-tab="Журнал действий"
          hidden
          aria-labelledby="journal-title"
        >
          <h2 id="journal-title" tabindex="-1">
            Журнал действий
          </h2>
          <p class="muted">Что команда делала здесь в последнее время.</p>
          <div class="group" aria-labelledby="audit-list-title">
            <header>
              <h3 id="audit-list-title">Действия</h3>
            </header>
            <ul id="audit-list" class="log"></ul>
          </div>
        </section>
      </div>
    </div>

    <dialog id="dialog" aria-labelledby="dialog-title" aria-describedby="dialog-text">
      <form method="dialog" class="form-stack">
        <h2 id="dialog-title"></h2>
        <p id="dialog-text"></p>
        <div id="dialog-fields"></div>
        <div class="actions end">
          <button type="submit" value="cancel" formnovalidate>
            Отмена
          </button>
          <button type="submit" value="ok" id="dialog-ok" class="primary"></button>
        </div>
      </form>
    </dialog>
    <div class="toasts" aria-live="polite" aria-atomic="false"></div>
  </main>

  <style is:global>
    .admin-main .hero {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      background: var(--panel);
      border: 1px solid var(--line);
      padding: 18px 20px;
    }
    .admin-main .hero .headline {
      font-size: clamp(19px, 3vw, 23px);
      font-weight: 700;
    }
    .admin-main .dot {
      flex: none;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      margin-top: 7px;
      background: var(--muted);
    }
    .admin-main [data-tone='ok'] {
      border-color: rgb(130 214 107 / 0.45);
    }
    .admin-main [data-tone='ok'] .dot {
      background: var(--ok);
      box-shadow: 0 0 0 4px rgb(130 214 107 / 0.15);
    }
    .admin-main [data-tone='warn'] {
      border-color: rgb(245 165 36 / 0.45);
    }
    .admin-main [data-tone='warn'] .dot {
      background: var(--amber);
    }
    .admin-main [data-tone='bad'] {
      border-color: rgb(255 157 153 / 0.45);
    }
    .admin-main [data-tone='bad'] .dot {
      background: var(--danger);
    }

    .admin-main .panel--warn {
      border-top-color: var(--line-warn);
    }
    .admin-main .quick-group + .quick-group {
      padding-top: 12px;
      border-top: 1px solid var(--line);
    }
    .admin-main .quick-group--warn {
      border-top-color: var(--line-warn);
    }
    .admin-main .quick-group h4 {
      margin: 0;
      font-size: 15px;
      font-weight: 700;
    }
    .admin-main fieldset.settings-group {
      padding-top: 8px;
    }
    .admin-main legend {
      font-size: 17px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      padding: 0 6px;
      margin-left: -6px;
    }
    .admin-main fieldset.plain {
      border: 0;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 8px;
    }
    .admin-main fieldset.plain legend {
      font-size: 15px;
      font-weight: 600;
      text-transform: none;
      letter-spacing: normal;
      margin-bottom: 8px;
    }

    .admin-main textarea {
      min-height: 88px;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .disclosure {
      margin-bottom: 12px;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .body-part-row {
      display: block;
      grid-column: 1 / -1;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .body-part-row .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
      gap: 12px 16px;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .body-part-row .form-grid .field,
    .admin-main #ai-budget-form .field {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
      padding: 0;
      border: 0;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) input:not([type='checkbox']),
    .admin-main :is(#gun-fields, #gun-advanced-fields) select {
      width: 100%;
      margin-block: 8px;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-sub {
      display: grid;
      gap: 6px;
      width: 100%;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-sub fieldset {
      border: 0;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 6px;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-sub-row {
      display: grid;
      grid-template-columns: minmax(120px, 200px) minmax(0, 1fr);
      gap: 4px 12px;
      align-items: center;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-list {
      display: grid;
      gap: 6px;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-list-row {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 8px;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-list-row > .gun-mini {
      flex: none;
      width: auto;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-list-row > [data-gunkey] {
      flex: 0 1 130px;
      min-width: 0;
    }
    .admin-main
      :is(#gun-fields, #gun-advanced-fields)
      .gun-list-row
      > :not(.gun-mini):not([data-gunkey]) {
      flex: 1 1 auto;
      min-width: 0;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-list-row input,
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-list-row select {
      min-width: 0;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-band {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 2px 6px;
      flex: 1 1 auto;
      min-width: 0;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-band .gun-band-lab {
      flex: none;
      font-size: 13px;
      color: var(--sand);
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-band input[type='text'],
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-band input[type='number'] {
      flex: 0 1 72px;
      width: 72px;
      min-width: 0;
      margin-block: 4px;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-band .gun-mini {
      flex: none;
      width: auto;
      margin-left: auto;
      white-space: nowrap;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-band .gun-dmg-wrap {
      display: flex;
      flex: none;
      flex-wrap: nowrap;
      align-items: center;
      gap: 6px;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-band .gun-band-final {
      flex: 1 1 100%;
      min-width: 0;
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-group-title {
      margin: 10px 0 -2px;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--sand);
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-mini {
      flex: none;
      padding: 2px 10px;
      font-size: 15px;
      line-height: 1.5;
      cursor: pointer;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-null > .check {
      margin-bottom: 4px;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-dmg {
      position: relative;
      display: inline-block;
      flex: none;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-dmg-btn {
      width: auto;
      padding: 2px 9px;
      border-radius: 50%;
      cursor: help;
      font-size: 13px;
      line-height: 1.5;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-dmg-pop {
      position: absolute;
      z-index: 5;
      right: 0;
      top: calc(100% + 6px);
      min-width: min(320px, 70vw);
      padding: 10px 12px;
      background: var(--panel);
      border: 1px solid var(--line-2);
      border-radius: 8px;
      color: var(--cream);
      font-size: 13px;
      line-height: 1.6;
      white-space: normal;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) .gun-dmg-pop[hidden] {
      display: none;
    }
    .admin-main :is(#gun-fields, #gun-advanced-fields) pre,
    .admin-main :is(#gun-fields, #gun-advanced-fields) small,
    .admin-main #map-history small,
    .admin-main #map-drafts small,
    .admin-main .git-diff pre,
    .admin-main .git-diff strong {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .admin-main .git-diff pre {
      max-width: 100%;
      margin-block: 8px;
    }
    .admin-main .row .actions select {
      width: auto;
      min-width: 170px;
    }

    .admin-main .options {
      display: grid;
      gap: 10px;
    }
    .admin-main .option {
      border: 1px solid var(--line);
      padding: 14px;
      display: grid;
      gap: 8px;
    }
    .admin-main .option[data-current] {
      border-color: var(--ok);
      background: rgb(130 214 107 / 0.05);
    }
    .admin-main .option p {
      color: var(--sand);
      font-size: 15px;
    }
    .admin-main .option-head {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      font-weight: 700;
    }

    .admin-main .rows {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 8px;
    }
    .admin-main .row {
      background: var(--panel);
      border: 1px solid var(--line);
      padding: 12px 14px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px 16px;
      align-items: center;
      justify-content: space-between;
    }
    .admin-main .row-main {
      display: grid;
      gap: 4px;
      min-width: 0;
      flex: 1 1 240px;
    }
    .admin-main .row-main strong {
      overflow-wrap: anywhere;
    }
    .admin-main .row.voided {
      opacity: 0.75;
      border-style: dashed;
    }
    /* Workshop: one disclosure per map; the closed summary already says what is in the game and who builds. */
    .admin-main .maps {
      display: grid;
      gap: 8px;
    }
    .admin-main .maps summary .badge {
      margin-left: 8px;
    }
    .admin-main .map-meta {
      display: block;
      margin-top: 4px;
      padding-left: 1.1em;
      color: var(--sand);
      font-size: 13px;
      font-weight: 400;
    }
    .admin-main .map-body {
      display: grid;
    }
    .admin-main .map-part {
      display: grid;
      gap: 8px;
      padding-block: 12px;
      border-top: 1px solid var(--line);
    }
    .admin-main .map-part h4 {
      margin: 0;
      font-size: 13px;
      font-weight: 700;
    }
    .admin-main .map-part .stack,
    .admin-main .map-part .stack > :not(header) {
      margin: 0;
    }
    .admin-main .map-part .stack > button {
      justify-self: start;
    }
    /* Rows inside a map plate are seam-divided lines, not a second layer of cards. */
    .admin-main .map-body .rows {
      gap: 0;
    }
    .admin-main .map-body .row {
      background: none;
      border-width: 1px 0 0;
      padding-inline: 0;
    }
    .admin-main .map-body .row-main strong .badge {
      margin-left: 8px;
    }
    .admin-main .map-advanced {
      margin-top: 4px;
    }
    .admin-main .digest {
      color: var(--dim);
      font-family: var(--mono);
      font-size: 11px;
    }
    .admin-main .ws-flow ol {
      display: grid;
      gap: 6px;
      margin: 0 0 14px;
      padding-left: 20px;
      color: var(--sand);
      font-size: 14px;
    }
    .admin-main .ws-flow strong {
      color: var(--cream);
    }
    .admin-main #ws-card .ws-card__body {
      display: grid;
      flex: 1;
