          text: `Мастерская сохранит текущий мир и откроет отдельную рабочую копию карты «${mapName(map.mapId)}». Прежний черновик останется в списке сохранённых. Игра продолжит работать.`,
          ok: 'Открыть ветку',
          danger: true,
        }))
      )
        return
      const line = $('#map-history-status')
      await run(line, async () => {
        const { id } = await api('mode', 'POST', {
          profile: 'workshop',
          session: 'new',
          maps: [map.mapId],
          branches: { [map.mapId]: branch },
          expectedRevision: controller.revision,
