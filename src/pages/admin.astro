              </p>
              <p id="workshop-ai-gateway-key-status" class="form-status" role="status">
                Проверяем ключ…
              </p>
              <p id="workshop-ai-provider-key-status" class="form-status" role="status" hidden>
                Проверяем ключ…
              </p>
            </div>
            <button id="workshop-ai-refresh" type="button" class="small">
              Обновить состояние AI
            </button>
          </details>
