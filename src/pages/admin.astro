        title: 'Создать набор?',
        text: 'Новый набор начнётся с пустого варианта. Добавьте предметы и выберите режимы до сохранения.',
        ok: 'Создать',
        fields: [
          field(
            'ID набора',
            el('input', {
              name: 'id',
              required: true,
              maxLength: 32,
              pattern: kitCatalog.fields.idPattern,
            }),
          ),
          field('Название', el('input', { name: 'name', required: true, maxLength: 80 })),
        ],
      })
