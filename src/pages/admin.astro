    /** Versions reachable from the published head are the map's history in the game; anything else exists only in a branch. */
    function playedVersions(map: MapCatalogEntry) {
      const byId = new Map(map.versions.map((version) => [version.versionDigest, version])),
        seen = new Set<string>(),
        stack = map.head ? [map.head.versionDigest] : []
      while (stack.length) {
        const id = stack.pop()!
        if (seen.has(id)) continue
        seen.add(id)
        const version = byId.get(id)
        stack.push(...(version?.parents ?? (version?.parent ? [version.parent] : [])))
      }
      return seen
    }
    /** An accepted version reaches players differently per map kind. */
    function goesLive(mapId: string) {
      const kind = mapCatalog?.find((map) => map.mapId === mapId)?.kind
      return kind === 'lobby'
        ? 'Лобби перейдёт на неё при следующем безопасном запуске сервера.'
        : kind === 'limbo'
          ? 'Прокси перейдёт на неё после подготовки в истории версий и перезапуска.'
          : 'Следующие матчи пойдут на ней, начатые доиграют на прежней.'
    }
    /** `work-<session UUID>` branches belong to a session: name them by who opened it and when. */
    function branchLabel(name: string) {
      if (name === 'main') return 'версия в игре'
      const id = /^work-(.+)$/.exec(name)?.[1]
      if (!id) return `ветка «${name}»`
      const owner = [mapSession, ...savedMapSessions].find((saved) => saved?.id === id)
      return typeof owner?.startedAt === 'number'
        ? `ветка сеанса от ${date(owner.startedAt)}${owner.startedBy?.name ? `, ${owner.startedBy.name}` : ''}`
        : 'ветка прошлого сеанса'
    }
    const versionLabel = (version: MapCatalogEntry['versions'][number]) =>
      `${date(version.createdAt)} · ${String(version.author.name ?? 'автор не указан')}${version.note ? ` · ${version.note.slice(0, 48)}` : ''}`
    async function requestReview(
