        $('#kits-status'),
        async () => {
          if (!kitCatalog) throw new Error('Каталог наборов недоступен.')
          validateKitChanges(kitOverrides, kitBindings, kitCatalog, kitClassCosts)
          const submitted = kitBody(),
            { settings } = await api('kits', 'PUT', {
              expectedRevision: kitRevision,
              kits: kitOverrides,
              fixedModeKits: kitBindings,
            })
          kitRevision = settings.revision
          kitSnapshot = submitted
          kitMeta()
          for (let attempt = 0; attempt < 15; attempt++) {
            const { applied } = await api('settings'),
              receipt = settingsReceipt(settings.revision, applied)
            if (receipt === 'applied') {
              say($('#kits-status'), 'Наборы применены. Новые выдачи используют эти настройки.')
              return
            }
            if (receipt === 'rejected' || receipt === 'partial')
              throw new Error(
                'Сервер отклонил настройки наборов. Прежняя выдача сохранена; проверьте поля и обновите каталог.',
              )
            say(
              $('#kits-status'),
              'Сохранено. Ожидаем подтверждения применения игровым сервером…',
              'pending',
            )
            await new Promise((resolve) => setTimeout(resolve, 2000))
          }
          say(
            $('#kits-status'),
            'Сохранено; применение пока не подтверждено. Обновите каталог позже.',
            'pending',
