    // ---------- Statistics ----------
    const REASONS: Record<string, string> = {
      draw: 'Ничья',
      abandoned: 'Прерван: все игроки вышли',
      stopped: 'Остановлен вручную',
      shutdown: 'Прерван: сервер выключился',
      error: 'Прерван из-за ошибки',
    }
    const matchTitle = (r: { kind: string; mode: string; mapId: string | null }) =>
      `${MODE_NAMES[r.mode] ?? 'Матч'} · ${r.kind === 'campaign' ? 'итог кампании' : (MAP_NAMES[r.mapId ?? ''] ?? 'другая карта')}`
    function outcome(r: any) {
      if (r.reason !== 'completed') return REASONS[r.reason] ?? 'Завершён'
      if (r.winnerName) return `Победил ${r.winnerName}`
      return TEAM_NAMES[r.winner] ? `Победа ${TEAM_NAMES[r.winner]}` : 'Завершён'
    }
    let resultPage = 1
    async function loadResults() {
      const mode = $<HTMLSelectElement>('#result-mode').value,
        data = await api(`results?page=${resultPage}${mode ? `&mode=${mode}` : ''}`)
      const line = $('#result-status')
      $('#result-list').replaceChildren(
        ...(data.results.length
          ? data.results.map((r: any) => {
              const voided = r.voidedAt !== null,
                title = matchTitle(r)
              const players = el(
                'small',
                {},
                `Игроки (${r.participants}): `,
                ...r.players.flatMap((p: any, i: number) => [
                  i ? ', ' : '',
                  el('span', { className: `team-${p.team}`, textContent: p.name }),
                ]),
                r.participants > r.players.length ? '…' : '',
              )
              const main = el(
                'div',
                { className: 'row-main' },
                el('strong', { textContent: title }),
                el(
                  'span',
                  {},
                  `${date(r.endedAt)} · ${outcome(r)}`,
                  voided
                    ? el('span', {
                        className: 'badge warn',
                        textContent: ` Не учитывается — решил ${r.voidedBy}`,
                      })
                    : null,
                ),
                players,
              )
              const toggle = button(
                voided ? 'Вернуть в статистику' : 'Не учитывать матч',
                async () => {
                  const answer = await ask(
                    voided
                      ? {
                          title: 'Вернуть матч в статистику?',
                          text: `«${title}», ${date(r.endedAt)}. Матч снова появится в лидерборде и профилях игроков.${r.rated ? ' Рейтинг сезона пересчитается.' : ''}`,
                          ok: 'Вернуть',
                        }
                      : {
                          title: 'Не учитывать этот матч?',
                          text: `«${title}», ${date(r.endedAt)}. Матч пропадёт из лидерборда и профилей игроков.${r.rated ? ' Рейтинг сезона пересчитается.' : ''} Решение можно отменить.`,
                          ok: 'Не учитывать',
                          danger: true,
                        },
                  )
                  if (!answer) return
                  await run(line, async () => {
                    await api('results/void', 'POST', {
                      serverId: r.serverId,
                      eventId: r.eventId,
                      voided: !voided,
                    })
                    await loadResults()
                    return voided ? 'Матч снова учитывается.' : 'Матч больше не учитывается.'
                  })
                },
                voided ? 'small' : 'small danger',
                `${voided ? 'Вернуть в статистику' : 'Не учитывать'}: ${title}, ${date(r.endedAt)}`,
              )
              return el('li', { className: `row${voided ? ' voided' : ''}` }, main, toggle)
            })
          : [el('li', { className: 'empty', textContent: 'Матчей пока нет.' })]),
      )
      const from = data.total ? (resultPage - 1) * data.limit + 1 : 0,
        to = Math.min(data.total, resultPage * data.limit)
      $('#page').textContent = data.total ? `Матчи ${from}–${to} из ${data.total}` : ''
      $<HTMLButtonElement>('#prev').disabled = resultPage <= 1
      $<HTMLButtonElement>('#next').disabled = resultPage * data.limit >= data.total
    }
    $('#result-mode').addEventListener('change', () => {
      resultPage = 1
      loadResults()
    })
    customSelect($<HTMLSelectElement>('#result-mode'))
    $('#prev').addEventListener('click', () => {
      resultPage--
      loadResults()
    })
    $('#next').addEventListener('click', () => {
      resultPage++
      loadResults()
    })
    // Season boundaries are UTC calendar days; local zones would shift them by a day.
    // They stay UTC and carry the UTC label, unlike the local match times beside them.
    const dayFormat = new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
      timeZoneName: 'short',
    })
    async function loadSeasons() {
      const { seasons } = await api('seasons')
      $('#season-list').replaceChildren(
        ...seasons
          .slice()
          .reverse()
          .map((s: any) =>
            el('li', {
              textContent: `${s.name}: ${dayFormat.format(Date.parse(s.startsAt))} — ${dayFormat.format(Date.parse(s.endsAt))}`,
            }),
          ),
      )
    }
    async function loadKeys() {
      const { keys } = await api('keys')
      $('#key-list').replaceChildren(
        ...keys.map((k: any) =>
          el(
            'li',
            { className: 'row' },
            el(
              'div',
              { className: 'row-main' },
              el('strong', { textContent: k.label }),
              el('small', {
                textContent: k.revokedAt
                  ? `Отозван ${ago(k.revokedAt)}`
                  : `Действует, создан ${ago(k.createdAt)}`,
              }),
            ),
            k.revokedAt
              ? null
              : button(
                  'Отозвать',
                  async () => {
                    if (
                      !(await ask({
                        title: `Отозвать ключ «${k.label}»?`,
                        text: 'Сервер с этим ключом перестанет отправлять результаты матчей, пока ему не выдадут новый.',
                        ok: 'Отозвать',
                        danger: true,
                      }))
                    )
                      return
                    await run($('#key-form .form-status'), async () => {
                      await api('keys/revoke', 'POST', { id: k.id })
                      await loadKeys()
                      return 'Ключ отозван.'
                    })
                  },
                  'small danger',
                  `Отозвать ключ «${k.label}»`,
                ),
          ),
        ),
      )
    }
    $<HTMLFormElement>('#key-form').addEventListener('submit', (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement,
        line = form.querySelector<HTMLElement>('.form-status')!
      run(
        line,
        async () => {
          const { key } = await api('keys', 'POST', {
            serverId: (form.elements.namedItem('serverId') as HTMLInputElement).value
              .trim()
              .toLowerCase(),
            label: (form.elements.namedItem('label') as HTMLInputElement).value,
          })
          form.reset()
          loadKeys()
          line.replaceChildren(
            'Ключ создан. Скопируйте его сейчас — больше он показан не будет:',
            el('div', { className: 'secret', textContent: key }),
          )
        },
        form,
      ).then(() => {
        if (!line.firstElementChild && line.textContent === 'применяем…') line.textContent = ''
      })
    })

    // ---------- Journal ----------
    /** [past tense, infinitive for a failed attempt, rest of the sentence]. */
    function sentence(a: any): [string, string, string] {
      let d: any = {}
      try {
        d = a.detail ? JSON.parse(a.detail) : {}
      } catch {
        // Legacy journal details may be plain text rather than JSON.
      }
      const player = d.player ?? a.target,
        reason = d.reason ? `, причина: «${d.reason}»` : ''
      const match = d.room ? ` «${d.room.name}»${d.room.map ? ` на карте ${d.room.map}` : ''}` : ''
      const result = d.mode ? ` «${matchTitle(d)}» от ${date(d.endedAt)}` : ''
      const cls = ` «${CLASS_NAMES[a.target] ?? 'неизвестный'}»`
      switch (a.action) {
        case 'mode':
          return a.target === 'workshop'
            ? ['открыл', 'открыть', ' сеанс мастерской']
            : a.target === 'test'
              ? ['начал', 'начать', ' тест карты в мастерской']
              : d.recover
                ? ['восстановил', 'восстановить', ' мастерскую']
                : ['вернул', 'вернуть', ' мастерскую в редактор']
        case 'cancel':
          return ['отменил', 'отменить', ' смену режима мастерской']
        case 'message':
          return ['изменил', 'изменить', ` сообщение для игроков: «${d.message ?? ''}»`]
        case 'rcon:say':
          return ['написал', 'написать', ` всем: «${d.text ?? ''}»`]
        case 'rcon:kick':
          return ['выгнал', 'выгнать', ` игрока ${player}${reason}`]
        case 'rcon:ban':
          return ['забанил', 'забанить', ` игрока ${player}${reason}`]
        case 'rcon:pardon':
          return ['разбанил', 'разбанить', ` игрока ${player}`]
        case 'rcon:team-kick':
          return ['убрал', 'убрать', ` игрока ${player} из матча`]
        case 'rcon:class-lock':
          return ['закрыл', 'закрыть', ` класс${cls}`]
        case 'rcon:class-unlock':
          return ['открыл', 'открыть', ` класс${cls}`]
        case 'rcon:range':
          return a.target === 'open'
            ? ['открыл', 'открыть', ' полигон']
            : a.target === 'close'
              ? ['закрыл', 'закрыть', ' полигон']
              : ['сбросил', 'сбросить', ' полигон']
        case 'rcon:stop-room':
          return [
            'завершил',
            'завершить',
            ` матч${match} — ${(OUTCOMES.find((o) => o[0] === d.outcome)?.[1] ?? 'без итога').toLowerCase()}${reason}`,
          ]
        case 'rcon:maintenance-status':
          return ['проверил', 'проверить', ' состояние техработ']
        case 'rcon:drain':
          return ['запретил', 'запретить', ' начинать новые матчи']
        case 'rcon:interrupt':
          return ['прервал', 'прервать', ` все матчи${reason}`]
        case 'settings':
          return ['изменил', 'изменить', ' настройки игры']
        case 'kits':
          return ['изменил', 'изменить', ' наборы снаряжения и назначения режимов']
        case 'map-create':
          return ['создал', 'создать', ` пустую карту «${d.name ?? mapName(a.target)}»`]
        case 'map-properties':
          return [
            'изменил',
            'изменить',
            ` название черновика карты на «${d.name ?? mapName(a.target)}»`,
          ]
        case 'map-availability':
          return [
            d.enabled ? 'включил' : 'отключил',
            d.enabled ? 'включить' : 'отключить',
            ` карту «${mapName(a.target)}» для новых матчей`,
          ]
        case 'role-grant':
          return [
            'назначил',
            'назначить',
            ` ${d.name ?? 'игрока'} на роль «${ROLES[d.role]?.name ?? 'участник'}»`,
          ]
        case 'role-revoke':
          return ['убрал', 'убрать', ` ${d.name ?? 'игрока'} из команды`]
        case 'workshop-sync':
          return ['обновил', 'обновить', ' доступ в мастерскую']
        case 'workshop-maps':
          return ['изменил', 'изменить', ` карты для ${d.name ?? 'строителя'} в мастерской`]
        case 'workshop-candidate':
          return [
            'отправил',
            'отправить',
            ` на проверку карту «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»${d.from === 'game' ? ' (из игры)' : ''}`,
          ]
        case 'workshop-publish':
          return [
            'выложил',
            'выложить',
            ` в игру карту «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`,
          ]
        case 'workshop-reject':
          return [
            'отклонил',
            'отклонить',
            ` версию карты «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`,
          ]
        case 'workshop-rollback':
          return ['восстановил', 'восстановить', ` прежнюю версию карты «${mapName(a.target)}»`]
        case 'map-branch-create':
          return ['создал', 'создать', ` ветку ${d.branch ?? ''} карты «${mapName(a.target)}»`]
        case 'map-commit':
          return [
            'сохранил',
            'сохранить',
            ` версию карты «${mapName(a.target)}» в ветке ${d.branch ?? ''}`,
          ]
        case 'map-compare':
        case 'map-merge-preview':
          return ['сравнил', 'сравнить', ` версии карты «${mapName(a.target)}»`]
        case 'map-sessions':
          return ['открыл', 'открыть', ' список сохранённых черновиков']
        case 'workshop-map-access':
          return d.from === 'game'
            ? [
                d.allowed ? 'разрешил' : 'запретил',
                d.allowed ? 'разрешить' : 'запретить',
                ` ${d.target ?? 'строителю'} строить: «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}» (из игры)`,
              ]
            : [
                'изменил',
                'изменить',
                ` список строителей: «${WORKSHOP_PLACES[a.target] ?? 'другая карта'}»`,
              ]
        case 'result-void':
          return ['исключил', 'исключить', ` из статистики матч${result}`]
        case 'result-restore':
          return ['вернул', 'вернуть', ` в статистику матч${result}`]
        case 'ingest-key-create':
          return ['создал', 'создать', ` ключ приёма результатов «${d.label ?? ''}»`]
        case 'ingest-key-revoke':
          return ['отозвал', 'отозвать', ' ключ приёма результатов']
        case 'rcon:raw':
          return [
            'выполнил',
            'выполнить',
            a.target
              ? ` в консоли: «${a.target}»${d.rejected ? ' — сервер не принял' : ''}`
              : ' команду в консоли',
          ]
        default:
          return ['выполнил', 'выполнить', ' действие в панели']
      }
    }
    function auditRow(a: any) {
      const [past, attempt, rest] = sentence(a),
        error = friendly(String(a.error ?? '').replace(/\s\(.*\)$/, ''), 400)
      return el(
        'li',
        { className: a.ok ? '' : 'failed', 'data-audit-id': a.id },
        el(
          'span',
          {},
          el('strong', { textContent: a.actorName }),
          a.ok ? ` ${past}${rest}` : ` пытался ${attempt}${rest} — `,
          a.ok
            ? null
            : el('span', {
                className: 'fail',
                textContent: `не получилось: ${error.charAt(0).toLowerCase()}${error.slice(1)}`,
              }),
        ),
        el('time', {
          dateTime: new Date(a.at).toISOString(),
          title: date(a.at),
          textContent: ago(a.at),
        }),
      )
    }
    function prependAudit(entry: any) {
      const list = $('#audit-list')
      if (
        entry.action === 'rcon:list' ||
        [...list.children].some((row) => (row as HTMLElement).dataset.auditId === String(entry.id))
      )
        return
      list.querySelector('.empty')?.remove()
      list.prepend(auditRow(entry))
      while (list.children.length > 200) list.lastElementChild!.remove()
    }
    async function loadAudit() {
      const { entries } = await api('audit')
      const shown = entries.filter((a: any) => a.action !== 'rcon:list').slice(0, 200)
      $('#audit-list').replaceChildren(
        ...(shown.length
          ? shown.map(auditRow)
          : [el('li', { className: 'empty', textContent: 'Пока никто ничего не делал.' })]),
      )
    }

    // ---------- Performance ----------
    type Sample = {
      at: number
      tps: number
      msptAvg: number
      msptMax: number
      heapUsedMb: number | null
      heapMaxMb: number | null
      startedAt: number | null
    }
    type ServerEvent = {
      serverId: string
      id: string
      at: number
      kind: string
      durationMs: number | null
      source: string | null
      message: string
      repeats: number
    }
    const EVENT_KINDS: Record<string, string> = {
      freeze: 'Фриз',
      error: 'Ошибка',
      crash: 'Падение',
      warning: 'Предупреждение',
    }
    // Below this the server visibly lags: 18 TPS is a 10% slowdown, a single 1 s tick is a freeze players notice.
    const LAG_TPS = 18
    const hourFormat = new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
      timeZoneName: 'short',
    })
    const ms = (n: number) => `${number(Math.round(n))} мс`
    const tps = (n: number) => n.toLocaleString('ru-RU', { maximumFractionDigits: 1 })
    let health: { samples: Sample[]; events: ServerEvent[]; lastSampleAt: number | null } = {
      samples: [],
      events: [],
      lastSampleAt: null,
    }
    function memory(s: Sample) {
      return s.heapUsedMb === null
        ? ''
        : `, память ${number(s.heapUsedMb)}${s.heapMaxMb ? ` из ${number(s.heapMaxMb)}` : ''} МБ`
    }
    function renderHealthCard() {
      const card = $('#health-card'),
        last = health.samples.at(-1),
        hourAgo = Date.now() - 3_600_000
      const set = (tone: string, headline: string, detail: string) => {
        card.dataset.tone = tone
        $('#health-headline').textContent = headline
        $('#health-detail').textContent = detail
      }
      // No data is not a healthy server: say so instead of showing green.
      if (health.lastSampleAt === null)
        return set(
          'warn',
          'Сервер не присылал замеров',
          'Пока замеров нет, судить о сервере нельзя. Тики прямо сейчас можно проверить ниже.',
        )
      if (!last || health.lastSampleAt < Date.now() - 3 * 60_000)
        return set(
          'bad',
          `Замеры не приходят с ${date(health.lastSampleAt)}`,
          'Сервер мог зависнуть, упасть или потерять связь с сайтом. Проверьте тики ниже и логи сервера.',
        )
      const recent = health.samples.filter((s) => s.at >= hourAgo),
        freezes = health.events
          .filter((e) => e.kind === 'freeze' && e.at >= hourAgo)
          .reduce((n, e) => n + e.repeats, 0),
        errors = health.events
          .filter((e) => e.kind !== 'freeze' && e.kind !== 'warning' && e.at >= hourAgo)
          .reduce((n, e) => n + e.repeats, 0),
        worst = Math.min(...recent.map((s) => s.tps))
      const now = `Сейчас TPS ${tps(last.tps)}, тик в среднем ${ms(last.msptAvg)}${memory(last)}.`
      if (worst < LAG_TPS || freezes || errors)
        return set(
          'warn',
          'За последний час были проблемы',
          `${now} За час: TPS падал до ${tps(worst)}, фризов ${freezes}, ошибок ${errors}.`,
        )
      set('ok', 'Сервер работает ровно', now)
    }
    function renderHours() {
      const hours = new Map<number, Sample[]>()
      for (const s of health.samples) {
        const hour = Math.floor(s.at / 3_600_000) * 3_600_000
        hours.set(hour, [...(hours.get(hour) ?? []), s])
      }
      $('#hour-list').replaceChildren(
        ...(hours.size
          ? [...hours].reverse().map(([hour, list]) => {
              const inHour = (e: ServerEvent) => e.at >= hour && e.at < hour + 3_600_000,
                freezes = health.events
                  .filter((e) => e.kind === 'freeze' && inHour(e))
                  .reduce((n, e) => n + e.repeats, 0),
                errors = health.events
                  .filter((e) => (e.kind === 'error' || e.kind === 'crash') && inHour(e))
                  .reduce((n, e) => n + e.repeats, 0),
                worst = Math.min(...list.map((s) => s.tps)),
                heap = Math.max(...list.map((s) => s.heapUsedMb ?? 0)),
                restart = list.find(
                  (s) =>
                    s.startedAt !== null && s.startedAt >= hour && s.startedAt < hour + 3_600_000,
                )
              return el(
                'li',
                {},
                el(
                  'span',
                  {},
                  el('span', {
                    className: worst < LAG_TPS ? 'bad' : '',
                    textContent: `TPS от ${tps(worst)}`,
                  }),
                  `, худший тик ${ms(Math.max(...list.map((s) => s.msptMax)))}`,
                  heap ? `, память до ${number(heap)} МБ` : '',
                  freezes ? `, фризов ${freezes}` : '',
                  errors ? `, ошибок ${errors}` : '',
                  restart ? `, перезапуск ${date(restart.startedAt!)}` : '',
                ),
                el('time', {
                  dateTime: new Date(hour).toISOString(),
                  textContent: hourFormat.format(hour),
                }),
              )
            })
          : [el('li', { className: 'empty', textContent: 'Замеров за сутки нет.' })]),
      )
    }
    function shownEvents() {
      const kind = $<HTMLSelectElement>('#event-kind').value,
        query = $<HTMLInputElement>('#event-search').value.trim().toLowerCase()
      return health.events.filter(
        (e) =>
          (!kind || e.kind === kind || (kind === 'error' && e.kind === 'crash')) &&
          (!query || `${e.source ?? ''} ${e.message}`.toLowerCase().includes(query)),
      )
    }
    const eventTitle = (e: ServerEvent) =>
      [
        EVENT_KINDS[e.kind] ?? e.kind,
        e.durationMs !== null ? ms(e.durationMs) : '',
        e.source ?? '',
        e.repeats > 1 ? `×${number(e.repeats)}` : '',
      ]
        .filter(Boolean)
        .join(' · ')
    function renderEvents() {
      const list = shownEvents()
      $('#event-list').replaceChildren(
        ...(list.length
          ? list.map((e) =>
              el(
                'li',
                { className: e.kind === 'warning' ? '' : 'failed' },
                el('strong', { textContent: eventTitle(e) }),
                el('time', {
                  dateTime: new Date(e.at).toISOString(),
                  title: date(e.at),
                  textContent: hourFormat.format(e.at),
                }),
                el('pre', { className: 'server-text', textContent: e.message }),
              ),
            )
          : [
              el('li', {
                className: 'empty',
                textContent: health.events.length
                  ? 'Под фильтр ничего не подходит.'
                  : 'За две недели фризов и ошибок нет.',
              }),
            ]),
      )
    }
    async function loadHealth() {
      health = await api('diagnostics')
      renderHealthCard()
      renderHours()
      renderEvents()
    }
    $('#event-kind').addEventListener('change', renderEvents)
    $('#event-search').addEventListener('input', renderEvents)
    customSelect($<HTMLSelectElement>('#event-kind'))
    $('#event-copy').addEventListener('click', () =>
      run($('#event-status'), async () => {
        const list = shownEvents()
        if (!list.length) return 'Копировать нечего.'
        await navigator.clipboard.writeText(
          list
            .map((e) => `${new Date(e.at).toISOString()} ${eventTitle(e)}\n${e.message}`)
            .join('\n\n'),
        )
        return `Скопировано записей: ${list.length}.`
      }),
    )
    $('#event-export').addEventListener('click', () => {
      const stamp = new Date().toISOString().replace(/[:.]/g, '-'),
        link = el('a', {
          href: URL.createObjectURL(
            new Blob(
              [
                JSON.stringify(
                  {
                    exportedAt: new Date().toISOString(),
                    samples: health.samples,
                    events: shownEvents(),
                  },
                  null,
                  2,
                ),
              ],
              { type: 'application/json' },
            ),
          ),
          download: `blockfield-diagnostics-${stamp}.json`,
        })
      link.click()
      setTimeout(() => URL.revokeObjectURL(link.href), 0)
    })
    const TICK_STATES: Record<string, string> = {
      running: 'Сервер успевает',
      lagging: 'Сервер не успевает за тиками',
      frozen: 'Тики заморожены командой tick freeze',
      sprinting: 'Идёт ускоренная прокрутка тиков',
    }
    $('#live-check').addEventListener('click', () =>
      run(
        $('#live-status'),
        async () => {
          const t = await api('diagnostics/live')
          const values: [string, string][] = [
            ['TPS', `${tps(t.tps)} из ${tps(t.targetTps)}`],
            ['Тик в среднем', ms(t.msptAvg)],
            ...(t.msptP95 !== null
              ? ([['95% тиков быстрее', ms(t.msptP95)]] as [string, string][])
              : []),
            ...(t.msptP99 !== null
              ? ([['99% тиков быстрее', ms(t.msptP99)]] as [string, string][])
              : []),
          ]
          const dl = $('#live-values')
          dl.replaceChildren(
            ...values.map(([k, v]) =>
              el('div', {}, el('dt', { textContent: v }), el('dd', { textContent: k })),
            ),
          )
          dl.hidden = false
          const verdict = `${TICK_STATES[t.state] ?? t.state} — ${date(t.at)}.`
          // A lagging or frozen server is the bad news this check exists for: show it in the error tone.
          if (t.state === 'lagging' || t.state === 'frozen') throw new Error(verdict)
          return verdict
        },
        $('#live-check').parentElement,
      ),
    )

    // ---------- Console ----------
    const TARGET_LABELS: Record<string, string> = {
      game: 'Основной сервер',
      workshop: 'Мастерская',
    }
    const consoleHistory: string[] = []
    let historyAt = 0
    const consoleTarget = $<HTMLSelectElement>('#console-target')
    customSelect(consoleTarget)
    const consoleInput = $<HTMLInputElement>('#console-input')
    consoleInput.addEventListener('keydown', (e) => {
      if ((e.key !== 'ArrowUp' && e.key !== 'ArrowDown') || !consoleHistory.length) return
      e.preventDefault()
      historyAt = Math.max(
        0,
        Math.min(consoleHistory.length, historyAt + (e.key === 'ArrowUp' ? -1 : 1)),
      )
      consoleInput.value = consoleHistory[historyAt] ?? ''
    })
    function consoleLine(target: string, command: string, text: string, bad: boolean) {
      const out = $('#console-output')
      const targetLabel = TARGET_LABELS[target] ?? target
      out.append(
        el('span', { className: 'cmd', textContent: `[${targetLabel}] > ${command}\n` }),
        el('span', { className: bad ? 'bad' : '', textContent: `${text || '(пустой ответ)'}\n` }),
      )
      // Keep the last 100 exchanges; the full record is the journal.
      while (out.childElementCount > 200) out.firstElementChild!.remove()
      out.scrollTop = out.scrollHeight
    }
    $<HTMLFormElement>('#console-form').addEventListener('submit', async (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement,
        target = consoleTarget.value,
        command = consoleInput.value.trim().replace(/^\/+/, '').trim()
      if (!command) return
      if (consoleHistory.at(-1) !== command) consoleHistory.push(command)
      historyAt = consoleHistory.length
      if (
        dangerousCommand(command) &&
        !(await ask({
          title: 'Выполнить опасную команду?',
          text: `«${command}» на ${TARGET_LABELS[target] ?? target} может остановить сервер, изменить доступ или необратимо изменить мир и игроков.`,
          ok: 'Выполнить',
          danger: true,
        }))
      )
        return
      run(
        form.querySelector<HTMLElement>('.form-status')!,
        async () => {
          const reply = await api('rcon/raw', 'POST', { command, target }).catch((error: Error) => {
            consoleLine(target, command, error.message, true)
            throw error
          })
          consoleLine(reply.target ?? target, command, reply.output, reply.rejected)
          consoleInput.value = ''
          if (reply.rejected) throw new Error('Команда не выполнена. Проверьте её и повторите.')
        },
        form,
      )
    })

    type SettingControl = HTMLInputElement | HTMLSelectElement
    const settingValues = new Map<string, string>()
    let remoteSettingsName = 'кто-то'
    let observedSettingsRevision = 0
    function controlKey(control: SettingControl) {
      return `${control.name || control.id}:${control.type === 'checkbox' ? control.value : ''}${control.name.startsWith('b_') ? ':' + scope : ''}`
    }
    function controlValue(control: SettingControl) {
      return control.type === 'checkbox'
        ? String((control as HTMLInputElement).checked)
        : control.value
    }
    function editingSetting(control: SettingControl) {
      return (
        busyControls.has(control) ||
        queuedSettings.has(controlKey(control)) ||
        control.closest('.field, .check')?.contains(document.activeElement) ||
        controlValue(control) !== settingValues.get(controlKey(control))
      )
    }
    function rememberSettingsControls(selector = '#settings-form') {
      $(selector)
        .querySelectorAll<SettingControl>('input, select')
        .forEach((control) => {
          settingValues.set(controlKey(control), controlValue(control))
        })
    }
    function flashSetting(row: Element) {
      row.classList.remove('flash')
      void (row as HTMLElement).offsetWidth
      row.classList.add('flash')
      const stateRow = row.matches('.check')
        ? (row.closest('.group')?.querySelector('header') ?? row)
        : row
      const state =
        stateRow.querySelector<HTMLElement>('.state') ??
        stateRow.appendChild(el('span', { className: 'state', role: 'status' }))
      if (
        ![...row.querySelectorAll<HTMLElement>('input, select')].some((c) => busyControls.has(c))
      ) {
        state.dataset.s = 'other'
        state.textContent = `${remoteSettingsName} · только что`
      }
      setTimeout(() => row.classList.remove('flash'), 1600)
    }
    function replaceSettingsFields(container: HTMLElement, live: boolean, ...rows: Element[]) {
      if (!live) {
        container.replaceChildren(...rows)
        return
      }
      rows.forEach((fresh, index) => {
        const old = container.children[index]
        if (!old) {
          container.append(fresh)
          return
        }
        const oldFields = old.querySelector<HTMLElement>('.fields')
        const freshFields = fresh.querySelector<HTMLElement>('.fields')
        if (oldFields && freshFields) {
          replaceSettingsFields(oldFields, true, ...freshFields.children)
          return
        }
        const controls = [...old.querySelectorAll<SettingControl>('input, select')]
        const changed = [...fresh.querySelectorAll<SettingControl>('input, select')].some(
          (control) =>
            settingValues.has(controlKey(control)) &&
            settingValues.get(controlKey(control)) !== controlValue(control),
        )
        const preserve = controls.some(editingSetting) || old.contains(document.activeElement)
        if (!preserve && changed) old.replaceWith(fresh)
        fresh
          .querySelectorAll<SettingControl>('input, select')
          .forEach((control) => settingValues.set(controlKey(control), controlValue(control)))
        if (changed) flashSetting(preserve ? old : fresh)
      })
    }
    function toast(text: string) {
      const node = el('div', { className: 'toast', textContent: text })
      $('.toasts').append(node)
      setTimeout(() => node.remove(), 5000)
    }
    function avatar(person: { uuid: string; name: string }) {
      const color =
        ([...person.uuid].reduce((sum, letter) => sum + letter.charCodeAt(0), 0) % 4) + 1
      return el('span', {
        className: 'av',
        dataC: color,
        title: person.name,
        textContent: person.name.slice(0, 1),
      })
    }
    function renderPresence(presence: (Me & { tab: string })[]) {
      const others = presence
        .filter((person) => person.uuid !== me.uuid)
        .sort((a, b) => a.name.localeCompare(b.name, 'ru'))
      $('#who').replaceChildren(el('span', { textContent: 'в панели:' }), ...others.map(avatar))
      document.querySelectorAll<HTMLElement>('[data-presence-slot]').forEach((slot) => {
        slot.replaceChildren(
          ...others
            .filter((person) => person.tab === slot.dataset.presenceSlot)
            .slice(0, 3)
            .map(avatar),
        )
      })
    }
    function sendPresence() {
      if (document.visibilityState === 'visible')
        api('presence', 'POST', { tab: location.hash.slice(1) }).catch(() => {})
    }
    async function loadLiveTps() {
      if (!can('diagnostics')) return
      try {
        const live = await api('diagnostics/live')
        $('#s-tps').textContent = tps(live.tps)
      } catch {
        $('#s-tps').textContent = '—'
      }
    }
    let presenceTimer: ReturnType<typeof setInterval> | undefined
    let tpsTimer: ReturnType<typeof setInterval> | undefined
    function visibleTimers() {
      clearInterval(presenceTimer)
      clearInterval(tpsTimer)
      if (document.visibilityState !== 'visible') return
      sendPresence()
      presenceTimer = setInterval(sendPresence, 30_000)
      if (can('diagnostics')) {
        void loadLiveTps()
        tpsTimer = setInterval(() => void loadLiveTps(), 60_000)
      }
    }
    function refreshCurrentTab() {
      const loaders: Record<string, (() => Promise<void>)[]> = {
        overview: [loadOverview],
        players: [loadOnline, ...(can('ban') ? [loadBans] : [])],
        matches: [loadOverview],
        settings: [async () => settingsEvent(await api('settings'))],
        weapons: [loadGunBalance],
        kits: [async () => loadKits(true)],
        workshop: [loadCandidates, loadMapHistory],
        stats: [loadResults, loadSeasons, loadKeys],
        team: [loadTeam],
        journal: [loadAudit],
        health: [loadHealth],
      }
      for (const load of loaders[location.hash.slice(1)] ?? []) load().catch(() => {})
    }
    async function settingsEvent(data: any) {
      for (const finish of mapAvailabilityWaiters) finish(data)
      if ((data.settings.revision ?? 0) < observedSettingsRevision) return
      const changed = settingsLoaded && data.settings.revision !== observedSettingsRevision
      remoteSettingsName =
        (typeof data.settings.updatedBy === 'string'
          ? data.settings.updatedBy
          : data.settings.updatedBy?.name) ?? 'кто-то'
      await loadSettings(0, false, data)
      if (changed && remoteSettingsName !== me.name)
        toast(`${remoteSettingsName}: настройки обновлены`)
      if (data.gunBalance) await loadGunBalance()
      if (data.kits) await loadKits(true)
      if (kitCatalog) {
        const receipt = settingsReceipt(kitRevision, data.applied)
        if (receipt === 'applied')
          say($('#kits-status'), 'Наборы применены. Новые выдачи используют эти настройки.')
        else if (receipt === 'rejected' || receipt === 'partial')
          say(
            $('#kits-status'),
            'Сервер отклонил настройки наборов. Прежняя выдача сохранена.',
            'error',
          )
        if (data.settings.revision > kitRevision) await loadKits(true)
      }
    }
    function startEvents() {
      const events = new EventSource('/api/admin/events')
      let disconnected = false
      events.addEventListener('open', () => {
        $('#conn').dataset.tone = 'live'
        $('#conn').textContent = 'live'
        if (disconnected) {
          refreshCurrentTab()
          for (const [id, finish] of pendingRequests)
            api(`request?id=${id}`)
              .then(({ result }) => {
                if (result) finish(result)
              })
              .catch(() => {})
        }
        disconnected = false
      })
      events.addEventListener('error', () => {
        disconnected = true
        $('#conn').dataset.tone = 'bad'
        $('#conn').textContent = 'нет связи'
      })
      events.addEventListener(
        'status',
        (event) => void renderOverview(JSON.parse((event as MessageEvent).data)).catch(() => {}),
      )
      events.addEventListener('rooms', (event) => {
        const { rooms } = JSON.parse((event as MessageEvent).data)
        renderGameOverview(controller, rooms, lastWorkshop)
      })
      events.addEventListener(
        'settings',
        (event) => void settingsEvent(JSON.parse((event as MessageEvent).data)).catch(() => {}),
      )
      events.addEventListener('audit', (event) =>
        prependAudit(JSON.parse((event as MessageEvent).data).entry),
      )
      events.addEventListener('presence', (event) =>
        renderPresence(JSON.parse((event as MessageEvent).data).presence),
      )
      events.addEventListener('request', (event) => {
        const { id, result } = JSON.parse((event as MessageEvent).data)
        requestResult(id, result)
      })
      document.addEventListener('visibilitychange', visibleTimers)
      addEventListener(
        'pagehide',
        () => {
          events.close()
          clearInterval(presenceTimer)
          clearInterval(tpsTimer)
        },
        { once: true },
      )
    }

    // ---------- Tabs and start ----------
    // One #tabs list for every breakpoint: groups share it, CSS changes its orientation.
    function renderNav() {
      const nav = $('#tabs'),
        labels = new Map(
          [...document.querySelectorAll<HTMLElement>('.admin-content > section')].map((s) => [
            s.id,
            s.dataset.tab ?? s.id,
          ]),
        )
      nav.replaceChildren(
        ...NAV_GROUPS.map((group) => {
          const links = group.tabs
            .filter((tab) => can(tab.perm) && labels.has(tab.id))
            .map((tab) =>
              el(
                'a',
                { href: `#${tab.id}` },
                el('span', { textContent: labels.get(tab.id) }),
                ['players', 'matches'].includes(tab.id)
                  ? el('span', {
                      className: 'cnt',
                      id: tab.id === 'players' ? 'n-online' : 'n-matches',
                      textContent: '—',
                    })
                  : null,
                el('span', { className: 'presence-slot', 'data-presence-slot': tab.id }),
              ),
            )
          if (!links.length) return null
          return el(
            'span',
            { className: 'tabs__group', role: 'group', ariaLabel: group.label },
            el('span', { className: 'tabs__label', ariaHidden: 'true', textContent: group.label }),
            ...links,
          )
        }).filter((g): g is HTMLElement => g !== null),
      )
      nav.hidden = false
    }
    // Hash is resolved against permitted tabs only: a forbidden hash falls back to the role default.
    function showTab(id: string, focus: boolean) {
      const target = `#${resolveTab(me.role, me.permissions, id)}`
      if (location.hash !== target) window.history.replaceState(null, '', target)
      const tabs = [...document.querySelectorAll<HTMLAnchorElement>('#tabs a')]
      const current = tabs.find((t) => t.hash === target) ?? tabs[0]
      if (!current) return
      tabs.forEach((t) =>
        t === current ? t.setAttribute('aria-current', 'page') : t.removeAttribute('aria-current'),
      )
      current.scrollIntoView({ block: 'nearest', inline: 'center' })
      document
        .querySelectorAll<HTMLElement>('.admin-content > section')
        .forEach((s) => (s.hidden = `#${s.id}` !== current.hash))
      sendPresence()
      const section = document.querySelector<HTMLElement>(current.hash)
      if (focus) {
        section?.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true })
        window.scrollTo(0, 0)
      }
    }
    addEventListener('hashchange', () => showTab(location.hash.slice(1), true))

    let savedMessage = '',
      messageInFlight = false
    let messageTimer: ReturnType<typeof setTimeout> | undefined
    async function commitMessage() {
      clearTimeout(messageTimer)
      const input = $<HTMLTextAreaElement>('#message'),
        value = input.value.trim()
      if (!value || value === savedMessage || messageInFlight) return
      const line = $('#message-form .form-status')
      messageInFlight = true
      say(line, 'сохраняем…', 'pending')
      try {
        const { id } = await api('message', 'POST', { message: value })
        const previous = savedMessage
        const result = await follow(line, id, 'применено')
        savedMessage = result ? value : previous
        if (result && previous)
          changeToast('Сообщение мастерской', previous, value, false, async () => {
            try {
              const { status } = await api('overview')
              if (savedMessage !== value || status?.message !== value) {
                toast('Сообщение уже изменено. Отмена недоступна.')
                return
              }
              input.value = previous
              await commitMessage()
            } catch (error) {
              say(line, (error as Error).message, 'error')
            }
          })
      } catch (error) {
        say(line, (error as Error).message, 'error')
      } finally {
        messageInFlight = false
        if (input.value.trim() !== value) void commitMessage()
      }
    }
    $('#message-form').addEventListener('submit', (e) => e.preventDefault())
    $('#message').addEventListener('blur', () => void commitMessage())
    $('#message').addEventListener('input', () => {
      clearTimeout(messageTimer)
      messageTimer = setTimeout(() => void commitMessage(), 1200)
    })
    const RANGE: Record<string, { title: string; text: string; ok: string; done: string }> = {
      open: {
        title: 'Открыть полигон?',
        text: 'Игроки смогут заходить на тренировочную площадку.',
        ok: 'Открыть',
        done: 'Полигон открыт.',
      },
      close: {
        title: 'Закрыть полигон?',
        text: 'Все, кто сейчас на полигоне, вернутся в лобби.',
        ok: 'Закрыть',
        done: 'Полигон закрыт.',
      },
      reset: {
        title: 'Сбросить полигон?',
        text: 'Площадка вернётся в исходное состояние, игроки на ней вернутся в лобби.',
        ok: 'Сбросить',
        done: 'Полигон сброшен.',
      },
    }
    document.querySelectorAll<HTMLButtonElement>('[data-range]').forEach((b) =>
      b.addEventListener('click', async () => {
        const spec = RANGE[b.dataset.range!]
        if (!(await ask({ ...spec, danger: b.dataset.range !== 'open' }))) return
        run(
          $('#range-status'),
          async () => {
            await api('rcon', 'POST', { action: 'range', op: b.dataset.range })
            return spec.done
          },
          b.parentElement,
        )
      }),
    )
    $('#drain').addEventListener('click', async () => {
      if (
        !(await ask({
          title: 'Не начинать новые матчи?',
          text: 'Идущие матчи доиграют. Новые не начнутся.',
          ok: 'Не начинать новые',
          danger: true,
        }))
      )
        return
      run(
        $('#maint-status'),
        async () => {
          await api('rcon', 'POST', { action: 'drain' })
          return 'Новые матчи больше не начинаются.'
        },
        $('#drain').parentElement,
      )
    })
    $('#interrupt').addEventListener('click', async () => {
      const answer = await ask({
        title: 'Прервать все матчи?',
        text: 'Все идущие матчи сразу остановятся без победителя, игроки вернутся в лобби. Это нельзя отменить.',
        ok: 'Прервать все матчи',
        danger: true,
        fields: [reasonField('Причина (увидят все игроки)', true)],
      })
      if (!answer) return
      run(
        $('#maint-status'),
        async () => {
          await api('rcon', 'POST', { action: 'interrupt', reason: String(answer.get('reason')) })
          loadOverview()
          return 'Все матчи прерваны.'
        },
        $('#interrupt').parentElement,
      )
    })
    $<HTMLFormElement>('#say-form').addEventListener('submit', (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement,
        input = $<HTMLInputElement>('#say-text')
      run(
        form.querySelector<HTMLElement>('.form-status')!,
        async () => {
          await api('rcon', 'POST', { action: 'say', text: input.value })
          input.value = ''
          return 'Объявление отправлено.'
        },
        form,
      )
    })
    $<HTMLFormElement>('#byname-form').addEventListener('submit', (e) => {
      e.preventDefault()
      const form = e.currentTarget as HTMLFormElement
      playerAction(
        (e.submitter as HTMLButtonElement | null)?.value || 'kick',
        $<HTMLInputElement>('#byname').value,
        form.querySelector<HTMLElement>('.form-status')!,
      )
    })
    $('#online-refresh').addEventListener('click', () => {
      $('#online-summary').textContent = 'Обновляем…'
      loadOnline()
    })

    /** Знакомые никнеймы в поля ввода: подсказка, а не ограничение — своё значение всегда можно вписать. */
    async function loadPlayerHints() {
      const inputs = [$<HTMLInputElement>('#byname'), $<HTMLInputElement>('#grant-name')].filter(
        Boolean,
      )
      if (!inputs.length) return
      const setters = inputs.map((input) => customCombo(input))
      const { players } = await api('players')
      setters.forEach((set) => set(players))
    }

    const failed = (where: string) => (error: Error) => {
      const w = $('#whoami')
      w.append(el('span', { className: 'error', textContent: ` ${where}: ${error.message}` }))
    }
    api('me').then(
      async (data: Me & { role: string | null }) => {
        me = data
        const who = $('#whoami')
        if (!me.role) {
          who.textContent =
            'У вашего аккаунта нет доступа к панели. Попросите администратора добавить вас в команду.'
          return
        }
        who.replaceChildren(
          avatar(me),
          el('span', { textContent: `${me.name} · ${ROLES[me.role].name.toLowerCase()}` }),
        )
        document.querySelectorAll<HTMLElement>('[data-perm]').forEach((node) => {
          node.hidden = !can(node.dataset.perm!)
        })
        // A hidden submit would still fire on Enter: disable it too, so Enter picks a permitted action.
        document
          .querySelectorAll<HTMLButtonElement>('#byname-form button[data-perm]')
          .forEach((b) => (b.disabled = b.hidden))
        if (!can('ban'))
          $('#byname-about').textContent =
            'Если игрока нет в списке «Сейчас на сервере», его можно выгнать по никнейму.'
        renderNav()
        showTab(location.hash.slice(1), false)
        // Workshop reads are view-gated (safe existing GET maps/candidates), so a builder lands on a full tab.
        const loaders: [string, () => Promise<void>, string][] = [
          ['view', loadOverview, 'Обзор'],
          ['moderate', loadOnline, 'Игроки'],
          ['ban', loadBans, 'Забаненные'],
          ['settings', () => loadSettings(), 'Настройки'],
          ['settings', loadGunBalance, 'Баланс оружия'],
          ['settings', loadKits, 'Наборы'],
          ['settings', loadAiBudget, 'Бюджет AI'],
          ['settings', loadWorkshopAi, 'AI мастерской'],
          ['roles', loadTeam, 'Команда'],
          ['view', loadCandidates, 'Кандидаты'],
          ['view', loadMapHistory, 'Архив карт'],
          ['stats', loadResults, 'Статистика'],
          ['stats', loadSeasons, 'Сезоны'],
          ['stats', loadKeys, 'Ключи'],
          ['audit', loadAudit, 'Журнал'],
          ['diagnostics', loadHealth, 'Производительность'],
          ['moderate', loadPlayerHints, 'Подсказки игроков'],
        ]
        await Promise.all(
          loaders
            .filter(([permission]) => can(permission))
            .map(([, load, where]) => load().catch(failed(where))),
        )
        startEvents()
        visibleTimers()
      },
      (error: Error & { raw?: string }) => {
        const who = $('#whoami')
        if (/Войдите|Сессия/.test(error.raw ?? ''))
          who.replaceChildren(
            'Войдите в ',
            el('a', { href: '/account', textContent: 'аккаунт' }),
            ', чтобы открыть панель управления.',
          )
        else say(who, error.message, 'error')
      },
    )
  </script>
</Site>
