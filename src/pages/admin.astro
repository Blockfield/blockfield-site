                min="1"
                max="1000000"
                step="1"
              />
              <label for="workshop-ai-hourly-player-request-limit">Запросов в час, игрок</label>
              <input
                id="workshop-ai-hourly-player-request-limit"
                type="number"
                min="1"
                max="1000000"
                step="1"
              />
              <label for="workshop-ai-max-hourly-builders">Строителей в час</label>
              <input
                id="workshop-ai-max-hourly-builders"
                type="number"
                min="1"
                max="4096"
                step="1"
              />
              <label for="workshop-ai-prompt-cap">Потолок входа, USD за млн токенов</label>
              <input
