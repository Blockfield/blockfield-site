                  ) {
                    settingsSnapshot = ''
                    await loadSettings()
                  }
                },
              },
              'Перезагрузить',
            ),
          )
          line.classList.remove('ok', 'pending')
          line.classList.add('error')
          say($('#settings-state'), (error as Error).message, 'error')
        } else settingsStatus((error as Error).message, 'error', (error as Error).message)
      } finally {
        save.disabled = false
      }
    })

