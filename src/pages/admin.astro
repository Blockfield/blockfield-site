      margin: 0;
    }
    .admin-main section {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      min-width: 0;
      scroll-margin-top: 80px;
    }
    /* Operational sections: rows divided by seams, not equal card grids. */
    .admin-main section > * + * {
      border-top: 1px solid var(--line);
    }
