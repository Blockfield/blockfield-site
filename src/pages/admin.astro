    $('#maps-refresh').onclick = () => run($('#map-history-status'), loadMapHistory)
    // ---------- Map candidates ----------
    const reviewOutlets = new Map<string, HTMLElement>()
    async function previewMapReview(
      candidate: any,
      outlet: HTMLElement,
      line: HTMLElement,
      choices: Record<string, 'ours' | 'theirs'> = {},
    ) {
      const map = mapCatalog?.find((entry) => entry.mapId === candidate.mapId)
      if (!map || (map.head?.versionDigest ?? null) !== candidate.targetHead)
        throw new Error('Main изменилась после отправки. Нужна новая проверка из ветки.')
      const data = await mapRequest(
        'maps/merge-preview',
        {
          mapId: candidate.mapId,
          versionDigest: candidate.versionDigest,
          expectedHead: candidate.targetHead,
          ...(Object.keys(choices).length ? { resolutions: choices } : {}),
        },
        line,
        'Сравнение для слияния готово.',
      )
      if (!data) return
      if (
        data.sourceVersion !== candidate.versionDigest ||
        data.targetVersion !== candidate.targetHead ||
        !Array.isArray(data.conflicts) ||
        !Array.isArray(data.unresolved) ||
        !data.changes
      )
        throw new Error('Контроллер не подтвердил точные версии слияния. Обновите историю.')
      const changes = el('div', {}),
        conflicts = el('div', { className: 'stack git-diff' }),
        fields: HTMLSelectElement[] = []
      outlet.replaceChildren(
        el('p', {
          textContent:
            candidate.targetHead === null
              ? `Первая публикация коммита ${candidate.versionDigest.slice(0, 12)}. main ещё нет. Конфликтов: ${data.conflicts.length}.`
              : `Слияние коммита ${candidate.versionDigest.slice(0, 12)} в main ${candidate.targetHead.slice(0, 12)}. Конфликтов: ${data.conflicts.length}.`,
        }),
        changes,
        conflicts,
      )
      renderMapChanges(changes, data.changes)
      for (const conflict of data.conflicts) {
        const item = el(
          'details',
          { className: 'disclosure' },
          el('summary', { textContent: conflict.path }),
          el('strong', { textContent: 'main' }),
          el('pre', {
            textContent: conflict.oursPresent ? JSON.stringify(conflict.ours) : 'Отсутствует',
          }),
          el('strong', { textContent: 'Коммит на проверке' }),
          el('pre', {
            textContent: conflict.theirsPresent ? JSON.stringify(conflict.theirs) : 'Отсутствует',
          }),
        )
        if (can('workshop')) {
          const select = el(
            'select',
            { name: conflict.path },
            el('option', { value: '', textContent: 'Выберите версию' }),
            el('option', { value: 'ours', textContent: 'Оставить main' }),
            el('option', { value: 'theirs', textContent: 'Взять коммит на проверке' }),
          ) as HTMLSelectElement
          select.value = choices[conflict.path] ?? ''
          fields.push(select)
          item.append(
            field(
              'Решение конфликта',
              select,
              conflict.kind === 'binary'
                ? 'Регион заменяется целиком; блоки двух версий автоматически не смешиваются.'
                : 'Применится именно выбранное значение этого поля.',
            ),
          )
        }
        conflicts.append(item)
      }
      const actions = el('div', { className: 'actions' })
      if (can('workshop')) {
        if (fields.length)
          actions.append(
            button(
              'Проверить выбранные версии',
              () =>
                run(
                  line,
                  () =>
                    previewMapReview(
                      candidate,
                      outlet,
                      line,
                      Object.fromEntries(
                        fields
                          .filter((select) => select.value)
                          .map((select) => [select.name, select.value as 'ours' | 'theirs']),
                      ),
                    ),
                  outlet,
                ),
              'small',
            ),
          )
        const merge = button(
          'Слить в main',
          async () => {
            if (
              !(await ask({
                title: `Слить «${mapName(candidate.mapId)}» в main?`,
                text: 'Будет применён именно сохранённый коммит и проверенные решения конфликтов. Новый коммит сохранит обе истории. Незакоммиченные правки в мире в слияние не входят.',
                ok: 'Слить в main',
                danger: true,
              }))
            )
              return
            await run(
              line,
              async () => {
                const { id } = await api('candidates/publish', 'POST', {
                  candidateId: candidate.id,
                  mapId: candidate.mapId,
                  expectedHead: candidate.targetHead,
                  ...(Object.keys(choices).length ? { resolutions: choices } : {}),
                })
                const result = await follow(
                  line,
                  id,
                  'Коммит слит в main. Следующие матчи используют новую версию.',
                  (error) => mapRequestError(line, error),
                )
                if (result?.ok) {
                  reviewOutlets.delete(candidate.id)
                  await loadMapHistory()
                }
              },
              outlet,
            )
          },
          'small primary',
          `Слить коммит карты ${mapName(candidate.mapId)} в main`,
        )
        merge.disabled = data.unresolved.length > 0
        fields.forEach((select) =>
          select.addEventListener('change', () => {
            merge.disabled = true
            say(line, 'Проверьте выбранные версии перед слиянием.', 'pending')
          }),
        )
        actions.append(merge)
      }
      outlet.append(
        data.unresolved.length
          ? el('p', {
              className: 'muted',
              textContent: 'Для слияния нужно решить все конфликты и проверить выбранные версии.',
            })
          : el('p', { textContent: 'Неразрешённых конфликтов нет.' }),
        actions,
      )
      outlet.querySelectorAll<HTMLSelectElement>('select').forEach(customSelect)
    }
    const CANDIDATE_STATUS: Record<string, [string, string]> = {
      pending: ['Ждёт проверки', 'warn'],
      accepted: ['Принята', 'ok'],
      published: ['В игре', 'ok'],
      rejected: ['Отклонена', ''],
      superseded: ['Заменена новой', ''],
      rolled_back: ['Откачена', ''],
    }
    async function testMapCandidate(candidate: any, line: HTMLElement) {
      const modes = candidate.supportedModes
      if (
        !Array.isArray(modes) ||
        !modes.length ||
        modes.length > 7 ||
        new Set(modes).size !== modes.length ||
        !modes.every((id: string) => Object.hasOwn(ARENA_MODES, id))
      )
        throw new Error('Режимы сохранённой версии не подтверждены. Обновите список проверок.')
      const select = el(
          'select',
          { name: 'modeId', required: true },
          ...modes.map((id: keyof typeof ARENA_MODES) =>
            el('option', { value: id, textContent: ARENA_MODES[id] }),
          ),
        ),
        pending = ask({
          title: `Тестовый матч «${mapName(candidate.mapId)}»?`,
          text: 'Выберите режим сохранённого коммита. Мастерская перезапустится в закрытый тест на отдельной копии карты. Допуск — по списку тестеров; статистика игры не изменится.',
          ok: 'Начать тест',
          danger: true,
          fields: [field('Режим теста', select)],
        })
      customSelect(select)
      const form = await pending
      if (!form) return
      await run(line, async () => {
        const { id } = await api('mode', 'POST', {
          profile: 'test',
          expectedRevision: controller.revision,
          candidateId: candidate.id,
          modeId: String(form.get('modeId')),
        })
        await follow(
          line,
          id,
          `Тест «${mapName(candidate.mapId)}» запрошен. Готовность показана в обзоре.`,
        )
        await loadOverview()
      })
    }
    async function loadCandidates() {
      const { candidates } = await api('candidates')
      const line = $('#candidates-status')
      const rows = (candidates ?? []).slice(0, 15).map((c: any) => {
        const name = mapName(c.mapId),
          [label, tone] = CANDIDATE_STATUS[c.status] ?? [c.status, '']
        const decided = c.decidedBy ? ` · решил ${c.decidedBy.name} ${ago(c.decidedAt)}` : ''
        // baseMatches: false — the map's reference changed since editing started; null — unknown base (older drafts). Either needs a forced publish.
        // Two versions of one map need distinct accessible names on their buttons.
        const version = c.id.slice(0, 6)
        const baseWarn = c.sourceBranch
          ? null
          : c.baseMatches === false
            ? 'эталон карты изменился после начала правки'
            : c.baseMatches === null
              ? 'база неизвестна'
              : null
        const main = el(
          'div',
          { className: 'row-main' },
          el(
            'strong',
            {},
            `${name} `,
            el('span', { className: `badge ${tone}`, textContent: label }),
            baseWarn ? el('span', { className: 'badge warn', textContent: baseWarn }) : null,
          ),
          el('small', {
            textContent: `Отправил ${c.author?.name ?? '?'} ${ago(c.createdAt)} · ${c.native ? 'сохранены изменения в архиве' : `${(c.size / 1048576).toFixed(1)} МБ`}, регионов ${c.regions}${decided}`,
          }),
        )
        const actions = el('div', { className: 'actions' })
        if (c.sourceBranch && mayEditMap(c.mapId)) {
          if (c.status !== 'pending') reviewOutlets.delete(c.id)
          const outlet = reviewOutlets.get(c.id) ?? el('div', { className: 'stack' })
          if (c.status === 'pending') reviewOutlets.set(c.id, outlet)
          main.append(
            el('small', {
              textContent: `Ветка ${c.sourceBranch} · коммит ${c.versionDigest?.slice(0, 12) ?? 'не подтверждён'}. Правки после отправки не включены.`,
            }),
            outlet,
          )
          actions.append(
            button(
              'Сравнить с main',
              () =>
                run(line, async () => {
                  const map = mapCatalog?.find((entry) => entry.mapId === c.mapId)
                  if (!map) throw new Error('Карта не подтверждена. Обновите историю.')
                  if (!map.head) await previewMapReview(c, outlet, line)
                  else
                    await compareMap(c.mapId, map.head.versionDigest, c.versionDigest, outlet, line)
                }),
              'small',
              `Сравнить коммит карты ${name} с main`,
            ),
          )
          if (can('workshop') && c.status === 'pending')
            actions.append(
              button(
                'Проверить слияние',
                () => run(line, () => previewMapReview(c, outlet, line)),
                'small primary',
                `Проверить слияние карты ${name}`,
              ),
            )
        }
        const confirmForce = (reason: string) =>
          ask({
            title: `Принять «${name}» с другой базой?`,
            text: `${reason} Пакет сохранится с отметкой об изменившейся базе. Выпуск требует отдельной проверки.`,
            ok: 'Принять с отметкой',
            danger: true,
          })
        const publish = (force: boolean) =>
          run(line, async () => {
            const map = mapCatalog?.find((entry) => entry.mapId === c.mapId)
            if (!map)
              throw new Error('Сначала обновите историю карт. Текущая версия не подтверждена.')
            const { id } = await api('candidates/publish', 'POST', {
              candidateId: c.id,
              mapId: c.mapId,
              expectedHead: map.head?.versionDigest ?? null,
              ...(force ? { force: true } : {}),
            })
            follow(line, id, `Версия «${name}» принята и выбрана.`, async (error) => {
              // The controller never lets an older version replace a newer accepted one: retrying cannot help.
              if (/newer version/.test(error)) {
                say(
                  line,
                  'Уже принята более новая версия этой карты. Эту версию можно только отклонить.',
                  'error',
                )
                return true
              }
              if (!/^base (changed|unknown)/.test(error)) return false
              if (await confirmForce('Эталон карты, возможно, изменился с начала правки.'))
                publish(true)
              else say(line, 'Публикация отменена.', 'error')
              return true
            }).then(() => Promise.all([loadCandidates(), loadMapHistory()]))
            return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
          })
        if (can('workshop') && c.status === 'pending' && !c.sourceBranch) {
          actions.append(
            button(
              'Принять',
              async () => {
                if (
                  !(await ask({
                    title: `Принять «${name}»?`,
                    text: 'Будет принята и выбрана именно эта версия. Новые матчи используют её копию; уже начатые матчи сохранят прежнюю. Лобби применяются при безопасной смене игрового мира.',
                    ok: 'Принять',
                  }))
                )
                  return
                if (
                  baseWarn &&
                  !(await confirmForce(`Эта версия правилась поверх карты, у которой ${baseWarn}.`))
                )
                  return
                publish(!!baseWarn)
              },
              'small primary',
              `Принять ${name}, версия ${version}`,
            ),
            button(
              'Отклонить',
              async () => {
                if (
                  !(await ask({
                    title: `Отклонить эту версию «${name}»?`,
                    text: 'Версия останется в списке как отклонённая, в игру она не попадёт.',
                    ok: 'Отклонить',
                    danger: true,
                  }))
                )
                  return
                run(line, async () => {
                  const { id } = await api('candidates/reject', 'POST', {
                    candidateId: c.id,
                    mapId: c.mapId,
                  })
                  follow(line, id, 'Версия отклонена.').then(loadCandidates)
                  return 'Запрос отправлен…'
                })
              },
              'small danger',
              `Отклонить ${name}, версия ${version}`,
            ),
          )
        }
        if (can('workshop') && c.status === 'pending' && c.sourceBranch)
          actions.append(
            button(
              'Отклонить',
              async () => {
                if (
                  !(await ask({
                    title: `Отклонить проверку «${name}»?`,
                    text: 'Коммит и рабочая ветка останутся в истории. В main эта проверка не попадёт.',
                    ok: 'Отклонить',
                    danger: true,
                  }))
                )
                  return
                await run(line, async () => {
                  const { id } = await api('candidates/reject', 'POST', {
                    candidateId: c.id,
                    mapId: c.mapId,
                  })
                  const result = await follow(line, id, 'Проверка отклонена.')
                  if (result?.ok) {
                    reviewOutlets.delete(c.id)
                    await loadCandidates()
                  }
                })
              },
              'small danger',
              `Отклонить проверку карты ${name}`,
            ),
          )
        if (
          can('mode') &&
          c.status === 'pending' &&
          controller?.phase === 'workshop' &&
          controller.gate === 'builders'
        ) {
          actions.append(
            button(
              'Тест',
              () => run(line, () => testMapCandidate(c, line)),
              'small',
              `Тестовый матч ${name}, версия ${version}`,
            ),
          )
        }
        if (can('workshop') && c.status === 'accepted' && c.sha256) {
          const link = el('a', {
            className: 'small',
            textContent: 'Скачать пакет',
            href: `/api/admin/candidates/download?id=${encodeURIComponent(c.id)}`,
          })
          actions.append(link)
        }
        if (can('workshop') && c.status === 'accepted' && c.native && !c.sha256) {
          actions.append(
            button(
              'Экспортировать ZIP',
              () =>
                run(line, async () => {
                  const { id } = await api('candidates/export', 'POST', {
                    candidateId: c.id,
                    mapId: c.mapId,
                  })
                  follow(line, id, 'Пакет готов к скачиванию.').then(loadCandidates)
                  return 'Создаём архив выбранной версии…'
                }),
              'small',
              `Экспортировать ${name}, версия ${version}`,
            ),
          )
        }
        return el('li', { className: 'row' }, main, actions)
      })
      $('#candidate-list').replaceChildren(
        ...(rows.length
          ? rows
          : [el('li', { className: 'empty', textContent: 'Пока ничего не отправляли.' })]),
      )
    }
    async function submitMap(mapId: string, name: string) {
      if (
        !(await ask({
          title: `Отправить коммит «${name}» на проверку?`,
          text: 'Будет отправлен последний сохранённый коммит текущей ветки. Незакоммиченные правки в мире в него не входят. Ветка останется доступна для дальнейшего редактирования.',
          ok: 'Отправить коммит',
        }))
      )
        return
      const line = $('#candidates-status')
      run(line, async () => {
        const map = mapCatalog?.find((entry) => entry.mapId === mapId),
          branch = map?.branches?.find((ref) => ref.name === mapSession?.branches?.[mapId])
        if (!branch) throw new Error('Выбранная рабочая ветка не подтверждена. Обновите историю.')
        const { id } = await api('candidates/create', 'POST', {
          mapId,
          branch: branch.name,
          expectedBranchHead: branch.versionDigest,
        })
        await follow(
          line,
          id,
          `Коммит «${name}» отправлен на проверку. Новые правки остаются в черновике.`,
          (error) => mapRequestError(line, error),
        )
        await loadCandidates()
      })
    }

    async function editMapAccess(
      mapId: string,
      name: string,
      builders: { uuid: string; name: string }[],
      current: Set<string>,
      line: HTMLElement,
    ) {
      const list = el(
        'div',
        { className: 'checks' },
        ...builders.map((b) =>
          el(
            'label',
            { className: 'check' },
            el('input', {
              type: 'checkbox',
              name: 'builder',
              value: b.uuid,
              checked: current.has(b.uuid),
            }),
            b.name,
          ),
        ),
      )
      const answer = await ask({
        title: `Кто строит: «${name}»`,
        text: 'Отметьте строителей, которые могут здесь строить. Остальные зайдут только посмотреть.',
        ok: 'Сохранить',
        fields: [list],
      })
      if (!answer) return
      await run(
        line,
        async () => {
          const { changed, sync } = await api('staff/map-access', 'POST', {
            mapId,
            uuids: answer.getAll('builder').map(String),
          })
          await loadTeam()
          if (!changed.length) return 'Ничего не изменилось.'
          return sync?.error
            ? `Доступ к карте «${name}» сохранён, но мастерская его ещё не получила — нажмите «Обновить доступ».`
            : `Доступ к карте «${name}» обновлён.`
        },
        $('#map-access'),
      )
    }
    $<HTMLFormElement>('#grant-form').addEventListener('submit', async (e) => {
