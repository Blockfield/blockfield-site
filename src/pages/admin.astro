    $('#sync').addEventListener('click', () => {
      const line = $('#sync-status')
      run(
        line,
        async () => {
          const { id } = await api('staff/sync', 'POST', {})
          follow(line, id, 'Доступ в мастерскую обновлён.').then(loadTeam)
          return 'применяем…'
        },
        $('#sync').parentElement,
