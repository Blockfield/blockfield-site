      }
      kitOverrides[id] = {
        id,
        name: String(form.get('name')),
        allowedModeIds: [],
        deploymentCost: 0,
        playerLimit: 999,
        knifeSlot: 2,
        variants: [{ id: 'default', name: 'Основной', items: [] }],
      }
