        <section
          id="console"
          data-perm="rcon-raw"
          data-tab="Консоль"
          hidden
          aria-labelledby="console-title"
        >
          <h2 id="console-title" tabindex="-1">
            Консоль
          </h2>
          <p class="muted">Каждая команда попадает в журнал.</p>
          <form id="console-form" class="form-stack console-plate group">
            <div class="scope">
              <label for="console-target">Цель консоли</label>
              <select id="console-target" name="target">
                <option value="game">Основной сервер</option>
                <option value="workshop">Мастерская</option>
              </select>
            </div>
            <label for="console-input">Команда</label>
            <div class="console-complete">
              <input
                id="console-input"
                name="command"
                maxlength="1000"
                required
                autocomplete="off"
                spellcheck="false"
                role="combobox"
                aria-expanded="false"
                aria-controls="console-suggest"
                aria-describedby="console-hint"
              />
              <ul id="console-suggest" class="console-suggest" role="listbox" hidden></ul>
            </div>
            <small id="console-hint">
              Без «/». Tab и стрелки ↑ ↓ выбирают подсказку, Esc закрывает. Без подсказки стрелки ↑
              и ↓ листают введённые команды. Опасные команды попросят подтверждения.
            </small>
            <p id="console-usage" class="console-usage muted" hidden></p>
            <button class="primary" type="submit">
              Выполнить
            </button>
            <p class="form-status" role="status"></p>
          </form>
          <div class="console-logs group">
            <header>
              <h3>Журнал сервера</h3>
              <p class="hint">Память — последние 500 строк.</p>
            </header>
            <div class="console-log-controls">
              <label for="console-level">Уровень</label>
              <select id="console-level">
                <option value="">Все</option>
                <option value="INFO">Info</option>
                <option value="WARN">Предупреждения</option>
                <option value="ERROR">Ошибки</option>
              </select>
              <label for="console-search">Поиск</label>
              <input
                id="console-search"
                maxlength="200"
                autocomplete="off"
                spellcheck="false"
                placeholder="Текст или игрок"
              />
              <label class="console-check" for="console-follow">
                <input id="console-follow" type="checkbox" checked /> Следить
              </label>
              <button id="console-pause" type="button" class="small">
                Пауза
              </button>
            </div>
            <div
              id="console-log"
              class="console-log"
              role="log"
              aria-label="Строки журнала сервера"
            ></div>
            <p id="console-log-detail" class="console-log-detail muted" hidden></p>
          </div>
          <pre
            id="console-output"
            class="console-output"
            role="log"
            aria-label="Ответы сервера"
          ></pre>
        </section>

        <section
          id="journal"
          data-perm="audit"
          data-tab="Журнал действий"
