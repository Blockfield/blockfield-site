        return
      }
      run($('#workshop-ai-key-status'), async () => {
        const { id } = await api('workshop-ai-key', 'POST', { key })
        field.value = ''
        say($('#workshop-ai-key-status'), 'Ключ применяется…', 'pending')
        await pollWorkshopAiKey(id)
      })
    }
    $('#workshop-ai-key-delete').onclick = async () => {
