                  return 'Запрос отправлен. Ожидаем подтверждение контроллера…'
                })
              },
              'small',
              `Восстановить ${name}, коммит ${version.versionDigest.slice(0, 8)}`,
            )
            // Only reviewers move protected main; editing rights belong to the selected work branch.
            choose.disabled = current
            const actions = el(
