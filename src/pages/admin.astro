    // Re-rendered cards get fresh enabled buttons: a map's save/send stays blocked until its own request ends.
    const busyMaps = new Set<string>()
    async function mapBusy(id: string, action: () => Promise<void>) {
      if (busyMaps.has(id)) return
      busyMaps.add(id)
      try {
        await action()
      } finally {
        busyMaps.delete(id)
        renderMaps()
      }
