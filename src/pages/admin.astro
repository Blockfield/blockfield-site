    }
    .admin-main section > h2 {
      padding-top: 4px;
    }
    .admin-main .panel,
    .admin-main .stack {
      display: grid;
      gap: 12px;
      align-content: start;
      min-width: 0;
      margin: 0;
    }
    .admin-main .stack-head {
      display: grid;
      gap: 4px;
      max-width: 78ch;
    }
    .admin-main .stack-head--row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      max-width: none;
    }
    .admin-main .form-stack {
      display: grid;
      gap: 12px;
      align-content: start;
      max-width: 720px;
    }
    .admin-main .form-stack .actions {
      max-width: none;
