      .admin-main .field {
        grid-template-columns: 1fr;
        gap: 6px;
      }
      .admin-main .field small {
        grid-column: 1;
      }
      .admin-main .console-head {
        gap: 4px;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .admin-main .tabs {
        scroll-behavior: auto;
      }
    }
  </style>

  <script>
    import {
      BALANCE_DEFAULTS,
      ARENA_MODES,
      BALANCE_GROUPS,
      BALANCE_LABELS,
      BALANCE_SCOPES,
      CLASS_COSTS,
      CLASS_NAMES,
      KIT_GUNS,
      MAP_NAMES,
      MODE_NAMES,
      PARCOOL_ACTIONS,
      PARCOOL_FILE_DEFAULT,
      WORKSHOP_PLACES,
      TEAM_NAMES,
    } from '../lib/game-names'
    import { settingsBody, settingsReceipt } from '../lib/settings-form'
    import { renderBodyPartField } from '../lib/body-part-form'
    import { renderAiBudgetForm, type BudgetTarget } from '../lib/ai-budget-form'
    import { canonicalBudgetUuid } from '../lib/ai-budget'
    import { weaponFields } from '../lib/gun-fields'
    import { effectiveKits, renderKitForm } from '../lib/kit-form'
    import { validateKitChanges, type KitCatalog, type KitDefinition } from '../lib/kit-schema'
    import { customSelect, customCombo } from '../lib/custom-select'
    import { gameReady, switchView } from '../lib/switch-status'
    import { dangerousCommand } from '../lib/console'
    import { NAV_GROUPS, resolveTab } from '../lib/admin-navigation'
    import type {
      GunBalanceCatalog,
      GunDefinition,
      GunField,
      GunOverrides,
    } from '../lib/gun-balance'
    import type { MapCatalogEntry, MapSession } from '../lib/admin'

    type Me = { name: string; role: string | null; permissions: string[] }
    const $ = <T extends HTMLElement = HTMLElement>(selector: string) =>
      document.querySelector<T>(selector)!
    const ROLES: Record<string, { name: string; about: string }> = {
      builder: {
        name: 'Строитель',
        about:
          'Правит доступные карты, создаёт ветки и коммиты, отправляет сохранённые версии на проверку.',
      },
      moderator: {
        name: 'Модератор',
        about:
          'Следит за порядком в игре: может выгнать, объявить что-то всем и завершить зависший матч.',
      },
      admin: {
        name: 'Администратор',
        about:
          'Отвечает за сервер целиком: баны, настройки игры, честность статистики и состав команды.',
      },
      owner: {
        name: 'Владелец',
        about:
          'Полный доступ, включая назначение администраторов. Владельцы задаются в настройках сервера.',
      },
    }
    const PHASES: Record<string, string> = {
      IDLE: 'Ждёт игроков',
      VOTING: 'Голосование за карту',
      PREPARING: 'Подготовка к бою',
      GAME: 'Идёт бой',
      MATCH_END: 'Подведение итогов',
    }
    const OUTCOMES: [string, string, string][] = [
      ['draw', 'Ничья', 'Никто не побеждает.'],
      ['RED', 'Победа красных', ''],
      ['BLUE', 'Победа синих', ''],
      ['none', 'Без итога', 'Матч просто останавливается, победитель не записывается.'],
    ]
    let me: Me
    const can = (permission: string) => me.permissions.includes(permission)

    // The whole site shows times in UTC (leaderboard and player pages too), always labelled.
    const dateFormat = new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'long',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'UTC',
    })
    const relative = new Intl.RelativeTimeFormat('ru', { numeric: 'auto' })
    const date = (ms: number) => `${dateFormat.format(ms)} UTC`
    function ago(ms: number) {
      const seconds = (ms - Date.now()) / 1000
      for (const [unit, size] of [
        ['year', 31536000],
        ['month', 2592000],
        ['week', 604800],
        ['day', 86400],
        ['hour', 3600],
        ['minute', 60],
      ] as const)
        if (Math.abs(seconds) >= size) return relative.format(Math.round(seconds / size), unit)
      return 'только что'
    }
    const number = (n: number) => n.toLocaleString('ru-RU')

    /** Server errors are mostly Russian already; technical or English ones are replaced with plain words. */
    function friendly(message: string | undefined, status: number) {
      const rules: [RegExp, string][] = [
        [
          /^Сервер не принял команду/,
          'Игровой сервер не выполнил действие. Возможно, игрок уже вышел или матч уже закончился.',
        ],
        [/^(Недостаточно прав|Нет доступа)/, 'У вашей роли нет прав на это действие.'],
        [
          /^RCON не настроен/,
          'Управление игровым сервером с сайта не настроено. Сообщите владельцу.',
        ],
        [/already voided/, 'Этот матч уже не учитывается. Обновите страницу.'],
        [/is not voided/, 'Этот матч уже учитывается. Обновите страницу.'],
        [/Result not found/, 'Матч не найден. Обновите страницу.'],
        [/^Нет ревизии/, 'Состояние сервера изменилось. Обновите страницу и попробуйте снова.'],
        [/Участник не найден/, 'Этого участника уже нет в команде. Обновите страницу.'],
      ]
      if (!message)
        return status >= 500
          ? 'Сайт сейчас не отвечает. Попробуйте через минуту.'
          : 'Не получилось. Обновите страницу и попробуйте ещё раз.'
      const rule = rules.find(([pattern]) => pattern.test(message))
      if (rule) return rule[1]
      return /[а-яё]/i.test(message)
        ? message
        : 'Что-то пошло не так. Обновите страницу и попробуйте ещё раз.'
    }
    async function api(path: string, method = 'GET', body?: unknown) {
      // Content-Type is sent even without a body: Astro's origin check rejects bodiless non-GET requests behind the proxy.
      const response = await fetch(`/api/admin/${path}`, {
        method,
        cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body),
      }).catch(() => null)
      if (!response) throw new Error('Нет связи с сайтом. Проверьте интернет и попробуйте ещё раз.')
      const data = await response.json().catch(() => null)
      if (method !== 'GET' && can('audit')) loadAudit().catch(() => {})
      if (!response.ok)
        throw Object.assign(new Error(friendly(data?.error, response.status)), {
          raw: data?.error ?? '',
          status: response.status,
        })
      return data
    }
    function el<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      props: Record<string, any> = {},
      ...children: (Node | string | null | undefined | false)[]
    ) {
      const node = document.createElement(tag)
      for (const [key, value] of Object.entries(props)) {
        if (key.startsWith('aria') || key.startsWith('data') || key === 'role' || key === 'for')
          node.setAttribute(
            key
              .replace(/^aria([A-Z])/, (_, c) => `aria-${c.toLowerCase()}`)
              .replace(/^data([A-Z])/, (_, c) => `data-${c.toLowerCase()}`),
            String(value),
          )
        else (node as any)[key] = value
      }
      node.append(
        ...children.filter((c): c is Node | string => c !== null && c !== undefined && c !== false),
      )
      return node
    }
    const button = (text: string, onclick: () => void, className = 'small', label?: string) =>
      el('button', {
        type: 'button',
        className,
        textContent: text,
        onclick,
        ...(label ? { ariaLabel: label } : {}),
      })
    function say(line: HTMLElement, text: string, tone: 'ok' | 'error' | 'pending' = 'ok') {
      line.textContent = text
      line.classList.remove('ok', 'error', 'pending')
      line.classList.add(tone)
    }
    /** Runs an action with its buttons disabled and reports progress, success or a friendly error on `line`. */
    async function run(
      line: HTMLElement,
      action: () => Promise<string | void>,
      scope: HTMLElement | null = null,
    ) {
      const buttons = scope ? [...scope.querySelectorAll('button')].filter((b) => !b.disabled) : []
      buttons.forEach((b) => (b.disabled = true))
      say(line, 'Выполняем…', 'pending')
      try {
        const text = await action()
        if (text) say(line, text)
        else {
          // Some actions render a one-time key or other structured success feedback directly.
          if (line.textContent === 'Выполняем…') line.textContent = ''
          line.classList.replace('pending', 'ok')
        }
      } catch (error) {
        say(line, (error as Error).message, 'error')
      } finally {
        buttons.forEach((b) => (b.disabled = false))
      }
    }

    // Accessible confirmation: native <dialog> traps focus, Escape cancels, focus returns to the opener.
    const dialog = $<HTMLDialogElement>('#dialog')
    function ask({
      title,
      text,
      ok,
      danger = false,
      fields = [],
    }: {
      title: string
      text: string
      ok: string
      danger?: boolean
      fields?: Node[]
    }): Promise<FormData | null> {
      const opener = document.activeElement as HTMLElement | null
      $('#dialog-title').textContent = title
      $('#dialog-text').textContent = text
      $('#dialog-fields').replaceChildren(...fields)
      Object.assign($('#dialog-ok'), {
        textContent: ok,
        className: danger ? 'primary danger' : 'primary',
      })
      dialog.returnValue = ''
      dialog.showModal()
      return new Promise((resolve) =>
        dialog.addEventListener(
          'close',
          () => {
            const form = dialog.querySelector('form')!
            resolve(dialog.returnValue === 'ok' ? new FormData(form) : null)
            opener?.focus()
          },
          { once: true },
        ),
      )
    }
    let fieldId = 0
    function field(label: string, input: HTMLElement, hint?: string, wrap?: HTMLElement) {
      const id = `f${++fieldId}`
      input.id = id
      if (hint) input.setAttribute('aria-describedby', `${id}-hint`)
      return el(
        'div',
        { className: 'field' },
        el('label', { for: id, textContent: label }),
        wrap ?? input,
        hint ? el('small', { id: `${id}-hint`, textContent: hint }) : null,
      )
    }
    const reasonField = (label = 'Причина (игрок её увидит)', required = false) =>
      field(
        label,
        el('input', { name: 'reason', maxLength: 120, required, autocomplete: 'off' }),
        required ? undefined : 'Необязательно.',
      )

    /**
     * Controller requests are applied by the host within ~15 s; poll its result file for up to a minute.
     * `onError`, when given, sees the raw error text first and may handle it itself (return true) instead of the generic message.
     * Each line tracks its own request id: a newer request on the same line supersedes the older poll, never the reverse.
     */
    const followTokens = new WeakMap<HTMLElement, string>()
    async function follow(
      line: HTMLElement,
      id: string,
      done: string,
      onError?: (error: string) => Promise<boolean> | boolean,
    ) {
      followTokens.set(line, id)
      say(
        line,
        `Запрос ${id.slice(0, 8)} отправлен. Сервер применит его в течение 15 секунд…`,
        'pending',
      )
      for (let i = 0; i < 30; i++) {
        await new Promise((r) => setTimeout(r, 2000))
        if (followTokens.get(line) !== id) return
        const { result } = await api(`request?id=${id}`).catch(() => ({ result: null }))
        if (result) {
          if (followTokens.get(line) !== id) return
          if (result.ok) say(line, done)
          else if (!(await onError?.(String(result.error))))
            say(
              line,
              /revision/i.test(String(result.error))
                ? 'Состояние сервера успело измениться. Обновите страницу и попробуйте снова.'
                : 'Сервер не смог выполнить запрос. Попробуйте ещё раз или сообщите владельцу.',
              'error',
            )
          loadOverview()
          return result
        }
      }
      if (followTokens.get(line) !== id) return
      say(
        line,
        'Сервер не ответил за минуту. Возможно, управляющая программа выключена — проверьте состояние позже.',
        'error',
      )
    }

    // ---------- Overview and matches ----------
    let controller: any = null
    let session: any = null
    /** since/deadline are ms timestamps; ago() naturally reads a future one as "через …" and a past one as "… назад". */
    function timing(view: ReturnType<typeof switchView>): string {
      return [
        typeof view.since === 'number' ? `началось ${ago(view.since)}` : null,
        typeof view.deadline === 'number' ? `автоматический откат ${ago(view.deadline)}` : null,
      ]
        .filter(Boolean)
        .join(' · ')
    }
    /** «Мастерская»/«Тестовый матч» status: who started the session, when, and which maps it covers. */
    function sessionLine(current: any): string | null {
      if (!current) return null
      const maps = current.maps
        ? current.maps.map((id: string) => MAP_NAMES[id] ?? id).join(', ')
        : 'все карты'
      return `Сеанс: ${maps} · начал ${current.startedBy?.name ?? '?'} ${ago(current.startedAt)}.`
    }
    function describeWorkshop(
      state: any,
      current: any,
      testCandidate: any,
    ): { tone: string; title: string; detail: string } {
      const view = switchView(state),
        when = timing(view)
      switch (state?.schema === 1 ? state.phase : undefined) {
        case 'workshop':
          if (state.gate !== 'builders') break
          return {
            tone: 'ok',
            title: 'Мастерская открыта',
            detail: [sessionLine(current), 'Доступна участникам команды с выданными правами.']
              .filter(Boolean)
              .join(' '),
          }
        case 'test': {
          if (state.gate !== 'testers') break
          const name = testCandidate
            ? (WORKSHOP_PLACES[testCandidate.mapId] ?? testCandidate.mapId)
            : 'карта'
          const who = testCandidate?.author?.name
            ? ` (кандидат от ${testCandidate.author.name}, ${ago(testCandidate.createdAt)})`
            : ''
          return {
            tone: 'warn',
            title: `Тестовый матч: ${name}${who}`,
            detail: [sessionLine(current), 'Заходить могут только тестеры.']
              .filter(Boolean)
              .join(' '),
          }
        }
        case 'DRAINING':
          return {
            tone: 'warn',
            title: 'Мастерская готовится к смене режима',
            detail: [view.step, when].filter(Boolean).join(' · '),
          }
        case 'REQUESTED':
        case 'SAVING':
        case 'STARTING':
          return {
            tone: 'warn',
            title: view.step ?? 'Мастерская перезапускается',
            detail: when || 'Вход в мастерскую временно закрыт.',
          }
        case 'ERROR':
          return {
            tone: 'bad',
            title: 'Мастерская недоступна из-за ошибки',
            detail: [
              view.errorMessage ? `Причина: ${view.errorMessage}.` : null,
              can('recover')
                ? 'Восстановите мастерскую в карточке «Игра и мастерская».'
                : 'Сообщите администратору.',
            ]
              .filter(Boolean)
              .join(' '),
          }
      }
      return {
        tone: 'warn',
        title: 'Готовность мастерской не подтверждена',
        detail: 'Дождитесь состояния от управляющей программы.',
      }
    }
    function describeGame(state: any, rooms: any): { tone: string; title: string; detail: string } {
      if (rooms.maintenance)
        return { tone: 'warn', title: 'Вход в игру закрыт', detail: rooms.maintenance.message }
      if (!gameReady(state))
        return {
          tone: 'warn',
          title:
            state?.game?.phase === 'STARTING'
              ? 'Игра запускается'
              : 'Готовность игры не подтверждена',
          detail: 'Дождитесь состояния игрового сервера.',
        }
      if (rooms.available)
        return {
          tone: 'ok',
          title: 'Игра работает',
          detail: `Идёт матчей: ${rooms.rooms?.length ?? 0}`,
        }
      return {
        tone: 'bad',
        title: 'Игровой сервер не отвечает',
        detail: rooms.lobby
          ? 'Лобби работает, но матчи сейчас недоступны.'
          : 'Игроки сейчас не могут зайти.',
      }
    }
    async function loadOverview() {
      const { status: state, session: sessionData, rooms } = await api('overview')
      controller = state
      session = sessionData
      // The candidate behind a running test match: same source the candidates card reads, "view" permission covers it.
      const testCandidate =
        state?.phase === 'test' && state?.desired?.candidate
          ? ((await api('candidates').catch(() => ({ candidates: [] }))).candidates?.find(
              (c: any) => c.sha256 === state.desired.candidate,
            ) ?? null)
          : null
      const workshop = describeWorkshop(state, session, testCandidate)
      say(
        $('#editor-state'),
        `${workshop.title}. ${workshop.detail}`,
        workshop.tone === 'bad' ? 'error' : workshop.tone === 'warn' ? 'pending' : 'ok',
      )
      const view = describeGame(state, rooms)
      $('#server-card').dataset.tone = view.tone
      $('#server-headline').textContent = view.title
      $('#server-detail').textContent = [
        view.detail,
        `проверено ${ago(rooms.checkedAt || Date.now())}`,
      ]
        .filter(Boolean)
        .join(' · ')
      const message = $<HTMLTextAreaElement>('#message')
      if (
        !message.value &&
        typeof state?.message === 'string' &&
        document.activeElement !== message
      )
        message.value = state.message
      renderModes(workshop, rooms)
      renderRooms(rooms)
      // The candidates card's «Тест» button depends on the phase just learned above; keep it in sync (cheap local read).
      if (can('workshop')) loadCandidates().catch(() => {})
    }

    function renderModes(workshop: { title: string; detail: string; tone: string }, rooms: any) {
      const box = $('#mode-options')
      const view = switchView(controller)
      say($('#mode-progress'), view.notice ?? '', view.notice ? 'error' : 'ok')
      const ready = gameReady(controller) && !rooms.maintenance
      const editor = el(
        'div',
        { className: 'option' },
        el(
          'div',
          { className: 'option-head' },
          workshop.title,
          el('span', {
            className: `badge ${workshop.tone}`,
            textContent: view.busy
              ? 'Применяется…'
              : controller?.phase === 'test'
                ? 'Закрытый тест'
                : workshop.tone === 'ok'
                  ? 'Доступна'
                  : 'Вход закрыт',
          }),
        ),
        el('p', { textContent: workshop.detail }),
      )
      const actionable =
        controller?.schema === 1 &&
        Number.isSafeInteger(controller.revision) &&
        controller.revision >= 0
      if (actionable && can('mode')) {
        if (view.busy && view.canCancel)
          editor.append(button('Отменить смену режима', cancelSwitch, 'small danger'))
        else if (controller.phase === 'ERROR' && can('recover'))
          editor.append(button('Восстановить мастерскую', recoverWorkshop, 'small primary'))
        else if (controller.phase === 'test')
          editor.append(button('Вернуться в мастерскую', resumeWorkshop, 'small'))
        else if (!view.busy && controller.phase !== 'ERROR')
          editor.append(button('Выбрать сеанс и карты', startWorkshop, 'small'))
      }
      box.replaceChildren(
        el(
          'div',
          { className: 'option', ...(ready ? { dataCurrent: '' } : {}) },
          el(
            'div',
            { className: 'option-head' },
            'Игра',
            el('span', {
              className: `badge ${ready ? 'ok' : 'warn'}`,
              textContent: ready ? 'Вход открыт' : 'Готовность не подтверждена',
            }),
          ),
          el('p', { textContent: 'Матчи и обычный вход обслуживает отдельный игровой сервер.' }),
        ),
        editor,
      )
    }
    async function cancelSwitch() {
      if (
        !(await ask({
          title: 'Отменить смену режима мастерской?',
          text: 'Мастерская вернётся в прежний режим. Отмена доступна на текущем этапе; после сохранения мира может потребоваться восстановление.',
          ok: 'Отменить смену режима',
          danger: true,
        }))
      )
        return
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('cancel', 'POST', {})
          follow(line, id, 'Мастерская возвращается в прежний режим.')
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
        },
        $('#mode-options'),
      )
    }
    async function recoverWorkshop() {
      if (
        !(await ask({
          title: 'Восстановить мастерскую?',
          text: 'Мастерская перезапустится в редакторе с прежним сеансом. Используйте это после ошибки запуска.',
          ok: 'Восстановить мастерскую',
          danger: true,
        }))
      )
        return
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('mode', 'POST', {
            profile: 'game',
            expectedRevision: controller.revision,
            recover: true,
          })
          follow(line, id, 'Сервер принял запрос: восстанавливаем мастерскую.')
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
        },
        $('#mode-options'),
      )
    }
    /** A new session selects published map copies; resume keeps the existing edits and selection. */
    async function startWorkshop() {
      const known = mapScopes()
      const checks = el(
        'div',
        { className: 'checks' },
        ...known.map((id) =>
          el(
            'label',
            { className: 'check' },
            el('input', { type: 'checkbox', name: 'map', value: id, checked: true }),
            mapName(id),
          ),
        ),
      )
      const all = el('input', { type: 'checkbox', checked: true }) as HTMLInputElement
      all.addEventListener('change', () =>
        checks
          .querySelectorAll('input')
          .forEach((i) => ((i as HTMLInputElement).checked = all.checked)),
      )
      const mapsBlock = el('div', {}, el('label', { className: 'check' }, all, 'Все карты'), checks)
      const fields: Node[] = []
      if (session) {
        const label = session.maps
          ? session.maps.map((id: string) => MAP_NAMES[id] ?? id).join(', ')
          : 'все карты'
        const resume = el('input', {
          type: 'radio',
          name: 'session',
          value: 'resume',
          checked: true,
        }) as HTMLInputElement
        const fresh = el('input', {
          type: 'radio',
          name: 'session',
          value: 'new',
        }) as HTMLInputElement
        const toggle = () =>
          mapsBlock
            .querySelectorAll('input')
            .forEach((i) => ((i as HTMLInputElement).disabled = !fresh.checked))
        resume.addEventListener('change', toggle)
        fresh.addEventListener('change', toggle)
        toggle()
        fields.push(
          el(
            'fieldset',
            { className: 'plain' },
            el('legend', { textContent: 'Сеанс' }),
            el(
              'label',
              { className: 'radio' },
              resume,
              el('span', {}, `Продолжить прошлый сеанс (${date(session.startedAt)}, ${label})`),
            ),
            el('label', { className: 'radio' }, fresh, 'Новый сеанс'),
          ),
        )
      }
      fields.push(mapsBlock)
      const answer = await ask({
        title: 'Выбрать сеанс мастерской?',
        text: 'При смене сеанса мастерская сохранит мир и перезапустится. Новый сеанс готовит рабочие копии из опубликованных версий карт; продолжение сохраняет текущие правки и список карт.',
        ok: 'Открыть сеанс',
        danger: true,
        fields,
      })
      if (!answer) return
      const resuming = !!session && answer.get('session') !== 'new'
      const ids = answer.getAll('map').map(String)
      const body: Record<string, unknown> = {
        profile: 'workshop',
        expectedRevision: controller.revision,
        session: resuming ? 'resume' : 'new',
        ...(resuming ? {} : { maps: ids.length === known.length ? null : ids }),
      }
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('mode', 'POST', body)
          follow(line, id, 'Сервер принял запрос: готовим выбранный сеанс мастерской.')
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
        },
        $('#mode-options'),
      )
    }
    async function resumeWorkshop() {
      if (
        !(await ask({
          title: 'Вернуться в мастерскую?',
          text: 'Тестовый матч остановится, мастерская вернётся в редактор с тем же сеансом и рабочими копиями.',
          ok: 'Вернуться в мастерскую',
        }))
      )
        return
      const line = $('#mode-status')
      run(
        line,
        async () => {
          const { id } = await api('mode', 'POST', {
            profile: 'workshop',
            expectedRevision: controller.revision,
            session: 'resume',
          })
          follow(line, id, 'Сервер принял запрос: возвращаемся в мастерскую.')
          return 'Запрос отправлен. Сервер применит его в течение 15 секунд…'
        },
        $('#mode-options'),
      )
    }

    function renderRooms(rooms: any) {
      const list = $('#room-list')
      if (!rooms.available) {
        list.replaceChildren(
          el('p', {
            className: 'empty',
            textContent: rooms.maintenance
              ? 'Вход на сервер закрыт — матчей сейчас нет.'
              : 'Игровой сервер не отвечает, список матчей недоступен.',
          }),
        )
        return
      }
      if (!rooms.rooms.length) {
        list.replaceChildren(
          el('p', { className: 'empty', textContent: 'Сейчас не идёт ни одного матча.' }),
        )
        return
      }
      list.replaceChildren(
        ...rooms.rooms.map((room: any) => {
          const facts: [string, string][] = [
            ['Карта', room.map || 'выбирается'],
            ['Режим', room.mode],
            ['Сейчас', PHASES[room.phase] ?? 'Идёт'],
            ['Игроков', String(room.players)],
          ]
          if (room.battle)
            facts.push(['Тикеты', `красные ${room.battle.red} · синие ${room.battle.blue}`])
          const card = el(
            'article',
            { className: 'card room', ariaLabel: room.name },
            el(
              'div',
              { className: 'card-head' },
              el('h3', { textContent: room.name }),
              el('span', {
                className: `badge ${room.joinable ? 'ok' : ''}`,
                textContent: room.joinable ? 'Можно зайти' : 'Набор закрыт',
              }),
            ),
            el(
              'dl',
              { className: 'facts' },
              ...facts.flatMap(([k, v]) => [
                el('dt', { textContent: k }),
                el('dd', { textContent: v }),
              ]),
            ),
          )
          if (can('moderate'))
            card.append(
              button(
                'Завершить матч',
                () => stopRoom(room),
                'danger',
                `Завершить матч «${room.name}»`,
              ),
            )
          return card
        }),
      )
    }
    async function stopRoom(room: any) {
      const radios = el(
        'fieldset',
        { className: 'plain' },
        el('legend', { textContent: 'Чем закончить матч' }),
        el(
          'div',
          { className: 'radios' },
          ...OUTCOMES.map(([value, label, about], i) =>
            el(
              'label',
              { className: 'radio' },
              el('input', {
                type: 'radio',
                name: 'outcome',
                value,
                required: true,
                checked: i === 0,
              }),
              el('span', {}, label, about ? el('small', { textContent: about }) : null),
            ),
          ),
        ),
      )
      const answer = await ask({
        title: `Завершить матч «${room.name}»?`,
        text: 'Все игроки вернутся в лобби. Итог попадёт в статистику.',
        ok: 'Завершить матч',
        danger: true,
        fields: [radios, reasonField('Причина (увидят игроки)')],
      })
      if (!answer) return
      const outcome = String(answer.get('outcome')),
        reason = String(answer.get('reason') ?? '')
      run($('#room-status'), async () => {
        await api('rcon', 'POST', {
          action: 'stop-room',
          roomId: room.id,
          outcome,
          reason: outcome === 'none' && /^(win|draw)\b/i.test(reason) ? `— ${reason}` : reason,
        })
        loadOverview()
        return `Матч «${room.name}» завершён.`
      })
    }

    // ---------- Players ----------
    const PLAYER_ACTIONS: Record<
      string,
      {
        ok: string
        title: (p: string) => string
        text: (p: string) => string
        done: (p: string) => string
        reason: boolean
      }
    > = {
      kick: {
        ok: 'Выгнать',
        title: (p) => `Выгнать ${p}?`,
        text: (p) => `${p} будет отключён от сервера, но сможет сразу зайти снова.`,
        done: (p) => `${p} выгнан с сервера.`,
        reason: true,
      },
      'team-kick': {
        ok: 'Убрать из матча',
        title: (p) => `Убрать ${p} из матча?`,
        text: (p) => `${p} покинет команду в текущем матче. С сервера его не выгонит.`,
        done: (p) => `${p} убран из матча.`,
        reason: false,
      },
      ban: {
        ok: 'Забанить',
        title: (p) => `Забанить ${p}?`,
        text: (p) => `${p} будет отключён и не сможет зайти на сервер, пока его не разбанят.`,
        done: (p) => `${p} забанен.`,
        reason: true,
      },
      pardon: {
        ok: 'Разбанить',
        title: (p) => `Разбанить ${p}?`,
        text: (p) => `${p} снова сможет заходить на сервер.`,
        done: (p) => `${p} разбанен.`,
        reason: false,
      },
    }
    async function playerAction(action: string, player: string, line: HTMLElement) {
      const spec = PLAYER_ACTIONS[action]
      const answer = await ask({
        title: spec.title(player),
        text: spec.text(player),
        ok: spec.ok,
        danger: action !== 'pardon',
        fields: spec.reason ? [reasonField()] : [],
      })
      if (!answer) return
      await run(line, async () => {
        await api('rcon', 'POST', { action, player, reason: String(answer.get('reason') ?? '') })
        if (action === 'ban' || action === 'pardon') loadBans()
        if (action !== 'pardon') setTimeout(loadOnline, 1000)
        return spec.done(player)
      })
    }
    async function loadOnline() {
      const summary = $('#online-summary')
      try {
        const { players } = await api('rcon', 'POST', { action: 'list' })
        summary.className = 'muted'
        summary.textContent = players.length
          ? `Игроков на сервере: ${players.length}.`
          : 'Сейчас на сервере никого нет.'
        $('#online-list').replaceChildren(
          ...players.map((name: string) =>
            el(
              'li',
              { className: 'row' },
              el('div', { className: 'row-main' }, el('strong', { textContent: name })),
              el(
                'div',
                { className: 'actions' },
                button(
                  'Выгнать',
                  () => playerAction('kick', name, summary),
                  'small',
                  `Выгнать ${name}`,
                ),
                button(
                  'Убрать из матча',
                  () => playerAction('team-kick', name, summary),
                  'small',
                  `Убрать ${name} из матча`,
                ),
                can('ban')
                  ? button(
                      'Забанить',
                      () => playerAction('ban', name, summary),
                      'small danger',
                      `Забанить ${name}`,
                    )
                  : null,
              ),
            ),
          ),
        )
      } catch (error) {
        say(summary, (error as Error).message, 'error')
        $('#online-list').replaceChildren()
      }
    }
    async function loadBans() {
      const { bans } = await api('bans')
      $('#ban-list').replaceChildren(
        ...(bans.length
          ? bans.map((b: any) =>
              el(
                'li',
                { className: 'row' },
                el(
                  'div',
                  { className: 'row-main' },
                  el('strong', { textContent: b.player }),
                  el('small', {
                    textContent: `Забанил ${b.by} ${ago(b.at)}${b.reason ? ` · причина: «${b.reason}»` : ''}`,
                  }),
                ),
                button(
                  'Разбанить',
                  () => playerAction('pardon', b.player, $('#ban-status')),
                  'small',
                  `Разбанить ${b.player}`,
                ),
              ),
            )
          : [el('li', { className: 'empty', textContent: 'Никто не забанен.' })]),
      )
    }

    // ---------- Settings ----------
    const GUN_LABELS: Record<string, string> = {
      ammo: 'Боеприпас',
      ammo_amount: 'Вместимость магазина',
      extended_mag_ammo_amount: 'Расширенные магазины',
      can_crawl: 'Стрельба ползком',
      can_slide: 'Стрельба в подкате',
      bolt: 'Затвор',
      rpm: 'Выстрелов в минуту',
      bullet: 'Пуля и урон',
      draw_time: 'Доставание, секунды',
      put_away_time: 'Убирание, секунды',
      sprint_time: 'Выход из спринта, секунды',
      aim_time: 'Прицеливание, секунды',
      bolt_action_time: 'Работа затвора, секунды',
      bolt_feed_time: 'Подача патрона, секунды',
      fire_sound: 'Дальность звука выстрела',
      reload: 'Перезарядка',
      fire_mode: 'Режимы огня',
      fire_mode_adjust: 'Настройки режимов огня',
      burst_data: 'Очередь',
      crawl_recoil_multiplier: 'Множитель отдачи ползком',
      recoil: 'Отдача',
      hurt_bob_tweak_multiplier: 'Множитель качания при уроне',
      inaccuracy: 'Разброс',
      movement_speed: 'Скорость движения',
      melee: 'Ближний бой',
      heat: 'Нагрев',
      allow_attachment_types: 'Типы обвесов',
      exclusive_attachments: 'Разрешённые обвесы',
      weight: 'Вес',
      builtin_attachments: 'Встроенные обвесы',
      script: 'ID скрипта',
      script_param: 'Параметры скрипта',
      charging: 'Зарядка',
    }
    let gunCatalog: GunBalanceCatalog | undefined,
      gunOverrides: GunOverrides = {},
      gunRevision = 0
    let selectedGun: GunDefinition | undefined
    const gunReaders = new Map<string, () => unknown>()
    const gunText = (value: unknown) => JSON.stringify(value, null, 2) ?? 'null'
    function gunValues(base: any, overrides: any): any {
      if (
        !base ||
        !overrides ||
        typeof base !== 'object' ||
        typeof overrides !== 'object' ||
        Array.isArray(base) ||
        Array.isArray(overrides)
      )
        return overrides
      return Object.fromEntries([
        ...Object.entries(base),
        ...Object.entries(overrides).map(([key, value]) => [key, gunValues(base[key], value)]),
      ])
    }
    const gunLabel = (gun: GunDefinition) =>
      gun.name.endsWith('.name') ? gun.id : `${gun.name} · ${gun.id}`
    function gunShape(field: GunField): string {
      if (field.type === 'object')
        return Object.entries(field.fields ?? {})
          .map(([key, child]) => `${key}: ${gunShape(child)}`)
          .join('; ')
      if (field.type === 'array') return `массив (${gunShape(field.items!)})`
      if (field.type === 'map')
        return `ключ: ${field.keys?.values?.join(' / ') ?? field.keys?.type}; значение: ${gunShape(field.items!)}`
      return field.values?.join(' / ') ?? field.type
    }
    function collectGun() {
      if (!selectedGun) return
      const values = Object.fromEntries(
        [...gunReaders]
          .map(([key, read]) => [key, read()])
          .filter(([, value]) => value !== undefined),
      )
      if (Object.keys(values).length) gunOverrides[selectedGun.id] = values as GunOverrides[string]
      else delete gunOverrides[selectedGun.id]
    }
    function renderGun() {
      const gun = selectedGun
      gunReaders.clear()
      if (!gun || !gunCatalog) {
        $('#gun-fields').replaceChildren()
        return
      }
      $('#gun-about').textContent =
        gun.weaponKind === 'item'
          ? `${gun.sourceId} · предмет. Здесь доступны только множители частей тела.`
          : `${gun.id} · данные ${gun.data} · ${gun.type}. Общие данные дают одинаковый базовый баланс; множители частей тела задаются для каждого оружия.`
      $('#gun-warnings').textContent = gun.warnings.join(' ')
      $('#gun-fields').replaceChildren(
        ...Object.entries(weaponFields(gunCatalog, gun).fields!).map(([key, field]) => {
          const hasOverride = Object.hasOwn(gunOverrides[gun.id] ?? {}, key)
          const value = hasOverride
            ? gunValues(gun.defaults[key], gunOverrides[gun.id][key])
            : gun.defaults[key]
          if (key === 'body_part_multipliers') {
            const control = renderBodyPartField(value as Record<string, any>, field, hasOverride)
            gunReaders.set(key, control.read)
            return control.node
          }
          const id = `gun-field-${key}`
          const edit = el('input', {
            type: 'checkbox',
            checked: hasOverride,
            ariaLabel: `Изменить ${GUN_LABELS[key] ?? key}`,
          })
          const nullable = field.nullable
            ? el('input', { type: 'checkbox', checked: value === null, ariaLabel: `${key}: null` })
            : null
          const complex =
            ['object', 'array', 'map', 'json'].includes(field.type) || field.acceptsInfinite
          const input = complex
            ? el('textarea', { id, rows: 5, value: gunText(value), spellcheck: false })
            : field.type === 'boolean' || field.values
              ? el(
                  'select',
                  { id },
                  ...(field.values ?? ['true', 'false']).map((v) =>
                    el('option', { value: v, textContent: v }),
                  ),
                )
              : el('input', {
                  id,
                  type: ['integer', 'number'].includes(field.type) ? 'number' : 'text',
                  value: value === null ? '' : String(value ?? ''),
                  step: field.type === 'integer' ? '1' : 'any',
                  ...(field.min === undefined ? {} : { min: field.min, max: field.max }),
                  maxLength: 256,
                })
          if (input instanceof HTMLSelectElement) input.value = String(value)
          const sync = () => {
            input.disabled = !edit.checked || !!nullable?.checked
            if (nullable) nullable.disabled = !edit.checked
          }
          edit.onchange = sync
          if (nullable) nullable.onchange = sync
          sync()
          gunReaders.set(key, () => {
            if (!edit.checked) return undefined
            if (nullable?.checked) return null
            if (complex) {
              try {
                return JSON.parse(input.value)
              } catch {
                throw new Error(`${key}: исправьте JSON.`)
              }
            }
            if (field.type === 'boolean') return input.value === 'true'
            if (['integer', 'number'].includes(field.type)) {
              if (!input.value.trim() || !Number.isFinite(Number(input.value)))
                throw new Error(`${key}: введите число.`)
              return Number(input.value)
            }
            return input.value
          })
          return el(
            'details',
            { className: 'disclosure', open: hasOverride },
            el('summary', {
              textContent: `${GUN_LABELS[key] ?? key} · ${key}${hasOverride ? ' · изменено' : ''}`,
            }),
            el('label', { className: 'check' }, edit, 'Изменить'),
            nullable ? el('label', { className: 'check' }, nullable, 'Значение null') : null,
            el('label', { htmlFor: id, textContent: GUN_LABELS[key] ?? key }),
            input,
            el('small', {
              className: 'muted',
              textContent: `${gunShape(field)}${field.min === undefined ? '' : ` · от ${field.min} до ${field.max}`}`,
            }),
            el(
              'details',
              {},
              el('summary', { textContent: 'Значение ганпака' }),
              el('pre', { textContent: gunText(gun.defaults[key]) }),
            ),
          )
        }),
      )
    }
    function filterGuns() {
      if (!gunCatalog) return
      const query = $<HTMLInputElement>('#gun-search').value.toLowerCase().trim()
      const guns = gunCatalog.guns
        .filter((gun) => `${gun.name} ${gun.id} ${gun.type}`.toLowerCase().includes(query))
        .sort(
          (a, b) =>
            Number(KIT_GUNS.has(b.id)) - Number(KIT_GUNS.has(a.id)) ||
            Number(!!gunOverrides[b.id]) - Number(!!gunOverrides[a.id]) ||
            a.id.localeCompare(b.id),
        )
      const select = $<HTMLSelectElement>('#gun-select')
      select.replaceChildren(
        ...guns.map((gun) =>
          el('option', {
            value: gun.id,
            textContent: `${gunLabel(gun)}${gunOverrides[gun.id] ? ' · изменено' : ''}`,
          }),
        ),
      )
      select.value =
        selectedGun && guns.some((gun) => gun.id === selectedGun!.id)
          ? selectedGun.id
          : (guns[0]?.id ?? '')
      selectedGun = gunCatalog.guns.find((gun) => gun.id === select.value)
      renderGun()
      if (!guns.length) $('#gun-about').textContent = 'Оружие не найдено. Измените запрос.'
    }
    async function loadGunBalance() {
      const [availability, { settings }] = await Promise.all([api('gun-balance'), api('settings')])
      const form = $<HTMLFormElement>('#gun-balance-form')
      form.hidden = !availability.available
      if (!availability.available) {
        say($('#gun-balance-status'), availability.error, 'error')
        return
      }
      gunCatalog = availability.catalog
      gunOverrides = structuredClone(settings.gunBalance ?? {})
      gunRevision = settings.revision ?? 0
      filterGuns()
      say(
        $('#gun-balance-status'),
        `${gunCatalog!.guns.length} оружий. Изменения хранятся поверх исходных настроек.${gunCatalog!.bodyPartsEnabled === false ? ' Урон по частям тела пока выключен на сервере; множители можно подготовить заранее.' : ''}`,
      )
    }
    $<HTMLInputElement>('#gun-search').oninput = () => {
      try {
        collectGun()
        filterGuns()
      } catch (error) {
        say($('#gun-balance-status'), (error as Error).message, 'error')
      }
    }
    $<HTMLSelectElement>('#gun-select').onchange = (event) => {
      try {
        collectGun()
        selectedGun = gunCatalog?.guns.find(
          (gun) => gun.id === (event.target as HTMLSelectElement).value,
        )
        renderGun()
      } catch (error) {
        say($('#gun-balance-status'), (error as Error).message, 'error')
        if (selectedGun) $<HTMLSelectElement>('#gun-select').value = selectedGun.id
      }
    }
    $('#gun-reset').onclick = () => {
      if (selectedGun) {
        delete gunOverrides[selectedGun.id]
        renderGun()
      }
    }
    $('#gun-refresh').onclick = async () => {
      if (
        await ask({
          title: 'Обновить каталог?',
          text: 'Несохранённые изменения баланса оружия будут заменены текущими настройками сервера.',
          ok: 'Обновить',
        })
      )
        run($('#gun-balance-status'), loadGunBalance, $('#gun-balance-form'))
    }
    $<HTMLFormElement>('#gun-balance-form').onsubmit = async (event) => {
      event.preventDefault()
      await run(
        $('#gun-balance-status'),
        async () => {
          collectGun()
          const { settings } = await api('gun-balance', 'PUT', {
            expectedRevision: gunRevision,
            gunBalance: gunOverrides,
          })
          if (settingsRevision === gunRevision) settingsRevision = settings.revision
          gunRevision = settings.revision
          gunOverrides = structuredClone(settings.gunBalance ?? {})
          renderGun()
          await loadSettings(Date.now(), true)
          return 'Сохранено. Подтверждение применения — в состоянии настроек выше.'
        },
        $('#gun-balance-form'),
      )
    }
    let kitCatalog: KitCatalog | undefined,
      kitRevision = 0,
      selectedKit = '',
      kitOverrides: Record<string, KitDefinition> = Object.create(null),
      kitBindings: Record<string, string | null> = {},
      kitClassCosts: Record<string, number> = {},
      kitSnapshot = ''
    const kitBody = () => JSON.stringify({ kits: kitOverrides, fixedModeKits: kitBindings })
    function kitMeta() {
      $('#kits-meta').textContent =
        `${kitBody() === kitSnapshot ? 'Изменений нет' : 'Есть несохранённые изменения'} · ревизия ${kitRevision}`
    }
    function renderKits() {
      if (!kitCatalog) return
      const definitions = effectiveKits(kitCatalog, kitOverrides, kitClassCosts),
        select = $<HTMLSelectElement>('#kit-select')
      select.replaceChildren(
        ...Object.values(definitions).map((kit) =>
          el('option', {
            value: kit.id,
            textContent: `${kit.name} · ${kit.id}${kitOverrides[kit.id] ? ' · изменено' : ''}`,
          }),
        ),
      )
      if (!Object.hasOwn(definitions, selectedKit)) selectedKit = Object.keys(definitions)[0] ?? ''
      select.value = selectedKit
      customSelect(select)
      const kit = definitions[selectedKit],
        standard = kitCatalog.kits.find((entry) => entry.id === selectedKit)?.defaults
      $('#kit-about').textContent = kit
        ? standard
          ? 'Стандартный набор. Изменения хранятся отдельно; сброс вернёт значения выпуска.'
          : 'Пользовательский набор. Удаление уберёт его из следующих выдач.'
        : 'Наборов нет. Создайте первый.'
      $('#kit-reset').textContent = standard ? 'Вернуть стандартный набор' : 'Удалить набор'
      $<HTMLButtonElement>('#kit-reset').disabled = !kit
      $<HTMLButtonElement>('#kit-new').disabled =
        Object.keys(definitions).length >= kitCatalog.fields.kits.max
      $('#kit-fields').replaceChildren(
        ...(kit
          ? [
              renderKitForm(kitCatalog, kit, (draft) => {
                kitOverrides[draft.id] = draft
                renderKitBindings()
                kitMeta()
