        { ...after, kits: effectiveKits(kitCatalog!, after.kits, kitClassCosts) },
      )
    }
    function kitPatch(body: any, { path, value }: KitPatch) {
      let parent = body
      for (const key of path.slice(0, -1)) parent = parent[key] ??= {}
