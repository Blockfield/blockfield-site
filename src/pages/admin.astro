    .admin-main {
      --control-height: 36px;
      --action-width: auto;
      display: grid;
      grid-template-columns: 232px minmax(0, 1fr);
      gap: 0;
      max-width: none;
      margin: 0;
      padding: 0;
      font-size: 15px;
      line-height: 1.5;
    }
    .admin-main .side {
      position: sticky;
      top: 0;
      height: calc(100dvh - clamp(64px, 6.64vw, 102px));
      display: flex;
      flex-direction: column;
      border-right: 1px solid var(--line);
      background: var(--bg-2);
      min-width: 0;
      overflow-y: auto;
    }
    .admin-main .console-title {
      font-size: 14px;
      padding: 20px 18px;
      border-bottom: 1px solid var(--line);
