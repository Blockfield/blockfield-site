      </div>
    </form>
  </dialog>

  <style is:global>
    /* This global stylesheet stays inside the admin surface, including comma-list selectors. */
    .admin-main {
      /* Console container: wider than the 1200px reading-page default so operational rows use a wide monitor. */
      max-width: 1320px;
    }
    /* Compact operational header: identity first, active workspace beside it. */
    .admin-main .console-head {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 32px;
      align-items: baseline;
      justify-content: space-between;
      padding-bottom: 12px;
