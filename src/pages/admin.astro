    $('#parcool-on').addEventListener('change', (e) => {
      const on = (e.target as HTMLInputElement).checked
      $('#parcool-list')
        .querySelectorAll('input')
        .forEach((i) => ((i as HTMLInputElement).disabled = !on))
    })

    function appliedErrors(errors: string[]) {
      return errors.map((error) => {
        const key = Object.keys(SETTING_LABELS).find((k) => error.includes(k))
        if (!key)
          return error.startsWith('gunBalance')
            ? `баланс оружия: ${error}`
            : 'сервер не смог прочитать часть настроек'
        return /clamp/i.test(error)
          ? `«${SETTING_LABELS[key]}» — значение вне допустимых границ, сервер его ограничил`
