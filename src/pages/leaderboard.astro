---
import Community from '../layouts/Community.astro';
import { statsStore, filters, StatsError } from '../lib/stats';
let board: ReturnType<ReturnType<typeof statsStore>['leaderboard']> | null = null;
let error = '';
try { board = statsStore().leaderboard(filters(Astro.url.searchParams)); }
catch (e) { Astro.response.status = e instanceof StatsError ? e.status : 503; error = e instanceof StatsError && e.status === 400 ? 'Некорректные фильтры. Сбросьте параметры и повторите запрос.' : 'История временно недоступна. Это не означает, что ваши результаты потеряны.'; }
const modes = [['', 'Все режимы'], ['room', 'Casual'], ['campaign', 'Ranked · кампания'], ['deathmatch', 'Deathmatch']];
const periods = [['all','Всё время'],['week','Последние 7 дней'],['month','Последние 30 дней']];
const sorts = [['score','Очки'],['rating','MMR (Ranked)'],['kills','Убийства'],['captures','Захваты'],['pointSeconds','Время на точках'],['wins','Победы в боях'],['kd','K/D']];
const rating = (m: any) => m ? `${m.rating}${m.provisional ? '?' : ''}` : '—';
const pageLink = (page: number) => { const query = new URLSearchParams(Astro.url.searchParams); query.set('page', String(page)); return `/leaderboard?${query}`; };
const number = (n: unknown) => Number(n).toLocaleString('ru-RU', { maximumFractionDigits: 2 });
---
<Community title="Лидерборд" description="Накопленные результаты боёв. Полигон, PvP в лобби и строительные сессии здесь не учитываются.">
  <form method="get" action="/leaderboard" aria-label="Фильтры лидерборда">
    <div class="field"><span id="f-mode">Режим</span><select name="mode" aria-labelledby="f-mode">{modes.map(([value,label]) => <option value={value} selected={value === (Astro.url.searchParams.get('mode') || '')}>{label}</option>)}</select></div>
    <div class="field"><span id="f-period">Период</span><select name="period" aria-labelledby="f-period">{periods.map(([value,label]) => <option value={value} selected={value === (Astro.url.searchParams.get('period') || 'all')}>{label}</option>)}</select></div>
    <div class="field"><span id="f-sort">Сортировка</span><select name="sort" aria-labelledby="f-sort">{sorts.map(([value,label]) => <option value={value} selected={value === (Astro.url.searchParams.get('sort') || 'score')}>{label}</option>)}</select></div>
    <div class="actions"><button type="submit">Применить</button><a href="/leaderboard">Сбросить</a></div>
  </form>
  <p class="notice">MMR — рейтинг Glicko-2: меняется один раз за целую завершённую Ranked-кампанию (победа, поражение или ничья), не за раунд. Остановленные и прерванные кампании, Casual и Deathmatch его не меняют. «?» — предварительный рейтинг (меньше 5 кампаний).</p>
  {error ? <p class="notice" role="status">{error}</p> : board && board.total === 0 ? <p class="notice" role="status">За выбранный период ещё нет результатов.</p> : board && <>
    <div class="table-wrap" tabindex="0" aria-label="Таблица результатов, возможна горизонтальная прокрутка">
      <table><thead><tr><th scope="col">Место</th><th scope="col">Игрок</th><th class="num" scope="col">MMR</th><th class="num" scope="col">Очки</th><th class="num" scope="col">K / D</th><th class="num" scope="col">Захваты</th><th class="num" scope="col">Бои / победы</th></tr></thead>
        <tbody>{board.players.map((p: any, index: number) => <tr><td>{(board!.page - 1) * board!.limit + index + 1}</td><td class="player"><a href={`/players/${p.uuid}`}>{p.name}</a></td><td class="num">{rating(p.mmr)}</td><td class="num">{number(p.score)}</td><td class="num">{number(p.kills)} / {number(p.deaths)}</td><td class="num">{number(p.captures)}</td><td class="num">{number(p.matches)} / {number(p.wins)}</td></tr>)}</tbody>
      </table>
    </div>
    <nav class="pagination" aria-label="Страницы результатов">{board.page > 1 && <a href={pageLink(board.page - 1)}>← Назад</a>}<span>Страница {board.page} · игроков: {board.total}</span>{board.page * board.limit < board.total && <a href={pageLink(board.page + 1)}>Далее →</a>}</nav>
  </>}
  <style is:global>
    .field { display: grid; gap: 8px; color: #C7AE86; font-size: 14px; min-width: 200px; }
    .field select, .field .select-trigger, form .actions button, form .actions a { height: 48px; }
    .actions { display: flex; align-items: center; gap: 24px; }
    .actions a { display: inline-flex; align-items: center; }
    .select { position: relative; }
    .select-trigger { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; text-align: left; font-size: 16px; font-weight: 400; background: #11100D; color: #F3E7D0; }
    .select-trigger:hover, .select[data-open] .select-trigger { border-color: #5C4526; }
    .select-trigger::after { content: ''; width: 8px; height: 8px; border: solid #C7AE86; border-width: 0 2px 2px 0; transform: translateY(-2px) rotate(45deg); transition: transform .15s; }
    .select[data-open] .select-trigger::after { transform: translateY(2px) rotate(-135deg); }
    .select-list { position: absolute; z-index: 10; top: calc(100% + 6px); left: 0; min-width: 100%; margin: 0; padding: 6px; list-style: none; background: #11100D; border: 1px solid #5C4526; border-radius: 4px; box-shadow: 0 12px 32px #000a; }
    .select-list:focus { outline: none; }
    .select-list li { padding: 10px 12px; border-radius: 3px; color: #F3E7D0; font-size: 16px; white-space: nowrap; cursor: pointer; }
    .select-list li[data-active] { background: #2A2116; }
    .select-list li[aria-selected="true"] { color: #F5A524; }
    @media (max-width: 600px) { .field { width: 100%; } }
    @media (prefers-reduced-motion: reduce) { .select-trigger::after { transition: none; } }
  </style>
  <script>
    // Progressive enhancement: the native select stays in the form and keeps submitting the value.
    document.querySelectorAll<HTMLSelectElement>('.field select').forEach((select, n) => {
      const wrap = document.createElement('div'); wrap.className = 'select';
      const trigger = document.createElement('button');
      const list = document.createElement('ul');
      const labelId = select.getAttribute('aria-labelledby')!;
      trigger.type = 'button'; trigger.className = 'select-trigger';
      trigger.setAttribute('aria-haspopup', 'listbox'); trigger.setAttribute('aria-expanded', 'false');
      trigger.id = `select-${n}`; trigger.setAttribute('aria-labelledby', `${labelId} select-${n}`);
      list.className = 'select-list'; list.setAttribute('role', 'listbox'); list.tabIndex = -1; list.hidden = true;
      list.setAttribute('aria-labelledby', labelId);
      const items = [...select.options].map((option, i) => {
        const li = document.createElement('li');
        li.id = `select-${n}-${i}`; li.setAttribute('role', 'option'); li.textContent = option.text;
        li.addEventListener('click', () => { choose(i); close(true); });
        li.addEventListener('mousemove', () => activate(i));
        list.append(li); return li;
      });
      let active = select.selectedIndex;
      const sync = () => {
        trigger.textContent = select.options[select.selectedIndex].text;
        items.forEach((li, i) => li.setAttribute('aria-selected', String(i === select.selectedIndex)));
      };
      const activate = (i: number) => {
        active = Math.max(0, Math.min(items.length - 1, i));
        items.forEach((li, j) => li.toggleAttribute('data-active', j === active));
        list.setAttribute('aria-activedescendant', items[active].id);
        items[active].scrollIntoView({ block: 'nearest' });
      };
      const choose = (i: number) => { select.selectedIndex = i; select.dispatchEvent(new Event('change', { bubbles: true })); sync(); };
      const open = () => { list.hidden = false; wrap.toggleAttribute('data-open', true); trigger.setAttribute('aria-expanded', 'true'); activate(select.selectedIndex); list.focus(); };
      const close = (focus: boolean) => { if (list.hidden) return; list.hidden = true; wrap.removeAttribute('data-open'); trigger.setAttribute('aria-expanded', 'false'); if (focus) trigger.focus(); };
      trigger.addEventListener('click', () => list.hidden ? open() : close(true));
      trigger.addEventListener('keydown', (e) => { if (['ArrowDown', 'ArrowUp'].includes(e.key)) { e.preventDefault(); open(); } });
      list.addEventListener('keydown', (e) => {
        const keys: Record<string, () => void> = {
          ArrowDown: () => activate(active + 1), ArrowUp: () => activate(active - 1),
          Home: () => activate(0), End: () => activate(items.length - 1),
          Enter: () => { choose(active); close(true); }, ' ': () => { choose(active); close(true); },
          Escape: () => close(true),
        };
        if (e.key === 'Tab') return close(false);
        if (keys[e.key]) { e.preventDefault(); keys[e.key](); }
      });
      list.addEventListener('focusout', (e) => { if (!wrap.contains(e.relatedTarget as Node)) close(false); });
      document.addEventListener('pointerdown', (e) => { if (!wrap.contains(e.target as Node)) close(false); });
      select.hidden = true; select.tabIndex = -1;
      select.after(wrap); wrap.append(trigger, list); sync();
    });
  </script>
</Community>
