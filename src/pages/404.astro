---
import SectionRule from '../components/SectionRule.astro'
import Community from '../layouts/Community.astro'
---

<Community title="Страница не найдена" description="Такой страницы на сайте нет." bare>
  <section class="oops">
    <SectionRule label="404" code="NOT FOUND" />
    <h1>Здесь пусто</h1>
    <p class="intro">Такой страницы нет. Возможно, ссылка устарела или в адресе опечатка.</p>
    <div class="actions">
      <a class="button primary" href="/">
        На главную
      </a>
      <a class="button" href="/leaderboard">
        В лидерборд
      </a>
    </div>
  </section>
</Community>
