---
import { siteIdentity } from '../lib/admin'
import { ui } from '../lib/icons'

type NavLink = { href: string; label: string; class?: string; hidden?: boolean }

interface Props {
  cta?: { href: string; label: string; title: string } | null
}
const { cta = null } = Astro.props

const links: NavLink[] = [
  { href: '/leaderboard', label: 'Лидерборд' },
  { href: '/#rooms', label: 'Матчи', class: 'rooms-nav-link', hidden: true },
  { href: '/#game', label: 'Игра' },
  { href: '/#download', label: 'Скачать' },
  { href: 'https://discord.gg/cAUcpeCVDM', label: 'Discord' },
  { href: 'https://github.com/Blockfield/blockfield-releases', label: 'GitHub' },
]
// Рендерится на сервере, чтобы никнейм был в исходном HTML, а не подставлялся после загрузки.
const identity = await siteIdentity(Astro.cookies).catch(() => null)
const account = {
  href: '/account',
  label: identity ? identity.name : 'Аккаунт',
  aria: identity ? `Аккаунт: ${identity.name}` : undefined,
}
---

<header class="site-header">
  <a class="site-header__mark" href="/" aria-label="Blockfield — главная">
    <img class="mark" src="/logo.svg" alt="" width="64" height="64" />
    BLOCKFIELD
  </a>
  <nav class="site-header__links" aria-label="Разделы сайта">
    {links.map((link) => (
      <a href={link.href} class={link.class} hidden={link.hidden}>
        {link.label}
      </a>
    ))}
  </nav>
  <a class="site-header__account" href={account.href} aria-label={account.aria}>
    {account.label}
  </a>
  {/*
    SSR-first: staff see «Панель» immediately. The link stays in the HTML (hidden)
    for everyone else, so a stale SSR denial (cached page, transient account/DB
    failure) converges to the /admin decision via the script below.
  */}
  <a class="site-header__console" href="/admin" data-admin-link hidden={!identity?.hasAdminAccess}>
    Панель
  </a>
  {cta && (
    <a
      class="button primary site-header__cta"
      href={cta.href}
      aria-label={cta.title}
      data-platform-download
    >
      <svg class="i" viewBox="0 0 24 24" aria-hidden="true" set:html={ui.download} />
      {cta.label}
    </a>
  )}
  <button
    class="site-header__burger"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Открыть меню"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <nav class="mobile-menu__links" aria-label="Мобильное меню">
    {links.map((link) => (
      <a href={link.href} class={link.class} hidden={link.hidden}>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="mobile-menu__account">
    <a href={account.href} aria-label={account.aria}>
      {account.label}
    </a>
    <a
      class="site-header__console"
      href="/admin"
      data-admin-link
      hidden={!identity?.hasAdminAccess}
    >
      Панель
    </a>
  </div>
  {cta && (
    <a
      class="button primary mobile-menu__cta"
      href={cta.href}
      aria-label={cta.title}
      data-platform-download
    >
      <svg class="i" viewBox="0 0 24 24" aria-hidden="true" set:html={ui.download} />
      <span>{cta.title}</span>
    </a>
  )}
</div>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.site-header__burger')
  const menu = document.querySelector<HTMLElement>('#mobile-menu')
  // The header shows «Панель» exactly when /admin would let in: an SSR denial can be
  // stale (cached page, transient account/DB failure), so recheck the /admin gate
  // and only ever reveal — an SSR grant never depends on this round trip.
  const deniedAdminLinks = [...document.querySelectorAll('[data-admin-link][hidden]')]
  if (deniedAdminLinks.length && typeof fetch === 'function') {
    fetch('/api/admin/me', { headers: { Accept: 'application/json' } }).then(
      (response) => {
        if (response.ok) deniedAdminLinks.forEach((link) => link.removeAttribute('hidden'))
      },
      () => {},
    )
  }
  if (burger && menu) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open))
      menu.hidden = !open
      document.querySelectorAll<HTMLElement>('main, .site-footer').forEach((node) => {
        node.inert = open
      })
      // Оверлей во весь экран — скролл фона под ним только мешает.
      document.body.style.overflow = open ? 'hidden' : ''
    }
    window.matchMedia('(max-width: 760px)').addEventListener('change', () => setOpen(false))
    burger.addEventListener('click', () => setOpen(menu.hidden))
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false)
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false)
        burger.focus()
      }
    })
  }
</script>
