---
// The server cannot know the visitor's time zone: UTC text is the no-script fallback, the script
// localizes it and keeps the zone abbreviation so the time is never ambiguous.
interface Props {
  at: number | string
  format: 'date' | 'datetime'
}
const { at, format } = Astro.props
const ms = typeof at === 'number' ? at : Date.parse(at)
const options: Intl.DateTimeFormatOptions =
  format === 'date' ? { dateStyle: 'long' } : { dateStyle: 'medium', timeStyle: 'short' }
---

<time datetime={new Date(ms).toISOString()} data-local={format}>
  {new Intl.DateTimeFormat('ru-RU', { ...options, timeZone: 'UTC' }).format(ms)} UTC
</time>

<script>
  // dateStyle/timeStyle cannot mix with timeZoneName on some runtimes, so the zone is added
  // with explicit fields instead; the no-script markup above keeps the UTC fallback shape.
  const formats: Record<string, Intl.DateTimeFormatOptions> = {
    date: { day: 'numeric', month: 'long', year: 'numeric', timeZoneName: 'short' },
    datetime: {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZoneName: 'short',
    },
  }
  for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-local]')) {
    const options = formats[el.dataset.local ?? '']
    const ms = Date.parse(el.dateTime)
    if (options && Number.isFinite(ms))
      el.textContent = new Intl.DateTimeFormat('ru-RU', options).format(ms)
  }
</script>
