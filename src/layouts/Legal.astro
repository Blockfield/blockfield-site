---
import Site from './Site.astro'
import SectionRule from '../components/SectionRule.astro'

interface Props {
  title: string
  description: string
  sections: { id: string; title: string }[]
}
const { title, description, sections } = Astro.props
const canonical = new URL(Astro.url.pathname, 'https://blockfield.pro')
// Per-user header HTML (nickname, «Панель» link) must never sit in a shared cache.
Astro.response.headers.set('Cache-Control', 'no-store')
---

<Site title={`${title} — Blockfield`} description={description} canonical={canonical}>
  <main id="content" class="page-main legal-main">
    <SectionRule label="Документ" code="LEGAL" />
    <h1>{title}</h1>
    <p class="revision">
      Редакция от <time datetime="2026-09-12">12 сентября 2026 года</time>
    </p>
    <p class="intro">{description}</p>
    <nav aria-label="Содержание документа">
      <ul>
        {sections.map((section) => (
          <li>
            <a href={`#${section.id}`}>{section.title}</a>
          </li>
        ))}
      </ul>
    </nav>
    <article>
      <slot />
    </article>
  </main>
  <style is:global>
    .legal-main {
      max-width: 78ch;
    }
    .legal-main .revision {
      font-family: var(--mono);
      font-size: 13px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .legal-main article p,
    .legal-main li {
      font-size: 17px;
      line-height: 1.75;
      color: var(--sand);
    }
    .legal-main article {
      display: grid;
      gap: 0;
    }
    .legal-main article p {
      margin: 16px 0;
    }
    .legal-main strong {
      color: var(--cream);
      font-weight: 650;
    }
    .legal-main nav[aria-label='Содержание документа'] {
      padding-bottom: 8px;
      border-bottom: 1px solid var(--line);
    }
    .legal-main nav[aria-label='Содержание документа'] ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 6px;
    }
    .legal-main article h2 {
      margin: 44px 0 12px;
      font-size: clamp(20px, 2.4vw, 26px);
      scroll-margin-top: 24px;
    }
    .legal-main article ul {
      padding-left: 22px;
    }
    .legal-main article li + li {
      margin-top: 10px;
    }
    .legal-main article li::marker {
      color: var(--amber-dim);
    }
    @media print {
      :root,
      body {
        color-scheme: light;
        background: white;
        color: black;
      }
      .legal-main p,
      .legal-main li,
      .legal-main strong,
      .legal-main a,
      .legal-main h1,
      .legal-main h2 {
        color: black;
      }
      .site-header,
      .site-footer,
      nav,
      .skip,
      .rule {
        display: none;
      }
      .legal-main {
        padding: 0;
        max-width: none;
      }
      h2 {
        break-after: avoid;
      }
    }
  </style>
</Site>
