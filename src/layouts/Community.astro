---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/500.css';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} — Blockfield</title><meta name="description" content={description} />
    <meta name="theme-color" content="#070604" /><link rel="icon" href="/logo.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#content">Перейти к содержимому</a>
    <header>
      <a class="brand" href="/"><img src="/logo.svg" width="40" height="40" alt="" />BLOCKFIELD</a>
      <nav aria-label="Навигация"><a href="/leaderboard">Лидерборд</a><a href="/account">Аккаунт</a><a href="/">На главную</a></nav>
    </header>
    <main id="content"><h1>{title}</h1><p class="intro">{description}</p><slot /></main>
    <footer><a href="/privacy">Конфиденциальность</a><span>История не зависит от доступности игрового сервера.</span></footer>
    <style is:global>
      :root { color-scheme: dark; font-family: 'Inter Variable',sans-serif; background: #070604; color: #F3E7D0; }
      * { box-sizing: border-box; } body { margin: 0; min-width: 320px; } a { color: #F5A524; text-underline-offset: 4px; }
      a:focus-visible,button:focus-visible,select:focus-visible { outline: 2px solid #F5A524; outline-offset: 4px; }
      header,main,footer { max-width: 1200px; margin: auto; padding: 24px clamp(20px,5vw,48px); }
      header,footer,nav { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; } header { justify-content: space-between; border-bottom: 1px solid #2A2116; }
      .brand { display: flex; align-items: center; gap: 12px; color: #F3E7D0; font-weight: 750; text-decoration: none; letter-spacing: .04em; }
      main { min-height: 65vh; padding-top: 48px; padding-bottom: 64px; } h1 { font-size: clamp(32px,5vw,48px); letter-spacing: -.025em; margin: 0 0 16px; overflow-wrap: anywhere; }
      h2 { margin-top: 36px; } p { line-height: 1.65; } .intro,.muted,footer { color: #C7AE86; } .notice { border: 1px solid #2A2116; padding: 18px; background: #11100D; }
      form,.pagination,.metrics { display: flex; align-items: end; flex-wrap: wrap; gap: 16px; margin: 24px 0; }
      label { display: grid; gap: 8px; color: #C7AE86; font-size: 14px; } select,button { border: 1px solid #2A2116; border-radius: 4px; padding: 12px 16px; background: #11100D; color: #F3E7D0; font: inherit; }
      button { cursor: pointer; background: #F5A524; color: #070604; font-weight: 650; }
      .table-wrap { overflow-x: auto; } table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
      th,td { padding: 16px 12px; text-align: left; border-bottom: 1px solid #2A2116; white-space: nowrap; } th { color: #C7AE86; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
      td.num,th.num { text-align: right; } td.player { min-width: 180px; white-space: normal; overflow-wrap: anywhere; }
      .metrics > div { background: #11100D; border: 1px solid #2A2116; padding: 20px; min-width: 150px; } .metrics dt { color: #C7AE86; font-size: 13px; } .metrics dd { margin: 10px 0 0; font-size: 28px; }
      code { overflow-wrap: anywhere; } footer { border-top: 1px solid #2A2116; font-size: 14px; } .skip { position: absolute; top: -80px; left: 16px; padding: 12px; background: #11100D; } .skip:focus { top: 12px; }
    </style>
  </body>
</html>
