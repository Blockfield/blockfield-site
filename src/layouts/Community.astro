---
import Site from './Site.astro'
interface Props {
  title: string
  description: string
  heading?: string
  bare?: boolean
}
const { title, description, heading, bare = false } = Astro.props
Astro.response.headers.set('Cache-Control', 'no-store')
---

<Site title={`${title} — Blockfield`} description={description}>
  <main id="content" class="page-main">
    {!bare && (
      <div class="page-head">
        <h1>{heading ?? title}</h1>
        <p class="intro">{description}</p>
      </div>
    )}
    <slot />
  </main>
</Site>
