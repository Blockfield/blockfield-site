---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/system.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props { title: string; description: string; heading?: string; bare?: boolean }
const { title, description, heading, bare = false } = Astro.props;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} — Blockfield</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070604" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#content">Перейти к содержимому</a>
    <SiteHeader />
    <main id="content">
      {!bare && (
        <div class="page-head">
          <h1>{heading ?? title}</h1>
          <p class="intro">{description}</p>
        </div>
      )}
      <slot />
    </main>
    <SiteFooter />
    <style is:global>
      main { max-width: 1200px; margin: 0 auto; padding: clamp(32px, 4vw, 56px) clamp(14px, 5vw, 48px) 80px; min-height: 60vh; display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-content: start; }
      .page-head { display: grid; gap: 12px; }
      .intro { max-width: 34em; color: var(--sand); font-size: clamp(15px, 1.17vw, 17px); }
      h2 { margin-top: 12px; }

      /* Фильтры и пагинация — одна горизонтальная полоса, всё на одной базовой линии. */
      form.filters, .pagination { display: flex; align-items: end; flex-wrap: wrap; gap: 16px; margin: 0; }
      .pagination { align-items: center; justify-content: space-between; color: var(--sand); font-size: 14px; }
      .pagination a { display: inline-flex; align-items: center; min-height: 38px; padding: 0 12px; border: 1px solid var(--line-2); color: var(--cream); text-decoration: none; font-weight: 600; font-size: 14px; }
      .pagination a:hover { background: var(--line); border-color: var(--amber); }

      .field { display: grid; gap: 8px; min-width: 200px; color: var(--sand); font-size: 14px; }
      .field > span { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
      .field select, .field .cselect-btn, form.filters .actions button, form.filters .actions a { height: 48px; }
      form.filters .actions { display: flex; align-items: center; gap: 16px; }
      form.filters .actions a { display: inline-flex; align-items: center; color: var(--sand); }

      td.player { min-width: 200px; white-space: normal; overflow-wrap: anywhere; }
      @media (max-width: 600px) { .field { width: 100%; } }
    </style>
  </body>
</html>
